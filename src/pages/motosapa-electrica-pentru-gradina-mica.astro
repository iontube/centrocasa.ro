---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import SimilarArticles from '../components/SimilarArticles.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import emag from '../data/emag-products.json';
import keywordsData from '../../keywords.json';
import { visibleArticles, slugify } from '../lib/articles.mjs';

const relatedArticles = visibleArticles(keywordsData.completed).map(item => ({
  title: item.keyword.charAt(0).toUpperCase() + item.keyword.slice(1),
  slug: item.slug || slugify(item.keyword),
  excerpt: item.excerpt || '',
  image: item.image || `/images/articles/${item.slug || slugify(item.keyword)}.webp`,
  category: item.category,
  categorySlug: item.categorySlug,
  date: item.date || '',
}));

const pool = emag['motosapa-electrica'] || [];
const byId = Object.fromEntries(pool.map(p => [p.id, p]));

const PICKS = [
  // --- Compacte, pentru gradina mica ---
  { g: 'mic', id: 'D70B9HYBM', badge: 'Cea mai ieftina', short: 'Kanwod Grave', putere: '1050 W', adancime: '22 cm', greutate: '8.65 kg',
    specs: ['1050 W, adancime de lucru 22 cm', 'usoara, 8.65 kg', 'cel mai mic pret din selectie', 'nota mare, 4.82 din 11 pareri'],
    pros: ['Cel mai mic pret din toata selectia', 'Usoara, 8.65 kg, o manevrezi lejer', 'Nota mare, 4.82, din 11 pareri', 'Adancime buna de lucru, 22 cm'],
    cons: ['Brand mai putin cunoscut', 'Putine pareri, 11'],
    verdict: 'Cu cel mai mic pret afanezi pamantul intr-o gradina mica, cu un aparat surprinzator de bine cotat. Kanwod Grave are 1050 W si o adancime de lucru de 22 cm, suficienta pentru un strat de legume sau o gradina de casa, si cantareste doar 8.65 kg, deci o plimbi si o intorci usor pe capete de rand. E cel mai ieftin model din selectie, iar nota de 4.82 din 11 pareri arata ca primii cumparatori sunt multumiti. Vine de la un brand mai putin cunoscut si are inca putine recenzii, asa ca te bazezi mai mult pe specificatii si pe notele bune. O iei cand vrei cea mai accesibila motosapa electrica pentru o gradina mica, usoara si cu adancime buna, si nu conteaza brandul.' },
  { g: 'mic', id: 'DT5PBPMBM', badge: 'Cea mai vanduta compacta', short: 'Könner KS 1000T E', putere: '1000 W', adancime: '22 cm', greutate: '8 kg',
    specs: ['1000 W, 4 freze, adancime 22 cm', 'usoara, 8 kg', 'de la Könner&Söhnen, brand cunoscut', 'cea mai vanduta din grupul compact, 22 de pareri'],
    pros: ['Cea mai vanduta motosapa compacta din selectie, 22 de pareri', 'Könner&Söhnen, brand apreciat pentru unelte', 'Nota buna, 4.68, si doar 8 kg', 'Patru freze, afaneaza bine solul'],
    cons: ['Putere de 1000 W, medie pentru grupul compact', 'Latime de lucru mai mica'],
    verdict: 'Cea mai vanduta motosapa compacta din selectie, de la un brand apreciat pentru unelte. Könner&Söhnen KS 1000T E are 1000 W, patru freze si o adancime de lucru de 22 cm, tot ce trebuie pentru afanarea unei gradini mici sau a unui solar, si cantareste doar 8 kg, deci e usor de manevrat de oricine. E cea mai vanduta din grupul compact, cu 22 de pareri si nota 4.68, semn ca lumea o cumpara si e multumita, iar Könner&Söhnen e un nume de incredere in uneltele de gradina. Puterea de 1000 W e medie pentru grup, potrivita pentru sol deja lucrat, nu pentru teren foarte tare. O iei cand vrei cea mai testata motosapa compacta, de la un brand serios, usoara si cu freze bune, pentru o gradina mica.' },
  { g: 'mic', id: 'DDYVJJMBM', badge: 'Bun raport', short: 'Heinner VSE001', putere: '1000 W', adancime: '20 cm', greutate: '',
    specs: ['1000 W, 380 rpm', 'adancime de lucru 20 cm', 'de la Heinner, brand cunoscut la noi', 'nota 4.37 din 19 pareri'],
    pros: ['Heinner, brand cunoscut, cu service la noi', 'Pret bun pentru un 1000 W de brand', '19 pareri, una dintre cele mai cotate', 'Buna pentru gradina de casa'],
    cons: ['Adancime ceva mai mica, 20 cm', 'Putere medie, 1000 W'],
    verdict: 'Un bun raport pret-brand, pentru cine vrea o motosapa de la un nume cunoscut la noi. Heinner VSE001 are 1000 W la 380 de rotatii pe minut si o adancime de lucru de 20 cm, potrivita pentru o gradina de casa sau un strat de legume, la un pret accesibil pentru un aparat de brand. Heinner e cunoscut si are service in tara, un plus de siguranta fata de marcile generice, iar cu 19 pareri e una dintre cele mai cotate din grupul compact. Adancimea de 20 cm e ceva mai mica decat la altele, iar puterea de 1000 W e medie. O iei cand vrei o motosapa de la un brand cunoscut, cu service la noi, la un pret bun, pentru intretinerea unei gradini mici.' },
  { g: 'mic', id: 'D3VWFJMBM', badge: 'Einhell, de brand', short: 'Einhell GC-RT 7530', putere: '750 W', adancime: '20 cm', greutate: '',
    specs: ['750 W, adancime de lucru 20 cm', 'de la Einhell, brand de unelte', 'compacta, pentru suprafete mici', 'nota 4.8 din 5 pareri'],
    pros: ['Einhell, brand consacrat de scule si unelte', 'Compacta si usoara, pentru gradini mici', 'Nota mare, 4.8', 'Ideala pentru straturi si solarii'],
    cons: ['Putere mai mica, 750 W', 'Putine pareri, 5'],
    verdict: 'Alegerea daca vrei o motosapa mica de la un brand de unelte consacrat. Einhell GC-RT 7530 are 750 W si o adancime de lucru de 20 cm, o putere potrivita pentru suprafete mici si sol deja lucrat, intr-un corp compact si usor de manevrat. Einhell e un nume cunoscut in scule si unelte de gradina, cu o gama larga si accesorii, un plus daca ai deja produse de la ei. A luat nota mare, 4.8, chiar daca din putine pareri, doar 5. Puterea de 750 W e printre cele mai mici din selectie, deci o iei pentru straturi, solarii si gradini mici, nu pentru teren tare sau suprafete mari. O alegi cand vrei brandul Einhell si o motosapa mica pentru o gradina de dimensiuni reduse.' },
  { g: 'mic', id: 'D4L77NBBM', badge: 'Cea mai usoara', short: 'Texas EL-TEX 750', putere: '750 W', adancime: '22 cm', greutate: '7.4 kg',
    specs: ['750 W, special pentru solarii si gradina', 'cea mai usoara, 7.4 kg', 'adancime de lucru 22 cm', 'nota maxima, 5 din 5'],
    pros: ['Cea mai usoara din selectie, 7.4 kg', 'Gandita special pentru solarii si gradini mici', 'Nota maxima, 5 din 5', 'Adancime buna pentru dimensiunea ei, 22 cm'],
    cons: ['Putere mica, 750 W', 'Putine pareri, 5'],
    verdict: 'Cea mai usoara motosapa din selectie, facuta anume pentru solarii si gradini mici. Texas EL-TEX 750 cantareste doar 7.4 kg, deci o ridici si o manevrezi fara efort, chiar si prin spatiile stramte dintre straturi sau intr-un solar, si are 750 W cu o adancime de lucru de 22 cm, buna pentru dimensiunea ei. E gandita exact pentru acest tip de utilizare, iar nota maxima, 5 din 5, chiar daca din 5 pareri, e un semn bun. Puterea mica o limiteaza la sol deja lucrat si suprafete reduse, nu la teren tare. O iei cand ai un solar sau o gradina mica si vrei cea mai usoara si mai manevrabila motosapa, potrivita perfect pentru spatii stramte.' },
  { g: 'mic', id: 'DMXBP3BBM', badge: 'Hecht, usoara', short: 'Hecht 738', putere: '1000 W', adancime: '', greutate: '7.7 kg',
    specs: ['1000 W, latime de lucru 30 cm', 'usoara, 7.7 kg', 'de la Hecht, brand de unelte', 'nota 4.5 din 10 pareri'],
    pros: ['Hecht, brand cunoscut de unelte de gradina', 'Usoara, 7.7 kg, si latime buna, 30 cm', 'Nota decenta, 4.5, din 10 pareri', 'Echilibru bun intre putere si greutate'],
    cons: ['Brand mai putin raspandit', 'Adancime nedeclarata clar'],
    verdict: 'O motosapa usoara si echilibrata de la un brand de unelte cunoscut. Hecht 738 are 1000 W si o latime de lucru de 30 cm, potrivita pentru gradini mici si medii, la o greutate de doar 7.7 kg, deci ramane usor de manevrat pe capete de rand si prin spatii stramte. Hecht e un nume cunoscut in uneltele de gradina, cu o gama larga, iar nota de 4.5 din 10 pareri e decenta. Puterea de 1000 W si latimea de 30 cm o fac un mijloc bun intre modelele foarte mici de 750 W si cele grele de 1500 W. O iei cand vrei o motosapa usoara, cu latime buna, de la un brand de unelte, pentru o gradina mica spre medie.' },
  // --- Mai puternice, pentru gradini mai mari ---
  { g: 'mare', id: 'D3BM8XYBM', badge: 'Cea mai vanduta', short: 'Steinhaus PRO-TIL1500', putere: '1500 W', adancime: '22 cm', greutate: '12.6 kg',
    specs: ['1500 W, latime de lucru 45 cm', '6 cutite, adancime 22 cm', 'de departe cea mai vanduta, 32 de pareri', 'pentru suprafete mai mari'],
    pros: ['De departe cea mai vanduta din selectie, 32 de pareri', 'Putere mare, 1500 W, si latime generoasa, 45 cm', 'Sase cutite, afaneaza in profunzime', 'Pret bun pentru puterea oferita'],
    cons: ['Grea, 12.6 kg', 'Nota 4.06, mai modesta'],
    verdict: 'Cea mai vanduta motosapa din toata selectia, pentru cine are o gradina mai mare. Steinhaus PRO-TIL1500 are 1500 W si o latime de lucru de 45 cm, deci acopera mai mult teren la fiecare trecere, cu sase cutite care afaneaza bine, la o adancime de 22 cm. E de departe cea mai vanduta, cu 32 de pareri, si are un pret bun pentru puterea oferita. In schimb, e grea, 12.6 kg, deci cere mai mult efort la manevrat si la intors, iar nota, 4.06, e ceva mai modesta decat la modelele compacte. O iei cand ai o gradina mai mare de afanat si vrei putere si latime la un pret bun, si nu te deranjeaza greutatea in plus.' },
  { g: 'mare', id: 'DBYGWSMBM', badge: 'Könner, robusta', short: 'Könner KS 1500TE', putere: '1500 W', adancime: '22 cm', greutate: '12 kg',
    specs: ['1500 W, adancime de lucru 22 cm', 'robusta, de la Könner&Söhnen', '12 kg', 'nota 4 din 15 pareri'],
    pros: ['Könner&Söhnen, brand apreciat pentru unelte', 'Putere mare, 1500 W', 'Constructie robusta', 'Adancime buna, 22 cm'],
    cons: ['Grea, 12 kg', 'Nota 4, mai modesta, si pret mai mare'],
    verdict: 'Alternativa robusta de la Könner&Söhnen, pentru cine vrea putere si un brand de incredere. KS 1500TE are 1500 W si o adancime de lucru de 22 cm, cu o constructie solida specifica brandului, potrivita pentru gradini mai mari sau sol mai tare. Könner&Söhnen e apreciat pentru uneltele lui, un plus de siguranta la un aparat pe care il folosesti sezonier. Cantareste 12 kg, deci e mai grea si mai obositoare la manevrat decat modelele compacte, iar nota de 4 din 15 pareri e mai modesta, la un pret mai ridicat decat Steinhaus de aceeasi putere. O iei cand pui pret pe robustetea si brandul Könner&Söhnen si vrei o motosapa puternica pentru o gradina mai mare.' },
  { g: 'mare', id: 'DJ03QZYBM', badge: 'Nota maxima', short: 'Evotools ET 1500', putere: '1500 W', adancime: '22 cm', greutate: '10 kg',
    specs: ['1500 W, latime de lucru 40 cm', 'adancime 22 cm, 10 kg', 'nota maxima, 5 din 5', 'mai usoara decat alte modele de 1500 W'],
    pros: ['Nota maxima, 5 din 5', 'Mai usoara, 10 kg, pentru un 1500 W', 'Latime buna, 40 cm', 'Putere mare la greutate mai mica'],
    cons: ['Putine pareri, 5', 'Brand mai putin cunoscut'],
    verdict: 'Alegerea daca vrei putere de 1500 W, dar mai putina greutate. Evotools ET 1500 are 1500 W si o latime de lucru de 40 cm, dar cantareste doar 10 kg, cu peste doua kilograme mai putin decat alte modele de aceeasi putere, ceea ce o face mai usor de manevrat fara sa pierzi din capacitate. Afaneaza la 22 cm adancime si a luat nota maxima, 5 din 5, chiar daca din putine pareri, 5. E un echilibru bun intre putere si greutate, potrivit pentru o gradina medie spre mare, fara efortul unui aparat de 12-13 kg. O iei cand vrei putere mare, latime buna si o greutate mai rezonabila, de la un brand mai nou dar bine notat de primii cumparatori.' },
  { g: 'mare', id: 'DYKLN4MBM', badge: 'Cea mai lata', short: 'Texas El-tex 1800', putere: '1800 W', adancime: '', greutate: '',
    specs: ['1800 W, latime de lucru 60 cm', 'cea mai lata din selectie', 'de la Texas, brand de unelte', 'pentru suprafete mari'],
    pros: ['Cea mai lata din selectie, 60 cm, acopera mult teren', 'Putere mare, 1800 W', 'Texas, brand cunoscut de unelte de gradina', 'Nota maxima de la primii cumparatori'],
    cons: ['Cea mai scumpa din selectie', 'Foarte putine pareri, 3'],
    verdict: 'Cea mai lata si mai productiva motosapa din selectie, pentru suprafete mari. Texas El-tex 1800 are 1800 W si o latime de lucru de 60 cm, de departe cea mai mare de aici, deci afaneaza o fasie lata la fiecare trecere si termina mult mai repede o gradina intinsa. Texas e un brand cunoscut de unelte de gradina, iar nota maxima de la primii cumparatori e incurajatoare. E, insa, cea mai scumpa din selectie si are foarte putine pareri, doar 3, asa ca te bazezi pe specificatii. Latimea mare o face mai putin manevrabila prin spatii stramte. O iei cand ai o gradina mare de lucrat si vrei sa termini repede, cu cea mai lata motosapa electrica din selectie, si bugetul nu e principala grija.' },
  { g: 'mare', id: 'D7L7GVMBM', badge: 'Cea mai puternica', short: 'Kraft&Dele KD5182', putere: '2200 W', adancime: '22 cm', greutate: '10 kg',
    specs: ['2200 W, cea mai mare putere din selectie', 'adancime de lucru 22 cm', '10 kg', 'nota maxima, 5 din 5'],
    pros: ['Cea mai mare putere din selectie, 2200 W', 'Face fata si solului mai tare', 'Doar 10 kg pentru puterea ei', 'Nota maxima, 5 din 5'],
    cons: ['Putine pareri, 3', 'Consum mai mare la puterea asta'],
    verdict: 'Cea mai puternica motosapa electrica din selectie, pentru sol mai tare si suprafete mari. Kraft&Dele KD5182 are 2200 W, de departe cea mai mare putere de aici, deci face fata mai bine terenului compact sau nelucrat de mult, unde motoarele mai mici se chinuie, si afaneaza la 22 cm adancime. Cantareste 10 kg, rezonabil pentru puterea ei, si a luat nota maxima, 5 din 5, din primele 3 pareri. Puterea mare inseamna si un consum pe masura, iar numarul de pareri e inca mic. O iei cand ai o gradina cu sol mai tare sau mai mare si vrei cea mai puternica motosapa electrica din selectie, care sa nu se opreasca in pamant greu.' },
  { g: 'mare', id: 'D1QRKTMBM', badge: 'Accesibila, 1700 W', short: 'Electrocultor Powermat 1700', putere: '1700 W', adancime: '', greutate: '',
    specs: ['electrocultor de 1700 W', 'latime de lucru 360 mm', 'pentru gradini medii', 'nota 4.17 din 6 pareri'],
    pros: ['Putere mare, 1700 W, la un pret accesibil', 'Latime de lucru de 36 cm, buna pentru gradini medii', 'Raport bun putere-pret', 'Alternativa mai ieftina la modelele de brand'],
    cons: ['Putine pareri, 6, nota 4.17', 'Brand generic'],
    verdict: 'O optiune puternica la un pret accesibil, pentru o gradina medie. Electrocultorul Powermat are 1700 W si o latime de lucru de 36 cm, deci multa putere si o latime decenta la un pret sub cel al modelelor de brand de aceeasi clasa. E un mijloc bun intre motosapele compacte si cele foarte late si scumpe, potrivit pentru o gradina medie unde vrei sa afanezi in profunzime fara sa dai bani multi. Are inca putine pareri, 6, cu o nota de 4.17, si vine de la un brand generic. O iei cand vrei putere mare, 1700 W, si o latime buna la cel mai mic pret posibil, si nu conteaza brandul, ci raportul putere-pret.' },
].map(x => ({ ...x, p: byId[x.id] })).filter(x => x.p);

const MIC = PICKS.filter(x => x.g === 'mic');
const MARE = PICKS.filter(x => x.g === 'mare');

const hero = '/images/articles/motosapa-electrica-pentru-gradina-mica.webp';
const figMic = '/imagini/articole/motosapa-compacte.webp';
const figMare = '/imagini/articole/motosapa-puternice.webp';
const published = '2026-07-18T21:37:21+03:00';

const faq = [
  { question: 'Ce putere de motosapa electrica imi trebuie pentru o gradina mica?', answer: 'Pentru o gradina mica sau un solar, o motosapa de 750-1500 W e mai mult decat suficienta. Modelele de 750-1000 W, ca Einhell, Texas sau Heinner din selectie, se descurca bine pe sol deja lucrat si pe suprafete reduse, iar cele spre 1500 W, ca Steinhaus sau Evotools, aduc un plus de putere daca ai o gradina ceva mai mare sau un sol mai tare. Puterea mai mare conteaza cel mai mult pe teren compact sau nelucrat de mult; pentru intretinerea unei gradini de casa, un motor de 1000 W face treaba fara probleme si e mai usor de manevrat.' },
  { question: 'Ce latime si adancime de lucru sa aleg?', answer: 'Latimea de lucru arata cat de mult teren afanezi la o trecere si variaza in general intre 28 si 45 cm, iar la modelele mari ajunge la 60 cm. Pentru o gradina mica sau un solar, o latime de 28-36 cm e ideala, pentru ca te strecori usor printre straturi; pentru suprafete mari, o latime mai mare termina treaba mai repede, dar e mai greu de manevrat. Adancimea de lucru, in general 20-22 cm la modelele din selectie, spune cat de adanc rascoleste pamantul: 20 cm ajung pentru un strat de legume, iar mai mult inseamna afanare in profunzime, buna inainte de plantare.' },
  { question: 'Motosapa electrica sau pe benzina, ce sa aleg?', answer: 'Pentru gradini mici si medii, motosapa electrica e alegerea mai buna: e mai usoara, mult mai silentioasa, porneste instant de la buton, nu are miros de combustibil si cere intretinere minima. E ideala pentru gradinari care ingrijesc suprafete mici, fara bataia de cap a unui motor termic. Motosapa pe benzina sau un motocultor cu motor termic isi arata rostul doar daca ai teren mare, sol foarte compact sau argilos, unde puterea si autonomia fara cablu conteaza. Pentru o gradina de casa sau un solar, insa, electrica e mai practica, mai curata si mai ieftina de intretinut.' },
  { question: 'Cat de grea trebuie sa fie si conteaza greutatea?', answer: 'Conteaza mult, pentru ca o motosapa se manevreaza cu bratele si se intoarce des la capete de rand. Modelele compacte din selectie cantaresc intre 7 si 9 kg, ca Texas EL-TEX de 7.4 kg sau Könner de 8 kg, deci le ridici si le controlezi usor, ideal pentru gradini mici si pentru cine nu vrea efort. Cele puternice, de 1500 W in sus, ajung la 10-13 kg, ca Steinhaus de 12.6 kg, mai obositoare la manevrat, dar cu mai multa putere. Daca lucrezi o suprafata mica sau vrei ceva usor de manuit, alege un model sub 9 kg; daca ai teren mai mare si mai tare, accepti greutatea in plus pentru putere.' },
  { question: 'Ce sunt frezele si cate imi trebuie?', answer: 'Frezele, numite si cutite, sunt discurile cu lame care se rotesc si rascolesc pamantul, inima motosapei. Numarul lor si latimea pe care o acopera influenteaza cat de bine si cat de lat afaneaza: mai multe freze inseamna o brazda mai lata si o afanare mai uniforma. Modelele din selectie vin cu configuratii diferite, de la patru freze, ca la Könner, pana la seturi cu mai multe cutite pe modelele late. Pentru o gradina mica, un set standard de freze e suficient; important e sa fie din otel rezistent si sa se poata inlocui la nevoie, ca sa nu ramai cu aparatul nefolosibil dupa cateva sezoane.' },
  { question: 'Cum folosesc si intretin o motosapa electrica?', answer: 'Fiind electrica, cu cablu, lucreaza legata la priza sau la un prelungitor pentru exterior, asa ca ai grija sa tii cablul in spate, departe de freze, ca sa nu il prinzi. Treci cu ea uniform peste teren, la o adancime pe care o cresti treptat daca solul e tare, si nu o forta in pamant foarte compact, unde s-ar putea supraincalzi. Dupa folosire, curata frezele de pamant si radacini, sterge aparatul si depoziteaza-l uscat. Verifica periodic frezele si suruburile si strange-le daca s-au slabit. Intretinerea unei motosape electrice e minima fata de una pe benzina, tocmai pentru ca nu are motor termic, ulei sau bujii.' },
  { question: 'Cat costa o motosapa electrica buna?', answer: 'In selectie, o motosapa compacta buna pentru o gradina mica porneste de la circa 300-490 de lei, cazul modelelor Kanwod, Hecht sau Texas, cu putere de 750-1050 W. Modelele mai puternice, de 1500 W, ca Steinhaus sau Evotools, sunt in general 500-730 de lei, iar cele foarte late sau puternice, ca Texas El-tex 1800 sau Kraft&Dele de 2200 W, trec de 750 si urca spre 1500 de lei. Pe langa pret, gandeste-te la marimea gradinii: pentru una mica, un model accesibil de 750-1000 W e cea mai buna alegere; puterea si latimea mari se justifica doar daca ai teren mare sau sol tare.' },
];

const images = [hero, figMic, figMare, ...PICKS.map(x => x.p.image)];
---

