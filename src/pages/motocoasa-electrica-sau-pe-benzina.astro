---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import SimilarArticles from '../components/SimilarArticles.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import emag from '../data/emag-products.json';
import keywordsData from '../../keywords.json';
import { visibleArticles, slugify } from '../lib/articles.mjs';

const relatedArticles = visibleArticles(keywordsData.completed).map(item => ({
  title: item.keyword.charAt(0).toUpperCase() + item.keyword.slice(1),
  slug: item.slug || slugify(item.keyword),
  excerpt: item.excerpt || '',
  image: item.image || `/images/articles/${item.slug || slugify(item.keyword)}.webp`,
  category: item.category,
  categorySlug: item.categorySlug,
  date: item.date || '',
}));

const pool = emag['motocoasa'] || [];
const byId = Object.fromEntries(pool.map(p => [p.id, p]));

const PICKS = [
  // --- Benzina ---
  { g: 'benzina', id: 'D2VX09YBM', badge: 'Cea mai vanduta', short: 'Ruris DAC 510', alim: 'Benzina', putere: '62 cm³', taiere: 'fir + lama', greutate: '9.3 kg',
    specs: ['motocoasa pe benzina, 62 cm³', 'taie cu fir si cu lama (disc)', 'brand romanesc Ruris', 'pentru iarba inalta si buruieni'],
    pros: ['Cea mai vanduta din selectie, sute de pareri', 'Vine cu fir si cu lama disc, pentru iarba si buruieni deopotriva', 'Ruris, brand romanesc cu service la indemana', 'Putere buna pentru suprafete mari si teren aspru'],
    cons: ['Cea mai grea, 9.3 kg, cere ham si obisnuinta', 'Motor pe benzina, cu amestec, zgomot si intretinere'],
    verdict: 'Alegerea clasica pentru cine are mult de tuns si teren dificil, cu buruieni, nu doar gazon fin. Ruris DAC 510 e o motocoasa pe benzina de 62 cm³, cu cel mai mare numar de pareri din selectie, semn ca s-a vandut foarte mult. Vine cu doua sisteme de taiere, fir pentru iarba si lama disc pentru buruieni si tulpini groase, deci acopera aproape orice in curte. Fiind Ruris, un brand romanesc, ai service si piese usor de gasit. E cea mai grea din selectie, 9.3 kg, deci se poarta cu ham si cere ceva obisnuinta. O iei cand ai suprafete mari, iarba inalta si buruieni de doborat, si vrei un utilaj pe benzina, puternic si de incredere.' },
  { g: 'benzina', id: 'DYXCH03BM', badge: 'Buget, pe benzina', short: 'Steinhaus PRO-TU430S', alim: 'Benzina', putere: '42.7 cm³', taiere: 'fir + lama', greutate: '8.5 kg',
    specs: ['motocoasa pe benzina, 2 timpi', 'capacitate 42.7 cm³', 'taie cu fir si cu lama', 'foarte vanduta, pret mic'],
    pros: ['Pret mic pentru o motocoasa pe benzina', 'Foarte vanduta, cu multe pareri', 'Vine cu fir si cu lama disc', 'Motor in 2 timpi, usor si cu putere buna pe greutate'],
    cons: ['Motor in 2 timpi, cere amestec benzina cu ulei 2T', 'Steinhaus e o gama de buget, calitate variabila'],
    verdict: 'Cea mai ieftina motocoasa pe benzina din selectie, si una dintre cele mai vandute. Steinhaus PRO-TU430S are un motor in 2 timpi de 42.7 cm³, care ii da un raport bun putere-greutate, si vine cu fir si cu lama disc, pentru iarba si buruieni. Fiind in 2 timpi, functioneaza cu amestec de benzina si ulei 2T, pe care il faci tu la proportia din manual, in general 1 la 50. Steinhaus e o gama de buget, deci calitatea mai variaza de la bucata la bucata, dar la pretul asta e un bun punct de intrare. O iei cand vrei o motocoasa pe benzina ieftina, pentru o curte cu iarba si buruieni, fara sa dai multi bani.' },
  { g: 'benzina', id: 'D0SR9MMBM', badge: 'Mai multa putere', short: 'ProCraft T4350', alim: 'Benzina', putere: '58 cm³', taiere: 'fir + lama', greutate: '6 kg',
    specs: ['benzina, 58 cm³, 6 CP', 'latime de taiere 415 mm', 'fir si 4 sisteme de taiere', 'usoara pentru clasa ei, 6 kg'],
    pros: ['Motor puternic, 6 CP, pentru buruieni si tulpini groase', 'Latime de taiere mare, 415 mm', 'Vine cu mai multe sisteme de taiere, fir si discuri', 'Doar 6 kg, usoara pentru o motocoasa pe benzina'],
    cons: ['Brand mai putin cunoscut, verifica service-ul', 'Motor pe benzina, cu amestec si zgomot'],
    verdict: 'Alegerea cand vrei putere multa pe benzina, dar si un utilaj usor de purtat. ProCraft T4350 are 6 CP si 58 cm³, printre cele mai puternice din selectie, cu o latime de taiere mare de 415 mm, deci doboara buruieni si tulpini groase repede si acopera suprafata din putine treceri. Vine cu mai multe sisteme de taiere, fir pentru iarba si discuri pentru buruieni, si cantareste doar 6 kg, surprinzator de putin pentru clasa ei. ProCraft nu e un brand la fel de cunoscut ca Ruris, deci verifica din timp piesele si service-ul. O iei cand vrei cea mai multa putere pe benzina dintr-un utilaj inca usor de manevrat.' },
  // --- Electrica cu fir ---
  { g: 'electric', id: 'DV91RWBBM', badge: 'Cea mai usoara', short: 'Bosch EasyGrassCut', alim: 'Electrica (fir)', putere: '280 W', taiere: 'fir', greutate: '1.9 kg',
    specs: ['coasa electrica cu fir, la retea', '280 W, latime de taiere 23 cm', 'taie cu fir', 'foarte usoara, 1.9 kg'],
    pros: ['Doar 1.9 kg, o manevreaza oricine, fara efort', 'Bosch, brand de incredere, nota mare', 'Porneste instant, fara benzina si fara amestec', 'Ideala pentru margini, alei si gazon mic'],
    cons: ['Depinzi de un cablu si de o priza in apropiere', 'Taie doar cu fir, nu doboara buruieni groase'],
    verdict: 'Alegerea pentru un gazon mic si pentru margini, cand nu vrei greutatea si bataia de cap ale benzinei. Bosch EasyGrassCut are doar 280 W si 1.9 kg, deci o poarta oricine fara efort, si porneste instant, doar din buton, fara amestec si fara fum. E perfecta pentru finisat marginile, aleile si petecele de iarba pe care masina de tuns nu le prinde. Fiind la retea, depinzi de un cablu si de o priza in apropiere, iar cu fir taie iarba, nu buruieni groase. Bosch e un brand de incredere, cu nota mare de la cumparatori. O iei cand ai o curte mica, vrei ceva usor, silentios si ieftin de intretinut.' },
  { g: 'electric', id: 'DJ0T2DBBM', badge: 'Raport bun', short: 'Einhell GC-ET 4530', alim: 'Electrica (fir)', putere: '450 W', taiere: 'fir', greutate: '2.65 kg',
    specs: ['coasa electrica cu fir, 450 W', 'latime de taiere 30 cm', 'taie cu fir', 'usoara, 2.65 kg'],
    pros: ['Latime de taiere mai mare, 30 cm, tunzi mai repede', 'Mai multa putere, 450 W, pentru iarba mai deasa', 'Einhell, raport bun calitate-pret', 'Usoara si simpla, fara benzina'],
    cons: ['Tot la retea, cu cablu', 'Cu fir, pentru iarba, nu pentru buruieni'],
    verdict: 'Un pas peste modelul de baza: mai multa putere si o latime de taiere mai mare, la un pret inca mic. Einhell GC-ET 4530 are 450 W si taie pe 30 cm, deci trece mai repede prin iarba mai deasa decat o coasa de 23 cm, ramanand usoara, la 2.65 kg. E tot o coasa electrica cu fir, la retea, deci depinzi de cablu, si e gandita pentru iarba, nu pentru buruieni groase. Einhell e un brand cu raport bun calitate-pret, cu piese si accesorii usor de gasit. O iei cand vrei o coasa electrica ceva mai capabila, pentru un gazon mic spre mediu, fara sa treci la benzina.' },
  { g: 'electric', id: 'D410DZBBM', badge: 'Cea mai puternica electrica', short: 'Makita UR3501', alim: 'Electrica (fir)', putere: '1000 W', taiere: 'fir', greutate: '',
    specs: ['coasa electrica cu fir, 1000 W', 'aproape de o motocoasa, fara benzina', 'Makita, brand profesional', 'nota cea mai mare din selectie'],
    pros: ['1000 W, cea mai puternica electrica, aproape de o motocoasa', 'Makita, brand profesional, foarte fiabil', 'Nota cea mai mare din selectie, aproape de maxim', 'Fara benzina si fara amestec, dar cu putere serioasa'],
    cons: ['Cea mai scumpa dintre cele electrice cu fir', 'Tot depinzi de un cablu si de o priza'],
    verdict: 'Alegerea daca vrei putere de motocoasa fara benzina si fara acumulator. Makita UR3501 are 1000 W, mult peste coasele electrice obisnuite, deci trece si prin iarba inalta si deasa, apropiindu-se de o motocoasa usoara, dar fara amestec, fara fum si mult mai silentioasa. Makita e un brand profesional, printre cele mai fiabile, iar modelul are nota cea mai mare din toata selectia. E cea mai scumpa dintre cele electrice cu fir si, ca oricare, depinde de un cablu si de o priza. O iei cand ai curent la indemana, vrei putere serioasa si preferi comoditatea electricului fata de benzina.' },
  // --- Acumulator ---
  { g: 'acumulator', id: 'DB58SK2BM', badge: 'Cea mai vanduta fara fir', short: 'Infiniteea Fara Fir', alim: 'Acumulator', putere: 'acumulator', taiere: 'lama', greutate: '1.8 kg',
    specs: ['motocoasa pe acumulator, fara fir', 'taie cu lama (disc)', 'foarte usoara, 1.8 kg', 'cea mai vanduta din categoria fara fir'],
    pros: ['Fara fir si fara benzina, o duci oriunde', 'Cea mai vanduta motocoasa pe acumulator, sute de pareri', 'Foarte usoara si maniabila, 1.8 kg', 'Pret mic, silentioasa, porneste instant'],
    cons: ['Autonomie limitata de acumulator, pentru suprafete mici', 'Compacta, nu inlocuieste o motocoasa pe benzina'],
    verdict: 'Cel mai popular mod de a avea o coasa fara fir si fara benzina, la un pret mic. Infiniteea e o motocoasa pe acumulator foarte usoara, 1.8 kg, cu care ajungi oriunde in curte fara cablu si fara sa cari benzina, si care taie cu o lama disc. E cea mai vanduta din categoria fara fir, cu sute de pareri, semn ca isi face treaba pentru multa lume. Fiind pe acumulator, are o autonomie limitata si e gandita pentru suprafete mici si finisaje, nu pentru a dobori buruieni pe teren mare, unde tot benzina castiga. O iei cand vrei ceva usor, silentios si fara fir, pentru o curte mica si lucrari scurte.' },
  { g: 'acumulator', id: 'DF8WYYYBM', badge: 'Fara fir, de brand', short: 'Makita LXT DUR193Z', alim: 'Acumulator 18 V', putere: '18 V', taiere: 'fir', greutate: '2.5 kg',
    specs: ['coasa pe acumulator 18 V Makita LXT', 'taie cu fir', 'se leaga la bateriile Makita LXT', 'livrata fara acumulator (doar unealta)'],
    pros: ['Makita LXT, ecosistem de scule cu acelasi acumulator', 'Fara fir si fara benzina, silentioasa', 'Usoara, 2.5 kg, echilibrata', 'Fiabilitate de brand profesional'],
    cons: ['Se livreaza fara acumulator, il cumperi separat', 'Inca putine pareri pe acest model'],
    verdict: 'Alegerea daca ai deja scule Makita sau vrei sa intri in ecosistemul LXT, unde acelasi acumulator merge pe zeci de unelte. Makita LXT DUR193Z e o coasa pe acumulator de 18 V, usoara si echilibrata, care taie cu fir si vine de la un brand profesional, cu fiabilitate cunoscuta. Codul Z inseamna ca se livreaza fara acumulator si incarcator, deci le cumperi separat, ceea ce are sens daca ai deja baterii Makita. Are inca putine pareri, fiind un model de nisa. O iei cand esti deja in sistemul Makita LXT sau vrei o coasa fara fir de brand, pe care sa o alimentezi cu acumulatori pe care ii folosesti si la alte scule.' },
].map(x => ({ ...x, p: byId[x.id] })).filter(x => x.p);

const BENZINA = PICKS.filter(x => x.g === 'benzina');
const ELECTRIC = PICKS.filter(x => x.g === 'electric');
const ACUMULATOR = PICKS.filter(x => x.g === 'acumulator');

const site = 'https://centrocasa.ro';
const hero = '/images/articles/motocoasa-electrica-sau-pe-benzina.webp';
const figBenzina = '/imagini/articole/motocoasa-benzina.webp';
const figElectric = '/imagini/articole/motocoasa-electrica.webp';
const figAcumulator = '/imagini/articole/motocoasa-acumulator.webp';
const published = '2026-07-18T10:55:33+03:00';

const faq = [
  { question: 'Motocoasa electrica sau pe benzina?', answer: 'Depinde de cat si ce ai de tuns. O motocoasa pe benzina e cea mai puternica, nu depinde de priza si doboara buruieni groase pe suprafete mari, dar e grea, zgomotoasa si cere amestec de benzina cu ulei. O coasa electrica e mai usoara, mai silentioasa si porneste instant, dar cea cu fir depinde de un cablu, iar cea pe acumulator are autonomie limitata. Alege benzina pentru teren mare si buruieni, electric pentru un gazon mic si margini.' },
  { question: 'Cu fir sau cu lama (disc)?', answer: 'Firul de nailon e pentru iarba si finisaje: taie curat langa garduri, pomi si alei, fara sa strice scoarta sau tencuiala daca atinge ceva. Lama sau discul de metal, cu dinti, e pentru buruieni groase, tulpini lemnoase si vegetatie deasa, pe care firul nu le rupe. Multe motocoase pe benzina vin cu ambele si le schimbi dupa nevoie: fir pentru gazon, disc pentru curatat un teren salbaticit. Coasele electrice mici taie de obicei doar cu fir.' },
  { question: 'Motocoasa in 2 timpi sau 4 timpi?', answer: 'Motorul in 2 timpi e mai usor si are un raport putere-greutate mai bun, bun pentru lucrari rapide si teren denivelat, dar functioneaza cu amestec de benzina si ulei 2T. Motorul in 4 timpi e mai silentios, mai economic si mai eficient pentru folosire indelungata pe suprafete mari, si nu cere amestec, uleiul fiind separat. Pentru o curte obisnuita, un 2 timpi usor e suficient; pentru cine tunde ore intregi, un 4 timpi e mai comod.' },
  { question: 'Ce amestec de benzina si ulei pune la o motocoasa in 2 timpi?', answer: 'La un motor in 2 timpi, benzina se amesteca cu ulei special pentru motoare in 2 timpi, marcat 2T, in general in proportie de 1 la 50, adica o parte ulei la 50 de parti benzina. Foloseste benzina fara plumb, cu cifra octanica de minimum 95, si ulei 2T, nu ulei auto pentru motoare in 4 timpi, care nu arde complet si lasa depuneri. Verifica intotdeauna proportia exacta din manualul motocoasei tale, pentru ca poate diferi.' },
  { question: 'O motocoasa pe acumulator e destul de puternica?', answer: 'Pentru o curte mica si pentru finisaje, da: e usoara, silentioasa, porneste instant si nu depinde de un cablu. Pentru suprafete mari, iarba inalta sau buruieni groase, o motocoasa pe acumulator ramane in urma uneia pe benzina, prin putere si prin autonomia limitata a bateriei. Un avantaj real il au sistemele de brand, ca Makita LXT sau Einhell Power X-Change, unde acelasi acumulator merge pe multe scule. Ia acumulator daca vrei fara fir si fara benzina, pentru lucrari scurte.' },
  { question: 'Ce echipament de protectie folosesc la motocoasa?', answer: 'La orice motocoasa, mai ales pe benzina cu lama, poarta ochelari sau viziera, pentru ca arunca pietre si resturi, si antifoane sau casti, ca sa iti protejezi auzul. Bocancii inchisi si pantalonii lungi sunt obligatorii, iar manusile ajuta la prinderea ferma. Foloseste hamul din dotare, ca sa distribui greutatea si sa lucrezi controlat. Nu tunde cu oameni sau animale in apropiere, pentru ca discul si firul pot arunca obiecte cu putere.' },
  { question: 'Cat de des fac intretinere la o motocoasa pe benzina?', answer: 'Curata filtrul de aer si verifica bujia regulat, iar dupa sezon goleste rezervorul sau adauga stabilizator, ca sa nu se strice benzina. La 2 timpi, foloseste mereu amestec proaspat, la proportia corecta. Schimba firul cand se toceste si verifica discul sa fie ascutit si fara fisuri. Depoziteaza motocoasa curata, la loc uscat. La cele electrice si pe acumulator, intretinerea e minima: cureti capul de taiere si, la acumulator, pastrezi bateria incarcata partial iarna.' },
];

const images = [hero, figBenzina, figElectric, figAcumulator, ...PICKS.map(x => x.p.image)];
const b64 = (s) => Buffer.from(s).toString('base64');
---

<Layout
  title="Motocoasa electrica sau pe benzina in 2026: cum alegi corect"
  description="Motocoasa electrica sau pe benzina? Comparam modele pe benzina, coase electrice cu fir si motocoase pe acumulator, pe putere, tip de taiere si greutate. Plus fir vs lama, 2 timpi vs 4 timpi si amestecul de benzina."
  image={hero}
  type="article"
  publishedTime={published}
  modifiedTime={published}
  author="Redactia CentroCasa"
  breadcrumb={[{ name: 'Acasa', url: '/' }, { name: 'Gradinarit si Unelte', url: '/gradinarit-unelte/' }, { name: 'Motocoasa electrica sau pe benzina' }]}
  faq={faq.map(f => ({ question: f.question, answer: f.answer }))}
>
  <article class="rd">
    <nav class="breadcrumb">
      <a href="/">Acasa</a><span class="breadcrumb-separator">/</span>
      <a href="/gradinarit-unelte/">Gradinarit si Unelte</a><span class="breadcrumb-separator">/</span>
      <span>Motocoasa electrica sau pe benzina</span>
    </nav>

    <h1>Motocoasa electrica sau pe benzina</h1>
    <p class="rd-byline">de <a href="/despre/">Redactia CentroCasa</a> · actualizat iulie 2026</p>

    <img class="rd-hero" src={hero} alt="Motocoasa electrica sau pe benzina, la tuns iarba" width="1200" height="675" fetchpriority="high" />

    <div class="rd-intro">
      <p>Pentru buruieni si suprafete mari, o <strong>motocoasa pe benzina</strong> ca Ruris DAC 510 e alegerea, cu fir si cu lama. Pentru un gazon mic si margini, o <strong>coasa electrica cu fir</strong> e mai usoara si mai ieftina, ca Bosch EasyGrassCut. Iar daca vrei fara fir si fara benzina, o <strong>motocoasa pe acumulator</strong> ca Infiniteea merge oriunde, silentioasa. Daca vrei putere fara benzina, Makita UR3501 electrica are 1000 W.</p>
      <p>Toata decizia se invarte in jurul unei intrebari: <strong>benzina, electrica cu fir sau acumulator</strong>. De asta depind puterea, greutatea, zgomotul si cat de liber te misti prin curte. Apoi conteaza <strong>cu ce taie</strong>, fir pentru iarba sau lama pentru buruieni, si ce putere iti trebuie pentru cat ai de tuns.</p>
      <p>Am pornit de la motocoasele si coasele vandute pe eMAG, le-am verificat tipul de alimentare, puterea, sistemul de taiere si greutatea, si le-am grupat pe benzina, electrice cu fir si pe acumulator. Pentru gazon pe roti, vezi <a href="/masina-de-tuns-gazonul-electrica/">masinile electrice de tuns gazonul</a>, iar pentru gardul viu, <a href="/foarfeca-electrica-pentru-gard-viu/">foarfecile electrice de gard viu</a>.</p>
    </div>

    <details class="rd-toc">
      <summary>Cuprins</summary>
      <ol>
        <li><a href="#tip">Benzina, electrica cu fir sau acumulator</a></li>
        <li><a href="#fir-lama">Cu fir sau cu lama</a></li>
        <li><a href="#tabel">Comparatie rapida</a></li>
        <li><a href="#benzina">Motocoase pe benzina</a></li>
        <li><a href="#electric">Coase electrice cu fir</a></li>
        <li><a href="#acumulator">Motocoase pe acumulator</a></li>
        <li><a href="#intretinere">Intretinere si siguranta</a></li>
        <li><a href="#cat-costa">Cat costa o motocoasa</a></li>
        <li><a href="#faq">Intrebari frecvente</a></li>
      </ol>
    </details>

    <h2 id="tip">Benzina, electrica cu fir sau acumulator</h2>
    <p>Prima si cea mai importanta alegere e sursa de energie, pentru ca schimba tot: putere, greutate, zgomot si libertate de miscare.</p>
    <p><strong>Pe benzina:</strong> cea mai puternica, nu depinde de priza si doboara buruieni groase pe suprafete mari. In schimb e cea mai grea, zgomotoasa si cere amestec de benzina cu ulei si mai multa intretinere. Alegerea pentru teren mult si aspru.</p>
    <p><strong>Electrica cu fir (la retea):</strong> usoara, silentioasa si ieftina, porneste instant din buton, fara amestec. Depinzi insa de un cablu si de o priza in apropiere, deci e pentru gazon mic si margini, langa casa.</p>
    <p><strong>Pe acumulator (fara fir):</strong> la fel de comoda ca cea electrica, dar fara cablu, deci ajungi oriunde. Are autonomia limitata de baterie si mai putina putere, potrivita pentru suprafete mici si finisaje.</p>

    <h2 id="fir-lama">Cu fir sau cu lama</h2>
    <p>Al doilea lucru care conteaza e capul de taiere, adica cu ce taie de fapt motocoasa:</p>
    <ul>
      <li><strong>Fir de nailon:</strong> pentru iarba si finisaje. Taie curat langa garduri, pomi si alei si nu strica scoarta sau tencuiala daca le atinge. Il gasesti pe toate, de la coase electrice la motocoase.</li>
      <li><strong>Lama sau disc de metal:</strong> pentru buruieni groase, tulpini lemnoase si vegetatie deasa, pe care firul nu le rupe. Il montezi pe motocoasele pe benzina, la curatat un teren salbaticit.</li>
    </ul>
    <p>Multe motocoase pe benzina vin cu ambele si le schimbi dupa nevoie: fir pentru gazon, disc pentru buruieni. Coasele electrice mici, in schimb, taie de obicei doar cu fir.</p>

    <h2 id="tabel">Comparatie rapida</h2>
    <div class="table-wrap">
      <table class="rd-table">
        <thead><tr><th>Model</th><th>Alimentare</th><th>Putere</th><th>Taiere</th><th>Greutate</th></tr></thead>
        <tbody>
          {PICKS.map(x => (<tr><td>{x.short}</td><td>{x.alim}</td><td>{x.putere}</td><td>{x.taiere}</td><td>{x.greutate || '-'}</td></tr>))}
        </tbody>
      </table>
    </div>

    <h2 id="benzina">Motocoase pe benzina</h2>
    <p>Cele mai puternice, pentru suprafete mari, iarba inalta si buruieni groase. Grele, dar independente de priza si echipate cu fir si lama.</p>
    <div class="rd-grid">
      {BENZINA.map(x => (
        <ProductCard name={x.p.name.replace(/’/g, "'")} image={x.p.image} price={x.p.price} rating={x.p.rating} reviews={x.p.reviews} badge={x.badge} specs={x.specs} pros={x.pros} cons={x.cons} verdict={x.verdict} outKey={'p-' + x.id} />
      ))}
    </div>

    <img class="rd-fig" src={figBenzina} alt="Motocoase pe benzina Ruris, Steinhaus si ProCraft" width="1200" height="675" loading="lazy" />

    <h2 id="electric">Coase electrice cu fir</h2>
    <p>Usoare, silentioase si ieftine, pentru un gazon mic si margini. Pornesc instant, fara benzina, dar depind de un cablu si de o priza.</p>
    <div class="rd-grid">
      {ELECTRIC.map(x => (
        <ProductCard name={x.p.name.replace(/’/g, "'")} image={x.p.image} price={x.p.price} rating={x.p.rating} reviews={x.p.reviews} badge={x.badge} specs={x.specs} pros={x.pros} cons={x.cons} verdict={x.verdict} outKey={'p-' + x.id} />
      ))}
    </div>

    <img class="rd-fig" src={figElectric} alt="Coase electrice cu fir Bosch, Einhell si Makita" width="1200" height="675" loading="lazy" />

    <h2 id="acumulator">Motocoase pe acumulator</h2>
    <p>Comoditatea electricului, fara cablu: ajungi oriunde in curte, silentios si fara benzina. Autonomie limitata, pentru suprafete mici si finisaje.</p>
    <div class="rd-grid">
      {ACUMULATOR.map(x => (
