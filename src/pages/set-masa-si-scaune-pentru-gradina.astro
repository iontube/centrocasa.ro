---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import SimilarArticles from '../components/SimilarArticles.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import emag from '../data/emag-products.json';
import keywordsData from '../../keywords.json';
import { visibleArticles, slugify } from '../lib/articles.mjs';

const relatedArticles = visibleArticles(keywordsData.completed).map(item => ({
  title: item.keyword.charAt(0).toUpperCase() + item.keyword.slice(1),
  slug: item.slug || slugify(item.keyword),
  excerpt: item.excerpt || '',
  image: item.image || `/images/articles/${item.slug || slugify(item.keyword)}.webp`,
  category: item.category,
  categorySlug: item.categorySlug,
  date: item.date || '',
}));

const pool = emag['set-masa-gradina'] || [];
const byId = Object.fromEntries(pool.map(p => [p.id, p]));

const PICKS = [
  // --- Mici (2-4 locuri) ---
  { g: 'mic', id: 'D2C4NCMBM', badge: 'Pentru balcon si 2 persoane', short: 'Set fier forjat, 2 locuri', material: 'Fier forjat', locuri: '2', perne: 'nu',
    specs: ['set 3 piese, masa si 2 scaune', 'fier forjat, aspect clasic', 'pentru 2 persoane', 'compact, pentru balcon sau terasa mica'],
    pros: ['Compact, incape pe un balcon sau o terasa mica', 'Fier forjat, robust si cu aspect clasic, elegant', 'Greu, nu il ia vantul', 'Nota maxima de la cumparatori'],
    cons: ['Doar 2 locuri, pentru cuplu sau cafeaua de dimineata', 'Fara perne, scaunele de metal cer o perna moale'],
    verdict: 'Alegerea pentru un balcon sau o terasa mica, unde vrei un colt de servit cafeaua sau cina in doi. Setul are o masa si doua scaune din fier forjat, cu aspect clasic, ornamental, care da un aer elegant unui spatiu mic. Fierul forjat e robust si greu, deci nu il ia vantul, si rezista bine afara daca ai grija de vopsea. Fiind din metal, scaunele cer o perna moale pentru confort la sederi lungi. Are doar doua locuri, deci e pentru cuplu, nu pentru mese cu musafiri. Il iei cand ai un spatiu mic si vrei un set frumos, solid, pentru doua persoane.' },
  { g: 'mic', id: 'DHTGNLBBM', badge: 'Ratan pentru 4', short: 'vidaXL ratan, 4 locuri', material: 'Ratan sintetic', locuri: '4', perne: 'nu',
    specs: ['set 5 piese, masa si 4 scaune', 'ratan sintetic pe cadru', 'pentru 4 persoane', 'aspect modern, rezistent afara'],
    pros: ['Ratan sintetic, aspect modern si placut', 'Patru locuri, pentru o familie mica sau musafiri putini', 'Rezistent la intemperii, gandit pentru exterior', 'Mai usor de mutat decat metalul sau lemnul'],
    cons: ['Vine fara perne, le iei separat pentru confort', 'Fara pareri inca'],
    verdict: 'Un set de patru locuri pentru cine vrea aspectul cald al ratanului fara sa dea multi bani. vidaXL propune o masa si patru scaune din ratan sintetic tesut pe un cadru, un material gandit pentru exterior, care rezista la soare si ploaie mai bine decat pare si arata modern pe o terasa. E mai usor de mutat decat un set de metal sau lemn, deci il rearanjezi simplu. Vine fara perne, asa ca pune la buget cateva pentru sederi lungi. Nu are inca pareri, fiind un model nou. Il iei cand vrei patru locuri, aspect de ratan si un pret rezonabil.' },
  // --- Familie (6 locuri) ---
  { g: 'familie', id: 'D5HFNVMBM', badge: 'Cel mai bun raport', short: 'idealStore plastic, 6 locuri', material: 'Plastic', locuri: '6', perne: 'nu',
    specs: ['set masa si 6 scaune', 'plastic rezistent, usor', 'pentru 6 persoane', 'cel mai vandut din selectie'],
    pros: ['De departe cele mai multe pareri, sute, cu nota mare', 'Sase locuri la un pret foarte bun', 'Plastic usor, se muta si se spala usor', 'Rezistent la apa, il lasi afara fara griji'],
    cons: ['Plasticul are un aspect mai simplu decat ratanul sau lemnul', 'La soare puternic, in ani, plasticul se poate decolora'],
    verdict: 'Recomandarea mea principala pentru o familie: sase locuri, pret mic si sute de pareri bune, cel mai vandut set din selectie. idealStore propune o masa cu sase scaune din plastic rezistent, usor de mutat si de spalat cu un furtun, care nu se teme de ploaie si il lasi afara tot sezonul fara griji. Aspectul e mai simplu decat al ratanului sau lemnului, iar la soare puternic plasticul se poate decolora in timp, dar la pretul si la numarul de pareri e greu de batut. O iei cand vrei un set de familie, incapator si ieftin, pe care sa te bazezi sezon dupa sezon.' },
  { g: 'familie', id: 'DMKNVD3BM', badge: 'Cel mai ieftin de 6', short: 'DacEnergy polipropilena, 6', material: 'Polipropilena', locuri: '6', perne: 'nu',
    specs: ['set masa si 6 scaune', 'polipropilena, rezistenta la UV', 'pentru 6 persoane', 'cel mai mic pret pentru 6 locuri'],
    pros: ['Cel mai mic pret din selectie pentru un set de 6', 'Polipropilena, rezistenta la apa si la soare', 'Usor de mutat si de curatat', 'Sase locuri, pentru toata familia'],
    cons: ['Nota modesta de la cumparatori, in jur de 3.8', 'Aspect simplu, functional'],
    verdict: 'Cu bugetul cel mai mic, asezi sase oameni la masa in curte. DacEnergy propune un set din polipropilena, un plastic tehnic rezistent la apa si la razele soarelui, deci nu se strica repede afara si se sterge usor. E functional si usor, il muti singur si il speli cu apa. Nota de la cumparatori e modesta, in jur de 3.8, deci asteptari realiste la un set atat de accesibil, dar isi face treaba pentru mesele din curte. O iei cand vrei sase locuri la cel mai mic pret si nu iti bati capul cu aspectul.' },
  { g: 'familie', id: 'D0CB2XYBM', badge: 'Elegant, cu blat de sticla', short: 'Heinner Alegria, otel + sticla', material: 'Otel si sticla', locuri: '6', perne: 'da',
    specs: ['set 7 piese, masa si 6 scaune', 'cadru din otel, blat de sticla', 'perne incluse', 'aspect elegant, modern'],
    pros: ['Cadru de otel si blat de sticla, aspect elegant si modern', 'Vine cu perne incluse, confort din start', 'Sase locuri, pentru familie si musafiri', 'Nota buna de la cumparatori'],
    cons: ['Mai scump decat seturile de plastic', 'Blatul de sticla cere atentie si curatare mai deasa'],
    verdict: 'Alegerea daca vrei un set de familie care arata bine, nu doar functional. Heinner Alegria are un cadru din otel si o masa cu blat de sticla securizata, care da un aspect elegant, modern, pe o terasa amenajata, si vine cu perne incluse, deci ai confort din prima. Cele sase locuri acopera familia si cativa musafiri. E mai scump decat seturile de plastic, iar blatul de sticla se vede cand e prafuit, deci il stergi mai des, dar castigi mult la aspect. O iei cand vrei un set de sase cu tinuta, cu perne si blat de sticla, la un pret inca rezonabil.' },
  { g: 'familie', id: 'DBZLM2MBM', badge: 'Pliabil, tip picnic', short: 'Masa + 2 banci pliabile', material: 'Plastic', locuri: '8', perne: 'nu',
    specs: ['masa plianta si 2 banci pliabile', 'se strange tip valiza', 'pana la 8 persoane', 'nota cea mai mare din selectie'],
    pros: ['Se plieaza tip valiza, se strange si se depoziteaza usor', 'Banci lungi, incap pana la 8 persoane', 'Nota cea mai mare din selectie, aproape de maxim', 'Ideal pentru mese ocazionale, gratare si camping'],
    cons: ['Banci, nu scaune individuale, mai putin confortabile la sederi lungi', 'Aspect practic, nu decorativ'],
    verdict: 'Alegerea daca nu vrei un set permanent, ci ceva de scos la mese mari si strans dupa. Setul are o masa plianta si doua banci pliabile care se strang tip valiza, deci il tii intr-o debara sau in portbagaj si il scoti la gratare, petreceri sau camping. Bancile lungi asaza pana la opt oameni, iar nota de la cumparatori e cea mai mare din selectie. Fiind banci, nu scaune cu spatar, sunt mai putin confortabile la sederi foarte lungi, iar aspectul e practic, nu decorativ. Il iei cand vrei un set flexibil, pentru multi oameni, pe care sa il strangi cand nu il folosesti.' },
  // --- Mari si elegante (ratan cu perne) ---
  { g: 'mare', id: 'D4TGNLBBM', badge: 'Ratan cu perne, 6 locuri', short: 'vidaXL ratan cu perne, 6', material: 'Ratan sintetic', locuri: '6', perne: 'da',
    specs: ['set 7 piese, masa si 6 scaune', 'ratan sintetic, cu perne incluse', 'pentru 6 persoane', 'aspect de terasa amenajata'],
    pros: ['Ratan sintetic cu perne incluse, confort si aspect elegant', 'Sase locuri, pentru familie si musafiri', 'Rezistent la intemperii, gandit pentru exterior', 'Arata a terasa amenajata, nu a mobilier de plastic'],
    cons: ['Pretul e peste seturile de plastic de aceeasi capacitate', 'Pernele se strang la ploaie, ca sa nu se ude'],
    verdict: 'Alegerea cand vrei ca terasa sa arate amenajat, nu doar functional, pentru sase persoane. vidaXL propune un set din ratan sintetic cu perne incluse, un material care rezista bine afara si da caldura si eleganta unei terase, mult peste un set de plastic. Cele sase locuri, cu perne, sunt confortabile pentru mese lungi si seri cu musafiri. Pretul e mai mare decat la plastic, iar pernele se strang cand ploua, ca sa nu se ude si sa se ingalbeneasca. O iei cand vrei aspect de terasa amenajata, cu ratan si perne, la sase locuri.' },
  { g: 'mare', id: 'DCHV39MBM', badge: 'Cel mai mare, 8 locuri', short: 'Set 9 piese ratan, 8 locuri', material: 'Ratan sintetic', locuri: '8', perne: 'da',
    specs: ['set 9 piese, masa si 8 scaune', 'ratan sintetic cu perne', 'pentru 8 persoane', 'cel mai mare si complet din selectie'],
    pros: ['Opt locuri, pentru mese mari si petreceri', 'Ratan sintetic cu perne, aspect si confort premium', 'Set complet, 9 piese, masa si 8 scaune cu perne', 'Rezistent la exterior'],
    cons: ['Cel mai scump din selectie, peste 4800 de lei', 'Cere o terasa mare, ocupa mult spatiu'],
    verdict: 'Pentru cine primeste des musafiri, cel mai generos set din selectie, cu o masa mare si eleganta afara. Setul are noua piese, o masa si opt scaune din ratan sintetic cu perne, deci asaza confortabil opt oameni pentru mese lungi si petreceri de vara. Ratanul cu perne ii da un aspect si un confort premium, iar setul e complet, nu mai adaugi nimic. E cel mai scump din selectie, peste 4800 de lei, si cere o terasa mare, unde sa incapa toate piesele cu spatiu de miscare in jur. Il iei cand ai o terasa spatioasa, primesti multi oameni si vrei cel mai mare si mai elegant set de dining pentru gradina.' },
].map(x => ({ ...x, p: byId[x.id] })).filter(x => x.p);

const MIC = PICKS.filter(x => x.g === 'mic');
const FAMILIE = PICKS.filter(x => x.g === 'familie');
const MARE = PICKS.filter(x => x.g === 'mare');

const site = 'https://centrocasa.ro';
const hero = '/images/articles/set-masa-si-scaune-pentru-gradina.webp';
const figMic = '/imagini/articole/set-masa-mic.webp';
const figFamilie = '/imagini/articole/set-masa-familie.webp';
const figMare = '/imagini/articole/set-masa-mare.webp';
const published = '2026-07-18T11:28:50+03:00';

const faq = [
  { question: 'Ce material de set de gradina rezista cel mai bine afara?', answer: 'Toate materialele de aici sunt gandite pentru exterior, dar difera. Plasticul si polipropilena sunt cele mai fara griji: nu se tem de ploaie, se spala cu furtunul si sunt usoare, dar se pot decolora la soare puternic in ani. Ratanul sintetic rezista bine la intemperii si arata elegant, cu perne care se strang la ploaie. Metalul si fierul forjat sunt robuste si grele, dar cer atentie la vopsea, ca sa nu ruginesca. Lemnul e cel mai cald la aspect, dar cere ulei sau lazura periodic. Alege dupa cat vrei sa intretii.' },
  { question: 'Cate locuri sa aiba setul de gradina?', answer: 'Depinde de cati sunteti si de cat loc ai. Pentru un balcon sau o terasa mica, un set de 2 pana la 4 locuri ajunge. Pentru o familie, marimea potrivita e de 6 locuri, cea mai cautata. Daca primesti des musafiri sau vrei mese mari de vara, cauta 8 locuri sau un set pliabil cu banci, care asaza multi oameni. Lasa mereu loc in jurul mesei ca scaunele sa se traga, cel putin un metru de fiecare parte.' },
  { question: 'Set cu scaune sau cu banci?', answer: 'Scaunele individuale sunt mai confortabile, mai ales cu perne si spatar, si le muti dupa nevoie; sunt alegerea pentru un set permanent, de zi cu zi. Bancile, mai ales cele pliabile, asaza mai multi oameni pe acelasi spatiu si se strang usor, deci sunt bune pentru mese ocazionale, gratare, petreceri sau camping. Daca folosesti setul zilnic, ia scaune; daca il scoti doar la ocazii si vrei sa il depozitezi, un set cu banci pliabile e mai practic.' },
  { question: 'Merita un set cu perne?', answer: 'Da, daca stai mult la masa. Pernele fac diferenta la confort, mai ales pe scaunele de metal, ratan sau lemn, care altfel sunt tari. Multe seturi de ratan si cele mai elegante vin cu perne incluse, iar la cele care nu au, le poti cumpara separat, potrivite pe scaun. Singura grija e ca pernele nu se lasa in ploaie: se ingalbenesc si prind mucegai, deci le strangi cand nu le folosesti sau cand se anunta vreme rea.' },
  { question: 'Cum ingrijesc si iernez un set de gradina?', answer: 'Peste sezon, curata setul cu apa si o laveta; plasticul si ratanul se spala usor, lemnul se sterge, metalul se verifica de rugina. Pernele se strang la ploaie si se depoziteaza uscate. Iarna, cel mai sigur e sa strangi setul intr-o magazie sau un garaj; daca ramane afara, pune o folie sau o husa de protectie peste el. Lemnul cere ulei sau lazura o data pe an, iar la metal atingi zgarieturile cu vopsea, ca sa nu porneasca rugina. Asa iti dureaza mult mai mult.' },
  { question: 'Setul de plastic e o alegere buna?', answer: 'Da, pentru cei mai multi. Un set de plastic sau polipropilena e ieftin, usor, rezistent la apa si foarte simplu de intretinut: il speli cu furtunul si il lasi afara tot sezonul. Modelele bune, ca cel de la idealStore, au sute de pareri bune, semn ca merg pentru multa lume. Singurul minus e aspectul, mai simplu decat ratanul sau lemnul, si o posibila decolorare la soare in ani. Daca vrei practic si ieftin, plasticul e alegerea; daca vrei aspect si confort, mergi pe ratan cu perne.' },
];

const images = [hero, figMic, figFamilie, figMare, ...PICKS.map(x => x.p.image)];
const b64 = (s) => Buffer.from(s).toString('base64');
---

<Layout
  title="Set masa si scaune pentru gradina in 2026: pe marime si material"
  description="Ce set de masa si scaune pentru gradina sa alegi in 2026: seturi mici pentru balcon, de familie cu 6 locuri si mari cu 8 locuri, din plastic, ratan, metal sau lemn. Plus ce material rezista afara si cum iernezi setul."
  image={hero}
  type="article"
  publishedTime={published}
  modifiedTime={published}
  author="Maria Ionescu"
  breadcrumb={[{ name: 'Acasa', url: '/' }, { name: 'Mobilier Gradina', url: '/mobilier-gradina/' }, { name: 'Set masa si scaune pentru gradina' }]}
  faq={faq.map(f => ({ question: f.question, answer: f.answer }))}
>
  <article class="rd">
    <nav class="breadcrumb">
      <a href="/">Acasa</a><span class="breadcrumb-separator">/</span>
      <a href="/mobilier-gradina/">Mobilier Gradina</a><span class="breadcrumb-separator">/</span>
      <span>Set masa si scaune pentru gradina</span>
    </nav>

    <h1>Set masa si scaune pentru gradina</h1>
    <p class="rd-byline">de <a href="/autori/maria-ionescu/">Maria Ionescu</a>, Designer Interior · actualizat iulie 2026</p>

    <img class="rd-hero" src={hero} alt="Set masa si scaune pentru gradina, pe terasa" width="1200" height="675" fetchpriority="high" />

    <div class="rd-intro">
      <p>Pentru o familie, cel mai bun set e <strong>idealStore cu 6 scaune</strong> din plastic: incapator, ieftin si cu sute de pareri bune. Daca vrei ca terasa sa arate amenajat, un <strong>set de ratan cu perne</strong> e alegerea, iar pentru un balcon, un <strong>set de fier forjat de 2 locuri</strong> incape oriunde. Pentru mese mari, un set de <strong>8 locuri</strong> sau unul pliabil cu banci asaza multa lume.</p>
      <p>La un set de dining pentru gradina, doua lucruri conteaza: <strong>cate locuri</strong> iti trebuie, dupa cati sunteti si cat loc ai, si <strong>din ce material</strong> e facut, pentru ca sta afara, in soare si ploaie. De aici pornesc si pretul, si aspectul, si cat il intretii.</p>
      <p>Am pornit de la seturile de masa si scaune vandute pe eMAG, le-am verificat materialul, numarul de locuri si dotarea, si le-am grupat pe mici (balcon si terasa mica), de familie si mari. Daca vrei doar cateva piese in loc de un set intreg, vezi <a href="/banca-de-gradina-din-lemn-masiv/">bancile de gradina din lemn</a> sau o <a href="/umbrela-de-gradina-rezistenta-la-vant/">umbrela rezistenta la vant</a> pentru umbra.</p>
    </div>

    <details class="rd-toc">
      <summary>Cuprins</summary>
      <ol>
        <li><a href="#material">Din ce material</a></li>
        <li><a href="#locuri">Cate locuri alegi</a></li>
        <li><a href="#tabel">Comparatie rapida</a></li>
        <li><a href="#mic">Seturi mici (balcon, terasa mica)</a></li>
        <li><a href="#familie">Seturi de familie (6 locuri)</a></li>
        <li><a href="#mare">Seturi mari si elegante</a></li>
        <li><a href="#intretinere">Cum reziste afara si iernare</a></li>
        <li><a href="#cat-costa">Cat costa un set de gradina</a></li>
        <li><a href="#faq">Intrebari frecvente</a></li>
      </ol>
    </details>

    <h2 id="material">Din ce material</h2>
    <p>Materialul decide cat rezista setul afara, cat il intretii si cum arata:</p>
    <ul>
      <li><strong>Plastic si polipropilena:</strong> ieftine, usoare, rezistente la apa, se spala cu furtunul. Cele mai fara griji, dar cu aspect mai simplu si o posibila decolorare la soare in ani.</li>
      <li><strong>Ratan sintetic:</strong> aspect elegant, cald, rezistent la intemperii, deseori cu perne. Arata a terasa amenajata; pernele se strang la ploaie.</li>
      <li><strong>Metal si fier forjat:</strong> robuste, grele, nu le ia vantul, cu aspect clasic. Cer atentie la vopsea, ca sa nu ruginesca.</li>
      <li><strong>Otel si sticla:</strong> cadru de otel cu blat de sticla securizata, aspect modern. Sticla se curata usor, dar se vede cand e prafuita.</li>
      <li><strong>Lemn:</strong> cel mai cald la aspect, natural, dar cere ulei sau lazura periodic si e greu.</li>
    </ul>

    <h2 id="locuri">Cate locuri alegi</h2>
    <p>A doua decizie e marimea, dupa cati sunteti si cat loc ai pe terasa:</p>
    <ul>
      <li><strong>2-4 locuri:</strong> pentru balcon sau terasa mica, un cuplu sau o familie mica.</li>
      <li><strong>6 locuri:</strong> marimea de familie, cea mai cautata, pentru mese de zi cu zi si cativa musafiri.</li>
      <li><strong>8 locuri sau pliabil:</strong> pentru cine primeste des sau vrea mese mari de vara; seturile cu banci pliabile asaza multi oameni si se strang usor.</li>
    </ul>
    <p>Lasa mereu loc in jurul mesei, cel putin un metru de fiecare parte, ca scaunele sa se poata trage comod.</p>

    <h2 id="tabel">Comparatie rapida</h2>
    <div class="table-wrap">
      <table class="rd-table">
        <thead><tr><th>Set</th><th>Material</th><th>Locuri</th><th>Perne</th></tr></thead>
        <tbody>
          {PICKS.map(x => (<tr><td>{x.short}</td><td>{x.material}</td><td>{x.locuri}</td><td>{x.perne}</td></tr>))}
        </tbody>
      </table>
    </div>

    <h2 id="mic">Seturi mici, pentru balcon si terasa mica</h2>
    <p>Compacte, pentru 2 pana la 4 locuri, cand ai un spatiu mic dar vrei un colt de servit masa afara.</p>
    <div class="rd-grid">
      {MIC.map(x => (
        <ProductCard name={x.p.name.replace(/’/g, "'")} image={x.p.image} price={x.p.price} rating={x.p.rating} reviews={x.p.reviews} badge={x.badge} specs={x.specs} pros={x.pros} cons={x.cons} verdict={x.verdict} outKey={'p-' + x.id} />
      ))}
    </div>

    <img class="rd-fig" src={figMic} alt="Seturi mici de gradina: fier forjat si ratan" width="1200" height="675" loading="lazy" />

    <h2 id="familie">Seturi de familie (6 locuri)</h2>
    <p>Sweet spot-ul: sase locuri, pret rezonabil si materiale de la plastic accesibil la otel cu sticla. Include si o varianta pliabila pentru mese mari ocazionale.</p>
    <div class="rd-grid">
      {FAMILIE.map(x => (
        <ProductCard name={x.p.name.replace(/’/g, "'")} image={x.p.image} price={x.p.price} rating={x.p.rating} reviews={x.p.reviews} badge={x.badge} specs={x.specs} pros={x.pros} cons={x.cons} verdict={x.verdict} outKey={'p-' + x.id} />
      ))}
    </div>

    <img class="rd-fig" src={figFamilie} alt="Seturi de familie de gradina: idealStore, DacEnergy si Heinner" width="1200" height="675" loading="lazy" />

    <h2 id="mare">Seturi mari si elegante</h2>
    <p>Cand vrei o terasa amenajata si mese cu multi musafiri: ratan sintetic cu perne, de la 6 la 8 locuri, cu aspect si confort peste seturile de plastic.</p>
    <div class="rd-grid">
      {MARE.map(x => (
        <ProductCard name={x.p.name.replace(/’/g, "'")} image={x.p.image} price={x.p.price} rating={x.p.rating} reviews={x.p.reviews} badge={x.badge} specs={x.specs} pros={x.pros} cons={x.cons} verdict={x.verdict} outKey={'p-' + x.id} />
      ))}
    </div>

    <img class="rd-fig" src={figMare} alt="Seturi mari de gradina din ratan cu perne, 6 si 8 locuri" width="1200" height="675" loading="lazy" />

    <h2 id="intretinere">Cum reziste afara si iernare</h2>
    <p>Un set de dining sta afara luni intregi, deci putina grija ii lungeste mult viata:</p>
    <ul>
      <li><strong>Curatare:</strong> plasticul si ratanul se spala cu apa si o laveta; lemnul se sterge; metalul se verifica de rugina si se atinge cu vopsea unde s-a zgariat.</li>
      <li><strong>Pernele la adapost:</strong> nu le lasa in ploaie, se ingalbenesc si prind mucegai. Strange-le cand se anunta vreme rea si tine-le uscate.</li>
      <li><strong>Iernare:</strong> cel mai sigur e sa strangi setul intr-o magazie sau garaj; daca ramane afara, pune o folie sau o husa de protectie.</li>
      <li><strong>Lemnul:</strong> cere ulei sau lazura o data pe an, ca sa nu crape si sa nu se cenusesca la soare.</li>
      <li><strong>Vantul:</strong> seturile usoare de plastic se pot rasturna la vant puternic; strange-le sau ancoreaza-le cand e furtuna.</li>
    </ul>

    <div class="rd-offers" data-o={b64('oferte-set-masa-gradina')} role="button" tabindex="0">
      <div class="rd-offers-txt">
        <strong>Vezi toate seturile de gradina la oferta</strong>
        <span>Reducerile din acest moment la seturi de masa si scaune pentru gradina, direct pe eMAG</span>
      </div>
      <span class="rd-offers-btn">Vezi ofertele
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </span>
    </div>

    <h2 id="cat-costa">Cat costa un set de masa si scaune pentru gradina</h2>
    <p>Preturile depind de material, numar de locuri si dotare:</p>
    <p><strong>Seturi de plastic si polipropilena:</strong> cele mai ieftine, de la circa 550 de lei pentru un set de 6 locuri, inclusiv variantele pliabile cu banci.</p>
    <p><strong>Seturi de metal, fier forjat sau otel cu sticla:</strong> in general 1000-1750 de lei, cu aspect mai elegant si, la unele, perne incluse.</p>
    <p><strong>Seturi de ratan sintetic cu perne:</strong> de la circa 1100 de lei la cele de 4-6 locuri, si peste 4800 de lei la seturile mari, de 8 locuri, complete.</p>
    <p>Pe langa pretul setului, pune la buget pernele, daca nu sunt incluse, si o husa de protectie pentru iarna. Un set bun tine multe sezoane, deci alege dupa cati sunteti si cat vrei sa il intretii, nu doar dupa pret. Pentru mai multe optiuni pe tip si material, vezi si <a href="/cele-mai-bune-seturi-de-mobilier-de-gradina/">selectia mai larga de seturi de mobilier de gradina</a>.</p>

