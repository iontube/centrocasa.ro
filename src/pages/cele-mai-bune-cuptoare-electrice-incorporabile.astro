  { g: 'acc', id: 'D553BCMBM', rol: 'Curatare cu aburi', short: 'Electrolux AquaClean', cap: '65 l', cur: 'AquaClean', ctrl: 'Butoane', pret: '1199 lei',
    specs: ['65 litri, 9 programe, convectie', 'curatare cu aburi AquaClean', 'grill, coacere, convectie, dezghetare', 'brand premium la pret accesibil'],
    pros: ['Curatare cu aburi AquaClean, ecologica, fara chimicale', 'Convectie pentru coacere uniforma', '9 programe de gatire', 'Brand premium sub 1200 de lei'],
    cons: ['Aburul inmoaie doar murdaria usoara, nu petele arse', 'Doar 28 de pareri'],
    verdict: 'Electrolux EOF5H40BX aduce un brand premium sub 1200 de lei, cu doua atuuri: convectie adevarata, adica un ventilator care imprastie caldura uniform, si curatarea cu aburi AquaClean. Aceasta din urma e cea mai simpla forma de autocuratare: pui apa intr-o tava, o incalzesti la circa 90 de grade, iar aburul inmoaie murdaria in vreo 30 de minute, apoi o stergi cu o carpa. E ecologica, fara chimicale si fara consumul urias al pirolizei. Are 65 de litri si 9 programe. Limita ei e ca aburul rezolva grasimea proaspata si stropii, nu petele vechi, arse; la alea tot freci. Il iei cand vrei convectie si o curatare usoara, blanda cu aparatul.' },
  { g: 'acc', id: 'DXL0G7BBM', rol: 'Cu SteamClean', short: 'Hansa 62 l', cap: '62 l', cur: 'SteamClean', ctrl: 'Butoane', pret: '1299 lei',
    specs: ['62 litri, convectie, SteamCleaning', 'grill, coacere, convectie, dezghetare, deshidratare', 'curatare cu aburi', 'multiple functii de gatire'],
    pros: ['SteamCleaning cu aburi, curatare blanda', 'Convectie plus functie de deshidratare', 'Multe functii de gatire', 'Design curat pentru bucatarii moderne'],
    cons: ['Nota 4.19, cea mai mica din articol', 'Curatarea cu aburi doar pentru murdarie usoara'],
    verdict: 'Hansa BOES68461 e alegerea cu cele mai multe functii din grupa accesibila: pe langa grill, coacere si convectie, are si deshidratare, utila pentru fructe sau legume uscate acasa. Curatarea SteamCleaning merge pe acelasi principiu al aburului ca AquaClean, blanda si fara chimicale, buna pentru intretinerea curenta. Are 62 de litri si un design curat, potrivit intr-o bucatarie moderna. Nota lui, 4.19, e cea mai mica din articol, pe 62 de pareri, deci experientele sunt ceva mai amestecate, un lucru de cantarit. Il iei cand vrei multe functii, inclusiv deshidratare, si o curatare usoara cu aburi, la un pret inca rezonabil.' },
  // --- B. Echilibrate, 1300-2000 ---
  { g: 'ech', id: 'D8P36JBBM', rol: 'Alegerea noastra', short: 'Zanussi 57 l', cap: '57 l', cur: 'Manuala', ctrl: 'Butoane', pret: '1682 lei',
