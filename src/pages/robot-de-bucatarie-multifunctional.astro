---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import SimilarArticles from '../components/SimilarArticles.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import emag from '../data/emag-products.json';
import keywordsData from '../../keywords.json';
import { visibleArticles, slugify } from '../lib/articles.mjs';

const relatedArticles = visibleArticles(keywordsData.completed).map(item => ({
  title: item.keyword.charAt(0).toUpperCase() + item.keyword.slice(1),
  slug: item.slug || slugify(item.keyword),
  excerpt: item.excerpt || '',
  image: item.image || `/images/articles/${item.slug || slugify(item.keyword)}.webp`,
  category: item.category,
  categorySlug: item.categorySlug,
  date: item.date || '',
}));

const pool = emag['robot-bucatarie-multi'] || [];
const byId = Object.fromEntries(pool.map(p => [p.id, p]));

const PICKS = [
  // --- Compacte ---
  { g: 'compact', id: 'DP438JBBM', badge: 'Cel mai accesibil', short: 'Heinner Charm', tip: 'Compact', bol: '1.2 L', putere: '750 W',
    specs: ['robot compact, bol de 1.2 L', '750 W, cu accesorii de baza', 'toaca, mixeaza si framanta', '239 pareri, nota 4.43'],
    pros: ['Cel mai accesibil robot din selectie', 'Compact, ocupa putin loc pe blat', 'Acopera nevoile de baza: tocat, mixat, framantat', '239 de pareri, bine testat'],
    cons: ['Bol mic, 1.2 L', 'Putere modesta pentru cantitati mari'],
    verdict: 'Cand bugetul e strans si vrei totusi un robot care sa te scape de tocat si mixat manual, Heinner Charm e cea mai ieftina cale. E un robot compact, cu bol de 1.2 litri si 750 W, care acopera nevoile de baza dintr-o bucatarie: toaca ceapa si legume, mixeaza si framanta aluaturi mici, la un pret pe care putine il bat. Cu 239 de pareri, e printre cele mai testate din selectie, iar nota 4.43 arata ca isi face treaba pentru ce costa. Bolul mic si puterea modesta il fac potrivit pentru portii mici, nu pentru gatit in cantitate. O iei cand vrei primul tau robot de bucatarie, ieftin si compact, pentru operatiile de zi cu zi si o bucatarie mica.' },
  { g: 'compact', id: 'DKZG86BBM', badge: 'Philips, simplu si compact', short: 'Philips HR7310 Daily', tip: 'Compact', bol: '1.9 L', putere: '700 W',
    specs: ['Philips Daily Collection, 700 W', 'tehnologie PowerChop pentru tocare uniforma', 'compact, usor de folosit si de curatat', '85 pareri, nota 4.64'],
    pros: ['De la Philips, brand de incredere', 'Tehnologia PowerChop, tocare uniforma', 'Compact si simplu, usor de folosit zilnic', 'Nota buna, 4.64'],
    cons: ['Accesorii de baza, fara extra', 'Putere de gama de intrare'],
    verdict: 'O varianta de la un brand de incredere o gasesti la Philips HR7310 Daily Collection, un robot compact gandit pentru folosire zilnica. Are 700 W si tehnologia PowerChop, o forma a lamelor si a bolului care toaca uniform, fara sa lase bucati mari langa altele foarte marunte, iar simplitatea lui il face usor de folosit si de curatat, tocmai bun pentru gatitul de fiecare zi. Cu 85 de pareri si nota 4.64, e apreciat pentru raportul dintre pret si ce stie sa faca. Are accesorii de baza si o putere de gama de intrare. O iei cand vrei un robot Philips compact, simplu si de incredere, pentru tocat si mixat zilnic, fara sa platesti pentru functii pe care nu le folosesti.' },
  { g: 'compact', id: 'D0191M2BM', badge: 'Cel mai bine notat, nota 4.87', short: 'Kenwood MultiPro Go', tip: 'Compact premium', bol: '1.3 L', putere: '650 W',
    specs: ['Kenwood MultiPro Go, compact', 'nota 4.87, cea mai mare din selectie', 'accesorii care se depoziteaza in bol', 'espressor de spatiu, cu cana de servire'],
    pros: ['Cea mai mare nota din toata selectia, 4.87', 'Foarte compact, accesoriile se strang in bol', 'De la Kenwood, brand premium', 'Vine cu o cana cu care servesti direct'],
    cons: ['Bol mic, pentru portii reduse', 'Mai scump decat alte compacte'],
    verdict: 'Daca vrei ce e mai bun intr-un format mic, Kenwood MultiPro Go are cea mai mare nota din toata selectia, 4.87, un semn clar ca ii multumeste pe cumparatori. E un robot foarte compact, gandit sa economiseasca spatiu: accesoriile se depoziteaza chiar in bol, deci il tii intr-un dulap fara sa imprastii piese, si vine cu o cana cu care servesti direct ce ai preparat. E de la Kenwood, un brand premium, iar calitatea se simte. Bolul e mic, deci e pentru portii reduse, si costa mai mult decat celelalte compacte. O iei cand vrei cel mai bine notat robot din selectie, compact si premium, ideal daca ai putin spatiu dar nu vrei sa faci compromisuri de calitate.' },
  // --- Cu bol mare ---
  { g: 'bol', id: 'D86TJYBBM', badge: 'Cel mai vandut, 330 pareri', short: 'Bosch MCM3501M', tip: 'Cu bol mare', bol: '2.3 L', putere: '800 W',
    specs: ['bol de 2.3 L plus blender, 800 W', 'multe accesorii: tocat, feliat, razuit, framantat', 'cel mai vandut din selectie, 330 pareri', 'nota 4.58'],
    pros: ['Cel mai vandut din selectie, 330 de pareri', 'Bol mare de 2.3 L plus blender inclus', 'Multe accesorii: toaca, feliaza, razuieste, framanta', 'De la Bosch, echilibru bun pret-dotari'],
    cons: ['Multe piese de spalat', 'Putere de 800 W, nu pentru aluaturi foarte grele'],
    verdict: 'Cu 330 de pareri, de departe cele mai multe din selectie, Bosch MCM3501M e alegerea pe care a facut-o cea mai multa lume, si se vede de ce. E un robot cu bol mare de 2.3 litri si blender inclus, cu o gramada de accesorii care acopera aproape tot ce ceri de la un robot: toaca, feliaza, razuieste, framanta si mixeaza, totul intr-un singur aparat de 800 W. E genul de robot multifunctional adevarat, care inlocuieste mai multe ustensile. Are, ca orice masina cu multe accesorii, destule piese de spalat, iar puterea de 800 W nu e pentru aluaturi foarte grele. O iei cand vrei cel mai popular si mai versatil robot din selectie, cu bol mare si blender, de la Bosch, pentru o bucatarie in care se gateste des si variat.' },
  { g: 'bol', id: 'DZ1KJYBBM', badge: 'Bol mare, mai accesibil', short: 'Bosch MCM3100W', tip: 'Cu bol mare', bol: '2.3 L', putere: '800 W',
    specs: ['bol de 2.3 L, 800 W, 2 viteze', 'accesorii pentru tocat, feliat si razuit', 'mai accesibil ca MCM3501M', '108 pareri, nota 4.64'],
    pros: ['Bol mare de 2.3 L la un pret mai mic', 'De la Bosch, robust si de incredere', 'Nota mare, 4.64', 'Acopera tocarea, felierea si razuirea'],
    cons: ['Fara blender, spre deosebire de MCM3501M', 'Doar 2 viteze'],
    verdict: 'Pentru cine vrea bolul mare Bosch la un pret mai bland, MCM3100W e sora mai accesibila a modelului de mai sus. Are acelasi bol generos de 2.3 litri si aceiasi 800 W, cu accesorii pentru tocat, feliat si razuit, dar renunta la blender si la unele extra, ca sa coste mai putin. Cu 108 pareri si nota 4.64, e chiar mai bine cotata ca procent decat sora ei mai vanduta, semn ca pentru operatiile de baza multumeste pe deplin. Are doar 2 viteze si nu include blenderul. O iei cand vrei un robot Bosch cu bol mare, robust si bine notat, dar nu ai nevoie de blender si preferi sa platesti mai putin.' },
  { g: 'bol', id: 'DTBD373BM', badge: 'Cel mai mare bol, 8 L', short: 'Izzy Chef Pro', tip: 'Cu bol mare', bol: '8 L inox', putere: '1500 W',
    specs: ['bol urias de 8 L din inox, 1500 W', '6 setari de viteza', 'cel mai puternic din grupul cu bol mare', '96 pareri, nota 4.73'],
    pros: ['Cel mai mare bol din selectie, 8 L inox', 'Cei mai multi W, 1500, pentru aluaturi grele', '6 setari de viteza', 'Nota mare, 4.73, la un pret rezonabil'],
    cons: ['Voluminos, cere spatiu de depozitare', 'Bolul de 8 L e mult pentru o persoana'],
    verdict: 'Cand gatesti pentru multa lume sau framanti aluaturi consistente, Izzy Chef Pro joaca la alta categorie de dimensiune. Are un bol urias de 8 litri din inox, cel mai mare din selectie, si 1500 W, cei mai multi de aici, deci face fata aluaturilor grele de paine sau cozonac si cantitatilor mari, cu 6 setari de viteza pentru control. E surprinzator de bine cotat, nota 4.73 din 96 de pareri, la un pret rezonabil pentru cat de mare si puternic e. Fiind voluminos, cere spatiu de depozitare, iar bolul de 8 litri e mult pentru o persoana singura. O iei cand gatesti in cantitate, framanti des aluat sau ai o familie mare, si vrei cel mai incapator si mai puternic robot din selectie fara sa intri in zona premium.' },
  // --- Cu vas planetar / premium ---
  { g: 'planetar', id: 'DGJK5KBBM', badge: 'Cel mai bine notat cu vas planetar', short: 'Kenwood kMix', tip: 'Vas planetar', bol: '5 L inox', putere: '1000 W',
    specs: ['vas planetar de 5 L din inox, 1000 W', 'mixer cu tel, palete si carlig de aluat', 'design retro, mai multe culori', '102 pareri, nota 4.8'],
    pros: ['Vas planetar de 5 L, ideal pentru aluat si creme', 'Nota mare, 4.8, de la Kenwood', 'Mixare planetara, prinde tot din vas', 'Design retro aratos, mai multe culori'],
    cons: ['Mai scump, zona premium', 'Mai ales pentru copt, mai putin pentru tocat'],
    verdict: 'Daca pasiunea ta e coptul, un robot cu vas planetar schimba complet povestea, iar Kenwood kMix e cel mai bine notat de acest tip din selectie, cu nota 4.8. Are un vas de 5 litri din inox si un sistem de mixare planetara, la care telul se roteste in jurul propriei axe si totodata prin vas, prinzand tot aluatul si toata crema, fara sa ramana nimic nemixat pe margini. Vine cu tel, palete si carlig de aluat, framanta paine si cozonac, bate frisca si albusuri, si arata bine, cu un design retro in mai multe culori. Costa mai mult, e in zona premium, si e gandit mai ales pentru copt, nu pentru tocat legume. O iei cand coci des si vrei cel mai bine notat robot cu vas planetar din selectie, o piesa pe care o tii la vedere in bucatarie.' },
  { g: 'planetar', id: 'D3PJ32BBM', badge: 'Planetar Bosch, echilibrat', short: 'Bosch MUM58720', tip: 'Vas planetar', bol: '3.9 L inox', putere: '1000 W',
    specs: ['vas planetar de 3.9 L inox, 1000 W', 'blender inclus, mixare planetara', 'accesorii pentru copt si tocat', '221 pareri, nota 4.47'],
    pros: ['Vas planetar Bosch cu blender inclus', 'Foarte testat, 221 de pareri', 'Mixare planetara pentru aluat si creme', 'Mai accesibil ca alte planetare premium'],
    cons: ['Vas ceva mai mic, 3.9 L', 'Nota putin sub varf, 4.47'],
    verdict: 'O alternativa planetara mai echilibrata la pret vine de la Bosch MUM58720, un robot cu vas de 3.9 litri din inox care imbina coptul cu functiile de robot obisnuit. Are mixare planetara pentru aluat si creme, dar vine si cu blender inclus si cu accesorii pentru tocat, deci acopera mai mult decat un mixer pur de patiserie. Cu 221 de pareri, e printre cele mai testate din selectie, iar nota 4.47 il aseaza solid, chiar daca nu la varf. Vasul e ceva mai mic decat la Kenwood, 3.9 fata de 5 litri. O iei cand vrei un robot cu vas planetar de la Bosch, care sa si coaca, si sa toace, si sa mixeze, la un pret mai echilibrat decat premium-ul curat de patiserie.' },
  { g: 'planetar', id: 'D5MG0ZBBM', badge: 'Premium, 50 de functii', short: 'Bosch MC812W872', tip: 'Premium', bol: '3.9 L', putere: '1250 W',
    specs: ['1250 W, bol de 3.9 L, 50 de functii', 'cel mai puternic din grupul premium', 'foarte multe accesorii incluse', '85 pareri, nota 4.48'],
    pros: ['Pana la 50 de functii, un adevarat bucatar in cutie', '1250 W, printre cele mai puternice', 'Bol de 3.9 L plus multe accesorii', 'De la Bosch, constructie solida'],
    cons: ['Cel mai scump din selectie', 'Multe accesorii de depozitat si spalat'],
    verdict: 'Pentru cine vrea un singur aparat care sa faca aproape tot, Bosch MC812W872 duce ideea de robot multifunctional la extrem: pana la 50 de functii intr-o singura masina de 1250 W. Toaca, feliaza, razuieste, framanta, mixeaza si stoarce, cu un bol de 3.9 litri si un teanc de accesorii care inlocuiesc jumatate din sertarul cu ustensile. E cel mai puternic dintre premium si e construit solid, ca un Bosch. Pretul e cel mai mare din selectie, iar multele accesorii cer loc de depozitare si spalare. O iei cand vrei un robot care sa acopere absolut tot, de la tocat la framantat si stors, intr-un singur aparat premium, si esti dispus la investitia si la spatiul pe care le cere.' },
].map(x => ({ ...x, p: byId[x.id] })).filter(x => x.p);

const COMPACT = PICKS.filter(x => x.g === 'compact');
const BOL = PICKS.filter(x => x.g === 'bol');
const PLANETAR = PICKS.filter(x => x.g === 'planetar');

const hero = '/images/articles/robot-de-bucatarie-multifunctional.webp';
const figCompact = '/imagini/articole/robot-compacte.webp';
const figBol = '/imagini/articole/robot-bol-mare.webp';
const figPlanetar = '/imagini/articole/robot-planetar.webp';
const published = '2026-07-19T17:22:09+03:00';

const faq = [
  { question: 'Ce e un robot de bucatarie multifunctional si cu ce difera de un mixer sau blender?', answer: 'Un robot de bucatarie multifunctional este un aparat cu un motor puternic si un bol in care schimbi accesorii, lame, discuri, tel, carlig de aluat, ca sa faci mai multe operatii cu o singura masina: toaca ceapa si legume, feliaza si razuieste, framanta aluat, mixeaza si adesea are si un blender atasat. Difera de un blender, care doar marunteste si lichefiaza pentru smoothie-uri si supe cremoase, si de un mixer de mana, care doar bate si amesteca. Robotul le combina pe toate si adauga tocarea si felierea, de aceea se numeste multifunctional. Practic, inlocuieste mai multe ustensile si iti scurteaza mult timpul petrecut cu prepararile de baza inainte de gatit.' },
  { question: 'Ce dimensiune de bol imi trebuie?', answer: 'Depinde de cate persoane gatesti si ce prepari. Un bol mic, de 1.2-1.9 litri, ca la robotii compacti din selectie, ajunge pentru o persoana sau un cuplu si pentru operatii rapide: tocat ceapa, o crema, un aluat mic. Un bol mediu-mare, de 2.3 litri, ca la Bosch MCM3501M, e bun pentru o familie si pentru gatit variat. Iar unul foarte mare, de 3.9 pana la 8 litri, ca la Izzy Chef Pro sau la robotii cu vas planetar, e pentru cantitati mari, aluaturi de paine si cozonac sau gatit pentru multa lume. Alege dupa consumul real: un bol prea mic te limiteaza cand gatesti in cantitate, dar unul prea mare e greu de umplut si de spalat daca faci mereu portii mici.' },
  { question: 'Ce e un robot cu vas planetar si cand se merita?', answer: 'Un robot cu vas planetar este in esenta un mixer de patiserie puternic: accesoriul, tel, palete sau carlig de aluat, se roteste in jurul propriei axe si totodata se plimba prin vas, ca planetele in jurul soarelui, de unde si numele. Astfel prinde tot continutul vasului, fara sa ramana aluat sau crema nemixate pe margini, si framanta aluaturi consistente de paine, cozonac sau pizza mult mai bine decat un robot obisnuit. Se merita mai ales daca coci des: paine, prajituri, bezele, frisca. Modele ca Kenwood kMix sau Bosch MUM58 sunt de acest tip. Daca insa gatesti mai ales sarat si ai nevoie de tocat si feliat legume, un robot clasic cu bol si discuri iti foloseste mai mult decat unul planetar, care e specializat pe copt.' },
  { question: 'Ce putere si cate viteze conteaza?', answer: 'Puterea, in wati, spune cat de usor face fata robotul unor sarcini grele. Pentru operatiile de baza, tocat, mixat, feliat, 700-800 W sunt de ajuns, ca la modelele compacte si cu bol mediu. Pentru aluaturi consistente si cantitati mari, cauta 1000 W sau mai mult, ca la robotii cu vas planetar sau la Izzy Chef Pro de 1500 W si Bosch MC812 de 1250 W, care nu se chinuie la framantat. Numarul de viteze conteaza pentru control: mai multe trepte, plus o functie de puls, pornit-oprit scurt, iti lasa sa maruntesti exact cat vrei, de la tocat grosier la pasat fin. Pe scurt, cu cat gatesti mai greu si mai mult, cu atat cauta mai multa putere si mai multe viteze.' },
  { question: 'Sunt greu de curatat robotii de bucatarie?', answer: 'Curatarea e, sincer, partea mai putin placuta la un robot multifunctional, tocmai pentru ca are multe piese: bol, capac, lame, discuri, uneori blender si accesorii de patiserie, toate trebuie spalate dupa folosire. Cu cat robotul are mai multe accesorii, cu atat ai mai multe de spalat, ceva de care sa tii cont daca vrei ceva simplu de zi cu zi. Vestea buna e ca la majoritatea modelelor piesele detasabile se pot pune in masina de spalat vase, ceea ce usureaza mult treaba, iar unele, ca Kenwood MultiPro Go, sunt gandite compact, cu accesorii care se strang in bol. Daca detesti spalatul, alege un model compact cu accesorii de baza; daca vrei versatilitate maxima, accepta ca vin cu mai multe piese de curatat.' },
  { question: 'Ce accesorii conteaza cel mai mult?', answer: 'Un robot bun vine cu un set de accesorii care ii dau versatilitatea. Cele mai folositoare sunt: lama in forma de S, cutit pentru tocat ceapa, legume, carne sau nuci; discurile de feliat si razuit, care taie legume subtiri sau razuiesc morcov si cascaval intr-o clipa; carligul de aluat, pentru framantat paine si cozonac; si telul, pentru batut frisca, albusuri si creme. Multe modele adauga un blender atasat, pentru smoothie-uri si supe, si un tocator mic. Cand alegi, uita-te ce accesorii sunt incluse in pret si care se cumpara separat: un robot cu multe accesorii in cutie, ca Bosch MCM3501M sau MC812, acopera mai multe nevoi fara costuri suplimentare. Gandeste-te ce gatesti des si verifica sa ai accesoriile pentru acele operatii.' },
  { question: 'Cat costa un robot de bucatarie multifunctional bun?', answer: 'In selectie, robotii pornesc de la circa 179 de lei pentru un model compact accesibil, ca Heinner Charm, si stau in zona 270-560 de lei pentru compacte de la Philips si Kenwood. Modelele cu bol mare, cele mai versatile pentru o familie, sunt intre circa 350 si 630 de lei, ca Bosch MCM3100W si MCM3501M sau Izzy Chef Pro. Robotii cu vas planetar, pentru copt, si cei premium cu zeci de functii ajung de la circa 1000 la 2560 de lei, ca Bosch MUM58, Kenwood kMix sau Bosch MC812. Cel mai bun raport il gasesti alegand dupa nevoie: un compact daca gatesti putin, unul cu bol mare daca esti o familie, si unul planetar sau premium doar daca coci des sau vrei un singur aparat pentru absolut tot.' },
];

const images = [hero, figCompact, figBol, figPlanetar, ...PICKS.map(x => x.p.image)];
---

<Layout
  title="Cel mai bun robot de bucatarie multifunctional in 2026: compact, cu bol mare sau planetar"
  description="Care e cel mai bun robot de bucatarie multifunctional in 2026: modele compacte accesibile de la Heinner, Philips si Kenwood, roboti cu bol mare de la Bosch si Izzy, si masini cu vas planetar pentru copt de la Kenwood kMix si Bosch. Comparate pe bol, putere, accesorii si pret, plus cum alegi si cum le intretii."
  image={hero}
  type="article"
  publishedTime={published}
  modifiedTime={published}
  author="Redactia CentroCasa"
  breadcrumb={[{ name: 'Acasa', url: '/' }, { name: 'Electrocasnice Casa', url: '/electrocasnice-casa/' }, { name: 'Cel mai bun robot de bucatarie multifunctional' }]}
  faq={faq.map(f => ({ question: f.question, answer: f.answer }))}
>
  <article class="rd">
    <nav class="breadcrumb">
      <a href="/">Acasa</a><span class="breadcrumb-separator">/</span>
      <a href="/electrocasnice-casa/">Electrocasnice Casa</a><span class="breadcrumb-separator">/</span>
      <span>Cel mai bun robot de bucatarie multifunctional</span>
    </nav>

    <h1>Cel mai bun robot de bucatarie multifunctional</h1>
    <p class="rd-byline">de <a href="/despre/">Redactia CentroCasa</a> · actualizat iulie 2026</p>

    <img class="rd-hero" src={hero} alt="Cel mai bun robot de bucatarie multifunctional: compact, cu bol mare si cu vas planetar" width="1200" height="675" fetchpriority="high" />

    <div class="rd-intro">
      <p>Cel mai vandut robot din selectie e <strong>Bosch MCM3501M</strong>, cu 330 de pareri, iar cel mai bine notat, <strong>Kenwood MultiPro Go</strong>, cu 4.87. Daca vrei un robot doar pentru copt, <strong>Kenwood kMix</strong>, cu vas planetar, e cel mai apreciat de acest tip.</p>
      <p>Un robot de bucatarie multifunctional inlocuieste mai multe ustensile deodata: <strong>toaca, feliaza, razuieste, framanta si mixeaza</strong>, si adesea are si un blender. Mai jos gasesti direct recomandarile, grupate pe compacte, cu bol mare si cu vas planetar, iar sub ele un ghid despre cum alegi si cum le intretii.</p>
      <p>Cele mai importante criterii sunt <strong>dimensiunea bolului</strong>, cat de multi sunteti in casa, <strong>puterea</strong>, pentru aluaturi grele, si <strong>accesoriile incluse</strong>. Le-am ales pe cele mai testate si mai bine notate din fiecare zona, de la compacte accesibile la premium cu zeci de functii, cu preturi si dotari clare la fiecare. Pentru cafea, vezi <a href="/espressor-automat-pentru-acasa/">espressoarele automate</a>, iar pentru gatit, <a href="/plita-cu-inductie-pentru-bucatarie/">plitele cu inductie</a>.</p>
    </div>

    <details class="rd-toc">
      <summary>Cuprins</summary>
      <ol>
        <li><a href="#tabel">Comparatie rapida</a></li>
        <li><a href="#compact">Compacte, pentru bucatarii mici</a></li>
        <li><a href="#bol">Cu bol mare, cele mai versatile</a></li>
        <li><a href="#planetar">Cu vas planetar, pentru copt</a></li>
        <li><a href="#de-ce">De ce un robot multifunctional</a></li>
        <li><a href="#conteaza">Ce conteaza cand alegi</a></li>
        <li><a href="#accesorii">Accesoriile, pe scurt</a></li>
        <li><a href="#intretinere">Intretinerea si curatarea</a></li>
        <li><a href="#cat-costa">Cat costa</a></li>
        <li><a href="#faq">Intrebari frecvente</a></li>
      </ol>
    </details>

    <h2 id="tabel">Comparatie rapida</h2>
    <div class="table-wrap">
      <table class="rd-table">
        <thead><tr><th>Model</th><th>Tip</th><th>Bol</th><th>Nota</th></tr></thead>
        <tbody>
          {PICKS.map(x => (
            <tr>
              <td><div class="cmp-prod"><img class="cmp-thumb" src={x.p.image} alt={x.short} loading="lazy" width="44" height="44" /><span>{x.short}</span></div></td>
              <td>{x.tip}</td>
              <td>{x.bol}</td>
              <td>{x.p.rating} ({x.p.reviews})</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 id="compact">Compacte, pentru bucatarii mici</h2>
    <p>Roboti mici, cu bol pana in 1.9 litri, care ocupa putin loc pe blat si acopera operatiile de baza: tocat, mixat, framantat portii mici. Perfecti pentru o persoana, un cuplu sau o bucatarie in care spatiul conteaza.</p>
    <div class="rd-grid">
      {COMPACT.map(x => (
        <ProductCard name={x.p.name.replace(/’/g, "'")} image={x.p.image} price={x.p.price} rating={x.p.rating} reviews={x.p.reviews} badge={x.badge} specs={x.specs} pros={x.pros} cons={x.cons} verdict={x.verdict} outKey={'p-' + x.id} />
      ))}
    </div>

    <img class="rd-fig" src={figCompact} alt="Roboti de bucatarie compacti: Heinner Charm, Philips Daily si Kenwood MultiPro Go" width="1200" height="675" loading="lazy" />

    <h2 id="bol">Cu bol mare, cele mai versatile</h2>
    <p>Roboti cu bol de 2.3 litri sau mai mare, cu multe accesorii si adesea blender inclus. Fac tot: toaca, feliaza, razuieste, framanta si mixeaza. Alegerea de baza pentru o familie care gateste des si variat.</p>
    <div class="rd-grid">
