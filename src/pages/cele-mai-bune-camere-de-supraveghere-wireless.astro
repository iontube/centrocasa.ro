  { g: 'interior', id: 'D0CD9GMBM', rol: 'Cea mai mare rezolutie de interior', short: 'BabyToy AG-D1 8MP', loc: 'Interior', rez: '8 MP', alim: 'Priza', pret: '285 lei',
