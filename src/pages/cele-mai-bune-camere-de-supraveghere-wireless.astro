  { g: 'exterior', id: 'D1B0JX2BM', rol: 'Cea mai completa, cu PoE', short: 'TP-Link Outdoor PoE', loc: 'Exterior', rez: '5 MP', alim: 'PoE / 12V', pret: '800 lei',
