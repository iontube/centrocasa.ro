const INT = PICKS.filter(x => x.g === 'interior');
const EXT = PICKS.filter(x => x.g === 'exterior');
const SOLAR = PICKS.filter(x => x.g === 'solar');
const VERS = PICKS.filter(x => x.g === 'versatile');

const hero = '/imagini/articole/cele-mai-bune-camere-de-supraveghere-wireless.webp';
const figInt = '/imagini/articole/camera-wireless-interior.webp';
const figExt = '/imagini/articole/camera-wireless-exterior.webp';
const figSolar = '/imagini/articole/camera-wireless-solar.webp';
const published = '2026-07-20T18:15:19+03:00';

const faq = [
  { question: 'Wireless inseamna ca nu are niciun cablu?', answer: 'Nu, si e cea mai frecventa confuzie la cumparare. La majoritatea camerelor, wireless se refera doar la transmisia video, care se face prin Wi-Fi in loc de cablu de retea. Alimentarea ramane insa prin cablu, la o priza obisnuita. Din cele 14 camere din selectie, doar doua functioneaza fara niciun cablu, cele cu panou solar si acumulator. Distinctia conteaza enorm cand alegi locul de montaj: o camera Wi-Fi obisnuita trebuie pusa la maximum cativa metri de o priza, sau ai nevoie de un electrician ca sa tragi una. Verifica intotdeauna campul de alimentare din fisa produsului inainte sa comanzi, nu doar denumirea.' },
  { question: 'Am nevoie de abonament lunar?', answer: 'Nu, si asta e o veste buna pe care producatorii nu o comunica foarte tare. Camerele din selectie inregistreaza pe un card microSD introdus in aparat, iar toate functiile de baza raman gratuite: vizionare live, detectie de miscare, notificari pe telefon si comunicare bidirectionala. La TP-Link, chiar si detectia inteligenta de persoane e inclusa fara abonament. Abonamentul, de exemplu Tapo Care, adauga stocare in cloud, istoric de 30 sau 180 de zile si posibilitatea de a recupera inregistrarile daca aparatul e furat sau distrus, dar ramane optional. Costul real ascuns nu e abonamentul, ci cardul microSD, care se cumpara separat si costa intre 30 si 100 de lei, in functie de capacitate.' },
  { question: 'Ce rezolutie imi trebuie de fapt?', answer: 'Depinde de ce vrei sa poti spune despre inregistrare. Pentru detectare, adica sa stii ca a fost cineva si cand, 2 MP sau Full HD sunt suficienti si costa cel mai putin. Pentru recunoastere, adica sa distingi o persoana cunoscuta sau culoarea unei masini, ai nevoie de 4-5 MP. Pentru identificare, adica o fata clara sau un numar de inmatriculare la distanta, iti trebuie 8 MP sau mai mult. In selectie, extremele sunt 2 MP la TP-Link C100 de 115 lei si 12 MP la BabyToy C3 de 397 de lei. Retine si consecinta practica: rezolutia mare inseamna fisiere mari, deci cardul se umple mai repede si suprascrii mai des, asa ca bugeteaza si un card mai mare.' },
  { question: 'Cum aleg intre Wi-Fi, 4G si PoE?', answer: 'Alegerea o face locatia, nu bugetul. Wi-Fi e potrivit cand ai internet in casa si camera e la o distanta rezonabila de router, iar aici intra majoritatea camerelor din selectie. PoE, adica Power over Ethernet, duce si curentul, si datele pe un singur cablu de retea, deci nu iti trebuie priza langa camera, iar conexiunea e mult mai stabila decat Wi-Fi si nu poate fi bruiata; costul e ca trebuie tras cablul. Varianta 4G cu cartela SIM se foloseste unde nu exista internet deloc: casa de vacanta, teren, livada, si vine cu un abonament de date lunar. Daca locatia nu are nici curent, nici internet, singura optiune reala e o camera cu panou solar si cartela SIM.' },
  { question: 'Camerele astea sunt sigure impotriva hackerilor?', answer: 'Riscul exista si merita tratat serios, pentru ca vorbim de un aparat care filmeaza in casa ta si e conectat la internet. Cateva reguli reduc considerabil problema. Schimba parola implicita imediat dupa instalare si foloseste una lunga, unica pentru camera. Activeaza autentificarea in doi pasi daca aplicatia o ofera. Actualizeaza firmware-ul cand aplicatia anunta o versiune noua, pentru ca acolo se repara vulnerabilitatile. Si, daca poti, pune camerele pe o retea Wi-Fi separata de calculatoare si telefoane, functia de retea pentru oaspeti a routerului fiind cea mai simpla varianta. Brandurile mari, ca TP-Link, publica actualizari mult mai constant decat producatorii mici, iar asta e un argument real in favoarea lor.' },
  { question: 'Camera merge fara internet?', answer: 'Partial, si depinde ce astepti de la ea. O camera Wi-Fi fara internet poate continua sa inregistreze local pe cardul microSD, deci daca ti se intrerupe conexiunea nu pierzi inregistrarile din acea perioada. Ce nu mai poti face e sa o vezi live de pe telefon si sa primesti notificari, pentru ca acestea trec prin internet. Daca locatia nu are internet deloc, ai doua optiuni reale din selectia asta: o camera cu cartela SIM, care isi face propria conexiune prin reteaua mobila, sau o camera care inregistreaza doar local si pe care o verifici periodic scotand cardul, varianta cea mai ieftina dar si cea mai putin utila, pentru ca afli ce s-a intamplat abia cand ajungi acolo.' },
  { question: 'Cat costa o camera de supraveghere buna?', answer: 'Selectia acopera de la 115 la 800 de lei. Sub 200 de lei gasesti camere de la branduri mari cu rezolutie de 2 MP, ca TP-Link C100, si modele Sricam versatile la 130 de lei, potrivite pentru detectare simpla. Intre 200 si 300 de lei e zona cu cel mai bun echilibru, unde intra cele mai vandute din articol: TP-Link C232 cu 4315 pareri, C325WB cu vedere nocturna color si Sricam de 9 MP. Peste 450 de lei ajungi la camerele cu panou solar, care nu au nevoie de priza, si la modelul PoE de 800 de lei, pentru instalari permanente. La buget adauga intotdeauna cardul microSD, 30-100 de lei, iar la modelele cu SIM, abonamentul de date lunar.' },
];

const images = [hero, figInt, figExt, figSolar, ...PICKS.map(x => x.p.image)];
