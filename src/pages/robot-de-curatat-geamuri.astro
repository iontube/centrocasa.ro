---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import SimilarArticles from '../components/SimilarArticles.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import emag from '../data/emag-products.json';
import keywordsData from '../../keywords.json';
import { visibleArticles, slugify } from '../lib/articles.mjs';

const relatedArticles = visibleArticles(keywordsData.completed).map(item => ({
  title: item.keyword.charAt(0).toUpperCase() + item.keyword.slice(1),
  slug: item.slug || slugify(item.keyword),
  excerpt: item.excerpt || '',
  image: item.image || `/images/articles/${item.slug || slugify(item.keyword)}.webp`,
  category: item.category,
  categorySlug: item.categorySlug,
  date: item.date || '',
}));

const pool = emag['robot-geamuri'] || [];
const byId = Object.fromEntries(pool.map(p => [p.id, p]));

const PICKS = [
  // --- Accesibile ---
  { g: 'acc', id: 'D0G6YCMBM', badge: 'Cel mai vandut', short: 'iHunt Smart Window', seg: 'Accesibil', control: 'Telecomanda',
    specs: ['programabil, cu senzor anti-cadere', 'indicator luminos de stare', 'pentru geamuri, cel mai accesibil', 'de departe cel mai vandut, 367 de pareri'],
    pros: ['De departe cel mai vandut din selectie, 367 de pareri', 'Cel mai mic pret dintre robotii de geamuri', 'Senzor anti-cadere si programare', 'iHunt, brand accesibil, cu multe produse smart'],
    cons: ['Nota 4.46, buna fara sa fie in top', 'Dotari de baza, fara pulverizator sofisticat'],
    verdict: 'Cea mai sigura alegere pentru cine vrea sa incerce un robot de geamuri fara sa investeasca mult. iHunt Smart Window Robot e de departe cel mai vandut din selectie, cu 367 de pareri, la cel mai mic pret dintre robotii de geamuri, semn ca multa lume l-a cumparat si e multumita de raportul pret-rezultat. Are senzor anti-cadere, care il opreste daca pierde aderenta la marginea geamului, indicator luminos de stare si posibilitatea de a-l programa. E de la iHunt, un brand accesibil cu multe produse smart. Nota, 4.46, e buna fara sa fie in varf, iar dotarile sunt de baza. Il iei cand vrei cel mai ieftin si mai testat robot de geamuri, pentru geamurile obisnuite din casa, fara sa dai bani de model premium.' },
  { g: 'acc', id: 'DK3X1V3BM', badge: 'Nota maxima', short: 'HOGA W10', seg: 'Accesibil', control: 'Telecomanda',
    specs: ['sistem avansat, cu frana de siguranta', 'pentru curatarea geamurilor', 'pret accesibil', 'nota maxima, 5 din 5'],
    pros: ['Nota maxima, 5 din 5, de la cumparatori', 'Frana de siguranta, tine robotul pe geam', 'Pret mic, printre cele mai accesibile', 'Sistem avansat pentru pretul lui'],
    cons: ['Putine pareri, 10', 'Brand mai putin cunoscut'],
    verdict: 'O alternativa accesibila foarte bine cotata, pentru cine vrea siguranta la un pret mic. HOGA W10 are un sistem avansat cu frana de siguranta, care ajuta robotul sa ramana lipit de geam si sa nu alunece, un detaliu important cand curata ferestre la inaltime. E printre cele mai ieftine din selectie si a luat nota maxima, 5 din 5, chiar daca deocamdata din putine pareri, doar 10. Vine de la un brand mai putin cunoscut, asa ca il iei mai mult pe increderea in specificatii si in notele bune de pana acum. Il alegi cand vrei un robot de geamuri ieftin, cu accent pe siguranta, si nu te deranjeaza ca are inca putine recenzii.' },
  { g: 'acc', id: 'DH08NM2BM', badge: 'Trei moduri de curatare', short: 'Techsen N1 Crystal', seg: 'Accesibil', control: 'Aplicatie',
    specs: ['3 moduri de curatare, pentru diverse geamuri', 'control din aplicatie', 'pentru geamuri interioare si exterioare', 'nota maxima, 5 din 5'],
    pros: ['Trei moduri de curatare, alegi traseul dupa geam', 'Control din aplicatie, comod', 'Nota maxima, 5 din 5', 'Pret rezonabil pentru dotari'],
    cons: ['Putine pareri, 22', 'Brand mai nou pe piata'],
    verdict: 'Alegerea daca vrei mai mult control asupra felului in care curata, la un pret inca accesibil. Techsen N1 Crystal are trei moduri de curatare, deci alegi traseul robotului in functie de geam, mai atent pe margini sau in zig-zag pe suprafata mare, si se comanda din aplicatie, comod de pe canapea. Are nota maxima, 5 din 5, din 22 de pareri, un semn bun, si e potrivit atat pentru geamuri interioare, cat si pentru exterioare. E de la un brand mai nou pe piata, cu inca putine recenzii. Il iei cand vrei un robot cu mai multe moduri de curatare si control din aplicatie, fara sa treci in zona premium.' },
  { g: 'acc', id: 'DF554K3BM', badge: 'Cu baterie de siguranta', short: 'Robot cu UPS', seg: 'Accesibil', control: 'Aplicatie',
    specs: ['UPS incorporat, baterie de urgenta', 'ramane pe geam la pana de curent', 'navigatie AI', 'accesibil, cu functii de siguranta'],
    pros: ['UPS incorporat: ramane lipit de geam daca se ia curentul', 'Navigatie AI pentru un traseu eficient', 'Functii de siguranta la un pret accesibil', 'Bun pentru geamuri la inaltime'],
    cons: ['Putine pareri, 7, nota 4.14', 'Brand generic'],
    verdict: 'Alegerea daca pui pret pe siguranta la pana de curent, dar ai buget limitat. Acest robot are un UPS incorporat, adica o baterie de urgenta care il tine lipit de geam daca se ia curentul in timpul curatarii, in loc sa cada, o functie pe care de obicei o gasesti la modele mult mai scumpe. Are si navigatie AI, pentru un traseu mai eficient pe suprafata geamului. E o optiune accesibila cu functii de siguranta reale, potrivita mai ales pentru ferestre la inaltime. Are inca putine pareri, 7, cu o nota de 4.14, si vine de la un brand generic. Il iei cand vrei protectia unui UPS fara sa platesti pretul unui robot premium.' },
  // --- Echilibrate ---
  { g: 'mid', id: 'DDM4TR3BM', badge: 'Cel mai cotat', short: 'SeveShop', seg: 'Mediu', control: 'Aplicatie (WiFi)',
    specs: ['cu pulverizator si control WiFi', 'silentios, programabil', 'nota 4.87 din 299 de pareri', 'unul dintre cele mai vandute'],
    pros: ['Foarte bine cotat, 4.87 din 299 de pareri, cele mai multe din grup', 'Pulverizeaza singur solutia pe geam', 'Control WiFi din aplicatie si functionare silentioasa', 'Programabil, il lasi sa lucreze cand vrei'],
    cons: ['Pret de gama medie', 'Necesita configurare in aplicatie'],
    verdict: 'Cel mai bine cotat robot din selectie, cu multe pareri si dotari complete. SeveShop are pulverizator integrat, deci aplica singur solutia de curatare pe geam in timp ce lucreaza, fara sa uzi tu fereastra dinainte, si se controleaza prin WiFi din aplicatie, cu functionare silentioasa si posibilitatea de a-l programa. Are o nota excelenta, 4.87, din 299 de pareri, cele mai multe din grupul echilibrat, deci e verificat de multi cumparatori. E in zona de pret medie si cere putina configurare in aplicatie la inceput. Il iei cand vrei un robot complet, cu pulverizator si WiFi, verificat de sute de oameni, si nu te sperie sa il configurezi o data.' },
  { g: 'mid', id: 'DG20D03BM', badge: 'Nota aproape maxima', short: 'IMA Trend', seg: 'Mediu', control: 'Aplicatie',
    specs: ['smart, cu pulverizator', 'filtru lavabil si baterie de siguranta', 'nota 4.92 din 245 de pareri', 'silentios'],
    pros: ['Nota aproape maxima, 4.92, din 245 de pareri', 'Filtru lavabil, il speli si il refolosesti', 'Baterie de siguranta integrata', 'Smart si silentios'],
    cons: ['Pret de gama medie', 'Brand mai putin cunoscut decat HOBOT'],
    verdict: 'Alegerea cu cea mai buna combinatie de nota mare si multe pareri din grupul echilibrat. IMA Trend are o nota aproape maxima, 4.92, din 245 de pareri, ceea ce inseamna ca aproape toti cumparatorii sunt multumiti, o raritate. E smart, cu pulverizator si o baterie de siguranta care il tine pe geam daca se ia curentul, si are un filtru lavabil, pe care il speli si il refolosesti, fara consumabile. Functioneaza silentios. E in zona de pret medie si vine de la un brand mai putin cunoscut decat HOBOT sau Ecovacs. Il iei cand vrei cea mai mare nota din grup, cu multe pareri in spate, si dotari complete de siguranta, la un pret rezonabil.' },
  { g: 'mid', id: 'DZ14MGYBM', badge: 'Cea mai buna nota', short: 'Robot aspirator ferestre', seg: 'Mediu', control: 'Telecomanda',
    specs: ['pentru multi-suprafete si exterioare', 'protectie la supraincalzire', 'colectare praf', 'nota 4.97, cea mai mare din selectie'],
    pros: ['Cea mai mare nota din selectie, 4.97', 'Merge pe mai multe suprafete, inclusiv exterioare', 'Protectie la supraincalzire', 'Bun si pentru geamuri, si pentru alte suprafete plane'],
    cons: ['Mai putine pareri, 29', 'Nume generic, brand neclar'],
    verdict: 'Robotul cu cea mai buna nota din toata selectia, pentru cine vrea versatilitate. Modelul are 4.97, cea mai mare nota de aici, si e gandit pentru multi-suprafete, inclusiv geamuri exterioare si alte suprafete plane, nu doar ferestrele obisnuite. Are protectie la supraincalzire, care il opreste daca se incinge, si functie de colectare a prafului, pe langa curatare. E in zona de pret medie si are 29 de pareri, mai putine decat SeveShop sau IMA, dar cu nota maxima. Numele e generic, iar brandul mai putin clar. Il iei cand vrei cea mai buna nota si un robot versatil, care sa curete si geamuri exterioare, si alte suprafete, si nu conteaza ca are un nume mai putin cunoscut.' },
  { g: 'mid', id: 'D8RN4ZYBM', badge: 'Cu filtru lavabil', short: 'Buntz WindowGlow', seg: 'Mediu', control: 'Aplicatie',
    specs: ['smart, cu filtru lavabil', 'avertizare sonora la probleme', 'pentru geamuri', 'nota 4.61 din 49 de pareri'],
    pros: ['Filtru lavabil, fara consumabile', 'Avertizare sonora daca apare o problema', 'Smart, control comod', 'Nota buna, 4.61, din 49 de pareri'],
    cons: ['Pret de gama medie', 'Brand mai putin cunoscut'],
    verdict: 'O optiune echilibrata, cu doua detalii practice de siguranta si intretinere. Buntz WindowGlow e un robot smart cu filtru lavabil, pe care il speli si il refolosesti, si cu avertizare sonora, care te anunta printr-un semnal daca apare o problema, de exemplu daca aderenta scade sau se blocheaza, util cand curata la inaltime si nu esti langa el. Are o nota buna, 4.61, din 49 de pareri, o baza solida de cumparatori. E in zona de pret medie si vine de la un brand mai putin cunoscut. Il iei cand vrei un robot echilibrat, cu filtru lavabil si avertizare sonora de siguranta, verificat de un numar decent de cumparatori.' },
  { g: 'mid', id: 'D7751M2BM', badge: 'Profesional, nota maxima', short: 'Rimenss', seg: 'Mediu', control: 'Aplicatie',
    specs: ['prezentat ca model profesional', 'silentios, smart, programabil', 'aspirator de geamuri', 'nota maxima, 5 din 5'],
    pros: ['Nota maxima, 5 din 5', 'Functionare silentioasa', 'Smart si programabil', 'Pozitionat ca model profesional, pentru uz intens'],
    cons: ['Putine pareri, 11', 'Brand mai putin cunoscut'],
    verdict: 'Alegerea daca vrei un robot pozitionat ca profesional, la un pret inca rezonabil. Rimenss e prezentat ca model profesional, silentios, smart si programabil, gandit pentru o curatare mai deasa sau mai exigenta a geamurilor. A luat nota maxima, 5 din 5, chiar daca din putine pareri, 11, un semn bun de la primii cumparatori. E in prima parte a gamei medii ca pret si vine de la un brand mai putin cunoscut, asa ca il iei mai mult pe specificatii si pe notele bune de pana acum. Il alegi cand vrei un robot descris ca profesional, silentios si programabil, si esti dispus sa te bazezi pe un numar mai mic de recenzii.' },
  // --- Premium ---
  { g: 'prem', id: 'DRBF78MBM', badge: 'HOBOT, 2 pulverizatoare', short: 'HOBOT R3', seg: 'Premium', control: 'Aplicatie',
    specs: ['HOBOT R3, cu 2 pulverizatoare', 'curatare automata, control din aplicatie', 'brand specializat in roboti de geamuri', 'indicator luminos'],
    pros: ['HOBOT, brand specializat in roboti de geamuri', 'Doua pulverizatoare, umezeste uniform geamul', 'Curatare automata si control din aplicatie', 'Constructie si tehnologie de nivel premium'],
    cons: ['Pret premium', 'Putine pareri, 9'],
    verdict: 'Alegerea premium de la brandul specializat in roboti de geamuri. HOBOT R3 vine cu doua pulverizatoare, care umezesc geamul uniform in fata robotului pentru o curatare mai buna, si cu un sistem de curatare automata controlat din aplicatie. HOBOT e numele care s-a facut cunoscut tocmai pe aceasta nisa, deci ai in spate tehnologie si constructie de nivel premium, cu accent pe aderenta si siguranta. E, evident, in zona de pret ridicat si are inca putine pareri, 9. Il iei cand vrei un robot de la un specialist in domeniu, cu doua pulverizatoare si dotari premium, si esti dispus sa platesti pentru brand si tehnologie.' },
  { g: 'prem', id: 'D0KWS4YBM', badge: 'Ecovacs, top de gama', short: 'Ecovacs WINBOT W2', seg: 'Premium', control: 'Aplicatie',
    specs: ['Ecovacs WINBOT W2, rezervor propriu', 'brand mare de roboti de curatenie', 'cel mai scump din selectie', 'tehnologie de top'],
    pros: ['Ecovacs, unul dintre cei mai mari producatori de roboti', 'Rezervor propriu pentru solutie', 'Tehnologie de aderenta si navigatie de top', 'Constructie premium, fiabila'],
    cons: ['Cel mai scump din selectie', 'Putine pareri, 11'],
    verdict: 'De la unul dintre cei mai mari producatori de roboti de curatenie, cel mai performant model din selectie. Ecovacs WINBOT W2 e cel mai scump din selectie si vine cu un rezervor propriu pentru solutie si cu tehnologia de aderenta si navigatie a unui brand consacrat, Ecovacs, cunoscut pentru robotii de aspirare si de geamuri. Primesti constructie premium, fiabila, si sistemele de siguranta care fac diferenta cand cureti ferestre mari sau la inaltime. Are inca putine pareri, 11, normal la un produs de nisa si scump. Il iei cand vrei cel mai bun robot de geamuri din selectie, de la un brand mare, si bugetul nu e principala grija, ci rezultatul si fiabilitatea.' },
  { g: 'prem', id: 'DM1JFMMBM', badge: 'HOBOT clasic, cu UPS', short: 'HOBOT 388', seg: 'Premium', control: 'Telecomanda',
    specs: ['HOBOT 388, cu pulverizator si UPS', 'baterie de urgenta la pana de curent', 'senzori de siguranta', 'model consacrat HOBOT'],
    pros: ['HOBOT, brand specializat, model consacrat', 'Pulverizator integrat si UPS de siguranta', 'Senzori care monitorizeaza aderenta', 'Tehnologie premium verificata in timp'],
    cons: ['Nota mai mica, 3.73, parerile sunt impartite', 'Pret premium'],
    verdict: 'Un model HOBOT consacrat, cu dotari premium, dar cu pareri mai impartite. HOBOT 388 are pulverizator integrat, care umezeste geamul, si un UPS de siguranta, adica o baterie de urgenta care il tine pe sticla daca se ia curentul, plus senzori care monitorizeaza continuu aderenta. Vine de la HOBOT, specialistul in roboti de geamuri, cu tehnologie verificata in timp. Partea mai putin buna e nota, 3.73, din 15 pareri, mai mica decat la celelalte modele din selectie, semn ca parerile sunt impartite, poate din cauza asteptarilor mari la un pret premium. Il iei doar daca tii neaparat la brandul HOBOT si la dotarile lui de siguranta, si accepti ca notele sunt mai amestecate decat la alte modele.' },
].map(x => ({ ...x, p: byId[x.id] })).filter(x => x.p);

const ACC = PICKS.filter(x => x.g === 'acc');
const MID = PICKS.filter(x => x.g === 'mid');
const PREM = PICKS.filter(x => x.g === 'prem');

const hero = '/images/articles/robot-de-curatat-geamuri.webp';
const figAcc = '/imagini/articole/robot-geam-accesibile.webp';
const figMid = '/imagini/articole/robot-geam-echilibrate.webp';
const figPrem = '/imagini/articole/robot-geam-premium.webp';
const published = '2026-07-18T21:20:26+03:00';

const faq = [
  { question: 'Cum sta un robot de curatat geamuri pe sticla si e sigur?', answer: 'Cele mai multe modele folosesc un motor cu vid, care creeaza o aspirare puternica ce le tine lipite de geam, indiferent de grosimea sau inclinarea acestuia, un sistem dovedit si sigur. Peste asta, robotii buni au trei plase de siguranta: un UPS, adica o baterie de urgenta care il tine pe geam inca 40 de minute daca se ia curentul, un cablu de siguranta pe care il prinzi de robot si il fixezi de ceva stabil, mai ales la curatarea la inaltime, in exterior, si senzori de presiune, care monitorizeaza aderenta si opresc robotul daca detecteaza o problema. Cu aceste sisteme, riscul de cadere e foarte mic.' },
  { question: 'Robotul de geamuri se poate folosi si la exterior, la inaltime?', answer: 'Da, si aici stralucesc cel mai mult, pentru ca fac o treaba periculoasa in locul tau, la geamurile de la etaj sau greu accesibile. Pentru exterior si inaltime, insa, siguranta e obligatorie: foloseste mereu cablul de siguranta, prins de robot si fixat de ceva solid, si alege un model cu UPS, ca sa nu cada la o pana de curent. Cauta si senzori de detectare a marginii, mai ales daca ai geamuri fara rama, ca robotul sa se opreasca la timp la capatul liber. Cu aceste masuri, poti curata in siguranta ferestre pe care altfel ar trebui sa le speli agatat pe afara.' },
  { question: 'Robotul curata singur sau trebuie sa ud eu geamul?', answer: 'Depinde de model. Unele au pulverizator integrat, ca SeveShop, IMA Trend sau modelele HOBOT din selectie, care aplica singure solutia de curatare pe geam in timp ce lucreaza, deci nu trebuie sa faci nimic dinainte. Altele functioneaza cu lavete de microfibra pe care le umezesti tu inainte de pornire, mai simple si mai ieftine. Modelele cu pulverizator sunt mai comode si dau adesea un rezultat mai uniform pe geamurile foarte murdare, dar costa mai mult. Daca vrei sa apesi un buton si sa nu te mai atingi de geam, alege unul cu pulverizator; daca nu te deranjeaza sa umezesti laveta, unul simplu e suficient.' },
  { question: 'Merge pe orice geam, cu rama sau fara rama?', answer: 'Pe geamurile cu rama merg toate, pentru ca rama le ajuta sa se orienteze si sa se opreasca la margine. Pentru geamurile fara rama, ca cele de la usi de sticla, balustrade sau vitrine, ai nevoie de un model cu senzori de detectare a marginii, care sa recunoasca unde se termina sticla si sa se opreasca la timp la capatul liber, ca sa nu treaca peste margine. Verifica in descriere daca robotul e potrivit pentru geamuri fara rama inainte sa il cumperi pentru asa ceva. Pe langa geamuri, unele modele merg si pe alte suprafete plane si netede, ca faianta, oglinzi sau blaturi.' },
  { question: 'Cat de bine curata, ajunge pana in colturi?', answer: 'Robotii de geamuri fac o treaba foarte buna pe suprafata mare a geamului, unde sterg uniform si scot praful si urmele, dar au o limita cunoscuta: colturile si marginile extreme. Din cauza formei, de obicei patrata sau rotunda, robotul lasa uneori o fasie ingusta nesterse chiar in colt sau pe marginea de langa rama. De aceea, cel mai bun rezultat il obtii lasand robotul sa faca partea grea, suprafata mare, si trecand tu la final cu o laveta prin colturi, daca vrei perfectiune. Pentru geamuri mari si multe, economia de efort ramane uriasa, chiar daca finisezi colturile manual.' },
  { question: 'Ce inseamna UPS la un robot de geamuri si de ce conteaza?', answer: 'UPS vine de la baterie de urgenta si e cea mai importanta functie de siguranta la un robot de geamuri. In mod normal, robotul sta lipit de geam datorita aspirarii create de motor, care are nevoie de curent. Daca se ia curentul brusc, la o pana sau daca scoti din greseala aparatul din priza, fara UPS aspirarea se opreste si robotul poate cadea. Cu un UPS, o baterie interna preia si mentine aspirarea inca aproximativ 40 de minute, timp in care robotul ramane pe geam si il poti da jos in siguranta. E o functie pe care merita sa o cauti, mai ales daca folosesti robotul la geamuri de la inaltime.' },
  { question: 'Robotul de geamuri chiar merita sau e doar un gadget?', answer: 'Merita mai ales in doua situatii: daca ai multe geamuri sau suprafete mari de sticla, si daca ai ferestre greu accesibile sau la inaltime, pe care altfel le speli periculos, agatat pe afara. In aceste cazuri, robotul face treaba grea si riscanta in locul tau, cu efort minim din partea ta. Daca ai un apartament mic, cu doua-trei geamuri usor de ajuns, un aspirator de geam obisnuit sau o simpla laveta pot fi suficiente si mult mai ieftine. Deci nu e doar un gadget, e o unealta care isi merita banii pentru cine are multe geamuri sau ferestre inalte, dar poate fi excesiv pentru nevoi mici.' },
  { question: 'Cat costa un robot de curatat geamuri?', answer: 'In selectie, un robot accesibil, dar functional, porneste de la circa 375-450 de lei, cazul modelelor iHunt, HOGA sau al celui cu UPS, cu functiile de baza si de siguranta. Modelele echilibrate, cu pulverizator, WiFi si note foarte bune, ca SeveShop, IMA Trend sau Buntz, sunt in general 750-900 de lei. Cele premium, de la branduri specializate ca HOBOT si Ecovacs, trec de 1800 si urca spre 2700 de lei. Pe langa pret, conteaza mult ce geamuri ai: pentru ferestre obisnuite, un model accesibil sau mediu e suficient; pentru multe geamuri sau ferestre la inaltime, merita un model cu UPS si dotari de siguranta mai bune.' },
];

const images = [hero, figAcc, figMid, figPrem, ...PICKS.map(x => x.p.image)];
