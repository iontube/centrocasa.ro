const KIT = PICKS.filter(x => x.g === 'kit');
const UDARE = PICKS.filter(x => x.g === 'udare');
const ACC = PICKS.filter(x => x.g === 'acc');

const hero = '/images/articles/sistem-de-irigare-automata-pentru-gradina.webp';
const figKit = '/imagini/articole/irigare-kituri.webp';
const figUdare = '/imagini/articole/irigare-udare.webp';
const figAcc = '/imagini/articole/irigare-accesorii.webp';
const published = '2026-07-19T12:32:07+03:00';

const faq = [
  { question: 'Ce inseamna un sistem de irigare automata?', answer: 'Un sistem de irigare duce apa direct la plante printr-un furtun cu picuratoare, o banda de picurare sau aspersoare, in loc sa uzi manual cu stropitoarea sau furtunul. Devine cu adevarat automat cand adaugi un programator, sau timer, la robinet: acesta porneste si opreste apa la orele setate, deci gradina se uda singura, chiar si cand nu esti acasa. Kiturile din selectie contin partea de distributie a apei, furtun, picuratoare, duze; pentru automatizarea completa le combini cu un programator, care se cumpara de obicei separat. Chiar si fara timer, un kit de picurare economiseste apa si timp fata de udatul manual.' },
  { question: 'Irigare prin picurare sau cu aspersoare?', answer: 'Depinde de ce uzi. Picurarea duce apa incet, direct la radacina fiecarei plante, deci e ideala pentru straturi de legume, flori si ghivece: consuma putina apa, uda tintit si nu uda frunzele, ceea ce previne bolile. Aspersoarele stropesc de sus, ca ploaia, si acopera o suprafata mare deodata, deci sunt facute pentru gazon si suprafete deschise de iarba. Pe scurt, pentru plante in straturi si ghivece alege picurarea, pentru gazon alege un aspersor. Multi le combina: picurare pentru gradina de legume si flori, aspersor pentru peluza.' },
  { question: 'Am nevoie de un programator pentru udare automata?', answer: 'Pentru automatizare completa, da. Kiturile de irigare din selectie duc apa la plante, dar tu deschizi si inchizi robinetul. Un programator, sau timer de udare, se monteaza intre robinet si sistem si porneste apa la orele si pe durata setate, de exemplu dimineata devreme si seara, chiar daca esti plecat. Asa gradina se uda singura, la momentul optim, si economisesti apa. Programatorul se cumpara de obicei separat de kit. Daca esti mereu acasa si nu te deranjeaza sa pornesti manual udarea, poti folosi kitul si fara timer; daca vrei sa pleci linistit sau sa uzi la ore fixe, programatorul e piesa care lipseste.' },
  { question: 'Cum uzi plantele cat esti plecat in concediu?', answer: 'Pentru cateva zile si pentru ghivece, cea mai simpla solutie sunt globurile de apa, ca seturile Jenuos sau OEM din selectie: le umpli, le infigi in pamant si elibereaza apa treptat, mentinand solul umed fara robinet sau curent. Pentru o gradina intreaga sau pentru absente mai lungi, ai nevoie de un sistem de picurare conectat la robinet, cu un programator care sa porneasca apa automat in fiecare zi. Alege in functie de scara: globurile pentru cateva plante de interior sau de balcon, un sistem cu timer pentru o gradina care trebuie udata zilnic cat esti plecat mai mult timp.' },
  { question: 'Cat de greu e de montat un sistem de irigare?', answer: 'Kiturile de baza sunt usor de montat, fara scule: imbini furtunul cu conectorii si picuratoarele, il asezi pe langa plante si il legi la robinet. Un kit mic il pui in una-doua ore. Cele complete, cu multe piese, ca sistemul 4U de 236 de piese, cer mai multa rabdare la inceput, pana pui la punct traseul si pozitionezi fiecare picurator, dar dupa aceea functioneaza singur. Accesoriile ajuta: tijele de fixare tin furtunul la locul lui, iar un distribuitor cu mai multe cai organizeaza liniile de la robinet. Nu ai nevoie de cunostinte speciale, doar de putina rabdare la primul montaj.' },
  { question: 'Cat costa un sistem de irigare pentru gradina?', answer: 'In selectie, un kit de irigare prin picurare porneste de la circa 70 de lei, ca sistemul OEM de doua linii, si urca spre 130 de lei pentru unul complet cu multe piese si doua moduri de udare. O banda de picurare de 100 m pentru randuri lungi de legume e in jur de 80 de lei. Aspersoarele pentru gazon costa intre 30 si 50 de lei, iar globurile de udat ghivecele, in jur de 35-40 de lei setul de 3. Accesoriile, ca picuratoarele reglabile sau distribuitoarele, sunt intre 10 si 60 de lei. La toate acestea se adauga, optional, un programator pentru udare cu adevarat automata. E o categorie accesibila, unde cu bani putini economisesti apa si timp.' },
];

const images = [hero, figKit, figUdare, figAcc, ...PICKS.map(x => x.p.image)];
