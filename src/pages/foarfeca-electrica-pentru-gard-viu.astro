---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import SimilarArticles from '../components/SimilarArticles.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import emag from '../data/emag-products.json';
import keywordsData from '../../keywords.json';
import { visibleArticles, slugify } from '../lib/articles.mjs';

const relatedArticles = visibleArticles(keywordsData.completed).map(item => ({
  title: item.keyword.charAt(0).toUpperCase() + item.keyword.slice(1),
  slug: item.slug || slugify(item.keyword),
  excerpt: item.excerpt || '',
  image: item.image || `/images/articles/${item.slug || slugify(item.keyword)}.webp`,
  category: item.category,
  categorySlug: item.categorySlug,
  date: item.date || '',
}));

const pool = emag['foarfeca-gard-viu'] || [];
const byId = Object.fromEntries(pool.map(p => [p.id, p]));

const PICKS = [
  // --- Cu fir, accesibile ---
  { g: 'fir', id: 'D3TGX4BBM', badge: 'Cea mai vanduta', short: 'Steinhaus PRO-HTR600', tip: 'Cu fir', lama: '51 cm', taiere: 'max 20 mm',
    specs: ['600 W, lama de 51 cm', 'taie crengi de pana la 20 mm grosime', 'cu fir, alimentare la priza', '186 pareri, nota 4.79'],
    pros: ['Cea mai vanduta din selectie, 186 de pareri', 'Lama lunga de 51 cm, avansezi repede', 'Taie crengi groase, pana la 20 mm', 'Pret accesibil pentru o foarfeca cu fir'],
    cons: ['Cablul te limiteaza la lungimea prelungitorului', 'Fara libertatea unei variante pe acumulator'],
    verdict: 'Cu 186 de pareri, de departe cele mai multe din selectie, Steinhaus PRO-HTR600 e alegerea pe care a facut-o cea mai multa lume, si se intelege de ce. Are 600 W si o lama lunga de 51 cm, cu care avansezi repede pe gardul viu, si taie crengi de pana la 20 mm grosime, mai groase decat multe rivale. Fiind cu fir, are putere constanta, nu se descarca la mijlocul lucrului, la un pret accesibil. In schimb, cablul te tine legat de priza si de lungimea prelungitorului, deci ai grija pe unde il porti. O iei cand vrei cea mai populara si mai verificata foarfeca de gard viu din selectie, cu lama lunga si putere buna, la un pret bland, pentru un gard viu la care ajungi cu prelungitorul.' },
  { g: 'fir', id: 'D8P9NVMBM', badge: 'Cea mai accesibila', short: 'Lehmann Brodsworth', tip: 'Cu fir', lama: '45 cm', taiere: '16 mm',
    specs: ['lama de 45 cm, distanta dinti 16 mm', 'cu fir, alimentare la priza', 'vine cu ochelari de protectie inclusi', '17 pareri, nota 4.41'],
    pros: ['Cel mai mic pret din selectie', 'Lama de 45 cm, buna pentru garduri obisnuite', 'Vine cu ochelari de protectie inclusi', 'Simpla, usor de folosit'],
    cons: ['Brand mai putin cunoscut', 'Nota mai modesta, 4.41'],
    verdict: 'Daca vrei sa cheltui cat mai putin si totusi sa scapi de foarfeca manuala, Lehmann Brodsworth e cea mai ieftina intrare din selectie. Are o lama de 45 cm, potrivita pentru garduri vii obisnuite, distanta intre dinti de 16 mm, si vine cu ochelari de protectie inclusi, un plus placut la acest pret. E cu fir, deci cu putere constanta la priza. Brandul e mai putin cunoscut, iar nota, 4.41 din 17 pareri, e mai modesta decat a celor de top, semn ca faci un compromis de finisaj pentru pretul mic. O iei cand bugetul e prioritatea numarul unu si vrei o foarfeca simpla, cu fir, pentru un gard viu mic, fara sa dai multi bani.' },
  { g: 'fir', id: 'D8PZQMBBM', badge: 'Einhell, lama de 51 cm', short: 'Einhell GH-EH 4245', tip: 'Cu fir', lama: '51 cm', taiere: '16 mm',
    specs: ['420 W, lama de 51 cm', '3200 curse pe minut, dinti la 16 mm', 'cu fir, de la Einhell', '14 pareri, nota 4.64'],
    pros: ['Lama lunga de 51 cm, avansezi repede', 'De la Einhell, brand cunoscut in unelte de gradina', '3200 curse pe minut, taiere rapida', 'Nota buna, 4.64'],
    cons: ['Cu fir, legata de priza', 'Inca putine pareri, 14'],
    verdict: 'De la un brand cu nume in uneltele de gradina, Einhell GH-EH 4245 e o foarfeca cu fir echilibrata, buna pentru cine vrea o marca de incredere fara sa plateasca premium. Are 420 W, o lama lunga de 51 cm, ca sa avansezi repede pe gard, si 3200 de curse pe minut pentru o taiere fina, cu dinti la 16 mm. Cu 14 pareri si nota 4.64, e bine cotata, chiar daca are inca putine recenzii. Fiind cu fir, e legata de priza si de prelungitor. O iei cand vrei o foarfeca de gard viu de la Einhell, cu lama lunga si taiere rapida, la un pret rezonabil, pentru un gard viu de dimensiune obisnuita.' },
  // --- Cele mai bune si fara fir ---
  { g: 'top', id: 'D0Y2LKMBM', badge: 'Cea mai bine notata, 4.93', short: 'Bosch EasyHedgeCut 45', tip: 'Cu fir', lama: '45 cm', taiere: '3400 curse/min',
    specs: ['Bosch, 420 W, lama de 45 cm', '3400 curse pe minut, taiere fina', 'cu fir, usoara si manevrabila', '40 pareri, nota 4.93, cea mai mare la modelele mari'],
    pros: ['Cea mai mare nota dintre foarfecile mari, 4.93', 'De la Bosch, calitate si siguranta', '3400 curse pe minut, taiere curata', 'Usoara si bine echilibrata, obosesti mai greu'],
    cons: ['Cu fir, legata de priza', 'Lama de 45 cm, nu cea mai lunga'],
    verdict: 'Cand cauti cel mai bine notat model dintre foarfecile mari, Bosch EasyHedgeCut 45 iese in fata cu o nota de 4.93, printre cele mai mari din toata selectia. E de la Bosch, cu tot ce inseamna asta ca siguranta si calitate a taierii, are 420 W si 3400 de curse pe minut, care dau o taiere fina si curata, si o lama de 45 cm. E usoara si bine echilibrata, deci o tii in maini mai mult fara sa te oboseasca, un lucru care conteaza pe un gard mare. E cu fir, deci legata de priza, iar lama nu e cea mai lunga. O iei cand vrei cea mai apreciata foarfeca de gard viu din selectie, de la Bosch, cu taiere fina si manevrare usoara, si nu te deranjeaza cablul.' },
  { g: 'top', id: 'DYQ0DZBBM', badge: 'Premium, brand japonez', short: 'Makita UH4861', tip: 'Cu fir', lama: '48 cm', taiere: '16 mm',
    specs: ['Makita, 400 W, lama de 48 cm', 'distanta dinti 16 mm, taiere robusta', 'cu fir, construita pentru durabilitate', 'nota 5 din 5, brand profesional'],
    pros: ['De la Makita, brand japonez profesional', 'Lama de 48 cm, taiere robusta', 'Construita pentru durabilitate si folosire intensa', 'Nota maxima, 5 din 5'],
    cons: ['Cel mai scump din selectie', 'Doar 5 pareri deocamdata'],
    verdict: 'Pentru cine pune calitatea si durabilitatea pe primul loc, Makita UH4861 vine cu reputatia unui brand japonez profesional, folosit si de gradinari care lucreaza zi de zi. Are 400 W si o lama de 48 cm, cu dinti la 16 mm, construita solid pentru folosire intensa si ani multi de lucru, nu doar pentru cateva tunsori pe sezon. A luat nota maxima, 5 din 5, chiar daca din doar 5 pareri deocamdata. E cu fir si e cel mai scump model din selectie, un pret pe care il dai pentru calitatea Makita. O iei cand vrei o foarfeca premium, durabila, de la un brand profesional, pentru un gard viu la care tii si pe care il ingrijesti multi ani, si esti dispus la investitie.' },
  { g: 'top', id: 'DTY2LKMBM', badge: 'Fara fir, pe acumulator', short: 'Bosch EasyHedgeCut 18V', tip: 'Pe acumulator', lama: '45 cm', taiere: '2400 curse/min',
    specs: ['Bosch, acumulator 18 V, fara fir', 'lama de 45 cm, 2400 curse pe minut', 'include acumulator 2.0 Ah si incarcator', '15 pareri, nota 4.87'],
    pros: ['Fara fir, te misti liber prin gradina', 'De la Bosch, cu acumulator 18 V inclus', 'Nota mare, 4.87', 'Vine complet: acumulator si incarcator'],
    cons: ['Autonomie limitata de acumulator', 'Mai scumpa decat variantele cu fir similare'],
    verdict: 'Daca te-ai saturat sa tragi cablul dupa tine si sa cauti prize, Bosch EasyHedgeCut 18V e singura din selectie care iti da libertate totala de miscare. Merge pe un acumulator de 18 V, inclus in pachet impreuna cu incarcatorul, deci o scoti din cutie si o folosesti, si ajungi cu ea oriunde in gradina, chiar si acolo unde nu ai priza aproape, fara grija cablului. Are o lama de 45 cm si 2400 de curse pe minut, cu nota 4.87 din 15 pareri, foarte bine cotata. Autonomia e insa limitata de acumulator, deci pentru garduri foarte lungi poti avea nevoie de o pauza de incarcare, si costa mai mult decat o foarfeca cu fir similara. O iei cand vrei libertatea de a lucra fara cablu, de la Bosch, si nu ai un gard atat de lung incat sa te limiteze acumulatorul.' },
  // --- Compacte de mana ---
  { g: 'mana', id: 'DML93KMBM', badge: 'Cea mai vanduta mica', short: 'Texas HTG360Li', tip: 'De mana', lama: 'compacta', taiere: 'iarba si arbusti',
    specs: ['acumulator Li-Ion 3.6 V, 2 in 1', 'taie iarba si arbusti mici', 'maner reglabil pe inaltime, incarcare USB', '75 pareri, nota 4.57'],
    pros: ['Cea mai vanduta dintre cele mici, 75 de pareri', '2 in 1: cap pentru iarba si cap pentru arbusti', 'Maner reglabil pe inaltime, se incarca prin USB', 'Foarte accesibila'],
    cons: ['Doar pentru forme mici, buxus si arbusti', 'Acumulator mic, 3.6 V'],
    verdict: 'Pentru tuns fin, forme si arbusti mici, nu ai nevoie de o foarfeca mare, iar Texas HTG360Li e cea mai vanduta unealta compacta din selectie. E un dispozitiv 2 in 1: schimbi capul si taie fie iarba pe margini, fie arbusti mici si buxus, cu un maner care se regleaza pe inaltime si un acumulator ce se incarca prin cablu USB, comod. Cu 75 de pareri si nota 4.57, e apreciata pentru cat de practica si accesibila e. Nu inlocuieste o foarfeca mare de gard viu: e pentru forme mici si detalii, cu un acumulator de doar 3.6 V. O iei cand vrei o unealta mica si ieftina pentru tuns buxusul, formele si marginile, ca accesoriu pe langa o foarfeca mare sau pentru o gradina cu forme mici.' },
  { g: 'mana', id: 'D5CW5RMBM', badge: 'Mini, de mana, nota 4.88', short: 'Shall 7.2V', tip: 'De mana', lama: 'mica', taiere: 'buxus si forme',
    specs: ['acumulator 7.2 V, foarte compacta', 'pentru tuns fin, buxus si forme', 'usoara, se tine intr-o mana', '24 pareri, nota 4.88'],
    pros: ['Foarte compacta, se tine intr-o mana', 'Nota mare, 4.88', 'Perfecta pentru buxus, forme si detalii', 'Usoara, nu oboseste incheietura'],
    cons: ['Doar pentru tuns fin, nu pentru gard mare', 'Acumulator mic'],
    verdict: 'Cand ai de tuns un buxus, forme sau margini si vrei ceva usor si precis, mini-foarfeca Shall de 7.2 V isi face treaba cu o nota de 4.88, una dintre cele mai mari din selectie. E foarte compacta, o tii intr-o singura mana si o manevrezi usor in jurul formelor si al ghivecelor, unde o foarfeca mare ar fi greoaie, iar greutatea mica nu-ti oboseste incheietura. Cu 24 de pareri si nota aproape maxima, cei care au cumparat-o sunt multumiti. E strict pentru tuns fin, nu pentru un gard viu inalt si lung, si are un acumulator mic. O iei cand vrei o unealta mica, precisa si bine notata pentru buxus, forme si detalii, pe langa uneltele mari de gradina.' },
  { g: 'mana', id: 'D13X9W3BM', badge: 'Compacta, acumulator 21 V', short: 'Mesterino NT20', tip: 'De mana', lama: '45 cm', taiere: '180 W',
    specs: ['acumulator 21 V, 2 Ah, 180 W', 'lama de 45 cm, mai lunga pentru o compacta', 'fara fir, manevrabila', '5 pareri, nota 4.8'],
    pros: ['Acumulator mai puternic, 21 V', 'Lama de 45 cm, mai lunga decat alte compacte', 'Fara fir, usor de manevrat', 'Nota buna, 4.8'],
    cons: ['Doar 5 pareri deocamdata', 'Brand mai putin cunoscut'],
    verdict: 'La granita dintre uneltele mici si cele mari, Mesterino NT20BHT01 ofera un acumulator mai puternic, de 21 V, si o lama de 45 cm, mai lunga decat la mini-foarfecile de mana, ceea ce o face utila si pentru garduri vii mici, nu doar pentru forme. Are 180 W, merge fara fir, deci te misti liber, si e usor de manevrat. Cu doar 5 pareri, chiar daca nota 4.8, e inca putin testata, iar brandul e mai putin cunoscut, asa ca te bazezi mai mult pe specificatii. O iei cand vrei o foarfeca compacta fara fir, cu un acumulator mai puternic si o lama ceva mai lunga, la mijloc intre mini-uneltele de forme si foarfecile mari de gard viu.' },
].map(x => ({ ...x, p: byId[x.id] })).filter(x => x.p);

const FIR = PICKS.filter(x => x.g === 'fir');
const TOP = PICKS.filter(x => x.g === 'top');
const MANA = PICKS.filter(x => x.g === 'mana');

const hero = '/images/articles/foarfeca-electrica-pentru-gard-viu.webp';
const figFir = '/imagini/articole/foarfeca-fir.webp';
const figTop = '/imagini/articole/foarfeca-premium.webp';
const figMana = '/imagini/articole/foarfeca-mana.webp';
const published = '2026-07-19T18:05:41+03:00';

const faq = [
  { question: 'Cu fir sau pe acumulator, ce e mai bun pentru gardul viu?', answer: 'Depinde de cat de lung e gardul si cat de departe ajungi cu priza. O foarfeca cu fir are putere constanta si nu se descarca niciodata, deci taie la fel de bine si dupa o ora de lucru, e mai usoara pentru ca nu cara un acumulator, si costa in general mai putin; in schimb, esti legat de cablu si de un prelungitor, trebuie sa ai grija sa nu-l tai si nu ajungi in colturi indepartate din gradina. O foarfeca pe acumulator iti da libertate totala de miscare, ajungi oriunde fara cablu, dar are autonomie limitata, la garduri foarte lungi poti avea nevoie de o pauza de incarcare sau de un al doilea acumulator, e ceva mai grea si mai scumpa. Pe scurt: pentru un gard mare la care ajungi cu prelungitorul, cu fir e mai practic si mai ieftin; pentru libertate si garduri raspandite prin gradina, alege pe acumulator.' },
  { question: 'Ce lungime de lama imi trebuie?', answer: 'Lama, masurata in centimetri, determina cat de repede avansezi si ce garduri poti tunde. O lama lunga, de 48-51 cm, ca la Steinhaus, Einhell sau Makita din selectie, acopera o suprafata mare la fiecare trecere, deci termini mai repede un gard viu lung si tai mai drept partile late. O lama de 45 cm, ca la Bosch, e un bun compromis, usor de manevrat si potrivita pentru garduri obisnuite. Uneltele compacte, de mana, au lame mici si sunt pentru buxus, forme si detalii, nu pentru garduri mari. Alege lama lunga daca ai mult de tuns si suprafete late, si una medie sau compacta daca ai un gard mic sau lucrezi mai ales forme si margini.' },
  { question: 'Ce grosime de crengi taie o foarfeca de gard viu?', answer: 'Conteaza distanta dintre dinti, care spune ce grosime de creanga intra intre lame si poate fi taiata. Modelele din selectie au distante intre dinti de 15-20 mm: una de 20 mm, ca Steinhaus, taie crengi mai groase, pana la 2 cm, potrivita pentru garduri mai lemnoase sau lasate mai mult netunse, iar una de 16 mm face fata crengilor obisnuite ale unui gard tuns regulat. Pentru intretinerea normala, cand tunzi de cateva ori pe sezon si crengile sunt subtiri, 15-16 mm ajung. Daca gardul e batran, des si cu ramuri groase, cauta o distanta mai mare intre dinti. Retine ca o foarfeca de gard viu e pentru crengi verzi si subtiri, nu pentru ramuri groase si uscate, pentru care ai nevoie de un fierastrau.' },
  { question: 'Cat de des trebuie tuns un gard viu?', answer: 'Depinde de specie si de cat de ingrijit vrei sa arate, dar regula generala e de doua ori pe an pentru majoritatea gardurilor: o data primavara, spre sfarsitul primaverii, si o data la sfarsitul verii, ca sa intre in iarna cu o forma buna. Gardurile cu crestere rapida, ca ligustrul, cer si o a treia tunsoare vara pentru a ramane compacte si dese. Tunsul regulat nu doar ca tine gardul frumos, ci il si indeasa: taind varfurile, stimulezi ramurile laterale sa creasca, asa ca gardul devine mai plin si mai des in timp. Evita sa tunzi in plin soare si arsita sau in perioada de cuibarit a pasarilor, primavara tarziu, si nu taia prea adanc in lemnul batran dintr-o data. Un gard tuns constant, de doua-trei ori pe an, ramane sanatos, des si cu o forma clara.' },
  { question: 'Cum folosesc in siguranta o foarfeca de gard viu?', answer: 'O foarfeca electrica are lame ascutite in miscare rapida, asa ca siguranta e importanta. Poarta intotdeauna ochelari de protectie, unele modele ii includ, ca sa te aperi de aschii si bucati de creanga, si manusi, iar la garduri mari o casca de protectie a auzului nu strica. Tine unealta cu ambele maini pe manere si ai grija ca a doua mana si picioarele sa fie mereu departe de lama. La modelele cu fir, poarta cablul peste umar si ai grija sa fie mereu in spatele tau, ca sa nu-l tai din greseala, si foloseste o priza cu protectie. Nu tunde pe scara instabila si nu te intinde peste masura, e mai sigur sa muti scara. Opreste si scoate din priza sau scoate acumulatorul inainte de a curata sau debloca lama. Cu aceste reguli simple, tunsul gardului e o treaba sigura si placuta.' },
  { question: 'Cum intretin foarfeca ca sa dureze?', answer: 'Cheia e sa ai grija de lama, care e inima uneltei. Dupa fiecare folosire, curata lama de resturi de frunze si de seva, care altfel se intaresc si o ingreuneaza, si sterge-o cu o carpa. Din cand in cand, mai ales daca ai taiat mult, aplica putin ulei special de lama sau un spray de intretinere, care unge, protejeaza de rugina si face taierea mai lina. Ascute lama periodic sau du-o la ascutit daca observi ca rupe crengile in loc sa le taie curat. La modelele pe acumulator, nu lasa acumulatorul complet descarcat perioade lungi si depoziteaza-l intr-un loc uscat, la temperatura camerei. Pastreaza unealta la adapost, nu in ploaie sau umezeala. Cu aceasta grija simpla, o foarfeca de gard viu buna taie curat si rezista multi ani.' },
  { question: 'Cat costa o foarfeca electrica de gard viu?', answer: 'In selectie, foarfecile cu fir pornesc de la circa 120 de lei pentru un model accesibil, ca Lehmann Brodsworth, si stau in zona 180-230 de lei pentru cele mai vandute cu lama lunga, ca Steinhaus si Einhell. Modelele de la Bosch cu fir sunt in jur de 300 de lei, cea pe acumulator, fara fir, in jur de 450 de lei, iar cele premium, ca Makita, ajung spre 670 de lei. Uneltele compacte, de mana, pentru buxus si forme, costa intre circa 120 si 190 de lei. Cel mai bun raport il gasesti alegand dupa nevoie: o foarfeca cu fir cu lama lunga pentru un gard obisnuit, una pe acumulator daca vrei libertate de miscare, si o unealta mica doar pentru forme si detalii.' },
];

const images = [hero, figFir, figTop, figMana, ...PICKS.map(x => x.p.image)];
---

<Layout
  title="Cea mai buna foarfeca electrica pentru gard viu in 2026: cu fir, pe acumulator si de mana"
  description="Care e cea mai buna foarfeca electrica pentru gard viu in 2026: modele cu fir accesibile de la Steinhaus, Einhell si Lehmann, cele mai bine notate si fara fir de la Bosch si Makita, si unelte compacte de mana pentru buxus si forme. Comparate pe lama, grosime de taiere si tip de alimentare, plus cu fir vs acumulator si cum tunzi gardul."
  image={hero}
  type="article"
  publishedTime={published}
  modifiedTime={published}
  author="Redactia CentroCasa"
  breadcrumb={[{ name: 'Acasa', url: '/' }, { name: 'Gradinarit si Unelte', url: '/gradinarit-unelte/' }, { name: 'Cea mai buna foarfeca electrica pentru gard viu' }]}
  faq={faq.map(f => ({ question: f.question, answer: f.answer }))}
>
  <article class="rd">
    <nav class="breadcrumb">
      <a href="/">Acasa</a><span class="breadcrumb-separator">/</span>
      <a href="/gradinarit-unelte/">Gradinarit si Unelte</a><span class="breadcrumb-separator">/</span>
      <span>Cea mai buna foarfeca electrica pentru gard viu</span>
    </nav>

    <h1>Cea mai buna foarfeca electrica pentru gard viu</h1>
    <p class="rd-byline">de <a href="/despre/">Redactia CentroCasa</a> · actualizat iulie 2026</p>

    <img class="rd-hero" src={hero} alt="Cea mai buna foarfeca electrica pentru gard viu: cu fir, pe acumulator si de mana" width="1200" height="675" fetchpriority="high" />

    <div class="rd-intro">
      <p>Cea mai vanduta foarfeca de gard viu din selectie e <strong>Steinhaus PRO-HTR600</strong>, cu 186 de pareri, iar cea mai bine notata dintre cele mari, <strong>Bosch EasyHedgeCut 45</strong>, cu 4.93. Pentru libertate fara cablu, <strong>Bosch EasyHedgeCut 18V</strong>, pe acumulator, e singura fara fir din selectie.</p>
      <p>La o foarfeca de gard viu conteaza cel mai mult <strong>tipul de alimentare</strong>, cu fir sau pe acumulator, <strong>lungimea lamei</strong>, cat de repede avansezi, si <strong>grosimea de taiere</strong>, ce crengi rup dintii. Mai jos gasesti direct recomandarile, grupate pe cu fir accesibile, cele mai bune si fara fir, si compacte de mana, iar sub ele un ghid despre cum alegi si cum tunzi gardul.</p>
      <p>Le-am ales pe cele mai testate si mai bine notate din fiecare zona, de la modele cu fir ieftine la premium si la unelte mici pentru buxus. Am notat clar la fiecare care e cu fir si care pe acumulator, cu lama si grosime de taiere, ca sa gasesti repede foarfeca potrivita gardului tau. Pentru crengi si lemne, vezi si <a href="/tocator-de-crengi-pentru-curte/">tocatoarele de crengi</a> si <a href="/fierastrau-electric-pentru-lemne/">fierastraiele electrice</a>.</p>
    </div>

    <details class="rd-toc">
      <summary>Cuprins</summary>
      <ol>
        <li><a href="#tabel">Comparatie rapida</a></li>
        <li><a href="#fir">Cu fir, accesibile</a></li>
        <li><a href="#top">Cele mai bune si fara fir</a></li>
        <li><a href="#mana">Compacte de mana, pentru buxus</a></li>
        <li><a href="#de-ce">De ce o foarfeca electrica</a></li>
        <li><a href="#conteaza">Ce conteaza cand alegi</a></li>
        <li><a href="#cum-tunzi">Cum tunzi corect gardul viu</a></li>
        <li><a href="#intretinere">Siguranta si intretinerea</a></li>
        <li><a href="#cat-costa">Cat costa</a></li>
        <li><a href="#faq">Intrebari frecvente</a></li>
      </ol>
    </details>

    <h2 id="tabel">Comparatie rapida</h2>
    <div class="table-wrap">
      <table class="rd-table">
        <thead><tr><th>Model</th><th>Alimentare</th><th>Lama</th><th>Nota</th></tr></thead>
        <tbody>
          {PICKS.map(x => (
            <tr>
              <td><div class="cmp-prod"><img class="cmp-thumb" src={x.p.image} alt={x.short} loading="lazy" width="44" height="44" /><span>{x.short}</span></div></td>
              <td>{x.tip}</td>
              <td>{x.lama}</td>
              <td>{x.p.rating} ({x.p.reviews})</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 id="fir">Cu fir, accesibile</h2>
    <p>Foarfecile la priza, cu putere constanta care nu se descarca niciodata. Sunt mai usoare si mai ieftine, ideale pentru un gard viu la care ajungi cu prelungitorul. Aici stau cele mai vandute modele, cu lama lunga, la preturi bland.</p>
    <div class="rd-grid">
      {FIR.map(x => (
        <ProductCard name={x.p.name.replace(/’/g, "'")} image={x.p.image} price={x.p.price} rating={x.p.rating} reviews={x.p.reviews} badge={x.badge} specs={x.specs} pros={x.pros} cons={x.cons} verdict={x.verdict} outKey={'p-' + x.id} />
      ))}
