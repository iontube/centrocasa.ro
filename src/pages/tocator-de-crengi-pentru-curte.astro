const figAcc = '/imagini/articole/tocator-accesibile.webp';
const figEch = '/imagini/articole/tocator-echilibrate.webp';
const figPrem = '/imagini/articole/tocator-premium.webp';
const published = '2026-07-19T13:15:18+03:00';

const faq = [
  { question: 'Tocator cu cutite sau cu valt, ce sa aleg?', answer: 'Depinde de ce toci. Sistemul cu cutite taie rapid si fin, si se descurca cel mai bine cu crengile uscate si tari rezultate din tunsul de intretinere; tocatura iese marunta, buna pentru compost rapid, dar aparatul e mai zgomotos si cutitele se uzeaza si cer ascutire. Sistemul cu valt, o roata dintata sau un cilindru care striveste crengile incet, e mult mai silentios, se autoalimenteaza, adica trage singur crengile, si e ideal pentru material verde, fibros si umed, unde cutitele se ineaca; tocatura e ceva mai grosiera. Pe scurt: cutite pentru crengi uscate si liniste mai putina, valt pentru crengi verzi, fibroase si mers silentios.' },
  { question: 'Ce diametru maxim de crengi imi trebuie?', answer: 'Diametrul maxim arata cat de groase pot fi crengile pe care le baga aparatul. Tocatoarele electrice se descurca in general cu crengi de pana la 40-45 mm, iar cele bune ating exact aceasta limita, ca Lehmann sau ParkSide din selectie, cu 45 mm. Pentru majoritatea gradinilor de casa, unde toci crengi din tunderea pomilor si a gardului viu, 40-45 mm sunt mai mult decat suficienti. Daca ai crengi mai groase, din curatarea unei livezi mari sau a unui teren, un tocator pe benzina, ca Raider din selectie, ajunge la 50 mm sau mai mult. Nu forta niciodata o creanga mai groasa decat limita aparatului, pentru ca il blochezi sau il strici.' },
  { question: 'Tocator electric sau pe benzina?', answer: 'Pentru o gradina de casa, tocatorul electric e alegerea mai buna: e mai usor, mult mai silentios, porneste instant de la buton, nu are miros de combustibil si cere intretinere minima. Se descurca la crengi de pana la 40-45 mm, suficient pentru intretinerea obisnuita, dar te tine legat de o priza sau de un prelungitor de exterior. Tocatorul pe benzina isi merita banii doar daca ai teren mare, crengi mai groase de 45 mm sau lucrezi departe de sursa de curent: are mai multa putere si libertate de miscare, dar e mai greu, mai zgomotos, mai scump si cere intretinerea unui motor termic. Pentru majoritatea curtilor, electricul e mai practic.' },
  { question: 'La ce foloseste tocatura rezultata?', answer: 'Tocatura, adica maruntisul de crengi si resturi vegetale, e o resursa valoroasa in gradina, nu un gunoi. Cea mai frecventa utilizare e compostul: crengile maruntite se descompun mult mai repede decat intregi si imbogatesc pamantul. O poti folosi si ca mulci, un strat asezat la baza plantelor si a pomilor, care pastreaza umezeala in sol, tine buruienile la distanta si protejeaza radacinile de ger si de caldura. Tocatura mai grosiera, de la sistemele cu valt, e potrivita ca mulci pe alei sau sub arbusti, iar cea marunta, de la cutite, se composteaza mai repede. Practic, tocatorul iti transforma resturile de la tuns intr-un material util, in loc sa le arunci.' },
  { question: 'Cat de zgomotos e un tocator de crengi?', answer: 'Tocatoarele electrice au un nivel de zgomot in general intre 85 si 100 dB, iar cele pe benzina pot depasi 110 dB. Diferenta cea mai mare o face sistemul: cele cu valt, care strivesc crengile incet, sunt considerabil mai silentioase, in jurul a 90 dB, in timp ce cele cu cutite, care taie rapid, sunt mai galagioase. Daca stai intr-o zona rezidentiala, cu vecini aproape, un model cu valt e mult mai potrivit si te fereste de reclamatii. Indiferent de model, poarta casti antifonice si ochelari de protectie cand lucrezi, pentru ca si un tocator electric produce un zgomot semnificativ si arunca aschii.' },
  { question: 'Cum folosesc in siguranta un tocator de crengi?', answer: 'Poarta intotdeauna ochelari de protectie, manusi si casti antifonice, si haine stranse pe corp, fara snururi sau maneci largi care s-ar putea prinde. Introdu crengile cu grija, tinand mainile departe de gura de alimentare, si foloseste impingatorul din dotare pentru materialul scurt, niciodata mana. Nu baga crengi mai groase decat limita aparatului si nu forta materialul, mai ales la cutite; daca se blocheaza, opreste aparatul si scoate stecherul inainte de a interveni. Aseaza tocatorul pe o suprafata stabila si plana si tine copiii si animalele la distanta. Dupa folosire, curata gura de alimentare si cutitele sau valtul de resturi, cu aparatul oprit si deconectat.' },
  { question: 'Cat costa un tocator de crengi bun?', answer: 'In selectie, tocatoarele electrice accesibile pornesc de la circa 610-650 de lei, ca Raider, Lehmann sau Einhell, si urca spre 780 de lei pentru cel mai vandut accesibil, VONROC. Segmentul echilibrat, cu Villager, Black & Decker, Bosch sau ParkSide, se aseaza intre circa 1170 si 1410 lei si aduce sisteme cu valt silentioase sau branduri premium. Modelele premium, ca Makita sau Bosch AXT 25 D, trec de 1500 si urca spre 1900 de lei, cu cosuri mari si durabilitate profesionala. Tocatoarele pe benzina, pentru crengi groase si teren mare, ajung la peste 3000 de lei. Cel mai bun raport il gasesti alegand sistemul, cutite sau valt, si puterea potrivite pentru ce toci.' },
];

const images = [hero, figAcc, figEch, figPrem, ...PICKS.map(x => x.p.image)];
