---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import SimilarArticles from '../components/SimilarArticles.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import emag from '../data/emag-products.json';
import keywordsData from '../../keywords.json';
import { visibleArticles, slugify } from '../lib/articles.mjs';

const relatedArticles = visibleArticles(keywordsData.completed).map(item => ({
  title: item.keyword.charAt(0).toUpperCase() + item.keyword.slice(1),
  slug: item.slug || slugify(item.keyword),
  excerpt: item.excerpt || '',
  image: item.image || `/images/articles/${item.slug || slugify(item.keyword)}.webp`,
  category: item.category,
  categorySlug: item.categorySlug,
  date: item.date || '',
}));

const pool = emag['aer-conditionat'] || [];
const byId = Object.fromEntries(pool.map(p => [p.id, p]));

const PICKS = [
  // --- Accesibile ---
  { g: 'buget', id: 'DHWT4LBBM', badge: 'Cel mai vandut', short: 'Star-Light ACT-09WIFI', clasa: 'A++', inverter: 'da', camera: '~16 m²', kit: 'nu',
    specs: ['9000 BTU, clasa A++', 'inverter, silentios', 'control WiFi, functie de incalzire', 'pentru camere pana la ~16 m²'],
    pros: ['De departe cel mai vandut din selectie, sute de pareri', 'Inverter la un pret mic, silentios si eficient', 'Control WiFi din telefon si functie de incalzire iarna', 'Perfect pentru o camera sau o garsoniera'],
    cons: ['Fara kit de instalare inclus, il iei separat', 'Brand de buget, nu premium'],
    verdict: 'Cea mai populara alegere pentru un apartament mic si un bun punct de plecare. Star-Light ACT-09WIFI are 9000 BTU, exact pentru o camera sau o garsoniera de pana la circa 16 m², cu tehnologie inverter, care il face silentios si mai economic decat un model simplu. Il pornesti si il reglezi din telefon prin WiFi, iar iarna incalzeste, deci il folosesti tot anul. E cel mai vandut din selectie, cu sute de pareri, semn ca merge pentru multa lume. Nu vine cu kit de instalare, deci il pui la buget separat, iar brandul e de buget, nu premium. Il iei cand vrei un aer conditionat inverter, ieftin si verificat, pentru o camera mica.' },
  { g: 'buget', id: 'DSYFDLYBM', badge: 'Daewoo, cu filtre', short: 'Daewoo 9000', clasa: 'A++', inverter: 'da', camera: '~16 m²', kit: 'nu',
    specs: ['9000 BTU, clasa A++, inverter', 'filtre cu ioni de argint', 'Eco Mode si functia iFeel', 'control WiFi'],
    pros: ['Daewoo, brand cunoscut, la un pret accesibil', 'Filtre cu ioni de argint, aer mai curat', 'Eco Mode si iFeel, care regleaza dupa temperatura de langa tine', 'Inverter, clasa A++, control WiFi'],
    cons: ['Fara kit de instalare inclus', 'Diferente mici de dotare fata de alte modele de buget'],
    verdict: 'O alternativa buna de la un brand mai cunoscut, cu cateva dotari peste modelele de baza. Daewoo de 9000 BTU e inverter, clasa A++, si acopera o camera de pana la circa 16 m², cu filtre cu ioni de argint pentru un aer mai curat si cu functia iFeel, care regleaza temperatura dupa senzorul din telecomanda, de langa tine, nu de la unitate. Are Eco Mode pentru consum mai mic si control WiFi. Nu vine cu kit de instalare, deci il pui la buget separat. Il iei cand vrei un aer conditionat de la un brand cunoscut, cu filtrare buna, pentru o camera mica, la pret accesibil.' },
  { g: 'buget', id: 'D3QBHYMBM', badge: 'Cel mai ieftin (on/off)', short: 'Heinner 9000', clasa: 'A++', inverter: 'nu', camera: '~15 m²', kit: 'nu',
    specs: ['9000 BTU, clasa A++', 'tehnologie on/off, nu inverter', 'pentru camere pana la ~15 m²', 'brand Heinner'],
    pros: ['Cel mai mic pret pentru o camera mica', 'Clasa A++, chiar si fara inverter', 'Heinner, brand cunoscut la noi', 'Simplu si robust, bun ca prim aer conditionat'],
    cons: ['On/off, nu inverter: mai zgomotos si mai putin economic in folosire', 'Fara kit de instalare inclus'],
    verdict: 'Cu cel mai mic pret racesti o camera mica, daca nu ai nevoie de inverter. Heinner de 9000 BTU e un model on/off, adica porneste si se opreste la atingerea temperaturii, spre deosebire de un inverter care moduleaza continuu, deci e ceva mai zgomotos si mai putin economic in folosire, dar si mai ieftin la cumparare. E clasa A++ si acopera o camera de pana la circa 15 m². Heinner e un brand cunoscut la noi, cu service accesibil. Nu vine cu kit de instalare. Il iei cand vrei cel mai mic pret si folosesti aerul conditionat ocazional, nu toata ziua, unde diferenta fata de inverter conteaza mai putin.' },
  // --- Raport bun ---
  { g: 'raport', id: 'DQT56GYBM', badge: 'Alegerea noastra', short: 'Yamato Optimum YW09', clasa: 'A++/A+', inverter: 'da', camera: '~20 m²', kit: 'da',
    specs: ['9000 BTU, inverter, gama 2025', 'foarte silentios, de la 22 dB', 'kit de instalare inclus', 'Golden Fin, rezistenta la coroziune'],
    pros: ['Nota cea mai mare din selectie, aproape de maxim', 'Foarte silentios, de la 22 dB, ideal in dormitor', 'Vine cu kit de instalare inclus, economisesti la montaj', 'Inverter, gama 2025, cu Golden Fin anticoroziune'],
    cons: ['Yamato e mai putin cunoscut ca Samsung sau LG', 'Pret peste modelele de buget'],
    verdict: 'Recomandarea mea principala pentru un apartament mic: cel mai bine notat model din selectie si silentiozitate de top. Yamato Optimum YW09 are 9000 BTU, inverter si un nivel de zgomot de la 22 dB, aproape imperceptibil, ceea ce conteaza enorm intr-o garsoniera sau un dormitor unde dormi langa el. Vine cu kit de instalare inclus, deci economisesti la montaj, si are tratament Golden Fin pentru rezistenta la coroziune. Yamato e mai putin cunoscut decat Samsung sau LG, dar nota de la sute de cumparatori il recomanda. Il iei cand vrei cel mai bun echilibru intre silentiozitate, dotari si pret, cu kit inclus.' },
  { g: 'raport', id: 'DF8DPVMBM', badge: 'Inverter, Follow me', short: 'Ariston PRIOS 25', clasa: 'A++', inverter: 'da', camera: '~20 m²', kit: 'nu',
    specs: ['9000 BTU, clasa A++, 2D inverter', 'functie Follow me', 'agent frigorific R32', 'brand Ariston'],
    pros: ['Ariston, brand cunoscut, cu service la noi', '2D inverter, distributie mai buna a aerului', 'Functia Follow me, regleaza dupa telecomanda de langa tine', 'Agent R32, mai eficient si mai prietenos cu mediul'],
    cons: ['Fara kit de instalare inclus', 'Nivel de zgomot mediu, nu cel mai silentios'],
    verdict: 'Un inverter de la un brand cunoscut, cu cateva functii utile intr-o camera mica. Ariston PRIOS 25 are 9000 BTU, clasa A++ si un 2D inverter, care distribuie aerul mai uniform in incapere, plus functia Follow me, prin care aparatul urmareste temperatura de la telecomanda, de langa tine, pentru un confort mai bun. Foloseste agent frigorific R32, mai eficient si mai prietenos cu mediul. Ariston e un brand cunoscut, cu service accesibil. Nu vine cu kit de instalare si nu e cel mai silentios din selectie. Il iei cand vrei un inverter de brand, cu distributie buna a aerului si Follow me, pentru o camera mica.' },
  { g: 'raport', id: 'DQF8PY2BM', badge: 'Samsung, silentios', short: 'Samsung AR35', clasa: 'A++', inverter: 'da', camera: '~25 m²', kit: 'nu',
    specs: ['9000 BTU, clasa A++, inverter', 'silentios, de la 28 dB', 'SmartThings, Fast cooling, Good Sleep', 'Self clean'],
    pros: ['Samsung, brand mare, cu retea de service extinsa', 'Silentios, de la 28 dB, bun in dormitor', 'SmartThings, Fast cooling si Good Sleep pentru noapte', 'Self clean, isi usuca singur unitatea interna'],
    cons: ['Mai scump decat modelele de buget', 'Fara kit de instalare inclus'],
    verdict: 'Alegerea daca vrei un brand mare, cu aplicatie matura si functii de confort. Samsung AR35 are 9000 BTU, inverter, clasa A++, si e silentios, de la 28 dB, potrivit pentru un dormitor. Il controlezi din SmartThings, ai Fast cooling cand vrei sa racesti repede si Good Sleep, care ajusteaza temperatura peste noapte pentru un somn mai bun, plus Self clean, care usuca unitatea ca sa nu prinda miros. Samsung are cea mai extinsa retea de service, un plus real pe termen lung. E mai scump decat modelele de buget si nu vine cu kit. Il iei cand vrei un aer conditionat de brand mare, silentios, cu functii de somn, pentru o camera mica.' },
  // --- Premium ---
  { g: 'premium', id: 'DHXQ3ZBBM', badge: 'Specialist, cu kit', short: 'Gree Bora A4', clasa: 'A++', inverter: 'da', camera: '~25 m²', kit: 'da',
    specs: ['9000 BTU, G10 inverter', 'silentios, de la 28 dB', 'kit de instalare inclus', 'Buton Turbo, auto-diagnoza'],
    pros: ['Gree, unul dintre cei mai mari producatori de aer conditionat', 'G10 inverter, silentios de la 28 dB', 'Vine cu kit de instalare inclus', 'Buton Turbo si auto-diagnoza'],
    cons: ['Mai scump decat modelele de mijloc', 'Brand cunoscut mai ales de instalatori, mai putin de publicul larg'],
    verdict: 'Alegerea daca vrei un aparat de la un specialist in aer conditionat, cu kit inclus. Gree e unul dintre cei mai mari producatori de climatizare din lume, iar modelul Bora A4 de 9000 BTU are un G10 inverter silentios, de la 28 dB, si vine cu kit de instalare inclus, deci economisesti la montaj. Are buton Turbo pentru racire rapida si auto-diagnoza, care iti spune daca ceva nu e in regula. Gree e cunoscut mai ales de instalatori, care il recomanda des, mai putin de publicul larg. E mai scump decat modelele de mijloc, dar solid. Il iei cand vrei un aparat de la un specialist, silentios si cu kit inclus, pentru o camera mica.' },
  { g: 'premium', id: 'D14RBWMBM', badge: 'Beko, complet', short: 'Beko 9000', clasa: 'A++/A+', inverter: 'da', camera: '~25 m²', kit: 'da',
    specs: ['9000 BTU, clasa A++/A+', 'control WiFi HomeWhiz', 'kit de instalare inclus', 'Silver Ion, Self Clean+'],
    pros: ['Beko, brand mare, cu service la noi', 'Control WiFi HomeWhiz din telefon', 'Vine cu kit de instalare inclus', 'Filtre Silver Ion si Self Clean+ pentru igiena'],
    cons: ['Cel mai scump din selectie', 'Dotari multe, mai mult decat are nevoie o camera mica'],
    verdict: 'Cel mai complet aparat din selectie, pentru cine vrea un brand mare si toate dotarile. Beko de 9000 BTU are clasa A++/A+, control WiFi prin HomeWhiz, kit de instalare inclus si functii de igiena ca filtrele Silver Ion si Self Clean+, care mentin unitatea curata. Beko e un brand mare, cu retea de service la noi, un plus pe termen lung. E cel mai scump din selectie si aduce mai multe dotari decat are strict nevoie o camera mica, dar daca vrei sa iei o data si sa uiti, e o alegere sigura. Il iei cand vrei un aer conditionat complet, de brand mare, cu kit inclus, pentru o camera pe care o folosesti mult.' },
].map(x => ({ ...x, p: byId[x.id] })).filter(x => x.p);

const BUGET = PICKS.filter(x => x.g === 'buget');
const RAPORT = PICKS.filter(x => x.g === 'raport');
const PREMIUM = PICKS.filter(x => x.g === 'premium');

const site = 'https://centrocasa.ro';
const hero = '/images/articles/aer-conditionat-pentru-apartament-mic.webp';
const figBuget = '/imagini/articole/ac-mic-buget.webp';
const figRaport = '/imagini/articole/ac-mic-raport.webp';
const figPremium = '/imagini/articole/ac-mic-premium.webp';
const published = '2026-07-18T12:40:41+03:00';

const faq = [
  { question: 'Cati BTU imi trebuie pentru un apartament mic?', answer: 'Pentru o camera sau o garsoniera, 9000 BTU sunt alegerea potrivita, pentru ca acopera o incapere de pana la aproximativ 20-25 m². Regula orientativa e in jur de 350-400 BTU pe metru patrat, deci 9000 BTU racesc bine o camera obisnuita de apartament. Nu lua un aparat prea mare, de 12000 sau 18000 BTU, pentru o camera mica: raceste prea repede, se opreste des, dezumidifica mai prost si consuma inutil. Pentru un spatiu mic, 9000 BTU e sweet spot-ul.' },
  { question: 'Inverter sau on/off pentru o camera mica?', answer: 'Un aparat inverter isi moduleaza continuu puterea ca sa mentina temperatura, deci e mai silentios, mai economic si mai confortabil, fara pornirile si opririle bruste ale unui on/off. Un aparat on/off e mai ieftin la cumparare, dar mai zgomotos si mai costisitor in folosire, potrivit doar daca il pornesti ocazional. Intr-un apartament mic, unde stai si dormi in aceeasi incapere cu aparatul, inverterul merita aproape mereu diferenta de pret, prin liniste si consum.' },
  { question: 'Cat de important e zgomotul intr-o garsoniera?', answer: 'Foarte important, pentru ca dormi si stai in aceeasi camera cu aparatul. Un aer conditionat silentios, care porneste de la 22-28 dB, e aproape imperceptibil noaptea, in timp ce unul mai zgomotos te poate deranja la somn. Cauta nivelul de zgomot al unitatii interne in specificatii si tinteste valori mici, mai ales daca il folosesti in dormitor. Modelele inverter, ca Yamato, Samsung sau Gree din aceasta selectie, sunt printre cele mai silentioase.' },
  { question: 'Kitul de instalare e inclus?', answer: 'Depinde de model. Unele aparate, ca Yamato, Gree si Beko din aceasta selectie, vin cu kit de instalare inclus (tevi, cablu, suporturi), iar altele nu, caz in care il cumperi separat sau il pune instalatorul din materialele lui. Kitul inclus iti economiseste ceva bani la montaj. Oricum, montajul unui aer conditionat il face un instalator autorizat, care vidueaza instalatia si o pune corect; nu e o lucrare de facut singur, pentru ca implica agentul frigorific.' },
  { question: 'Ce clasa energetica sa aleg?', answer: 'Pentru un aer conditionat, cauta cel putin clasa A++, cum sunt toate modelele din aceasta selectie, iar daca bugetul permite, A+++ consuma si mai putin. Clasa energetica, impreuna cu coeficientii SEER la racire si SCOP la incalzire, iti spun cat de eficient e aparatul si cat vei plati pe curent. Intr-un apartament mic, unde aparatul merge des vara, o clasa buna se simte pe factura in cativa ani si merita diferenta de pret la cumparare.' },
  { question: 'Unde montez aparatul intr-un apartament mic?', answer: 'Unitatea interna se pune pe un perete liber, cat mai sus, de unde aerul se distribuie bine in camera, ferita de pat sau canapea, ca sa nu sufle direct in tine. Unitatea externa merge de obicei pe balcon, pe fatada sau pe un suport, cat mai aproape de cea interna, ca traseul de tevi sa fie scurt. Intr-un apartament mic conteaza sa alegi din start locul, ca traseul sa fie discret si scurt. Instalatorul iti spune ce e posibil in functie de structura blocului.' },
];

const images = [hero, figBuget, figRaport, figPremium, ...PICKS.map(x => x.p.image)];
const b64 = (s) => Buffer.from(s).toString('base64');
---

<Layout
  title="Aer conditionat pentru apartament mic in 2026: cele mai bune de 9000 BTU"
  description="Ce aer conditionat de apartament mic sa alegi in 2026: aparate de 9000 BTU pentru o camera sau garsoniera, cu inverter, clasa A++ si nivel de zgomot mic, de la Star-Light, Daewoo, Yamato, Samsung, Gree si Beko. Plus cati BTU, inverter vs on/off si montaj."
  image={hero}
  type="article"
  publishedTime={published}
  modifiedTime={published}
  author="Redactia CentroCasa"
  breadcrumb={[{ name: 'Acasa', url: '/' }, { name: 'Incalzire si Climatizare', url: '/incalzire-climatizare/' }, { name: 'Aer conditionat pentru apartament mic' }]}
  faq={faq.map(f => ({ question: f.question, answer: f.answer }))}
>
  <article class="rd">
    <nav class="breadcrumb">
      <a href="/">Acasa</a><span class="breadcrumb-separator">/</span>
      <a href="/incalzire-climatizare/">Incalzire si Climatizare</a><span class="breadcrumb-separator">/</span>
      <span>Aer conditionat pentru apartament mic</span>
    </nav>

    <h1>Aer conditionat pentru apartament mic in 2026</h1>
    <p class="rd-byline">de <a href="/despre/">Redactia CentroCasa</a> · actualizat iulie 2026</p>

    <img class="rd-hero" src={hero} alt="Aer conditionat pentru apartament mic, de 9000 BTU" width="1200" height="675" fetchpriority="high" />

    <div class="rd-intro">
      <p>Pentru un apartament mic, cel mai bun aer conditionat e <strong>Yamato Optimum</strong>: 9000 BTU, foarte silentios, de la 22 dB, cu kit de instalare inclus si nota cea mai mare. Cel mai vandut si mai ieftin cu inverter e <strong>Star-Light ACT-09WIFI</strong>. Daca vrei un brand mare cu functii de somn, <strong>Samsung AR35</strong> porneste de la 28 dB, iar cel mai ieftin, on/off, e <strong>Heinner</strong>.</p>
      <p>Pentru o camera sau o garsoniera, alegerea corecta e un aparat de <strong>9000 BTU</strong>: nici prea mic, nici prea mare. Apoi conteaza doua lucruri, mai mult decat oriunde: <strong>inverter sau on/off</strong>, care decide zgomotul si consumul, si <strong>cat de silentios</strong> e, pentru ca stai si dormi in aceeasi camera cu el.</p>
      <p>Am pornit de la aparatele de aer conditionat de 9000 BTU vandute pe eMAG, le-am verificat clasa energetica, tehnologia inverter, zgomotul si dotarile, si le-am grupat pe accesibile, raport bun si premium. Vezi si <a href="/cele-mai-bune-aparate-de-aer-conditionat/">comparatia mai larga de aparate de aer conditionat</a>, iar pentru facturi mai mici, <a href="/cele-mai-bune-panouri-solare/">panourile solare</a>.</p>
    </div>

    <details class="rd-toc">
      <summary>Cuprins</summary>
      <ol>
        <li><a href="#btu">De ce 9000 BTU pentru un apartament mic</a></li>
        <li><a href="#inverter">Inverter sau on/off</a></li>
        <li><a href="#zgomot">Zgomotul si clasa energetica</a></li>
        <li><a href="#tabel">Comparatie rapida</a></li>
        <li><a href="#buget">Aparate accesibile</a></li>
        <li><a href="#raport">Cel mai bun raport</a></li>
        <li><a href="#premium">Premium</a></li>
        <li><a href="#montaj">Montaj intr-un apartament mic</a></li>
        <li><a href="#faq">Intrebari frecvente</a></li>
      </ol>
    </details>

    <h2 id="btu">De ce 9000 BTU pentru un apartament mic</h2>
    <p>Prima decizie la un aer conditionat e puterea, masurata in BTU, si pentru un spatiu mic raspunsul e clar. Un aparat de <strong>9000 BTU</strong> raceste bine o camera sau o garsoniera de pana la aproximativ 20-25 m², dupa regula orientativa de circa 350-400 BTU pe metru patrat.</p>
    <p>Greseala frecventa e sa iei prea mult, un 12000 sau 18000 BTU, pentru o camera mica. Un aparat supradimensionat raceste prea repede, se opreste des, dezumidifica mai prost si consuma inutil, iar tu simti aerul mai umed si mai putin confortabil. Pentru un apartament mic, 9000 BTU e sweet spot-ul: exact cat trebuie, la cel mai bun pret.</p>

    <h2 id="inverter">Inverter sau on/off</h2>
    <p>A doua decizie conteaza si mai mult intr-un spatiu mic, unde stai langa aparat:</p>
    <p><strong>Inverter:</strong> isi moduleaza continuu puterea ca sa tina temperatura constanta, deci e mai silentios, mai economic si mai confortabil, fara pornirile si opririle bruste. E alegerea pentru un apartament unde folosesti aerul des si dormi in aceeasi camera.</p>
    <p><strong>On/off:</strong> porneste la maxim si se opreste cand atinge temperatura, apoi reia. E mai ieftin la cumparare, dar mai zgomotos si mai costisitor in folosire. Merita doar daca il pornesti ocazional.</p>
    <p>Pe scurt: intr-o garsoniera, inverterul isi merita aproape mereu diferenta de pret, prin liniste si consum mai mic.</p>

    <h2 id="zgomot">Zgomotul si clasa energetica</h2>
    <p>Doua cifre de verificat inainte sa cumperi, importante intr-o camera mica:</p>
    <ul>
      <li><strong>Nivelul de zgomot:</strong> intr-o garsoniera dormi langa aparat, deci cauta valori mici. Modelele silentioase pornesc de la 22-28 dB, aproape imperceptibil noaptea; unele on/off ajung la 50 dB si peste.</li>
      <li><strong>Clasa energetica:</strong> tinteste macar A++, cum sunt toate modelele de aici. Impreuna cu coeficientii SEER si SCOP, iti spune cat platesti pe curent. Intr-un apartament unde aparatul merge des vara, o clasa buna se simte pe factura.</li>
    </ul>

    <h2 id="tabel">Comparatie rapida</h2>
    <div class="table-wrap">
      <table class="rd-table">
        <thead><tr><th>Model</th><th>Clasa</th><th>Inverter</th><th>Camera</th><th>Kit inclus</th></tr></thead>
        <tbody>
          {PICKS.map(x => (<tr><td>{x.short}</td><td>{x.clasa}</td><td>{x.inverter}</td><td>{x.camera}</td><td>{x.kit}</td></tr>))}
        </tbody>
      </table>
    </div>

    <h2 id="buget">Aparate accesibile</h2>
    <p>Aer conditionat de 9000 BTU la pret mic, pentru o camera sau o garsoniera. De la inverter accesibil la cel mai ieftin model on/off.</p>
    <div class="rd-grid">
      {BUGET.map(x => (
        <ProductCard name={x.p.name.replace(/’/g, "'")} image={x.p.image} price={x.p.price} rating={x.p.rating} reviews={x.p.reviews} badge={x.badge} specs={x.specs} pros={x.pros} cons={x.cons} verdict={x.verdict} outKey={'p-' + x.id} />
      ))}
    </div>

    <img class="rd-fig" src={figBuget} alt="Aparate de aer conditionat accesibile de 9000 BTU: Star-Light, Daewoo, Heinner" width="1200" height="675" loading="lazy" />

    <h2 id="raport">Cel mai bun raport</h2>
    <p>Inverter, silentioase si de la branduri cunoscute, la un pret echilibrat. Aici intra cel mai bine notat model si o varianta Samsung cu functii de somn.</p>
    <div class="rd-grid">
      {RAPORT.map(x => (
        <ProductCard name={x.p.name.replace(/’/g, "'")} image={x.p.image} price={x.p.price} rating={x.p.rating} reviews={x.p.reviews} badge={x.badge} specs={x.specs} pros={x.pros} cons={x.cons} verdict={x.verdict} outKey={'p-' + x.id} />
      ))}
    </div>

    <img class="rd-fig" src={figRaport} alt="Aparate de aer conditionat de 9000 BTU: Yamato, Ariston si Samsung" width="1200" height="675" loading="lazy" />

    <h2 id="premium">Premium</h2>
    <p>De la un specialist in climatizare si un brand mare complet, cu kit de instalare inclus si dotari in plus, pentru cine vrea sa ia o data si sa uite.</p>
    <div class="rd-grid">
      {PREMIUM.map(x => (
        <ProductCard name={x.p.name.replace(/’/g, "'")} image={x.p.image} price={x.p.price} rating={x.p.rating} reviews={x.p.reviews} badge={x.badge} specs={x.specs} pros={x.pros} cons={x.cons} verdict={x.verdict} outKey={'p-' + x.id} />
      ))}
    </div>

    <img class="rd-fig" src={figPremium} alt="Aparate de aer conditionat premium de 9000 BTU: Gree si Beko" width="1200" height="675" loading="lazy" />

    <h2 id="montaj">Montaj intr-un apartament mic</h2>
    <p>Cateva lucruri de stiut inainte de a cumpara si a monta:</p>
    <ul>
      <li><strong>Instalator autorizat:</strong> montajul se face de un specialist, care videaza instalatia si o pune corect. Nu e o lucrare de bricolaj, pentru ca implica agentul frigorific.</li>
      <li><strong>Locul unitatii interne:</strong> pe un perete liber, cat mai sus, ferit de pat sau canapea, ca sa nu sufle direct in tine.</li>
      <li><strong>Unitatea externa:</strong> pe balcon, fatada sau un suport, cat mai aproape de cea interna, pentru un traseu de tevi scurt.</li>
      <li><strong>Kitul:</strong> unele aparate vin cu kit inclus (Yamato, Gree, Beko aici), altele nu; verifica, ca sa stii daca il pui la buget separat.</li>
    </ul>

