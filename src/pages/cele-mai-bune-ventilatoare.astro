const PODEA = PICKS.filter(x => x.g === 'podea');
const TURN = PICKS.filter(x => x.g === 'turn');
const BIROU = PICKS.filter(x => x.g === 'birou');

const hero = '/imagini/articole/cele-mai-bune-ventilatoare.webp';
const figPodea = '/imagini/articole/ventilator-podea.webp';
const figTurn = '/imagini/articole/ventilator-turn.webp';
const figBirou = '/imagini/articole/ventilator-birou.webp';
const published = '2026-07-20T17:22:10+03:00';

const faq = [
  { question: 'Ventilatorul raceste camera?', answer: 'Nu, si asta e cea mai raspandita neintelegere despre ventilatoare. Un ventilator nu scade temperatura aerului, ci doar il misca. Senzatia de racoare vine din faptul ca aerul in miscare accelereaza evaporarea transpiratiei de pe piele, iar evaporarea consuma caldura din corp. Efectul se simte ca 2-4 grade in minus, dar termometrul din camera arata aceeasi valoare. Consecinta practica e importanta: un ventilator lasat pornit intr-o camera goala nu face absolut nimic, doar consuma curent. Il pornesti cand esti in camera si il indrepti spre tine sau spre zona in care stai, nu il lasi sa mearga toata ziua ca sa gasesti racoare cand te intorci.' },
  { question: 'Ventilator sau aer conditionat?', answer: 'Sunt complementare, nu alternative, iar cifrele de consum arata de ce. Ventilatoarele din aceasta selectie consuma intre 5.5 si 60 de wati, in timp ce un aparat de aer conditionat obisnuit trage undeva la 700-1000 de wati, adica de peste zece ori mai mult. Aerul conditionat chiar raceste aerul si scade umiditatea, ventilatorul doar il misca. Combinatia e insa cea mai eficienta: Departamentul american al Energiei recomanda ca, atunci cand folosesti si un ventilator, sa urci termostatul aparatului de aer conditionat cu aproximativ 2 grade, pentru ca senzatia ramane aceeasi. Economia rezultata e de 10-12 la suta din costul de racire, iar ventilatorul adauga o fractiune neglijabila la consum.' },
  { question: 'De podea, de turn sau de birou?', answer: 'Alegerea tine de spatiu si de distanta la care stai. Ventilatorul de podea, cu elice de 35-40 de centimetri si 40-60 de wati, e singurul care misca aerul intr-o camera intreaga si e alegerea pentru living sau dormitor mare. Turnul misca mai putin aer la aceeasi putere, dar ocupa un patrat mic pe podea si nu are elice expusa, ceea ce conteaza cu copii sau animale in casa. Modelele de birou, cu 5-8 wati si elice de 10-15 centimetri, nu racoresc o camera si nici nu incearca: fac un curent de aer in jurul tau, la un metru distanta, si sunt potrivite la masa de lucru. Daca vrei sa racoresti o incapere, singura optiune reala din cele trei e cea de podea.' },
  { question: 'Cati decibeli inseamna silentios?', answer: 'Reperele practice: sub 30 de decibeli inseamna ca nu il auzi decat daca esti atent, intre 30 si 45 il auzi dar poti dormi, iar peste 50 devine deranjant intr-o camera linistita. In selectia de aici, cel mai silentios e modelul de birou Ideas4Comfort cu 20 de decibeli, urmat de Freezy Air cu 25 si de Xiaomi Mi Smart 1C cu 26.6 pe treapta mica. La celalalt capat, acelasi Xiaomi urca la 63 de decibeli pe treapta maxima, iar Rowenta la 60. De retinut ca aproape toti producatorii declara valoarea pe treapta cea mai mica, unde aparatul e cel mai silentios, deci cifra de pe cutie e cea mai favorabila, nu media.' },
  { question: 'Cat consuma un ventilator?', answer: 'Foarte putin, si asta e principalul lui argument. Modelele din selectie merg de la 5.5 wati la un ventilator de birou pana la 60 de wati la cel mai puternic model de podea. Ca reper, 60 de wati inseamna cat un bec incandescent vechi, iar 19 wati, cat are modelul Heinner cu 9 trepte, inseamna cat un bec LED. La opt ore de functionare zilnica, un ventilator de 60 de wati consuma 0.48 kWh pe zi, adica sub 15 kWh pe luna. Un aparat de aer conditionat consuma atat in cateva zile. De aceea, chiar daca ai aer conditionat, merita sa folosesti si ventilatorul: costul lui e neglijabil, iar efectul combinat iti permite sa setezi aerul conditionat mai sus.' },
  { question: 'Unde il asez in camera?', answer: 'Regula de baza e sa il indrepti spre tine, nu spre mijlocul camerei, pentru ca efectul de racoare exista doar acolo unde aerul atinge pielea. Daca vrei totusi sa schimbi aerul din incapere, exista un truc care functioneaza: asezi ventilatorul in dreptul unei ferestre deschise, orientat spre exterior, seara, cand afara s-a racit. Astfel scoti aerul cald acumulat in casa si tragi aer mai rece prin celelalte ferestre, iar asta chiar scade temperatura, spre deosebire de utilizarea obisnuita. Oscilatia e utila cand sunteti mai multi in camera, pentru ca imparte fluxul, dar daca stai singur intr-un loc fix o poti opri: aerul constant pe o directie racoreste mai bine decat unul intermitent.' },
  { question: 'Ventilatorul e bun pentru alergii sau praf?', answer: 'Aici raspunsul e nuantat si merita stiut inainte. Un ventilator nu filtreaza nimic, doar misca aerul, iar prin asta ridica praful si polenul depuse pe suprafete si le pune in circulatie. Pentru cineva cu alergii sau astm, un ventilator indreptat direct spre fata poate inrautati simptomele, mai ales daca nu ai aspirat de curand. Solutiile sunt simple: pastreaza aparatul curat, sterge paletele periodic, pentru ca praful se depune pe ele si e reimprastiat, si nu il indrepta direct spre fata noaptea. Daca problema principala e calitatea aerului, nu caldura, un purificator cu filtru face ce ventilatorul nu poate.' },
  { question: 'Cat costa un ventilator bun?', answer: 'Selectia acopera de la 49 la 1210 lei si se imparte clar pe tipuri. Modelele de birou si portabile stau intre 49 si 200 de lei, cu Aiyando 4 in 1 la capatul de jos si Freezy Air AeroCool Pro la cel de sus, iar la pretul asta cumperi aer in jurul tau, nu in camera. Ventilatoarele de podea adevarate pornesc de la circa 130 de lei cu Zass ZF 1605 si urca la 360 cu Xiaomi Mi Smart 1C, iar zona cea mai buna ca raport e in jur de 275 de lei, unde Star-Light FTBB-60W ofera cea mai mare putere si cel mai mare diametru din articol. Turnurile costa intre 300 si 529 de lei, iar diferenta fata de un model de podea o platesti pe forma si pe siguranta, nu pe aer mutat.' },
];

const images = [hero, figPodea, figTurn, figBirou, ...PICKS.map(x => x.p.image)];
