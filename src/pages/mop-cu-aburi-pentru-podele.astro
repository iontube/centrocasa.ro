  { g: 'vert', id: 'DL7TCXYBM', badge: 'Cel mai bun raport', short: 'Cecotec HydroSteam', putere: '1500 W', incalzire: 'rapida', cablu: '',
    specs: ['1500 W, incalzire rapida', 'putere mare pentru un pret mic', 'pentru curatarea si igienizarea podelelor', 'nota 4.36 din 55 de pareri'],
    pros: ['Cel mai bun raport pret-putere din grupul vertical', '1500 W, abur consistent', 'Nota buna, 4.36, din multe pareri', 'Cecotec, brand cu preturi bune'],
    cons: ['Mai putine detalii de dotari declarate', 'Fara accesorii multifunctionale'],
