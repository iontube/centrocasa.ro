---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import SimilarArticles from '../components/SimilarArticles.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import emag from '../data/emag-products.json';
import keywordsData from '../../keywords.json';
import { visibleArticles, slugify } from '../lib/articles.mjs';

const relatedArticles = visibleArticles(keywordsData.completed).map(item => ({
  title: item.keyword.charAt(0).toUpperCase() + item.keyword.slice(1),
  slug: item.slug || slugify(item.keyword),
  excerpt: item.excerpt || '',
  image: item.image || `/images/articles/${item.slug || slugify(item.keyword)}.webp`,
  category: item.category,
  categorySlug: item.categorySlug,
  date: item.date || '',
}));

const pool = emag['mop-aburi'] || [];
const byId = Object.fromEntries(pool.map(p => [p.id, p]));

const PICKS = [
  // --- Verticale, pentru podele ---
  { g: 'vert', id: 'DM20YQBBM', badge: 'Cel mai vandut', short: 'Rowenta RY6597', putere: '1200 W', incalzire: '30 s', cablu: '7 m',
    specs: ['1200 W, rezervor 0.6 l', 'gata de folosit in 30 de secunde', 'cablu lung, 7 m', 'de departe cel mai vandut vertical, 158 de pareri'],
    pros: ['De departe cel mai vandut mop vertical din selectie, 158 de pareri', 'Se incalzeste rapid, in 30 de secunde', 'Cablu lung, 7 m, acoperi o camera fara sa schimbi priza', 'Rowenta, brand cunoscut, cu service la noi'],
    cons: ['Clasic, fara accesorii de aparat multifunctional', 'Rezervor mediu, 0.6 l'],
