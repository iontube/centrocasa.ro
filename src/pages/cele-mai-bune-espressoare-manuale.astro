  description="12 espressoare manuale cu portafiltru comparate: cu carafa de lapte sau spumare manuala, de la 152 la 921 de lei. Plus ce inseamna barii de pe cutie."
  image={hero}
  preloadImage={hero}
  preloadSrcset={`${hero.replace('.webp','-960.webp')} 960w, ${hero.replace('.webp','-1280.webp')} 1280w, ${hero} 1920w`}
  preloadSizes="(max-width: 860px) 100vw, 860px"
  type="article"
