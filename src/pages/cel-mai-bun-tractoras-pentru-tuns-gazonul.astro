---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import SimilarArticles from '../components/SimilarArticles.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import emag from '../data/emag-products.json';
import keywordsData from '../../keywords.json';
import { visibleArticles, slugify } from '../lib/articles.mjs';

const relatedArticles = visibleArticles(keywordsData.completed).map(item => ({
  title: item.keyword.charAt(0).toUpperCase() + item.keyword.slice(1),
  slug: item.slug || slugify(item.keyword),
  excerpt: item.excerpt || '',
  image: item.image || `/images/articles/${item.slug || slugify(item.keyword)}.webp`,
  category: item.category,
  categorySlug: item.categorySlug,
  date: item.date || '',
}));

const pool = emag['tractoras-gazon'] || [];
const byId = Object.fromEntries(pool.map(p => [p.id, p]));

const PICKS = [
  // --- Gazon mediu / buget ---
  { g: 'buget', id: 'DCSTBX2BM', badge: 'Cel mai ieftin', short: 'Powermat PM-OTS-6HPM', latime: '66 cm', motor: 'benzina', transm: 'manuala', supraf: 'mediu',
    specs: ['tractoras pe benzina', 'latime de taiere 66 cm', 'cos de colectare 150 l', 'pentru gazon mediu'],
    pros: ['Cel mai mic pret din selectie pentru un tractoras', 'Latime de taiere de 66 cm, buna pentru un gazon mediu', 'Vine cu cos de colectare de 150 l', 'Simplu, fara dotari care sa se strice'],
    cons: ['Brand mai putin cunoscut, service greu de gasit', 'Transmisie manuala, cu trepte'],
    verdict: 'Cel mai accesibil mod de a trece de la masina impinsa la un tractoras pe care stai. Powermat PM-OTS-6HPM are o latime de taiere de 66 cm, potrivita pentru un gazon mediu, si un cos de colectare de 150 l in care aduna iarba. E un model simplu, fara dotari sofisticate care sa se defecteze, exact ce vrei la primul tractoras. In schimb, e un brand mai putin cunoscut la noi, deci gaseste-i din timp piese si service. Transmisia e manuala, cu trepte, deci schimbi viteza cu ambreiaj. Il iei cand vrei sa treci pe un tractoras la cel mai mic pret, pentru un gazon de dimensiune medie.' },
  { g: 'buget', id: 'D71X5HMBM', badge: 'Electric, pentru gazon mic', short: 'Villager VTR 650', latime: '61 cm', motor: 'electric', transm: 'manuala', supraf: '350-1000 mp',
    specs: ['tractoras electric, la retea', 'latime de taiere 61 cm', 'pentru 350-1000 mp', 'fara benzina, fara ulei'],
    pros: ['Electric, fara benzina, ulei sau fum de esapament', 'Villager, brand cunoscut pe piata din RO', 'Silentios fata de un motor pe benzina', 'Are pareri de la cumparatori, rar la tractorase'],
    cons: ['Merge la retea, deci depinzi de un cablu si de o priza aproape', 'Nota de la cumparatori e modesta, in jur de 3 din 5'],
    verdict: 'Alegerea daca ai un gazon mic spre mediu si vrei un tractoras fara batai de cap cu benzina si uleiul. Villager VTR 650 e electric, cu alimentare la retea, deci nu torni combustibil, nu schimbi ulei si nu ai fum de esapament, doar il pornesti si tunzi. Are 61 cm latime si e gandit pentru suprafete de 350 pana la 1000 mp. Villager e un brand cunoscut la noi, cu service accesibil. Fiind la retea, depinzi de un cablu si de o priza in apropiere, ceea ce il limiteaza la gazoane nu foarte mari. Nota de la cumparatori e modesta, in jur de 3 din 5, deci asteptari realiste. Il iei cand vrei un tractoras electric, silentios, pentru un gazon mic.' },
  { g: 'buget', id: 'DF05GB3BM', badge: 'Cel mai dotat mini', short: 'Blackstone Raven', latime: '61 cm', motor: '5.9 CP', transm: '5 viteze', supraf: 'mediu',
    specs: ['mini tractoras, 5.9 CP', 'latime de taiere 61 cm, mulching', 'pornire electrica, 5 viteze', 'faruri LED, inaltime 35-75 mm'],
    pros: ['Bine dotat pentru pretul lui: mulching, faruri LED, pornire electrica', '5 viteze, pornire la cheie, nu la sfoara', 'Functie de mulching, tocare fina a ierbii', 'Compact, bun pentru un gazon mediu'],
    cons: ['Latime de doar 61 cm, tunzi in mai multe treceri pe suprafete mari', 'Brand de buget, verifica service-ul'],
    verdict: 'Un mini tractoras surprinzator de bine dotat pentru pretul lui. Blackstone Raven are motor de 5.9 CP, pornire electrica la cheie, cinci viteze, faruri LED si, important, functie de mulching, care toaca iarba fin si o lasa pe gazon ca ingrasamant, fara sa mai golesti un cos. Latimea de 61 cm e potrivita pentru un gazon mediu; pe suprafete mari o sa faci mai multe treceri. E un brand de buget, deci verifica disponibilitatea pieselor inainte. Pentru cineva care vrea confortul unui tractoras mic, cu pornire usoara si mulching, la un pret rezonabil, e o alegere buna. Il iei cand vrei cele mai multe dotari pe un mini tractoras accesibil.' },
  // --- Gazon mare / raport bun ---
  { g: 'mare', id: 'DNJDKTMBM', badge: 'Cel mai bun raport', short: 'O-Mac TG 13000', latime: '72 cm', motor: '9 CP', transm: '6 trepte', supraf: 'peste 1000 mp',
    specs: ['benzina, 9 CP, 352 cc', 'latime de taiere 72 cm', 'cos colector 170 l, 6 trepte', 'pentru suprafete peste 1000 mp'],
    pros: ['Are pareri bune de la cumparatori, cu nota mare', 'Latime de 72 cm si 9 CP, pentru gazoane peste 1000 mp', 'Cos colector generos, de 170 l', 'Raport bun putere-pret'],
    cons: ['Brand mai putin cunoscut international', 'Transmisie manuala cu 6 trepte, nu hidrostatica'],
    verdict: 'Alegerea echilibrata pentru un gazon mare, la un pret care ramane rezonabil. O-Mac TG 13000 are motor pe benzina de 9 CP, 72 cm latime de taiere si un cos colector de 170 l, deci acopera repede suprafete de peste 1000 mp. E unul dintre putinele tractorase din selectie cu pareri de la cumparatori, iar nota e mare, un semn bun intr-o categorie unde recenziile lipsesc. Are sase trepte de viteza, transmisie manuala cu ambreiaj, nu hidrostatica, deci schimbi vitezele. Brandul nu e la fel de cunoscut ca Husqvarna sau Stiga, dar raportul putere-pret e bun. Il iei cand vrei cel mai bun echilibru intre putere, latime si pret, pentru un gazon mare.' },
  { g: 'mare', id: 'DCJPC5MBM', badge: 'Cu transmisie automata', short: 'Stiga Combi 166', latime: '66 cm', motor: '7.5 CP', transm: 'automata', supraf: 'mare',
    specs: ['Stiga, 7.5 CP', 'latime de taiere 66 cm', 'cutie automata (fara ambreiaj)', 'combi: colectare si mulching'],
    pros: ['Cutie automata, conduci fara ambreiaj si schimbat trepte', 'Stiga, unul dintre cele mai serioase branduri de gazon', 'Combi: colecteaza sau face mulching', 'Mai comod de manevrat printre obstacole'],
    cons: ['Latime de 66 cm, nu cea mai mare', 'Mai scump decat modelele buget de aceeasi latime'],
    verdict: 'Alegerea daca vrei confort la condus, fara sa te chinui cu ambreiajul si treptele. Stiga Combi 166 are o cutie automata, adica accelerezi si franezi ca la o masina cu transmisie automata, foarte comod cand ai multe obstacole de ocolit, pomi, straturi de flori, alei. Stiga e unul dintre cele mai serioase branduri de echipamente de gazon, cu piese si service usor de gasit. E un model combi, deci fie colecteaza iarba in cos, fie o toaca prin mulching. Latimea de 66 cm il tine potrivit pentru un gazon mediu spre mare, iar pretul e peste modelele buget, justificat de cutia automata si de brand. Il iei cand vrei manevrare usoara si un brand de incredere.' },
  { g: 'mare', id: 'D2598WMBM', badge: 'Mai mult motor', short: 'Alpina AT2 72', latime: '72 cm', motor: '11.5 CP', transm: '5 viteze', supraf: 'mare',
    specs: ['Alpina, 11.5 CP', 'latime de taiere 72 cm', 'inaltime reglabila 30-80 mm', '5 viteze'],
    pros: ['Motor mai puternic, 11.5 CP, pentru iarba deasa', 'Alpina, brand serios, parte din grupul Stiga', 'Latime de 72 cm, acopera repede gazonul', 'Reglaj bun al inaltimii, 30-80 mm'],
    cons: ['Fara pareri inca, categorie de nisa', 'Transmisie manuala cu 5 viteze'],
    verdict: 'Alegerea cand ai un gazon mare si iarba care creste repede sau deasa, unde conteaza motorul. Alpina AT2 72 are 11.5 CP, printre cele mai puternice din selectia accesibila, si o latime de 72 cm, deci trece prin iarba inalta fara sa se inece si acopera repede suprafata. Alpina face parte din grupul Stiga, deci beneficiezi de un brand serios, cu piese la indemana. Inaltimea de taiere se regleaza intre 30 si 80 mm, cat sa potrivesti gazonul dupa sezon. Nu are inca pareri, normal la un tractoras de nisa. Are transmisie manuala cu cinci viteze. Il iei cand vrei mai mult motor pentru un gazon mare cu iarba viguroasa, de la un brand de incredere.' },
  // --- Gazon foarte mare / premium ---
  { g: 'premium', id: 'DHT6JTYBM', badge: 'Premium, pentru gazon foarte mare', short: 'Husqvarna TC 138', latime: '102 cm', motor: 'benzina', transm: 'hidrostatica', supraf: 'foarte mare',
    specs: ['Husqvarna, benzina', 'latime de taiere 102 cm', 'transmisie hidrostatica', 'pentru gazoane foarte mari'],
    pros: ['Latime de 102 cm, acopera cel mai repede suprafete mari', 'Transmisie hidrostatica, cea mai comoda, ca o cutie automata', 'Husqvarna, referinta in echipamente de gazon', 'Construit pentru folosire intensa, pe suprafete mari'],
    cons: ['Cea mai scumpa din selectie, peste 23000 de lei', 'Prea mult pentru un gazon mic sau mediu'],
    verdict: 'In varful gamei, pentru cine are un gazon foarte mare si vrea sa termine repede si comod. Husqvarna TC 138 are o latime de taiere de 102 cm, deci acopera suprafata in cele mai putine treceri, si o transmisie hidrostatica, cea mai comoda dintre toate: controlezi viteza continuu, dintr-o pedala, fara ambreiaj si fara trepte, ca la o masina automata. Husqvarna e o referinta in echipamente de gazon, construite pentru folosire intensa si de durata, cu retea de service solida. E cea mai scumpa din selectie, peste 23000 de lei, si ar fi prea mult pentru un gazon mic. Il iei cand ai o suprafata mare de intretinut des si vrei un tractoras serios, comod si durabil.' },
].map(x => ({ ...x, p: byId[x.id] })).filter(x => x.p);

const BUGET = PICKS.filter(x => x.g === 'buget');
const MARE = PICKS.filter(x => x.g === 'mare');
const PREMIUM = PICKS.filter(x => x.g === 'premium');

const site = 'https://centrocasa.ro';
const hero = '/images/articles/cel-mai-bun-tractoras-pentru-tuns-gazonul.webp';
const figBuget = '/imagini/articole/tractoras-buget.webp';
const figMare = '/imagini/articole/tractoras-mare.webp';
const figPremium = '/imagini/articole/tractoras-premium.webp';
const published = '2026-07-18T10:31:16+03:00';

const faq = [
  { question: 'Ce marime de tractoras imi trebuie pentru gazonul meu?', answer: 'Alege dupa suprafata gazonului si dupa latimea de taiere. Pentru un gazon de pana la circa 2000 mp, un tractoras compact, cu latime de 60-72 cm si o transmisie usoara, e suficient. Pentru suprafete mari, peste 5000 mp, cauta o latime de taiere de peste 100 cm si o transmisie hidrostatica, ca sa termini in cat mai putine treceri. Latimea de taiere influenteaza direct cat de repede tunzi, deci pe un gazon mare merita o latime cat mai mare.' },
  { question: 'Transmisie manuala, automata sau hidrostatica?', answer: 'Transmisia manuala are trepte si ambreiaj, ca la o masina cu cutie manuala: e cea mai ieftina, dar mai obositoare cand ai multe obstacole de ocolit. Cutia automata iti permite sa accelerezi si sa franezi fara sa schimbi trepte. Transmisia hidrostatica e cea mai comoda: controlezi viteza continuu, dintr-o pedala, fara ambreiaj, e durabila si cere mai putina intretinere, dar costa mai mult. Pentru o curte cu multe obstacole sau un gazon mare, hidrostatica merita banii in plus.' },
  { question: 'Ce fac cu iarba taiata: cos, mulching sau evacuare laterala?', answer: 'Sunt trei optiuni. Cosul de colectare aduna iarba si e ideal pentru un gazon ingrijit, dar trebuie golit des, cam la 15-20 de minute la cosurile de 240-320 l. Mulchingul toaca iarba foarte fin si o lasa pe gazon ca ingrasamant natural, cea mai buna alegere pentru o intretinere regulata, saptamanala. Evacuarea laterala arunca iarba in lateral si e utila la iarba inalta, cand cosul s-ar infunda repede. Multe tractorase, numite combi, fac colectare si mulching, la alegere.' },
  { question: 'De ce au tractorasele atat de putine pareri online?', answer: 'Pentru ca sunt o cumparatura scumpa si de nisa, pe care putini oameni o fac, si mai rar online. De aceea, la tractorase, aproape niciun model nu are pareri, iar cand exista, sunt cateva. Cand alegi, uita-te la suprafata pentru care e recomandat, la latimea de taiere, la putere, la transmisie si la brand, nu la numarul de note, pentru ca acestea spun cel mai mult despre ce primesti. Un brand cunoscut, ca Husqvarna, Stiga sau Alpina, e un reper de incredere in lipsa parerilor.' },
  { question: 'Cat de mult conteaza puterea motorului, in CP?', answer: 'Puterea, masurata in cai putere, conteaza mai ales daca ai iarba deasa, viguroasa, sau un teren cu denivelari si pante. Un motor mai puternic, de 11-17 CP, trece prin iarba inalta fara sa se inece si urca mai usor pantele. Pentru un gazon plat, intretinut regulat, un motor de 6-9 CP e suficient. Nu lua putere multa doar de dragul cifrei: un motor mare consuma mai mult si e mai scump; potriveste-l cu marimea si starea gazonului tau.' },
  { question: 'Cat de des fac intretinere la un tractoras?', answer: 'Verifica nivelul de ulei si curata filtrul de aer regulat, iar schimbul de ulei si de filtre se face de obicei la circa 50 de ore de functionare sau macar o data pe an, la inceputul sezonului. Lamele trebuie verificate si ascutite periodic, ca sa taie curat, nu sa rupa iarba. Curata puntea de taiere de resturile de iarba dupa fiecare tuns. Iarna, depoziteaza tractorasul intr-un loc uscat si ferit. O intretinere corecta ii prelungeste mult viata.' },
  { question: 'Un tractoras electric e o alternativa buna?', answer: 'Da, pentru un gazon mic spre mediu. Un tractoras electric, cum e Villager VTR 650, nu are nevoie de benzina si ulei, e mai silentios si nu scoate fum de esapament, deci porneste imediat si e mai comod de intretinut. Dezavantajul modelelor la retea e ca depinzi de un cablu si de o priza in apropiere, ceea ce il limiteaza la suprafete nu foarte mari. Pentru un gazon mare, un model pe benzina ramane alegerea practica, prin autonomie si putere.' },
];

const images = [hero, figBuget, figMare, figPremium, ...PICKS.map(x => x.p.image)];
const b64 = (s) => Buffer.from(s).toString('base64');
---

<Layout
  title="Cel mai bun tractoras pentru tuns gazonul in 2026: pe suprafata gazonului"
  description="Ce tractoras de tuns gazonul sa iei in 2026, ales pe suprafata gazonului: modele de buget, pentru gazon mare si premium cu transmisie hidrostatica, de la Villager, Stiga, Alpina si Husqvarna. Plus latime de taiere, transmisie si mulching vs cos."
  image={hero}
  type="article"
  publishedTime={published}
  modifiedTime={published}
  author="Redactia CentroCasa"
  breadcrumb={[{ name: 'Acasa', url: '/' }, { name: 'Gradinarit si Unelte', url: '/gradinarit-unelte/' }, { name: 'Cel mai bun tractoras pentru tuns gazonul' }]}
  faq={faq.map(f => ({ question: f.question, answer: f.answer }))}
>
  <article class="rd">
    <nav class="breadcrumb">
      <a href="/">Acasa</a><span class="breadcrumb-separator">/</span>
      <a href="/gradinarit-unelte/">Gradinarit si Unelte</a><span class="breadcrumb-separator">/</span>
      <span>Cel mai bun tractoras pentru tuns gazonul</span>
    </nav>

    <h1>Cel mai bun tractoras pentru tuns gazonul in 2026</h1>
    <p class="rd-byline">de <a href="/despre/">Redactia CentroCasa</a> · actualizat iulie 2026</p>

    <img class="rd-hero" src={hero} alt="Cel mai bun tractoras pentru tuns gazonul, pe gazon" width="1200" height="675" fetchpriority="high" />

    <div class="rd-intro">
      <p>Pentru un gazon mare, cel mai bun echilibru il da <strong>O-Mac TG 13000</strong>: 72 cm latime, 9 CP si, rar la tractorase, pareri bune. Daca vrei confort maxim pe o suprafata foarte mare, <strong>Husqvarna TC 138</strong> are 102 cm si transmisie hidrostatica. Pentru un gazon mediu la pret mic, <strong>Powermat PM-OTS-6HPM</strong> porneste selectia, iar daca vrei un tractoras fara benzina, <strong>Villager VTR 650</strong> merge electric.</p>
      <p>La un tractoras, totul pleaca de la <strong>suprafata gazonului</strong>: ea decide ce latime de taiere si ce putere iti trebuie. Apoi conteaza <strong>transmisia</strong>, cat de comod conduci, si <strong>ce faci cu iarba</strong>, o aduni in cos sau o toci prin mulching. Un lucru de stiut: tractorasele sunt o cumparatura scumpa, de nisa, deci aproape niciun model nu are pareri online, asa ca ne-am uitat mai ales la suprafata, latime, motor si brand.</p>
      <p>Am pornit de la tractorasele vandute pe eMAG, le-am verificat suprafata recomandata, latimea de taiere, motorul si transmisia, si le-am grupat pe buget (gazon mediu), gazon mare si premium. Pentru gazon mai mic, vezi si <a href="/cele-mai-bune-masini-de-tuns-iarba/">masinile de tuns iarba</a> si <a href="/cel-mai-bun-robot-de-tuns-iarba/">robotii de tuns iarba</a>.</p>
    </div>

    <details class="rd-toc">
      <summary>Cuprins</summary>
      <ol>
        <li><a href="#suprafata">De ce marime ai nevoie</a></li>
        <li><a href="#transmisie">Transmisie: manuala, automata sau hidrostatica</a></li>
        <li><a href="#iarba">Ce faci cu iarba: cos, mulching sau evacuare</a></li>
        <li><a href="#tabel">Comparatie rapida</a></li>
        <li><a href="#buget">Tractorase de buget (gazon mediu)</a></li>
        <li><a href="#mare">Tractorase pentru gazon mare</a></li>
        <li><a href="#premium">Premium, pentru gazon foarte mare</a></li>
        <li><a href="#motor">Motor si intretinere</a></li>
        <li><a href="#cat-costa">Cat costa un tractoras</a></li>
        <li><a href="#faq">Intrebari frecvente</a></li>
      </ol>
    </details>

    <h2 id="suprafata">De ce marime ai nevoie</h2>
    <p>Prima si cea mai importanta decizie e sa potrivesti tractorasul cu suprafata gazonului. Latimea de taiere influenteaza direct cat de repede termini:</p>
    <div class="table-wrap">
      <table class="rd-table">
        <thead><tr><th>Suprafata gazon</th><th>Latime de taiere</th><th>Putere motor</th><th>Transmisie</th></tr></thead>
        <tbody>
          <tr><td>Pana in ~2000 mp</td><td>60 - 72 cm</td><td>5 - 9 CP</td><td>Manuala sau automata</td></tr>
          <tr><td>~2000 - 5000 mp</td><td>72 - 92 cm</td><td>9 - 14 CP</td><td>Automata sau hidrostatica</td></tr>
          <tr><td>Peste 5000 mp</td><td>peste 100 cm</td><td>14 CP si peste</td><td>Hidrostatica</td></tr>
        </tbody>
      </table>
    </div>
    <p>Ce trebuie sa retii: pe o suprafata mare, o latime de taiere cat mai mare inseamna mai putine treceri si un timp de lucru mult mai scurt. Dar nu lua un tractoras urias pentru un gazon mic, unde nici nu ai loc sa il manevrezi si platesti degeaba pentru putere si latime pe care nu le folosesti.</p>

    <h2 id="transmisie">Transmisie: manuala, automata sau hidrostatica</h2>
    <p>Modul in care controlezi viteza schimba mult confortul, mai ales pe un teren cu obstacole:</p>
    <ul>
      <li><strong>Manuala (cu trepte):</strong> ai un ambreiaj si schimbi vitezele, ca la o masina cu cutie manuala. E cea mai ieftina, dar mai obositoare cand ocolesti des pomi, straturi sau alei.</li>
      <li><strong>Automata:</strong> accelerezi si franezi fara sa schimbi trepte. Mai comoda, buna pentru curti cu multe obstacole.</li>
      <li><strong>Hidrostatica:</strong> controlezi viteza continuu, dintr-o pedala, fara ambreiaj. Cea mai comoda, durabila si cu intretinere redusa, dar si cea mai scumpa.</li>
    </ul>
    <p>Pentru un gazon mic si plat, manuala e suficienta. Pentru un gazon mare sau o curte cu multe obstacole, hidrostatica isi merita banii in plus.</p>

    <h2 id="iarba">Ce faci cu iarba: cos, mulching sau evacuare</h2>
    <p>Tractorasele scapa de iarba taiata in trei feluri, iar unele, numite combi, le combina:</p>
    <ul>
      <li><strong>Cos de colectare:</strong> aduna iarba, pentru un gazon ingrijit. Trebuie golit des, cam la 15-20 de minute la cosurile mari de 240-320 l.</li>
      <li><strong>Mulching:</strong> toaca iarba foarte fin si o lasa pe gazon ca ingrasamant natural. Cea mai buna alegere pentru o intretinere regulata, saptamanala.</li>
      <li><strong>Evacuare laterala:</strong> arunca iarba in lateral. Utila la iarba inalta, cand cosul s-ar infunda repede.</li>
    </ul>
    <p>Daca tunzi des si nu vrei sa golesti un cos, alege un model cu mulching. Daca vrei un gazon curat, cu iarba stransa, mergi pe cos.</p>

    <h2 id="tabel">Comparatie rapida</h2>
    <div class="table-wrap">
      <table class="rd-table">
        <thead><tr><th>Model</th><th>Latime</th><th>Motor</th><th>Transmisie</th></tr></thead>
        <tbody>
          {PICKS.map(x => (<tr><td>{x.short}</td><td>{x.latime}</td><td>{x.motor}</td><td>{x.transm}</td></tr>))}
        </tbody>
      </table>
    </div>

    <h2 id="buget">Tractorase de buget, pentru gazon mediu</h2>
    <p>Cea mai accesibila cale de a trece de la masina impinsa la un tractoras pe care stai. Latimi de 61-66 cm, potrivite pentru un gazon mediu, inclusiv o varianta electrica.</p>
    <div class="rd-grid">
      {BUGET.map(x => (
        <ProductCard name={x.p.name.replace(/’/g, "'")} image={x.p.image} price={x.p.price} rating={x.p.rating} reviews={x.p.reviews} badge={x.badge} specs={x.specs} pros={x.pros} cons={x.cons} verdict={x.verdict} outKey={'p-' + x.id} />
      ))}
    </div>

    <img class="rd-fig" src={figBuget} alt="Tractorase de buget pentru gazon mediu: Powermat, Villager si Blackstone" width="1200" height="675" loading="lazy" />

    <h2 id="mare">Tractorase pentru gazon mare</h2>
    <p>Mai mult motor, latime mai mare si transmisii mai comode, pentru suprafete de peste 1000 mp. Aici intra si branduri serioase, ca Stiga si Alpina.</p>
    <div class="rd-grid">
      {MARE.map(x => (
        <ProductCard name={x.p.name.replace(/’/g, "'")} image={x.p.image} price={x.p.price} rating={x.p.rating} reviews={x.p.reviews} badge={x.badge} specs={x.specs} pros={x.pros} cons={x.cons} verdict={x.verdict} outKey={'p-' + x.id} />
      ))}
    </div>

    <img class="rd-fig" src={figMare} alt="Tractorase pentru gazon mare: O-Mac, Stiga si Alpina" width="1200" height="675" loading="lazy" />

    <h2 id="premium">Premium, pentru gazon foarte mare</h2>
    <p>Cand ai o suprafata mare de intretinut des si vrei sa termini repede si comod: latime peste 100 cm si transmisie hidrostatica, de la un brand de referinta.</p>
    <div class="rd-grid">
      {PREMIUM.map(x => (
