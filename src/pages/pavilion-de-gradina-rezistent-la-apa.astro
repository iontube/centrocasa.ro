---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import SimilarArticles from '../components/SimilarArticles.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import emag from '../data/emag-products.json';
import keywordsData from '../../keywords.json';
import { visibleArticles, slugify } from '../lib/articles.mjs';

const relatedArticles = visibleArticles(keywordsData.completed).map(item => ({
  title: item.keyword.charAt(0).toUpperCase() + item.keyword.slice(1),
  slug: item.slug || slugify(item.keyword),
  excerpt: item.excerpt || '',
  image: item.image || `/images/articles/${item.slug || slugify(item.keyword)}.webp`,
  category: item.category,
  categorySlug: item.categorySlug,
  date: item.date || '',
}));

const pool = emag['pavilion-gradina'] || [];
const byId = Object.fromEntries(pool.map(p => [p.id, p]));

const PICKS = [
  // --- Impermeabile 3x3 ---
  { g: 'imperm', id: 'D6LW5KMBM', badge: 'Impermeabil, bine notat', short: 'Danubewd', dim: '3 x 3 m', pereti: 'Fara', material: 'PVC',
    specs: ['pavilion impermeabil 3x3 m', 'prelata din PVC, rezistenta la ploaie', 'acoperis usor, 4.2 kg', 'nota 4.53 din 17 pareri'],
    pros: ['Prelata din PVC, cu adevarat impermeabila', 'Nota buna, 4.53, din 17 pareri, bine testat', 'Acoperis usor, 4.2 kg, se manevreaza simplu', 'Dimensiune standard 3x3, acopera o masa mare'],
    cons: ['Fara pereti laterali, expus pe lateral la vant', 'Brand mai putin cunoscut'],
    verdict: 'Cel mai bine testat pavilion impermeabil din selectie si o alegere sigura daca pui pret pe rezistenta la ploaie. Danubewd are 3x3 m si o prelata din PVC cu adevarat impermeabila, care tine apa afara la o ploaie de vara, nu doar o stropeste, si un acoperis usor de doar 4.2 kg, deci il montezi si il muti fara efort. Cu 17 pareri si nota 4.53 e unul dintre cele mai apreciate din selectie, un semn bun ca prelata isi face treaba. Dimensiunea standard de 3x3 acopera o masa mare cu scaune, potrivit pentru terasa sau curte. Nu are pereti laterali, deci pe vant sau ploaie oblica esti expus pe margini, dar la o vreme obisnuita protejeaza bine. Il iei cand vrei un pavilion clar impermeabil, usor si bine cotat, pentru umbra si adapost la o ploaie trecatoare, si nu ai nevoie de pereti.' },
  { g: 'imperm', id: 'DDDYTN2BM', badge: 'Cel mai bine notat', short: 'PEXOR Forte', dim: '3 x 3 m', pereti: 'Fara', material: 'Metal + poliester',
    specs: ['pavilion impermeabil PEXOR Forte 3x3', 'cadru metalic pliabil, montaj rapid', 'poliester tratat impermeabil', 'nota 4.86, cea mai mare din selectie'],
    pros: ['Cea mai mare nota din selectie, 4.86', 'Cadru metalic pliabil, se ridica rapid', 'Poliester tratat impermeabil', 'Structura solida, rezistenta'],
    cons: ['Inca 7 pareri deocamdata', 'Fara pereti laterali inclusi'],
    verdict: 'Cel mai bine notat pavilion din selectie si alegerea daca vrei calitate si impermeabilitate intr-un pachet solid. PEXOR Forte are 3x3 m, un cadru metalic pliabil care se ridica rapid, tip pop-up, si o prelata din poliester tratat impermeabil, care face fata ploii. Cu nota 4.86, cea mai mare din tot articolul, chiar daca deocamdata din 7 pareri, primii cumparatori sunt foarte multumiti de rezistenta si de montajul simplu. Structura solida il recomanda pentru folosire repetata, la evenimente in curte sau ca umbrar de vara. Nu vine cu pereti laterali, deci pentru protectie completa pe vant adaugi separat, dar acoperisul isi face treaba. Il iei cand vrei cel mai bine cotat pavilion din selectie, cu cadru metalic pliabil si prelata impermeabila, pentru montaj rapid si adapost de calitate.' },
  { g: 'imperm', id: 'DM56L8MBM', badge: 'Cel mai vandut', short: 'AT Performance', dim: '3 x 3 m', pereti: 'Fara', material: 'Poliester',
    specs: ['cel mai vandut din selectie, 38 pareri', 'prelata impermeabila, pliabil', '3x3 m, verde, cadru metalic', 'cel mai accesibil pret'],
    pros: ['Cel mai vandut din selectie, 38 de pareri', 'Prelata impermeabila si cadru pliabil', 'Cel mai accesibil pret din selectie', 'Montaj rapid, tip pop-up'],
    cons: ['Nota 3.74, medie, verifica recenziile', 'Fara pereti laterali'],
    verdict: 'Cel mai vandut pavilion din selectie si cea mai accesibila cale de a avea umbra si adapost in curte. AT Performance are 3x3 m, o prelata impermeabila si un cadru metalic pliabil care se ridica rapid, la cel mai mic pret din selectie, ceea ce explica de ce s-a vandut cel mai mult, cu 38 de pareri, cele mai multe de aici. E o alegere practica pentru cine vrea un pavilion functional fara sa dea multi bani, pentru mese in gradina, umbra la piscina sau un eveniment ocazional. Nota de 3.74 e medie, asa ca merita sa citesti recenziile inainte, iar la acest pret te astepti la o constructie de baza, nu premium, si nu are pereti laterali. Il iei cand vrei cel mai ieftin pavilion popular, impermeabil si pliabil, pentru folosire ocazionala, si accepti o constructie simpla in schimbul pretului mic.' },
  // --- Pliabile accesibile ---
  { g: 'pliabil', id: 'DN4TR6MBM', badge: 'Pliabil, bine vandut', short: 'JRH alb', dim: '3 x 3 m', pereti: 'Fara', material: 'Poliester',
    specs: ['pavilion pliabil 3x3 m, alb', 'cadru metalic, montaj rapid', 'poliester, pentru curte si evenimente', 'nota 3.8 din 30 de pareri'],
    pros: ['Bine vandut, 30 de pareri', 'Cadru metalic pliabil, se ridica repede', 'Culoare alba, eleganta la evenimente', '3x3 m, acopera o masa mare'],
    cons: ['Nota 3.8, medie', 'Prelata mai putin robusta la vant puternic'],
    verdict: 'Un pavilion pliabil alb, potrivit pentru evenimente in curte si bine vandut. JRH are 3x3 m si un cadru metalic pliabil care se ridica rapid, tip pop-up, plus o prelata din poliester in nuanta alba, care arata elegant la o petrecere sau o masa festiva in gradina. Cu 30 de pareri e printre cele mai testate din selectie, iar nota de 3.8 e medie, deci merita sa te uiti la recenzii inainte de a comanda. Albul se murdareste mai usor decat culorile inchise, dar da un aspect mai ingrijit la evenimente. Prelata face fata unei vremi obisnuite, dar la vant puternic e bine sa il ancorezi bine. Il iei cand vrei un pavilion pliabil alb pentru evenimente si mese in curte, cu montaj rapid si un pret rezonabil, si nu te deranjeaza o nota medie.' },
  { g: 'pliabil', id: 'D182ZM2BM', badge: 'Nota mare, accesibil', short: 'OEM pliabil', dim: '3 x 3 m', pereti: 'Fara', material: 'Poliester',
    specs: ['pavilion pliabil 3x3 m', 'structura metalica, pentru exterior', 'poliester, cort de evenimente', 'nota 4.83 din 6 pareri'],
    pros: ['Nota mare, 4.83, cea mai buna dintre pliabile', 'Structura metalica pliabila, montaj rapid', 'Pret accesibil', 'Bun pentru evenimente si curte'],
    cons: ['Doar 6 pareri deocamdata', 'Fara pereti laterali'],
    verdict: 'Pavilionul pliabil de ales daca vrei o nota mare la un pret accesibil. Acest OEM are 3x3 m si o structura metalica pliabila, tip pop-up, care se ridica rapid, plus o prelata din poliester pentru exterior, potrivita pentru evenimente, mese in gradina sau umbra la piscina. Cu nota 4.83 e cel mai bine cotat dintre pavilioanele pliabile din selectie, chiar daca deocamdata din 6 pareri, deci primii cumparatori sunt multumiti. Pretul accesibil il face o alternativa buna la modelele mai cunoscute, pentru cine cauta raport bun calitate-pret. Nu are pereti laterali, deci pentru protectie pe margini adaugi separat. Il iei cand vrei un pavilion pliabil bine notat si ieftin, cu montaj rapid, pentru folosire in curte si la evenimente, si nu te deranjeaza ca are inca putine pareri.' },
  { g: 'pliabil', id: 'DQP7KSBBM', badge: 'Design Flippy', short: 'Flippy', dim: '3 x 3 m', pereti: 'Fara', material: 'Poliester',
    specs: ['pavilion Flippy 300 x 300 cm, alb', 'poliester, pentru gradina', 'cadru pliabil, montaj rapid', 'nota 3.5 din 6 pareri'],
    pros: ['Dimensiune buna, 300 x 300 cm', 'Cadru pliabil, se ridica repede', 'Culoare alba, potrivita la evenimente', 'Brand cu prezenta la noi'],
    cons: ['Nota 3.5, medie, din 6 pareri', 'Mai scump decat alte pliabile de baza'],
    verdict: 'O alternativa pliabila de la un brand cu prezenta la noi, pentru cine vrea un pavilion alb de gradina. Flippy are 300 x 300 cm si un cadru pliabil tip pop-up, cu o prelata din poliester in nuanta alba, potrivit pentru mese in curte, evenimente sau umbra pe terasa. Cu 6 pareri si nota 3.5 e o alegere medie, asa ca te uiti la recenzii inainte, iar pretul e ceva mai ridicat decat al pavilioanelor pliabile de baza din selectie. Albul arata bine la evenimente, dar cere mai multa grija la curatare. E un pavilion functional, fara pretentii premium, de la un nume cunoscut pe piata locala. Il iei cand vrei un pavilion pliabil alb de la Flippy, pentru curte si evenimente, si preferi un brand cu prezenta la noi, acceptand o nota medie si un pret ceva mai mare.' },
  // --- Cu pereti laterali ---
  { g: 'pereti', id: 'D1QQN8MBM', badge: 'Cu pereti si ferestre', short: 'Hessa', dim: '3 x 3 m', pereti: 'Da, cu ferestre', material: 'Poliester',
    specs: ['pavilion 3x3 m cu pereti laterali', 'pereti cu ferestre, pentru petreceri', 'inchizi complet spatiul', 'nota 3.07, marcata onest'],
    pros: ['Vine cu pereti laterali si ferestre', 'Inchizi complet spatiul, protectie pe toate partile', 'Ferestrele lasa lumina si aer', 'Pret accesibil pentru un model cu pereti'],
    cons: ['Nota 3.07 din 14 pareri, verifica atent recenziile', 'Peretii cer montaj si prindere in plus'],
    verdict: 'Pavilionul de ales daca vrei sa inchizi complet spatiul, cu pereti pe toate partile. Hessa are 3x3 m si vine cu pereti laterali cu ferestre, deci il transformi dintr-un simplu umbrar intr-un spatiu inchis, protejat de vant, soare piezis si ploaie oblica, potrivit pentru petreceri sau pentru zile cu vreme schimbatoare. Ferestrele lasa lumina si aer sa intre, ca sa nu para o cutie. Pretul e accesibil pentru un model cu pereti inclusi. Trebuie spus insa clar: cu nota 3.07 din 14 pareri, e printre cele mai slab cotate din selectie, asa ca citeste atent recenziile inainte de a comanda, iar peretii cer montaj si prindere in plus. Il iei cand ai nevoie de un spatiu inchis complet, cu pereti si ferestre, la un pret mic, si esti dispus sa verifici bine recenziile, constient de nota modesta.' },
  { g: 'pereti', id: 'DY630JMBM', badge: 'Structura de otel', short: 'Sersimo 3 pereti', dim: '3 x 3 m', pereti: 'Da, 3 pereti', material: 'Otel + prelata',
    specs: ['pavilion cu 3 pereti laterali', 'structura solida din otel', 'acoperis rezistent', 'nota 3.5 din 8 pareri'],
    pros: ['Structura solida din otel, mai robusta', 'Vine cu 3 pereti laterali', 'Mai rezistent la vant decat cadrele subtiri', 'Acopera si protejeaza bine'],
    cons: ['Nota 3.5, medie, din 8 pareri', 'Mai greu si mai scump'],
    verdict: 'Pavilionul de ales daca vrei o structura mai robusta, cu pereti si cadru de otel. Sersimo are 3x3 m, o structura solida din otel, mai rezistenta decat cadrele subtiri ale pavilioanelor pliabile ieftine, si vine cu 3 pereti laterali, care inchid spatiul si il apara de vant si de soarele piezis. E gandit pentru cine vrea ceva mai durabil, care sa stea montat mai mult timp in curte, nu doar ocazional. Cu 8 pareri si nota 3.5 e o alegere medie, asa ca merita sa citesti recenziile, iar structura robusta il face mai greu si mai scump decat pavilioanele pliabile. Il iei cand vrei un pavilion cu pereti si o structura solida din otel, mai rezistent la vant, pentru folosire mai indelungata in gradina, si accepti greutatea si pretul mai mari in schimbul robustetei.' },
  { g: 'pereti', id: 'DQWGRWMBM', badge: 'Quick tent cu pereti', short: 'PROCART quick', dim: '3 x 3 x 3 m', pereti: 'Da, 3 pereti', material: 'Poliester',
    specs: ['cort quick tent cu 3 pereti laterali', '3x3x3 m, inaltime generoasa', 'montaj rapid, tip pop-up', 'nota 3.5 din 8 pareri'],
    pros: ['Sistem quick tent, se ridica foarte rapid', 'Vine cu 3 pereti laterali', 'Inaltime generoasa, 3 m', 'Combina montajul rapid cu peretii'],
    cons: ['Nota 3.5, medie, din 8 pareri', 'Printre cele mai scumpe din selectie'],
    verdict: 'Pavilionul de ales daca vrei si pereti, si montaj foarte rapid. PROCART quick tent are 3x3x3 m, cu o inaltime generoasa de 3 m, si un sistem pliabil de tip quick tent, care se ridica foarte repede, dintr-o miscare, plus 3 pereti laterali care inchid spatiul. E combinatia buna intre pavilioanele pliabile simple, care nu au pereti, si cele cu structura fixa, greu de montat: aici primesti si peretii, si rapiditatea. Cu 8 pareri si nota 3.5 e o alegere medie, deci citeste recenziile inainte, iar pretul il pune printre cele mai scumpe din selectie. Il iei cand vrei un pavilion cu pereti laterali care se monteaza foarte rapid, cu inaltime buna, pentru evenimente sau folosire in curte, si esti dispus la un pret mai mare pentru comoditatea sistemului quick tent.' },
].map(x => ({ ...x, p: byId[x.id] })).filter(x => x.p);

const IMPERM = PICKS.filter(x => x.g === 'imperm');
const PLIABIL = PICKS.filter(x => x.g === 'pliabil');
const PERETI = PICKS.filter(x => x.g === 'pereti');

const hero = '/images/articles/pavilion-de-gradina-rezistent-la-apa.webp';
const figImperm = '/imagini/articole/pavilion-impermeabile.webp';
const figPliabil = '/imagini/articole/pavilion-pliabile.webp';
const figPereti = '/imagini/articole/pavilion-pereti.webp';
const published = '2026-07-19T12:58:55+03:00';

const faq = [
  { question: 'Ce inseamna un pavilion cu adevarat impermeabil?', answer: 'Inseamna ca prelata acoperisului tine apa afara, nu doar o respinge o vreme. Materialele si tratamentele conteaza: o prelata din PVC sau din poliester tratat impermeabil, ca la Danubewd sau PEXOR din selectie, face fata unei ploi de vara, in timp ce o panza subtire, netratata, lasa apa sa treaca dupa un timp. Cauta in descriere mentiunea clara impermeabil si, daca e trecuta, densitatea materialului: cu cat e mai mare, cu atat prelata e mai groasa si mai rezistenta. Tine minte insa ca un pavilion fara pereti te apara de ploaie doar de sus; la ploaie oblica sau pe vant, apa poate intra pe laterale.' },
  { question: 'Pavilion pliabil sau cu structura fixa?', answer: 'Pavilionul pliabil, tip pop-up, se ridica in cateva minute, se strange la loc si se muta usor, ideal pentru evenimente ocazionale, mese in curte sau umbra la piscina, cand nu vrei ceva permanent. Structura e mai usoara, deci si mai sensibila la vant. Un pavilion cu structura mai solida, din otel, ca Sersimo din selectie, e mai greu si mai stabil, gandit sa stea montat mai mult timp, dar il montezi mai greu. Daca vrei ceva flexibil, pe care sa il pui si sa il strangi des, alege pliabilul; daca vrei un adapost care sa stea toata vara in curte, o structura mai robusta rezista mai bine.' },
  { question: 'Am nevoie de pereti laterali?', answer: 'Depinde de cum il folosesti. Un pavilion fara pereti iti da umbra si adapost de ploaie de sus, suficient pentru o masa la umbra intr-o zi obisnuita. Peretii laterali, ca la Hessa sau PROCART din selectie, inchid spatiul si te apara de vant, de soarele piezis de dimineata si seara si de ploaia oblica, si transforma pavilionul intr-un spatiu aproape de camera, potrivit pentru petreceri sau vreme schimbatoare. Multe modele cu pereti au si ferestre, ca sa intre lumina si aer. Daca il folosesti mai ales pe vreme buna, pentru umbra, te descurci fara pereti; daca vrei protectie completa si un spatiu inchis, alege un model cu pereti.' },
  { question: 'Cum fixez un pavilion sa nu il ia vantul?', answer: 'Ancorarea e cel mai important lucru la un pavilion, mai ales la cele pliabile si usoare. Foloseste picotii, tarusii, care vin de obicei in pachet, si infige-i in pamant la fiecare picior, plus corzi de tensionare intinse spre exterior, ca la un cort. Pe suprafete tari, unde nu poti infige picoti, foloseste greutati, saci de nisip sau greutati speciale, la baza fiecarui picior. Nu lasa niciodata un pavilion nefixat pe vant, pentru ca se poate rasturna sau lua pe sus, si strange-l daca se anunta furtuna. O structura mai grea, din otel, rezista mai bine, dar si aceea trebuie ancorata la vant puternic.' },
  { question: 'Ce dimensiune de pavilion sa aleg?', answer: 'Cel mai comun format este 3x3 m, dimensiunea majoritatii modelelor din selectie, si e o alegere buna pentru o masa cu 4-6 scaune, pentru umbra la piscina sau pentru un mic eveniment in curte. Acopera suficient spatiu pentru o familie fara sa fie greu de manevrat sau de depozitat. Pentru evenimente mai mari, cu mai multi invitati sau mai multe mese, exista corturi mai mari, dar acelea sunt mai grele, mai scumpe si mai greu de montat singur. Masoara locul din curte inainte si gandeste-te cati oameni vrei sa incapa la umbra: pentru uz casnic obisnuit, 3x3 m e formatul potrivit.' },
  { question: 'Cum intretin un pavilion de gradina?', answer: 'Cel mai important e sa il strangi curat si uscat. Dupa folosire pe ploaie, lasa prelata sa se usuce complet inainte de a o plia, altfel mucegaieste si miroase. Curata panza de frunze, praf si pete cu apa si o solutie blanda, fara detergenti agresivi care ii pot afecta tratamentul impermeabil. Verifica periodic cadrul, imbinarile si picioarele, si strange suruburile slabite. Iarna sau pe furtuna, strange pavilionul si depoziteaza-l intr-un loc uscat, in husa lui, ca sa nu il strice inghetul sau vantul. Cu aceasta grija simpla, un pavilion tine mai multe veri, iar prelata isi pastreaza rezistenta la apa.' },
  { question: 'Cat costa un pavilion de gradina rezistent la apa?', answer: 'In selectie, cele mai accesibile pavilioane impermeabile 3x3, pliabile, pornesc de la circa 220 de lei, ca AT Performance, si urca spre 340 de lei pentru modele mai bine notate, ca Danubewd sau PEXOR. Pavilioanele pliabile obisnuite sunt in aceeasi zona, 230-425 de lei, in functie de brand si calitate. Modelele cu pereti laterali si structura mai solida, din otel, sunt mai scumpe, intre circa 300 si 640 de lei, pentru ca inchid spatiul si rezista mai bine. Cel mai bun raport il gasesti alegand dupa nevoie: un pavilion pliabil impermeabil pentru umbra ocazionala, sau unul cu pereti si structura robusta daca vrei protectie completa si folosire indelungata.' },
];

const images = [hero, figImperm, figPliabil, figPereti, ...PICKS.map(x => x.p.image)];
---

<Layout
  title="Cele mai bune pavilioane de gradina rezistente la vant si ploaie in 2026: impermeabile, pliabile si cu pereti"
  description="Care sunt cele mai bune pavilioane de gradina rezistente la vant si ploaie in 2026: modele impermeabile 3x3 de la Danubewd si PEXOR, pliabile accesibile si cu pereti laterali de la Hessa si PROCART, comparate pe dimensiune, pereti si material. Plus cum alegi, pliabil vs fix si cum le fixezi pe vant."
  image={hero}
  type="article"
  publishedTime={published}
  modifiedTime={published}
  author="Maria Ionescu"
  breadcrumb={[{ name: 'Acasa', url: '/' }, { name: 'Mobilier Gradina', url: '/mobilier-gradina/' }, { name: 'Cele mai bune pavilioane de gradina rezistente la vant si ploaie' }]}
  faq={faq.map(f => ({ question: f.question, answer: f.answer }))}
>
  <article class="rd">
    <nav class="breadcrumb">
      <a href="/">Acasa</a><span class="breadcrumb-separator">/</span>
      <a href="/mobilier-gradina/">Mobilier Gradina</a><span class="breadcrumb-separator">/</span>
      <span>Cele mai bune pavilioane de gradina rezistente la vant si ploaie</span>
    </nav>

    <h1>Cele mai bune pavilioane de gradina rezistente la vant si ploaie</h1>
    <p class="rd-byline">de <a href="/autori/maria-ionescu/">Maria Ionescu</a>, Designer Interior · actualizat iulie 2026</p>

    <img class="rd-hero" src={hero} alt="Cele mai bune pavilioane de gradina rezistente la vant si ploaie: impermeabile, pliabile si cu pereti laterali" width="1200" height="675" fetchpriority="high" />

    <div class="rd-intro">
      <p>Pentru un pavilion cu adevarat impermeabil, cel mai bine notat e <strong>PEXOR Forte</strong>, iar <strong>Danubewd</strong> are prelata din PVC, clar rezistenta la ploaie. Cel mai vandut si mai accesibil e <strong>AT Performance</strong>. Daca vrei sa inchizi spatiul de vant, modelele cu pereti laterali, ca <strong>Hessa</strong> sau <strong>PROCART</strong>, ofera protectie completa.</p>
      <p>La un pavilion de gradina conteaza cat de <strong>impermeabil</strong> e acoperisul, daca are <strong>pereti laterali</strong> pentru protectie pe vant, tipul de <strong>structura</strong> (pliabila sau fixa) si cat de bine il ancorezi. Mai jos gasesti direct recomandarile, pe trei tipuri, iar sub ele un ghid despre cum alegi si cum il fixezi ca sa nu il ia vantul.</p>
      <p>Am pornit de la pavilioanele in stoc pe eMAG, cu cele mai multe pareri, le-am verificat pe impermeabilitate, dimensiune, pereti si structura, si le-am impartit in impermeabile, pliabile accesibile si cu pereti laterali. E o categorie cu note amestecate, asa ca am fost onesti si am notat clar unde ratingurile sunt slabe sau parerile inca putine. Pentru alte solutii de umbra pe terasa, vezi si <a href="/pergola-din-lemn-pentru-terasa/">pergolele din lemn</a> si <a href="/copertina-retractabila-pentru-terasa/">copertinele retractabile</a>.</p>
    </div>

    <details class="rd-toc">
      <summary>Cuprins</summary>
      <ol>
        <li><a href="#tabel">Comparatie rapida</a></li>
        <li><a href="#imperm">Pavilioane impermeabile 3x3</a></li>
        <li><a href="#pliabil">Pavilioane pliabile accesibile</a></li>
        <li><a href="#pereti">Pavilioane cu pereti laterali</a></li>
        <li><a href="#de-ce">De ce un pavilion in gradina</a></li>
        <li><a href="#conteaza">Ce conteaza cand alegi</a></li>
        <li><a href="#vant">Cum il fixezi pe vant</a></li>
        <li><a href="#intretinere">Intretinere si depozitare</a></li>
        <li><a href="#cat-costa">Cat costa</a></li>
        <li><a href="#faq">Intrebari frecvente</a></li>
      </ol>
    </details>

    <h2 id="tabel">Comparatie rapida</h2>
    <div class="table-wrap">
      <table class="rd-table">
        <thead><tr><th>Model</th><th>Dimensiune</th><th>Pereti</th><th>Material</th></tr></thead>
        <tbody>
          {PICKS.map(x => (
            <tr>
              <td><div class="cmp-prod"><img class="cmp-thumb" src={x.p.image} alt={x.short} loading="lazy" width="44" height="44" /><span>{x.short}</span></div></td>
              <td>{x.dim}</td>
              <td>{x.pereti}</td>
              <td>{x.material}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 id="imperm">Pavilioane impermeabile 3x3</h2>
    <p>Accentul cade pe rezistenta la apa: prelate din PVC sau poliester tratat, care tin ploaia afara, nu doar o resping o vreme. Sunt pliabile, se monteaza rapid si acopera o masa mare. Aici e si cel mai bine notat pavilion din selectie.</p>
    <div class="rd-grid">
      {IMPERM.map(x => (
        <ProductCard name={x.p.name.replace(/’/g, "'")} image={x.p.image} price={x.p.price} rating={x.p.rating} reviews={x.p.reviews} badge={x.badge} specs={x.specs} pros={x.pros} cons={x.cons} verdict={x.verdict} outKey={'p-' + x.id} />
      ))}
    </div>

    <img class="rd-fig" src={figImperm} alt="Pavilioane impermeabile 3x3: Danubewd, PEXOR, AT Performance" width="1200" height="675" loading="lazy" />

    <h2 id="pliabil">Pavilioane pliabile accesibile</h2>
    <p>Tip pop-up, se ridica in cateva minute si se strang la loc pentru mutare sau depozitare. Ideale pentru evenimente ocazionale, mese in curte si umbra la piscina, cand vrei ceva practic si usor de manevrat.</p>
    <div class="rd-grid">
      {PLIABIL.map(x => (
        <ProductCard name={x.p.name.replace(/’/g, "'")} image={x.p.image} price={x.p.price} rating={x.p.rating} reviews={x.p.reviews} badge={x.badge} specs={x.specs} pros={x.pros} cons={x.cons} verdict={x.verdict} outKey={'p-' + x.id} />
      ))}
    </div>

    <img class="rd-fig" src={figPliabil} alt="Pavilioane pliabile accesibile: JRH, OEM, Flippy" width="1200" height="675" loading="lazy" />

    <h2 id="pereti">Pavilioane cu pereti laterali</h2>
    <p>Inchid complet spatiul si te apara de vant, de soarele piezis si de ploaia oblica. Cu structura mai solida sau cu ferestre, sunt alegerea pentru petreceri si pentru vreme schimbatoare, cand un simplu umbrar nu ajunge.</p>
    <div class="rd-grid">
      {PERETI.map(x => (
