const PRESIUNE = PICKS.filter(x => x.g === 'presiune');
const SLOW = PICKS.filter(x => x.g === 'slow');
const MULTI = PICKS.filter(x => x.g === 'multi');

const hero = '/imagini/articole/cele-mai-bune-multicookere.webp';
const figPresiune = '/imagini/articole/multicookere-presiune.webp';
const figSlow = '/imagini/articole/multicookere-slow.webp';
const figMulti = '/imagini/articole/multicookere-multifunctionale.webp';
const published = '2026-07-21T16:11:55+03:00';

const faq = [
  { question: 'Care e diferenta intre multicooker, oala sub presiune si slow cooker?', answer: 'Un slow cooker gateste doar lent, la foc mic, ore intregi. O oala sub presiune electrica gateste doar rapid, sub presiune, in minute. Un multicooker le combina pe amandoua intr-un aparat, plus functii ca sote, aburi, orez sau iaurt. Instant Pot, de exemplu, este in esenta o oala sub presiune care are si programe de gatire lenta si orez. Practic, daca vrei un singur aparat care le face pe toate, iei un multicooker; daca vrei anume gatire lenta clasica, un slow cooker dedicat, ca Crock-Pot, e mai simplu de folosit.' },
  { question: 'Cu presiune sau slow cooker, ce sa aleg?', answer: 'Depinde de cum gatesti. Gatirea sub presiune e pentru cine vrea rezultate rapide: o tocana care ar cere doua ore la foc iese in aproximativ 30 de minute. Slow cooking-ul e pentru cine planifica: pui ingredientele dimineata, pleci si seara gasesti mancarea facuta, iar carnea tare iese exceptional de frageda. Multi aleg un multicooker tocmai ca sa aiba ambele si sa decida in functie de zi. Daca insa gatesti mereu grabit, mergi pe presiune; daca iti place sa lasi mancarea la foc mic cat esti plecat, un slow cooker simplu e suficient.' },
  { question: 'Ce capacitate imi trebuie?', answer: 'Pentru 1-2 persoane, 3-4 litri ajung. Pentru o familie de 3-4, 5-6 litri sunt zona corecta, iar cele mai multe modele din articol sunt exact acolo. Peste 7 litri, doar daca ai familie mare sau gatesti in avans, o oala pentru mai multe mese. Un detaliu util la aparatele cu presiune: nu se umplu niciodata pana sus, ci pana la doua treimi, pentru ca lichidul si aburul au nevoie de spatiu. Deci un vas de 6 litri nu inseamna 6 litri de mancare, ci in jur de 4. Daca esti la limita intre doua marimi, ia-o pe cea mai mare.' },
  { question: 'Chiar pot lasa un slow cooker pornit cat sunt plecat?', answer: 'Da, exact pentru asta e conceput. Un slow cooker functioneaza la temperatura joasa si constanta, iar producatorii il proiecteaza sa fie lasat nesupravegheat 4 pana la 8 ore, chiar mai mult pe setarea low. E, de altfel, principalul lui motiv de a exista: gatit fara supraveghere. Bunul simt ramane valabil, il pui pe o suprafata rezistenta la caldura, nu langa materiale inflamabile, si verifici sa fie in stare buna cablul, dar ideea de a-l lasa sa lucreze cat esti la serviciu e chiar rostul aparatului, nu un risc.' },
  { question: 'E sigura o oala sub presiune electrica?', answer: 'Mult mai sigura decat vechile oale sub presiune de pe aragaz. Modelele electrice moderne au mai multe sisteme de siguranta: capac care se blocheaza si nu se poate deschide cat timp e presiune inauntru, valve de eliberare a aburului si senzori care opresc incalzirea daca ceva nu e in regula. Spre deosebire de oala clasica, unde controlai focul manual, aici electronica regleaza totul. Trebuie doar sa respecti instructiunile: sa nu umpli peste limita, sa verifici garnitura capacului si sa eliberezi aburul asa cum spune manualul inainte sa deschizi. Cu astea, e un aparat sigur pentru uz zilnic.' },
  { question: 'Ce pot gati intr-un multicooker?', answer: 'Mai mult decat te astepti. De baza: tocane, supe, ciorbe, carne, orez, paste, legume la aburi. Cu functia de sote calesti ceapa si rumenesti carnea in acelasi vas inainte de gatit. Multe modele fac si iaurt, terci de ovaz, compot sau chiar prajituri simple. Cele cu presiune sunt imbatabile la fasole, naut sau carne tare, care altfel cer ore. Cele fara presiune, ca Fuzzy Logic sau SpheriCook, sunt bune la gatit asezat si la orez constant. Practic, un multicooker inlocuieste mai multe oale si aparate mici, iar asta e si motivul pentru care economiseste spatiu in bucatarie.' },
  { question: 'Merita un model combi cu air fryer?', answer: 'Merita daca te enerveaza limita clasica a gatirii sub presiune: mancarea iese frageda, dar palida, fara crusta. Un combi ca Instant Pot Pro Crisp are doua capace, unul de presiune si unul cu ventilator pentru rumenire, deci gatesti carnea moale sub presiune si apoi o faci crocanta in acelasi vas. E doua aparate intr-unul si economiseste spatiu. Reversul e pretul mai mare si al doilea capac de depozitat. Daca vrei mai ales rumenire si mai putin presiune, s-ar putea sa fii mai multumit cu o friteuza cu aer cald dedicata. Daca vrei ambele si nu vrei doua aparate, combi-ul are sens.' },
  { question: 'Cum curat un multicooker?', answer: 'Vasul interior, cel in care gatesti, se scoate si se spala cu apa calda si detergent, iar la multe modele e compatibil cu masina de spalat vase, verifica in manual. La aparatele cu presiune, curata dupa fiecare folosire si garnitura de silicon a capacului si supapa de abur, pentru ca acolo se prind mirosuri si resturi; garnitura se scoate usor si se spala separat. Corpul cu rezistenta il stergi doar cu o carpa umeda, nu il bagi in apa. La slow cookere, vasul de ceramica se spala ca o oala obisnuita. Curatarea la timp a garniturii e ce tine aparatul fara miros in timp.' },
];

const images = [hero, figPresiune, figSlow, figMulti, ...PICKS.map(x => x.p.image)];
