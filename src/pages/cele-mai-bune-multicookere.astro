    <h2 id="tabel">Comparatie rapida</h2>
    <div class="table-wrap">
      <table class="rd-table">
        <thead><tr><th>Model</th><th>Tip</th><th>Capacitate</th><th>Programe</th><th>Pret</th></tr></thead>
