  // --- B. Slow cooker (gatire lenta) ---
  { g: 'slow', id: 'DC60RMBBM', rol: 'Slow cooker clasic, il pornesti si pleci', short: 'Crock-Pot 4.7 l', tip: 'Slow cooker', cap: '4.7 l', prog: '2 setari', pret: '290 lei',
