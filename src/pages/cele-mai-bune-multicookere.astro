  { g: 'presiune', id: 'D3HP6B2BM', rol: 'Reperul international al gatirii sub presiune', short: 'Instant Pot Duo 5.7 l', tip: 'Cu presiune', cap: '5.7 l', prog: '13', pret: '581 lei',
