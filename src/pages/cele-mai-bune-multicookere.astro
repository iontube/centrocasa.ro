  // --- C. Fara presiune, multifunctionale si orez ---
  { g: 'multi', id: 'DY76QBBBM', rol: 'Multicooker fara presiune, bine vandut', short: 'Tefal Fuzzy Logic 5 l', tip: 'Fara presiune', cap: '5 l', prog: '12', pret: '405 lei',
    specs: ['5 litri, 750 W, 12 programe, fara presiune', 'tehnologie Fuzzy Logic, ajusteaza singur gatitul', 'timer si pastrare la cald', 'gateste orez, supe, tocane, aburi'],
    pros: ['212 pareri, bine vandut si testat', 'Fuzzy Logic regleaza singur temperatura si timpul', '12 programe pentru feluri variate', 'Mai simplu si mai sigur, fara presiune'],
