const MIC = PICKS.filter(x => x.g === 'mic');
const MEDIU = PICKS.filter(x => x.g === 'mediu');
const NOFROST = PICKS.filter(x => x.g === 'nofrost');

const hero = '/imagini/articole/cele-mai-bune-congelatoare.webp';
const figMic = '/imagini/articole/congelatoare-compacte.webp';
const figMediu = '/imagini/articole/congelatoare-medii.webp';
const figNofrost = '/imagini/articole/congelatoare-no-frost.webp';
const published = '2026-07-22T17:12:03+03:00';

const faq = [
  { question: 'Congelator static sau No Frost?', answer: 'E prima decizie si depinde de cat de mult te deranjeaza decongelarea manuala. Un congelator static costa mai putin, consuma mai putin curent si e mai silentios, dar acumuleaza gheata pe pereti si trebuie decongelat manual o data sau de doua ori pe an. Un No Frost are un ventilator care circula aerul si impiedica formarea ghetii, deci nu il mai decongelezi niciodata, insa consuma cu aproximativ 40% mai mult, e ceva mai zgomotos si costa mai mult la cumparare. Regula simpla: daca il pui undeva la vedere si vrei zero intretinere, ia No Frost; daca vrei consum si pret mici si nu te deranjeaza o decongelare pe an, ia static.' },
  { question: 'De cati litri am nevoie?', answer: 'Orientativ, socoteste in jur de 50-60 de litri de persoana daca folosesti congelatorul normal, plus un supliment daca gatesti in avans sau congelezi legume si carne in cantitate. Sub 100 de litri, un compact de 63-103 litri, e pentru o persoana, un cuplu sau ca al doilea congelator. Zona de 160-190 de litri acopera o familie obisnuita de 3-4 persoane. Peste 230-270 de litri intri in teritoriul celor care congeleaza serios: jumatate de porc, recolta din gradina, cumparaturi en-gros. Mai bine putin mai mare decat prea mic, pentru ca un congelator plin consuma mai eficient decat unul pe jumatate gol.' },
  { question: 'Ce inseamna clasa E sau F la un congelator? E slab?', answer: 'Nu, si e o confuzie foarte raspandita. Din martie 2021, eticheta energetica a fost rescrisa de la A la G, iar clasele vechi A+, A++ si A+++ au disparut. Scara a fost inasprita intentionat, iar clasele A si B au fost lasate goale la inceput, pentru progresul viitor. Asta inseamna ca un aparat care ar fi fost A+ pe eticheta veche apare acum ca F pe cea noua. In practica, aproape toate congelatoarele de pe piata sunt azi E sau F, deci o clasa F nu e un semn de aparat prost. Ce conteaza cu adevarat e cifra reala de consum in kWh pe an, scrisa pe eticheta: compara acel numar intre modele de capacitate similara, nu litera in sine.' },
  { question: 'Pot tine congelatorul in garaj sau pe balcon?', answer: 'Doar daca temperatura din acel spatiu nu coboara prea mult iarna, si aici intervine clasa climatica de pe eticheta. Un aparat de clasa SN e proiectat sa functioneze corect pana la 10 grade, N de la 16 grade, ST si T de la 18 grade in sus. Sub aceste praguri, uleiul din compresor devine vascos si termostatul poate crede ca e destul de frig si sa nu mai porneasca racirea, ceea ce paradoxal duce la dezghetarea mancarii. Deci un garaj sau un balcon inchis care scade sub 10 grade iarna nu e potrivit pentru majoritatea congelatoarelor obisnuite, decat cele marcate special pentru garaj. Daca il tii intr-o camara racoroasa care ramane peste 10-16 grade, verifica sa aiba cel putin clasa SN, cum e Arctic sau Beko din selectie.' },
  { question: 'Ce este autonomia fara curent si de ce conteaza?', answer: 'E numarul de ore in care mancarea ramane congelata dupa o pana de curent, cu usa inchisa. In articol variaza de la circa 8 ore la compactele mici pana la 20 de ore la Beko de 404 litri. Regula, poate contraintuitiva, e ca un congelator mai mare si mai plin tine frigul mai mult, pentru ca masa inghetata din interior actioneaza ca un rezervor de frig. Daca stai intr-o zona cu pene dese sau lungi, autonomia mare devine un criteriu real, nu un moft: la 20 de ore treci peste aproape orice intrerupere fara sa pierzi mancarea. Sfatul valabil oricum: in timpul unei pene, nu deschide usa deloc.' },
  { question: 'Ce face functia de congelare rapida sau Fast Freeze?', answer: 'Cand bagi o cantitate mare de alimente proaspete deodata, ele ridica temperatura din congelator si risca sa dezghete partial ce era deja inghetat. Functia de congelare rapida, numita si Fast Freeze sau super-congelare, coboara temperatura mult sub normal cu cateva ore inainte, ca noile alimente sa inghete repede si sa nu afecteze restul. O folosesti concret cand vii cu o transa mare de carne sau cu legume de congelat pentru iarna. Dupa ce totul a inghetat, aparatul revine singur la regimul normal, la modelele moderne, sau il readuci tu manual. Arctic, Heinner N194, Tesla si cele doua Beko din articol o au.' },
  { question: 'Un congelator convertibil in frigider merita?', answer: 'Merita daca banuiesti ca nevoile ti se vor schimba. Modelele convertibile, ca LDK 238 l si Tesla 273 l din articol, pot lucra fie ca un congelator care duce pana la minus 18 grade, fie ca un frigider normal, printr-o simpla setare. E util in cateva situatii concrete: cumperi acum un al doilea congelator pentru iarna cu legume, dar vara ai nevoie mai degraba de spatiu de racire pentru bauturi si conserve; sau il muti intre camere cu roluri diferite. Daca stii sigur ca il vrei doar congelator pentru totdeauna, functia nu iti aduce nimic in plus si nu ai de ce sa platesti pentru ea. E o plasa de siguranta, nu o necesitate.' },
  { question: 'Cum decongelez corect un congelator static?', answer: 'O data la sase-douasprezece luni, sau cand stratul de gheata pe pereti trece de 5 milimetri, pentru ca gheata groasa izoleaza si creste consumul. Muta intai mancarea intr-o lada frigorifica sau in alt congelator, scoate aparatul din priza si lasa usa deschisa. Nu razui gheata cu obiecte metalice, strici peretii; lasa-o sa se topeasca singura, eventual grabeste cu un vas de apa calda pus inauntru. Sterge apa, usuca bine interiorul, baga la loc in priza si asteapta sa ajunga la temperatura inainte de a repune alimentele. La un No Frost sari peste tot pasul asta, pentru ca nu se formeaza gheata; asta e, de fapt, principalul lui avantaj.' },
];

