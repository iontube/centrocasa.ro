const MIC = PICKS.filter(x => x.g === 'mic');
const MEDIU = PICKS.filter(x => x.g === 'mediu');
const MARE = PICKS.filter(x => x.g === 'mare');

const hero = '/imagini/articole/cele-mai-bune-dezumidificatoare.webp';
const figMic = '/imagini/articole/dezumidificator-camera.webp';
const figMediu = '/imagini/articole/dezumidificator-apartament.webp';
const figMare = '/imagini/articole/dezumidificator-casa.webp';
const figValoare = '/imagini/articole/dezumidificator-lei-per-litru.webp';
const figTemp = '/imagini/articole/dezumidificator-temperatura.webp';
const published = '2026-07-20T16:23:16+03:00';

const faq = [
  { question: 'Cati litri pe zi imi trebuie?', answer: 'Regula practica pleaca de la suprafata si de la cat de umed e spatiul. Pentru o camera mica sau o baie, intre 15 si 20 de metri patrati, ajung 10-15 litri pe zi. Pentru un apartament sau o suprafata de 30-50 de metri patrati cu umezeala vizibila, ai nevoie de 20-30 de litri. Peste 50 de metri patrati sau cand vorbim de un subsol cu probleme serioase, treci de 30 de litri. Sfatul care se repeta la toti producatorii e sa alegi cu o treapta mai mult decat pare necesar: un aparat usor supradimensionat atinge umiditatea dorita mai repede si apoi merge in regim redus, in loc sa functioneze permanent la maximum, ceea ce inseamna si mai putina uzura, si mai putin zgomot.' },
  { question: 'De ce nu merge bine dezumidificatorul in beci iarna?', answer: 'Pentru ca toate aparatele accesibile, inclusiv cele 12 din acest articol, functioneaza cu compresor. Ele racesc o serpentina sub temperatura aerului, apa din aer condenseaza pe ea si se scurge in rezervor. Cand aerul din incapere e deja rece, serpentina ajunge sub zero grade si se acopera de gheata, iar aparatul intra in cicluri de dezghetare in care nu mai extrage nimic. Sub 10 grade petrece tot mai mult timp dezghetandu-se decat uscand. Multe modele declara in fisa un interval de operare care coboara pana la 5 grade, dar asta inseamna ca porneste, nu ca lucreaza eficient. Pentru spatii care stau sub 10 grade iarna exista aparate cu absorbtie, cu alt principiu de functionare, care nu depind de temperatura. Nu se gasesc insa usor pe piata de la noi.' },
  { question: 'Dezumidificator sau aer conditionat cu functie de uscare?', answer: 'Sunt doua lucruri diferite, desi par sa faca acelasi lucru. Aerul conditionat in modul dry scade umiditatea ca efect secundar al racirii, deci raceste camera in acelasi timp, ceea ce iarna sau in sezonul rece e exact ce nu vrei. In plus, nu poti seta un nivel de umiditate, doar il lasi sa mearga. Un dezumidificator dedicat lucreaza invers: mentine temperatura aproape neschimbata, pentru ca aerul uscat e reincalzit usor la iesire, si il setezi la un procent anume de umiditate, dupa care porneste si se opreste singur. Daca problema ta e umezeala, nu caldura, aparatul dedicat e alegerea corecta si consuma mai putin pentru acelasi rezultat.' },
  { question: 'Ce umiditate ar trebui sa am in casa?', answer: 'Intervalul confortabil si sanatos e intre 40 si 60 la suta umiditate relativa, iar tinta pe care o seteaza majoritatea oamenilor e in jur de 50. Sub 40 la suta aerul devine prea uscat si apar iritatii ale cailor respiratorii, piele uscata si electricitate statica. Peste 60 la suta incep problemele opuse: acarienii se inmultesc, apare condensul pe geamuri si, in colturile reci ale peretilor, mucegaiul. Peste 70 la suta mucegaiul se dezvolta vizibil in cateva zile. Aproape toate aparatele din selectie au un higrostat, deci setezi procentul dorit si aparatul porneste si se opreste singur ca sa il mentina, fara sa stea pornit degeaba.' },
  { question: 'Cat consuma un dezumidificator?', answer: 'Mult mai putin decat se asteapta lumea. Modelele din selectie declara consumuri intre 165 si aproximativ 300 de wati in functionare, adica in jurul unui bec puternic sau al unui laptop, nu al unui radiator. La 165 de wati si opt ore de functionare pe zi ajungi la circa 1.3 kWh zilnic. Important e ca aparatul nu merge continuu: odata atinsa umiditatea setata, se opreste si reporneste doar cand e nevoie, deci consumul real e sub cel teoretic. Un aparat supradimensionat consuma paradoxal mai putin pe termen lung, pentru ca atinge tinta repede si apoi sta. La modelele cu purificare, filtrul adauga un cost de inlocuire periodica, nu de curent.' },
  { question: 'Unde il asez in camera?', answer: 'La cel putin 20-30 de centimetri de pereti si de mobila, ca aerul sa circule liber prin el pe toate partile. Nu il lipi de perete, nici nu il baga intr-un colt inchis sau sub o masa, pentru ca isi aspira propriul aer uscat si crede ca a terminat treaba. Pozitia ideala e cat mai aproape de sursa de umezeala: langa peretele cu condens, in dreptul uscatorului de rufe sau la baza scarii, daca vorbim de un demisol. Usile si geamurile incaperii trebuie sa fie inchise cat timp lucreaza, altfel trage umezeala din tot restul casei si nu termina niciodata. Daca il muti dintr-o camera in alta, lasa-l cateva minute inainte sa il pornesti, mai ales daca l-ai transportat culcat.' },
  { question: 'Trebuie sa golesc rezervorul mereu?', answer: 'Nu neaparat, si asta e una dintre cele mai utile functii pe care putini o verifica inainte de cumparare. Toate aparatele au un rezervor, de obicei intre 2 si 5 litri, care se umple si opreste automat aparatul cand e plin. Intr-un spatiu foarte umed, un aparat de 20 de litri pe zi umple un rezervor de 3 litri de cateva ori pe zi, ceea ce devine obositor. Solutia e evacuarea continua: aproape toate modelele au un racord pe care atasezi un furtun si il duci intr-o scurgere, la o chiuveta sau afara, iar apoi aparatul merge nesupravegheat saptamani intregi. Pentru beci, demisol sau casa de vacanta, functia asta nu e optionala, e obligatorie.' },
  { question: 'Cat costa un dezumidificator bun?', answer: 'Selectia acopera intervalul de la 534 la 1699 de lei si se imparte destul de clar. Pana in 600 de lei gasesti aparate de 8-13 litri pe zi pentru o singura camera, ca AlecoAir D8 si D12 Junior sau Turbionaire EPI 12 si SENSO 12, iar la pretul asta primesti compresor adevarat, nu granule. Intre 600 si 900 de lei intra modelele de 16-20 de litri pentru un apartament, plus cele cu purificare, cum sunt Turbionaire Smart 16M, AlecoAir D16 HOME, D14 PURIFY si Freezy Air Dry 20. Peste 1100 de lei ajungi la 22-35 de litri pentru case si subsoluri, cu AlecoAir D22 PURIFY, D23 si D35 ARIO. Cel mai bun raport din tot articolul il gasesti in jur de 850 de lei, unde Freezy Air Dry 20 da 20 de litri si 45 de metri patrati.' },
];

const images = [hero, figMic, figMediu, figMare, figValoare, figTemp, ...PICKS.map(x => x.p.image)];
