const ACC = PICKS.filter(x => x.g === 'acc');
const ECH = PICKS.filter(x => x.g === 'ech');
const PREM = PICKS.filter(x => x.g === 'prem');

const hero = '/images/articles/plita-cu-inductie-pentru-bucatarie.webp';
const figAcc = '/imagini/articole/plita-accesibile.webp';
const figEch = '/imagini/articole/plita-echilibrate.webp';
const figPrem = '/imagini/articole/plita-premium.webp';
const published = '2026-07-19T14:00:49+03:00';

const faq = [
  { question: 'Cum functioneaza o plita cu inductie?', answer: 'O plita cu inductie incalzeste direct vasul, nu suprafata de sticla. Sub fiecare zona se afla o bobina care creeaza un camp magnetic, iar acesta genereaza caldura chiar in fundul oalei sau al tigaii, prin inductie electromagnetica. De aceea, plita raspunde instant: cresti sau scazi puterea si caldura se schimba imediat, ca la gaz, dar mai precis. Sticla din jurul vasului ramane relativ rece, se incalzeste doar de la caldura vasului, ceea ce face inductia mai sigura si mai eficienta decat vitroceramica clasica. Zona functioneaza doar cand detecteaza un vas potrivit pe ea, altfel ramane oprita.' },
  { question: 'De ce inductie si nu vitroceramica sau gaz?', answer: 'Inductia e cea mai rapida, mai eficienta si mai sigura optiune. Fata de vitroceramica, care incalzeste sticla si apoi vasul, inductia incalzeste direct vasul, deci gateste mai repede, consuma mai putin si raspunde instant la reglaje. Fata de gaz, e mai curata, mai usor de curatat, fara flacara si fara riscul scaparilor de gaz, si tot mai precisa. In plus, sticla ramane rece in jurul vasului, deci nu te arzi si mancarea varsata nu se arde pe plita. Singurele conditii sunt sa ai vase compatibile cu inductia si o instalatie electrica potrivita, pentru ca plitele au putere mare. Pentru majoritatea bucatariilor moderne, inductia e alegerea de top.' },
  { question: 'Cate zone de gatit imi trebuie?', answer: 'Depinde de cat si pentru cati gatesti. O plita cu 2 zone, in format domino de 30 cm, e potrivita pentru o persoana, un cuplu, o garsoniera sau ca a doua plita. Cele mai multe familii aleg 4 zone, formatul standard de 60 cm, care iti permite sa gatesti mai multe feluri odata, cu oale si tigai diferite. Modelele cu zona flexibila sau cu mai multe zone, ca cel Whirlpool de 8 zone si 65 cm din selectie, iti dau libertatea de a aseza vase de orice forma oriunde pe plita, utile daca gatesti mult si cu vase mari. Pentru o bucatarie obisnuita, 4 zone pe 60 cm sunt alegerea potrivita.' },
  { question: 'Ce este functia booster si zona flexibila?', answer: 'Boosterul concentreaza temporar putere suplimentara pe o zona, ridicand-o la maximum, la unele modele pana spre 3700 W, ca sa fierbi apa sau sa incingi o tigaie foarte repede, in cateva secunde. E util cand te grabesti, iar dupa cateva minute puterea revine la normal. Zona flexibila inseamna ca mai multe zone alaturate se pot combina intr-o singura suprafata mare de gatit, cu inductoare care lucreaza impreuna: asa pui o tigaie lunga, un vas de gratar sau doua oale una langa alta oriunde in acea zona, fara sa te limitezi la cercuri fixe. Amandoua sunt dotari care fac gatitul mai rapid si mai comod, mai frecvente la modelele de mijloc si premium.' },
  { question: 'Ce vase pot folosi pe inductie?', answer: 'Doar vase compatibile cu inductia, adica cele cu fund magnetic, din fonta, otel emailat sau inox magnetic. Un test simplu: daca un magnet se lipeste de fundul oalei, vasul e bun pentru inductie. Vasele din aluminiu, cupru, sticla sau ceramica obisnuita, fara fund magnetic special, nu functioneaza, pentru ca plita nu le detecteaza. Multe seturi noi de oale sunt marcate ca fiind pentru inductie. Fundul vasului trebuie sa fie plat, curat si neted, ca sa faca un contact bun cu sticla si sa incalzeasca eficient. Daca treci la inductie de la gaz sau vitroceramica, verifica intai vasele; s-ar putea sa fie nevoie sa cumperi cateva noi, compatibile.' },
  { question: 'Ce functii de siguranta are o plita cu inductie?', answer: 'Plitele cu inductie sunt printre cele mai sigure. Detectarea vasului face ca zona sa functioneze doar cand are un vas potrivit deasupra, altfel ramane oprita, deci nu ramane pornita degeaba. Blocarea pentru copii, sau child lock, impiedica pornirea sau modificarea accidentala a setarilor, utila intr-o casa cu copii. Indicatorul de caldura reziduala arata care zone sunt inca fierbinti dupa gatit, ca sa nu le atingi. Protectia la supraincalzire opreste automat plita daca se incinge prea tare. In plus, sticla din jurul vasului ramane rece, deci riscul de arsuri e mult mai mic decat la gaz sau vitroceramica. Cauta aceste functii cand alegi, mai ales daca ai copii.' },
  { question: 'Cum curat si intretin o plita cu inductie?', answer: 'E foarte usor de curatat, unul dintre marile avantaje. Fiind o suprafata plana din sticla, o stergi cu o carpa umeda si o solutie blanda dupa fiecare folosire, iar pentru ca sticla ramane relativ rece, mancarea varsata nu se arde si nu se lipeste ca pe gaz sau vitroceramica. Pentru pete uscate, foloseste un razuitor special pentru vitroceramica si o solutie dedicata, fara bureti abrazivi care zgarie sticla. Sterge imediat zaharul sau mancarea varsata cat plita e calda, cu grija sa nu te arzi, pentru ca se pot lipi. Nu folosi detergenti agresivi sau obiecte ascutite. Cu aceasta grija simpla, sticla ramane ca noua ani la rand.' },
  { question: 'Cat costa o plita cu inductie buna?', answer: 'In selectie, plitele accesibile pornesc de la circa 460 de lei pentru un model domino cu 2 zone, ca Heinner, si ajung spre 850 de lei pentru unul cu 4 zone si latime standard, ca Starcrest. Segmentul echilibrat, cu Arctic, Beko si Electrolux, se aseaza intre circa 1200 si 1700 de lei si aduce branduri cunoscute cu service la noi si note bune. Modelele premium, de la Electrolux, Samsung sau AEG, trec de 2000 si urca spre 3600 de lei, cu control mai fin al puterii, booster puternic, zona flexibila sau design deosebit. Cel mai bun raport il gasesti alegand numarul de zone si dotarile potrivite nevoii tale, nu neaparat cel mai scump model.' },
];

const images = [hero, figAcc, figEch, figPrem, ...PICKS.map(x => x.p.image)];
---

