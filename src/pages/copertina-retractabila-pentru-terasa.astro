---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import SimilarArticles from '../components/SimilarArticles.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import emag from '../data/emag-products.json';
import keywordsData from '../../keywords.json';
import { visibleArticles, slugify } from '../lib/articles.mjs';

const relatedArticles = visibleArticles(keywordsData.completed).map(item => ({
  title: item.keyword.charAt(0).toUpperCase() + item.keyword.slice(1),
  slug: item.slug || slugify(item.keyword),
  excerpt: item.excerpt || '',
  image: item.image || `/images/articles/${item.slug || slugify(item.keyword)}.webp`,
  category: item.category,
  categorySlug: item.categorySlug,
  date: item.date || '',
}));

const pool = emag['copertina'] || [];
const byId = Object.fromEntries(pool.map(p => [p.id, p]));

const PICKS = [
  // --- Mici, de fereastra si balcon ---
  { g: 'mici', id: 'DGLYN2MBM', badge: 'Cea mai mica si ieftina', short: 'Compacta albastra', dim: '100 cm', material: 'Poliester', actionare: 'Manuala',
    specs: ['cea mai mica si mai ieftina din selectie', 'latime compacta, 100 cm', 'panza din poliester, cadru din otel', 'pentru o fereastra sau un balcon mic'],
    pros: ['Cea mai accesibila copertina din selectie', 'Compacta, 100 cm, pentru spatii mici', 'Panza din poliester, cadru din otel', 'Usor de montat pe o fereastra sau balcon'],
    cons: ['Mica, doar pentru ferestre si balcoane', 'Actionare manuala'],
    verdict: 'Cea mai mica si mai accesibila copertina din selectie, pentru o fereastra sau un balcon mic. Acest model vidaXL are o latime compacta de 100 cm si o panza din poliester pe un cadru din otel, deci umbreste o fereastra sau un colt de balcon, ferind incaperea de soarele puternic si racorind-o vara. E cea mai ieftina din selectie, o solutie simpla pentru cine vrea umbra pe un spatiu mic fara sa dea multi bani. Fiind mica, e potrivita doar pentru ferestre si balcoane, nu pentru o terasa, iar actionarea e manuala. Ca la toate produsele din aceasta selectie, e un model relativ nou, cu putine pareri, deci te bazezi pe specificatii. O iei cand vrei cea mai ieftina copertina, compacta, pentru a umbri o fereastra sau un balcon mic, si nu ai nevoie de o suprafata mare sau de motor.' },
  { g: 'mici', id: 'DS1YN2MBM', badge: 'Compacta, maro', short: 'Compacta maro', dim: '100 cm', material: 'Poliester', actionare: 'Manuala',
    specs: ['latime compacta, 100 cm', 'nuanta maro inchis, discreta', 'panza din poliester, cadru din otel', 'pentru fereastra sau balcon'],
    pros: ['Compacta, 100 cm, pentru spatii mici', 'Nuanta maro inchis, discreta si eleganta', 'Panza din poliester rezistenta', 'Pret accesibil'],
    cons: ['Mica, doar pentru ferestre si balcoane', 'Actionare manuala'],
    verdict: 'O copertina compacta in nuanta maro inchis, pentru cine vrea o culoare mai discreta pe fereastra sau balcon. Acest model vidaXL are aceeasi latime de 100 cm si panza din poliester pe cadru din otel ca varianta albastra, dar intr-o nuanta maro inchis, care se integreaza mai discret pe o fatada in tonuri neutre sau calde. Umbreste o fereastra sau un colt de balcon, ferind de soare si racorind spatiul. E o optiune accesibila, potrivita pentru spatii mici, cu actionare manuala. Fiind un produs nou, are inca putine pareri. O iei cand vrei o copertina mica pentru fereastra sau balcon, intr-o nuanta maro discreta care se asorteaza usor cu fatada, la un pret accesibil, si nu ai nevoie de o suprafata mare.' },
  { g: 'mici', id: 'DV1YN2MBM', badge: 'Compacta, rosie', short: 'Compacta rosie', dim: '100 cm', material: 'Poliester', actionare: 'Manuala',
    specs: ['latime compacta, 100 cm', 'nuanta rosie, aspect vioi', 'panza din poliester, cadru din otel', 'pentru fereastra sau balcon'],
    pros: ['Compacta, 100 cm, pentru spatii mici', 'Nuanta rosie, aspect vioi si cald', 'Panza din poliester pe cadru din otel', 'Usor de montat'],
    cons: ['Mica, doar pentru ferestre si balcoane', 'Actionare manuala'],
    verdict: 'Varianta compacta in rosu, pentru cine vrea un accent de culoare pe fereastra sau balcon. Acest model vidaXL are 100 cm latime si panza din poliester pe cadru din otel, ca celelalte doua din grup, dar intr-o nuanta rosie, vie si calda, care da personalitate unei fatade. Umbreste un spatiu mic, ferind incaperea de soare. E o optiune accesibila pentru ferestre si balcoane, cu actionare manuala. Ca la toate produsele din selectie, e un model nou, cu putine pareri. O iei cand vrei o copertina mica pentru fereastra sau balcon, intr-o nuanta rosie care sa aduca un accent de culoare pe fatada, la un pret accesibil, si nu ai nevoie de o copertina mare de terasa.' },
  // --- De terasa, automate ---
  { g: 'terasa', id: 'DV596XMBM', badge: 'Terasa, cea mai accesibila', short: 'Antracit 250 cm', dim: '250 cm', material: 'Poliester', actionare: 'Automata',
    specs: ['proiectie 250 cm, latime 300 cm', 'nuanta antracit, moderna', 'panza din poliester, usoara, 19.8 kg', 'actionare automata cu motor'],
    pros: ['Cea mai accesibila copertina de terasa din selectie', 'Proiectie buna, 250 cm, umbreste o masa', 'Nuanta antracit, moderna si eleganta', 'Usoara, 19.8 kg, si actionare automata'],
    cons: ['Panza din poliester, mai putin robusta ca textilul gros', 'Produs nou, putine pareri'],
    verdict: 'Cea mai accesibila copertina de terasa din selectie si o alegere buna pentru a umbri o masa cu scaune. Acest model vidaXL are o proiectie de 250 cm si o latime de 300 cm, deci acopera un colt de terasa cu o masa, si o nuanta antracit moderna, care se potriveste pe fatade contemporane. Panza din poliester o face usoara, doar 19.8 kg, iar actionarea automata, cu motor, iti permite sa o intinzi si sa o strangi la o apasare de buton. E cea mai ieftina copertina de terasa de aici, un bun punct de plecare. Panza din poliester e ceva mai putin robusta decat textilul gros, iar produsul e nou, cu putine pareri. O iei cand vrei cea mai accesibila copertina de terasa automata, cu proiectie buna si aspect modern, pentru a umbri o masa, si nu insisti pe cel mai rezistent material.' },
  { g: 'terasa', id: 'D2J6WB3BM', badge: 'Cadru din aluminiu', short: 'Visiniu 250 cm', dim: '250 cm', material: 'Aluminiu', actionare: 'Automata',
    specs: ['proiectie 250 cm, latime 300 cm', 'cadru din aluminiu, robust', 'nuanta visiniu, calda', 'actionare automata'],
    pros: ['Cadru din aluminiu, robust si rezistent la rugina', 'Proiectie buna, 250 cm', 'Nuanta visiniu, calda si distincta', 'Actionare automata cu motor'],
    cons: ['Mai grea, 37 kg, montaj mai serios', 'Produs nou, fara pareri inca'],
    verdict: 'O copertina de terasa cu cadru robust din aluminiu, pentru cine pune pret pe rezistenta structurii. Acest model vidaXL are o proiectie de 250 cm si o latime de 300 cm, cu un cadru din aluminiu care nu rugineste si e mai solid decat structurile usoare, plus o nuanta visiniu calda, care iese din tiparul nuantelor neutre. Actionarea automata, cu motor, o intinde si o strange comod. Fiind cu cadru de aluminiu, e mai grea, aproape 37 kg, deci montajul e ceva mai serios si de obicei se face in doi. E un produs nou, fara pareri inca, deci te bazezi pe specificatii. O iei cand vrei o copertina de terasa cu un cadru robust din aluminiu, proiectie buna si o nuanta calda, si nu te deranjeaza greutatea mai mare la montaj, in schimbul unei structuri mai solide.' },
  { g: 'terasa', id: 'D2KC6HMBM', badge: 'Lata, de 450 cm', short: 'Crem 450 cm', dim: '300 cm', material: 'Textil', actionare: 'Automata',
    specs: ['latime mare, 450 cm, proiectie 300 cm', 'nuanta crem, luminoasa', 'panza din textil', 'actionare automata'],
    pros: ['Lata, 450 cm, acopera o terasa generoasa', 'Proiectie mare, 300 cm', 'Nuanta crem, luminoasa si neutra', 'Actionare automata cu motor'],
    cons: ['Nota 3, dintr-o singura parere', 'Necesita un perete lat pentru montaj'],
    verdict: 'O copertina lata, pentru o terasa generoasa care are nevoie de multa umbra. Acest model vidaXL are o latime de 450 cm si o proiectie de 300 cm, deci acopera o zona mare, cu o masa lunga si mai multe scaune, potrivit pentru o terasa spatioasa sau o familie mare. Nuanta crem e luminoasa si neutra, se asorteaza usor cu orice fatada, iar panza din textil si actionarea automata completeaza pachetul. Are nevoie de un perete suficient de lat pentru montaj, iar nota, 3 dintr-o singura parere, e prea putin ca sa spuna ceva, deci te bazezi pe specificatii. O iei cand ai o terasa mare si vrei o copertina lata, de 450 cm, cu proiectie generoasa, intr-o nuanta crem neutra, si ai un perete suficient de lat pe care sa o montezi.' },
  { g: 'terasa', id: 'D9R96XMBM', badge: 'Cea mai mare proiectie', short: 'Antracit 350 cm', dim: '350 cm', material: 'Poliester', actionare: 'Automata',
    specs: ['proiectie 350 cm, cea mai mare din selectie', 'latime 450 cm, acopera mult', 'nuanta antracit, moderna', 'actionare automata'],
    pros: ['Cea mai mare proiectie din selectie, 350 cm', 'Lata, 450 cm, umbra pentru o terasa mare', 'Nuanta antracit, moderna', 'Actionare automata cu motor'],
    cons: ['Mare si grea, montaj serios', 'Produs nou, fara pareri inca'],
    verdict: 'Copertina cu cea mai mare proiectie din selectie, pentru cine vrea umbra adanca pe o terasa mare. Acest model vidaXL are o proiectie de 350 cm, cea mai mare de aici, si o latime de 450 cm, deci creeaza o zona de umbra generoasa, care iese mult de la perete si acopera confortabil o masa cu scaune, chiar si la orele cand soarele bate piezis. Nuanta antracit ii da un aspect modern, iar actionarea automata o face comoda de folosit. Fiind mare, e si grea, cu un montaj serios, de obicei in doi si cu prinderi solide in perete. E un produs nou, fara pareri inca. O iei cand ai o terasa mare si vrei cea mai adanca umbra din selectie, cu proiectie de 350 cm si latime generoasa, si esti pregatit pentru un montaj mai pretentios al unei copertine de dimensiuni mari.' },
  // --- Cu stor, LED si senzor de vant ---
  { g: 'dotari', id: 'DPC90JMBM', badge: 'Cu stor frontal', short: 'Cu stor', dim: '3 x 2.5 m', material: 'Aluminiu', actionare: 'Automata',
    specs: ['copertina cu stor frontal reglabil', 'protectie in plus fata de soarele piezis', 'cadru din aluminiu, 3 x 2.5 m', 'actionare automata'],
    pros: ['Are un stor frontal, coboara pentru umbra in plus', 'Te apara si de soarele piezis, de dimineata si seara', 'Cadru din aluminiu, robust', 'Actionare automata'],
    cons: ['Produs nou, fara pareri inca', 'Storul cere reglaj separat'],
    verdict: 'Copertina de ales daca vrei protectie si de soarele care bate piezis, nu doar de sus. Acest model vidaXL are, pe langa panza principala, un stor frontal reglabil, un panou care coboara din marginea copertinei, deci te apara si de soarele de dimineata sau de seara, care intra pe sub o copertina obisnuita, si iti da mai multa intimitate. Are un cadru din aluminiu robust, dimensiunea de 3 x 2.5 m si actionare automata. E o solutie mai completa decat o copertina simpla, potrivita pentru o terasa expusa la soare din lateral. Storul cere un reglaj separat, iar produsul e nou, fara pareri inca. O iei cand vrei o copertina cu stor frontal, pentru protectie si de soarele piezis, nu doar de cel de sus, si preferi o solutie mai completa pentru o terasa expusa lateral.' },
  { g: 'dotari', id: 'DBCV6XMBM', badge: 'Cu LED si senzor de vant', short: 'Cu LED + senzor', dim: '350 cm', material: 'Textil', actionare: 'Manuala',
    specs: ['cu iluminare LED integrata', 'senzor de vant pentru protectie', 'antracit, 450 x 350 cm, textil', 'se strange singura pe vant puternic'],
    pros: ['Iluminare LED, folosesti terasa si seara', 'Senzor de vant, se strange singura la vant puternic', 'Mare, 350 cm proiectie, textil', 'Protejeaza copertina de deteriorare'],
    cons: ['Nota 3, dintr-o singura parere', 'Pret ridicat'],
    verdict: 'O copertina mare cu doua dotari care conteaza: lumina si protectie la vant. Acest model vidaXL are iluminare LED integrata, deci folosesti terasa si seara, dupa lasarea intunericului, fara sa mai adaugi un corp de iluminat separat, si un senzor de vant, care strange automat copertina cand vantul devine prea puternic, protejand-o de deteriorare, una dintre cele mai frecvente cauze de stricare a copertinelor. E mare, cu proiectie de 350 cm si panza din textil, in nuanta antracit. Nota, 3 dintr-o singura parere, e prea putin ca sa conteze, deci te bazezi pe dotari si specificatii, iar pretul e ridicat. O iei cand vrei o copertina mare cu iluminare LED pentru serile pe terasa si un senzor de vant care sa o protejeze automat, si esti dispus la un pret mai mare pentru aceste dotari.' },
  { g: 'dotari', id: 'D9T90JMBM', badge: 'Cea mai completa, 5 m', short: 'Completa 5 m', dim: '5 x 3 m', material: 'Textil', actionare: 'Automata',
    specs: ['cea mai mare si mai completa, 5 x 3 m', 'cu stor, LED si senzor de vant', 'antracit, panza din textil', 'actionare automata'],
    pros: ['Cea mai mare din selectie, 5 metri latime', 'Are tot: stor, LED si senzor de vant', 'Actionare automata, textil rezistent', 'Pentru o terasa mare, complet echipata'],
    cons: ['Cea mai scumpa din selectie', 'Montaj serios, pentru un perete foarte lat'],
    verdict: 'Cea mai mare si mai completa copertina din selectie, pentru o terasa generoasa pe care vrei totul. Acest model vidaXL are 5 metri latime si 3 metri proiectie, cea mai mare suprafata de umbra de aici, si combina toate dotarile: un stor frontal pentru soarele piezis, iluminare LED pentru serile pe terasa si un senzor de vant care o strange singura la vant puternic, protejand-o. Panza e din textil, in nuanta antracit, si actionarea e automata. E, practic, o copertina complet echipata, pentru cine vrea cea mai buna experienta pe o terasa mare. E cea mai scumpa din selectie si cere un perete foarte lat si un montaj serios. O iei cand ai o terasa mare si vrei cea mai completa copertina din selectie, cu stor, LED si senzor de vant, si esti dispus la investitia si montajul unei copertine de 5 metri.' },
].map(x => ({ ...x, p: byId[x.id] })).filter(x => x.p);

const MICI = PICKS.filter(x => x.g === 'mici');
const TERASA = PICKS.filter(x => x.g === 'terasa');
const DOTARI = PICKS.filter(x => x.g === 'dotari');

const hero = '/images/articles/copertina-retractabila-pentru-terasa.webp';
const figMici = '/imagini/articole/copertina-mici.webp';
const figTerasa = '/imagini/articole/copertina-terasa.webp';
const figDotari = '/imagini/articole/copertina-dotari.webp';
const published = '2026-07-19T15:15:03+03:00';

const faq = [
  { question: 'Ce inseamna proiectia unei copertine?', answer: 'Proiectia e cat de mult iese copertina de la perete spre exterior, adica cat de adanca e umbra pe care o creeaza, si se masoara in centimetri. E la fel de importanta ca latimea: o copertina lata, dar cu proiectie mica, umbreste doar o fasie langa perete, in timp ce una cu proiectie mare acopera si o masa asezata mai departe. Modelele din selectie au proiectii intre 250 si 350 cm; pentru o masa cu scaune, o proiectie de 250-300 cm e in general suficienta, iar 350 cm iti da umbra si la orele cand soarele bate piezis. Cand alegi, gandeste-te cat de departe de perete vrei umbra, nu doar cat de lat e peretele.' },
  { question: 'Copertina cu actionare manuala sau cu motor?', answer: 'Cea manuala se intinde si se strange cu o manivela, pe care o rotesti, o solutie mai ieftina si care nu depinde de curent, dar cere ceva efort de fiecare data. Cea automata, cu motor, se deschide si se inchide la o apasare de buton sau de pe o telecomanda, mult mai comod, mai ales la copertinele mari, unde manivela ar cere multe rotiri. Majoritatea modelelor de terasa din selectie sunt automate. Dezavantajul motorului e ca depinde de o sursa de curent si costa mai mult. Daca ai o copertina mare si o folosesti des, motorul merita; pentru una mica sau daca vrei sa economisesti, actionarea manuala face treaba, doar cu ceva efort in plus.' },
  { question: 'La ce foloseste senzorul de vant?', answer: 'Vantul puternic e cel mai mare dusman al unei copertine intinse: o poate indoi, rupe sau smulge de pe perete. Senzorul de vant rezolva exact aceasta problema: cand detecteaza ca vantul a depasit un anumit prag, strange automat copertina, fara sa fii tu acasa sau sa apuci sa reactionezi, protejand-o de deteriorare. E o dotare foarte utila, mai ales daca stai intr-o zona expusa la vant sau daca lasi copertina intinsa cand pleci de acasa. Modelele mari din selectie, ca cel cu LED si senzor, au aceasta functie. Fara senzor, trebuie sa strangi tu copertina de fiecare data cand se anunta vant, altfel risti sa o strici.' },
  { question: 'Ce material de panza sa aleg?', answer: 'Panza copertinei suporta soarele, ploaia si praful, asa ca materialul conteaza pentru durabilitate. Poliesterul e cel mai raspandit si mai usor, rezistent la soare si la apa, o alegere buna si accesibila, folosit la multe modele din selectie. Textilul mai gros, tot din fibre sintetice tratate, e mai robust si mai durabil in timp, potrivit pentru copertinele mari care stau mult intinse. Indiferent de material, cauta o panza tratata sa reziste la razele UV si la apa, ca sa nu se decoloreze si sa nu lase apa sa treaca. Culoarea conteaza si ea: nuantele inchise, ca antracitul, absorb mai mult caldura, iar cele deschise, ca cremul, reflecta lumina si raman mai racoroase.' },
  { question: 'Cum montez o copertina retractabila?', answer: 'Copertina se prinde pe perete, deasupra terasei sau a ferestrei, cu console solide fixate in zid, si e important ca peretele sa fie rezistent, din caramida sau beton, nu din materiale usoare, pentru ca structura si panza intinsa creeaza o forta considerabila, mai ales pe vant. Copertinele mari si grele, ca cele de 350 cm proiectie sau de 5 metri latime, se monteaza de obicei in doi si cer prinderi robuste, iar pentru cele cu motor ai nevoie si de o sursa de curent in apropiere. La modelele mici, de fereastra, montajul e mai simplu. Daca nu esti sigur pe montaj, mai ales la o copertina mare si scumpa, merita sa apelezi la un specialist, pentru ca o prindere gresita se poate desprinde si strica atat copertina, cat si peretele.' },
  { question: 'Cum intretin o copertina de terasa?', answer: 'Cel mai important e sa nu o lasi intinsa pe vreme rea. Strange-o cand se anunta vant puternic, furtuna sau ploaie abundenta, mai ales daca nu are senzor de vant, pentru ca acestea sunt principalele cauze de deteriorare. Cand o strangi, lasa panza sa se usuce complet intai, ca sa nu mucegaiasca sau sa capete miros in caseta. Curata periodic panza de praf, frunze si pete, cu apa si o solutie blanda, fara detergenti agresivi care ii pot afecta tratamentul, si verifica din cand in cand consolele si suruburile de prindere, strangandu-le daca s-au slabit. Iarna, cel mai bine e sa o tii stransa. Cu aceasta grija, o copertina rezista multe veri si isi pastreaza panza si mecanismul in stare buna.' },
  { question: 'Cat costa o copertina retractabila?', answer: 'Preturile depind mult de dimensiune si dotari. In selectie, copertinele mici, de fereastra sau balcon, de 100 cm, pornesc de la circa 185 de lei. Cele de terasa, automate, cu proiectii de 250-350 cm, sunt in general intre 1700 si 2700 de lei, in functie de dimensiune, material si cadru. Modelele complet echipate, cu stor frontal, iluminare LED si senzor de vant, sau cele foarte mari, de pana la 5 metri, trec de 3000 si urca spre 3600 de lei. Cel mai bun raport il gasesti alegand dimensiunea potrivita terasei, adica latimea peretelui si proiectia de care ai nevoie, si doar dotarile pe care chiar le folosesti, ca senzorul de vant intr-o zona expusa sau LED-ul daca stai mult afara seara.' },
];

const images = [hero, figMici, figTerasa, figDotari, ...PICKS.map(x => x.p.image)];
---

<Layout
  title="Cele mai bune copertine retractabile pentru terasa in 2026: mici, de terasa si cu senzor"
  description="Care sunt cele mai bune copertine retractabile pentru terasa in 2026: modele mici de fereastra si balcon, copertine de terasa automate cu proiectii de 250-350 cm, si variante cu stor, LED si senzor de vant, comparate pe dimensiune, material si actionare. Plus cum alegi proiectia, materialul si montajul."
  image={hero}
  type="article"
  publishedTime={published}
  modifiedTime={published}
  author="Maria Ionescu"
  breadcrumb={[{ name: 'Acasa', url: '/' }, { name: 'Mobilier Gradina', url: '/mobilier-gradina/' }, { name: 'Cele mai bune copertine retractabile pentru terasa' }]}
  faq={faq.map(f => ({ question: f.question, answer: f.answer }))}
>
  <article class="rd">
    <nav class="breadcrumb">
      <a href="/">Acasa</a><span class="breadcrumb-separator">/</span>
      <a href="/mobilier-gradina/">Mobilier Gradina</a><span class="breadcrumb-separator">/</span>
      <span>Cele mai bune copertine retractabile pentru terasa</span>
    </nav>

    <h1>Cele mai bune copertine retractabile pentru terasa</h1>
    <p class="rd-byline">de <a href="/autori/maria-ionescu/">Maria Ionescu</a>, Designer Interior · actualizat iulie 2026</p>

    <img class="rd-hero" src={hero} alt="Cele mai bune copertine retractabile pentru terasa: mici, de terasa si cu senzor de vant" width="1200" height="675" fetchpriority="high" />

    <div class="rd-intro">
      <p>Pentru o terasa, cea mai accesibila copertina automata e cea <strong>antracit de 250 cm</strong>, iar cea mai mare umbra o da modelul de <strong>350 cm proiectie</strong>. Daca vrei totul, varianta <strong>completa de 5 metri</strong> are stor, LED si senzor de vant, iar pentru o fereastra sau un balcon, ajung <strong>copertinele compacte de 100 cm</strong>.</p>
      <p>La o copertina retractabila conteaza <strong>dimensiunea</strong>, adica latimea si proiectia potrivite terasei, <strong>materialul</strong> panzei, <strong>actionarea</strong>, manuala sau cu motor, si dotari ca <strong>senzorul de vant</strong>. Mai jos gasesti direct recomandarile, grupate pe marime si dotari, iar sub ele un ghid despre cum alegi.</p>
      <p>Trebuie spus cinstit: copertinele din aceasta selectie sunt in mare parte produse noi, de la vidaXL, un brand cunoscut pentru articole de casa si gradina, si au inca putine pareri. Le-am ales asadar dupa dimensiune, material si dotari, nu dupa recenzii, si le-am impartit in copertine mici, de terasa si cu dotari suplimentare, ca sa gasesti repede tipul potrivit spatiului tau. Pentru umbra fixa, vezi si <a href="/pergola-din-lemn-pentru-terasa/">pergolele din lemn</a> si <a href="/pavilion-de-gradina-rezistent-la-apa/">pavilioanele de gradina</a>.</p>
    </div>

    <details class="rd-toc">
      <summary>Cuprins</summary>
      <ol>
        <li><a href="#tabel">Comparatie rapida</a></li>
        <li><a href="#mici">Mici, de fereastra si balcon</a></li>
        <li><a href="#terasa">De terasa, automate</a></li>
        <li><a href="#dotari">Cu stor, LED si senzor de vant</a></li>
        <li><a href="#de-ce">De ce o copertina retractabila</a></li>
        <li><a href="#conteaza">Ce conteaza cand alegi</a></li>
        <li><a href="#montaj">Montaj si intretinere</a></li>
        <li><a href="#cat-costa">Cat costa</a></li>
        <li><a href="#faq">Intrebari frecvente</a></li>
      </ol>
    </details>

