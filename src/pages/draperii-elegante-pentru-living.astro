---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import SimilarArticles from '../components/SimilarArticles.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import emag from '../data/emag-products.json';
import keywordsData from '../../keywords.json';
import { visibleArticles, slugify } from '../lib/articles.mjs';

const relatedArticles = visibleArticles(keywordsData.completed).map(item => ({
  title: item.keyword.charAt(0).toUpperCase() + item.keyword.slice(1),
  slug: item.slug || slugify(item.keyword),
  excerpt: item.excerpt || '',
  image: item.image || `/images/articles/${item.slug || slugify(item.keyword)}.webp`,
  category: item.category,
  categorySlug: item.categorySlug,
  date: item.date || '',
}));

const pool = emag['draperii-catifea'] || [];
const byId = Object.fromEntries(pool.map(p => [p.id, p]));

const PICKS = [
  // --- Nuante calde ---
  { g: 'cald', id: 'DP84LZBBM', badge: 'Coniac, cald si elegant', short: 'Coniac', culoare: 'Coniac', dim: '175 x 250 cm', ton: 'Cald',
    specs: ['catifea, culoare coniac, set 2 panouri', '175 x 250 cm fiecare panou', 'nuanta calda, eleganta, versatila', '283 pareri, nota 4.76'],
    pros: ['Nuanta coniac, calda si eleganta, se asorteaza usor', 'Catifea cu cadere bogata, aspect premium', 'Set de 2 panouri, pentru o fereastra de living', '283 de pareri, nota mare 4.76'],
    cons: ['Catifeaua cere intretinere cu grija', 'Tonul cald nu merge cu orice paleta rece'],
    verdict: 'Cu 283 de pareri si nota 4.76, gama Mastel de catifea e cea mai apreciata din selectie, iar nuanta coniac e alegerea calda si eleganta prin excelenta. Coniacul, un maro cald cu reflexe aurii, aduce imediat un aer de rafinament in living, se asorteaza usor cu lemnul, cu bejul si cu tonurile neutre, si e destul de discret cat sa nu domine camera. Catifeaua cade bogat si prinde frumos lumina, cu acel aspect premium pe care doar ea il da. Are, ca orice catifea, nevoie de intretinere cu grija, iar tonul cald nu se potriveste unei palete foarte reci. Il iei cand vrei draperii de catifea elegante intr-o nuanta calda si versatila, coniac, care sa dea living-ului un aer rafinat fara sa iasa strident in evidenta.' },
  { g: 'cald', id: 'D7XGQVBBM', badge: 'Maro, clasic si discret', short: 'Maro', culoare: 'Maro', dim: '175 x 250 cm', ton: 'Cald',
    specs: ['catifea, culoare maro, set 2 panouri', '175 x 250 cm fiecare', 'nuanta clasica, neutra, discreta', '282 pareri, nota 4.76'],
    pros: ['Maro clasic, cea mai neutra nuanta calda', 'Se potriveste aproape oricarui living', 'Catifea eleganta, cadere bogata', 'Foarte testata, 282 de pareri'],
    cons: ['Maroul poate parea sobru intr-o camera mica', 'Nuanta mai putin spectaculoasa'],
    verdict: 'Daca vrei eleganta catifelei fara nicio bataie de cap la asortare, maroul clasic e cea mai sigura nuanta calda. E discret si neutru, se potriveste aproape oricarui living, de la mobila de lemn la tonuri crem, si nu risti sa dea un accent gresit, ceea ce il face alegerea celor care vor un rezultat cald si sigur. Catifeaua Mastel isi pastreaza aici caderea bogata si aspectul premium, cu aceeasi nota 4.76 din 282 de pareri. Intr-o camera mica si intunecata, maroul poate parea ceva mai sobru, iar ca aspect e mai putin spectaculos decat culorile intense. Il iei cand vrei draperii de catifea elegante intr-o nuanta calda cat mai sigura si neutra, maro, care sa se integreze fara efort in orice living.' },
  { g: 'cald', id: 'DJN3DZBBM', badge: 'Cea mai accesibila', short: 'Cappuccino', culoare: 'Cappuccino', dim: '130 x 245 cm', ton: 'Cald',
    specs: ['catifea, culoare cappuccino deschis', '130 x 245 cm, panouri mai inguste', 'nuanta deschisa, luminoasa', '283 pareri, nota 4.76, cel mai mic pret'],
    pros: ['Cel mai mic pret din selectie', 'Nuanta cappuccino deschisa, luminoasa si calda', 'Panouri mai inguste, pentru ferestre mai mici', 'Aceeasi catifea apreciata, 283 de pareri'],
    cons: ['Panouri mai inguste, 130 cm, pentru ferestre mici', 'Nuanta deschisa se pateaza mai vizibil'],
    verdict: 'Cand vrei catifeaua eleganta la cel mai bun pret, varianta cappuccino e cea mai accesibila din selectie, si asta pentru ca vine in panouri mai inguste, de 130 cm, potrivite ferestrelor mai mici. Cappuccino, un bej cald deschis, lumineaza camera si o incalzeste, o alegere buna pentru un living mai mic sau mai intunecat, unde nuantele inchise ar apasa. E aceeasi catifea Mastel apreciata, cu nota 4.76 din 283 de pareri. Panourile mai inguste inseamna ca pentru o fereastra larga alegi alta dimensiune, iar nuanta deschisa arata petele mai usor. Il iei cand vrei draperii de catifea elegante la cel mai mic pret, intr-o nuanta deschisa si luminoasa, pentru o fereastra de dimensiune mai mica.' },
  // --- Nuante intense ---
  { g: 'intens', id: 'D484LZBBM', badge: 'Rosu, cald si dramatic', short: 'Rosu', culoare: 'Rosu', dim: '175 x 260 cm', ton: 'Intens',
    specs: ['catifea, culoare rosu, set 2 panouri', '175 x 260 cm, panouri lungi', 'nuanta calda, dramatica, aspect luxos', '283 pareri, nota 4.76'],
    pros: ['Rosu intens, aspect luxos si primitor', 'Catifeaua da rosului o profunzime bogata', 'Panouri lungi, 260 cm, cadere spectaculoasa', 'Foarte apreciata, 283 de pareri'],
    cons: ['Culoare puternica, domina camera', 'Cere o mobila si pereti care s-o sustina'],
    verdict: 'Pentru un living cu personalitate, rosul in catifea e alegerea care schimba complet atmosfera. Catifeaua da rosului o profunzime bogata, aproape teatrala, si transforma camera intr-un spatiu cald, primitor si luxos, cum vezi in interioarele clasice si elegante. Panourile lungi, de 260 cm, cad spectaculos pana la podea. E aceeasi calitate Mastel, cu nota 4.76 din 283 de pareri. Trebuie stiut ca rosul e o culoare puternica: domina camera si cere o mobila si pereti in tonuri care sa il sustina, altfel poate coplesi. Il iei cand vrei sa dai living-ului un aer luxos si cald, cu un accent puternic, si ai o camera si un decor care sustin o culoare atat de intensa.' },
  { g: 'intens', id: 'DSZH8SBBM', badge: 'Grena, bordo profund', short: 'Grena', culoare: 'Grena', dim: '250 x 245 cm', ton: 'Intens',
    specs: ['catifea, culoare grena, set 2 panouri', '250 x 245 cm, panouri late', 'bordo profund, elegant si matur', '282 pareri, nota 4.76'],
    pros: ['Grena, un bordo profund, elegant si matur', 'Mai subtila decat rosul aprins, dar tot bogata', 'Panouri late, 250 cm, pentru ferestre mari', '282 de pareri, nota 4.76'],
    cons: ['Mai scumpa, fiind panouri late', 'Tot o culoare inchisa, intuneca putin camera'],
    verdict: 'Intre rosul aprins si nuantele neutre, grena ofera eleganta bordoului fara dramatismul rosului pur. E un rosu inchis, profund, cu o nota mai matura si mai sobra, care aduce lux si caldura in living dar intr-un fel mai discret si mai rafinat, potrivit unui spatiu care vrea sa para elegant, nu exuberant. Panourile late, de 250 cm, acopera ferestre mari si cad bogat. E tot catifea Mastel, cu nota 4.76 din 282 de pareri. Fiind late, costa mai mult, iar ca orice nuanta inchisa, intuneca putin camera. Il iei cand vrei o culoare bogata si eleganta pentru un living generos, un bordo profund mai matur si mai rafinat decat rosul aprins, pe o fereastra larga.' },
  { g: 'intens', id: 'D0JZHVBBM', badge: 'Mov-lila, rafinat', short: 'Mov-lila', culoare: 'Mov-lila', dim: '175 x 245 cm', ton: 'Intens',
    specs: ['catifea, culoare mov-lila, set 2 panouri', '175 x 245 cm', 'nuanta aparte, rafinata si moderna', '282 pareri, nota 4.76'],
    pros: ['Mov-lila, o nuanta aparte, care iese din comun', 'Rafinata si moderna, da un accent de personalitate', 'Catifeaua ii adauga profunzime', '282 de pareri, nota 4.76'],
    cons: ['Culoare de nisa, nu place tuturor', 'Mai greu de asortat cu mobila'],
    verdict: 'Pentru cine vrea sa iasa din tiparul obisnuit, mov-lila e nuanta care da caracter unui living. E o culoare aparte, rafinata si moderna, care iese din comun fara sa fie stridenta, mai ales in catifea, care ii adauga profunzime si eleganta, transformand draperiile intr-un accent de personalitate al camerei. E aceeasi catifea Mastel apreciata, cu nota 4.76 din 282 de pareri. Fiind o culoare de nisa, nu place tuturor si e mai greu de asortat cu mobila decat nuantele neutre, deci se potriveste cel mai bine unui decor gandit in jurul ei. Il iei cand vrei ceva diferit si rafinat, o nuanta mov-lila care sa dea living-ului o personalitate aparte, si ai un decor care o pune in valoare.' },
  // --- Neutre si dimensiuni mari ---
  { g: 'neutru', id: 'D0PB0QBBM', badge: 'Gri, modern si versatil', short: 'Gri', culoare: 'Gri', dim: '175 x 245 cm', ton: 'Neutru',
    specs: ['catifea, culoare gri, set 2 panouri', '175 x 245 cm', 'nuanta moderna, se asorteaza cu orice', '219 pareri, nota 4.78'],
    pros: ['Gri, cea mai moderna si versatila nuanta', 'Se asorteaza cu aproape orice decor', 'Catifeaua ii da un aspect elegant, nu rece', 'Nota 4.78, cea mai mare din selectie'],
    cons: ['Ceva mai putine pareri, 219', 'Griul poate parea neutru pentru cine vrea culoare'],
    verdict: 'Daca vrei o nuanta care merge cu absolut orice si arata modern, griul in catifea e alegerea cea mai sigura si mai actuala. Griul e neutrul prin excelenta al designului contemporan: se asorteaza cu orice culoare de pereti si de mobila, de la alb si lemn la tonuri indraznete, iar catifeaua il salveaza de la a parea rece, dandu-i in schimb un aspect cald si elegant. Are chiar cea mai mare nota din selectie, 4.78, din 219 pareri. Are ceva mai putine recenzii decat nuantele clasice, iar pentru cine cauta un accent de culoare, griul poate parea prea neutru. Il iei cand vrei draperii de catifea elegante si moderne care sa se potriveasca oricarui decor, o nuanta gri versatila si actuala, cu cea mai mare nota din selectie.' },
  { g: 'neutru', id: 'DPJZHVBBM', badge: 'Maro wenge, sofisticat', short: 'Maro wenge', culoare: 'Maro wenge', dim: '175 x 245 cm', ton: 'Neutru',
    specs: ['catifea, culoare maro wenge inchis', '175 x 245 cm', 'nuanta inchisa, sofisticata', '282 pareri, nota 4.76'],
    pros: ['Maro wenge, un maro inchis sofisticat', 'Da profunzime si eleganta camerei', 'Se asorteaza cu mobila inchisa la culoare', '282 de pareri, nota 4.76'],
    cons: ['Nuanta inchisa, intuneca putin camera', 'Se potriveste mai ales spatiilor generoase'],
    verdict: 'O alternativa mai inchisa si mai sofisticata a maroului clasic o gasesti in nuanta wenge, un maro adanc, aproape ciocolatiu. Wenge da profunzime si o eleganta grava camerei, se asorteaza superb cu mobila inchisa la culoare si cu parchetul de nuanta calda, si transforma living-ul intr-un spatiu matur si rafinat. E aceeasi catifea Mastel, cu nota 4.76 din 282 de pareri. Fiind o nuanta inchisa, intuneca putin camera, deci se potriveste cel mai bine unui living generos si luminos, unde adauga adancime fara sa apese. Il iei cand vrei un maro mai inchis si mai sofisticat decat cel clasic, o nuanta wenge care sa dea living-ului profunzime si eleganta, intr-un spatiu suficient de luminos.' },
  { g: 'neutru', id: 'DK144YMBM', badge: 'XXL, pentru ferestre largi', short: 'Maro XXL 300 cm', culoare: 'Maro', dim: '300 x 245 cm', ton: 'Neutru',
    specs: ['catifea, culoare maro, panouri XXL', '300 x 245 cm fiecare panou, foarte late', 'pentru ferestre si usi de balcon largi', '219 pareri, nota 4.78'],
    pros: ['Panouri XXL, 300 cm, cele mai late din selectie', 'Ideale pentru ferestre mari si usi de balcon', 'Cadere bogata, foarte generoasa', 'Nota mare, 4.78'],
    cons: ['Cea mai scumpa din selectie', 'Prea late pentru o fereastra obisnuita'],
    verdict: 'Pentru ferestrele foarte largi si usile de balcon, unde panourile obisnuite raman scurte, varianta XXL de 300 cm rezolva problema. Sunt cele mai late panouri din selectie, care acopera generos deschideri mari si cad bogat, cu pliuri ample, pentru un aspect impunator intr-un living spatios. E tot maro, o nuanta sigura, aceeasi catifea Mastel cu nota 4.78 din 219 pareri. E cea mai scumpa optiune, tocmai pentru ca e atat de mare, iar pe o fereastra obisnuita ar fi mult prea lata, adunand prea mult material. Il iei cand ai o fereastra foarte larga sau o usa de balcon mare si ai nevoie de panouri XXL de 300 cm, care sa o acopere complet si sa cada bogat, elegant.' },
].map(x => ({ ...x, p: byId[x.id] })).filter(x => x.p);

const CALD = PICKS.filter(x => x.g === 'cald');
const INTENS = PICKS.filter(x => x.g === 'intens');
const NEUTRU = PICKS.filter(x => x.g === 'neutru');

const hero = '/images/articles/draperii-elegante-pentru-living.webp';
const figCald = '/imagini/articole/draperii-calde.webp';
const figIntens = '/imagini/articole/draperii-intense.webp';
const figNeutru = '/imagini/articole/draperii-neutre.webp';
const published = '2026-07-19T20:41:19+03:00';

const faq = [
  { question: 'De ce sa aleg draperii de catifea pentru living?', answer: 'Catifeaua e materialul care ridica instant nivelul unui living. Are o cadere grea si bogata, care formeaza pliuri ample si elegante, si o textura care prinde lumina si joaca intre umbra si stralucire, dand camerei un aspect luxos si primitor pe care putine tesaturi il obtin. Dincolo de estetica, catifeaua e groasa, deci si functionala: izoleaza termic, tinand caldura iarna si racoarea vara, atenueaza zgomotul de afara si blocheaza bine lumina, utila daca vrei si intimitate, si intuneric. E alegerea potrivita pentru un living in care vrei un aer elegant, cald si ingrijit, unde draperiile nu sunt doar functionale, ci o piesa de decor in sine, care da tonul intregii camere.' },
  { question: 'Ce culoare de draperii sa aleg pentru living?', answer: 'Depinde de atmosfera pe care o vrei si de decorul existent. Nuantele neutre, ca griul, maroul si cappuccino, sunt cele mai sigure: se asorteaza cu aproape orice mobila si pereti, dau eleganta fara sa domine si nu se demodeaza, alegerea buna daca vrei ceva versatil si de durata. Nuantele calde, ca coniacul si maroul, incalzesc camera si merg cu lemnul si tonurile pamantii. Culorile intense, ca rosul, grena si mov-lila, sunt pentru cine vrea un accent puternic si un living cu personalitate, dar cer o camera si o mobila care sa le sustina. Un sfat practic: daca peretii si mobila sunt deja colorati sau cu model, alege draperii neutre; daca totul e simplu si neutru, iti poti permite o culoare intensa ca punct de atractie.' },
  { question: 'Ce dimensiune de draperii imi trebuie?', answer: 'Pentru un aspect elegant, draperiile trebuie sa fie mai late decat fereastra si suficient de lungi cat sa cada frumos. Ca latime, regula e ca panourile adunate sa fie de aproximativ doua ori latimea ferestrei, ca sa faca pliuri bogate cand sunt trase, nu sa stea intinse si sarace; de aceea seturile vin cu doua panouri. Alege latimea totala in functie de fereastra: panouri de 130-175 cm pentru ferestre obisnuite, de 200-250 cm pentru ferestre largi, si XXL de 300 cm pentru usi de balcon si deschideri foarte mari. Ca lungime, cele de 245-260 cm ajung de la o sina obisnuita aproape pana la podea, caderea ideala. Masoara fereastra si inaltimea de la sina la podea inainte de a comanda, si alege cu putina rezerva la latime pentru pliuri frumoase.' },
  { question: 'Draperiile de catifea izoleaza termic si fonic?', answer: 'Da, si e unul dintre marile lor avantaje practice, pe langa aspect. Catifeaua e o tesatura groasa si densa, iar acest lucru o face o bariera buna: termic, tine caldura in camera iarna, reducand pierderile prin geam, si opreste o parte din caldura soarelui vara, ajutand living-ul sa ramana mai racoros, ceea ce se poate simti chiar la confortul si la factura de energie. Fonic, aceeasi grosime absoarbe o parte din zgomotul de afara, nu il elimina complet, dar il atenueaza vizibil, util daca stai la strada sau intr-o zona aglomerata. In plus, catifeaua blocheaza bine si lumina, oferind intimitate seara. Practic, alegand catifea nu iei doar un element decorativ elegant, ci si un plus real de confort termic, acustic si de intimitate.' },
  { question: 'Cum am grija de draperiile de catifea?', answer: 'Catifeaua cere o intretinere ceva mai atenta decat o tesatura obisnuita, dar nu complicata. Verifica intai eticheta: multe draperii de catifea se spala in masina la temperatura joasa, cu un program delicat si fara centrifugare puternica, dar unele se curata mai bine profesional, la curatatorie, ca sa nu se turteasca sau sa se deformeze firul. Nu le stoarce si nu le rasuci; e mai bine sa le atarni usor umede, ca sa se intinda singure sub propria greutate si sa nu aiba nevoie de calcat. Daca totusi calci, foloseste temperatura mica si calca pe dos, printr-o carpa, sau foloseste aburul de la distanta. Intre spalari, o aspirare usoara cu duza pentru tapiterie indeparteaza praful si prospeteste catifeaua. Cu aceasta grija, draperiile isi pastreaza caderea bogata si luciul ani buni.' },
  { question: 'Cum montez draperiile ca sa arate elegant?', answer: 'Cateva trucuri simple fac diferenta intre draperii care arata banal si unele care arata scump. Primul: monteaza sina sau bara mai sus decat marginea de sus a ferestrei, ideal aproape de tavan, si mai lata decat geamul; asta inalta vizual camera si lasa fereastra sa para mai mare, un truc de designer. Al doilea: alege draperii suficient de lungi cat sa atinga aproape podeaua sau sa cada exact pana la ea, pentru o linie eleganta; draperiile scurte, care se opresc la pervaz, ieftinesc aspectul. Al treilea: asigura latime destula, panourile adunate sa fie generoase, ca sa faca pliuri bogate. In fine, foloseste ciucurii sau cordoanele de prindere, pe care multe seturi le includ, ca sa strangi frumos draperia in timpul zilei. Cu aceste detalii, chiar si draperii accesibile arata rafinat.' },
  { question: 'Cat costa niste draperii elegante de living?', answer: 'In selectie, seturile de catifea Mastel, cele mai apreciate, cu 282 de pareri si nota 4.76, pornesc de la circa 193 de lei pentru varianta cappuccino cu panouri mai inguste, si stau in jur de 255 de lei pentru dimensiunea obisnuita de 175 cm, in majoritatea culorilor. Panourile late, de 225-250 cm, pentru ferestre mari, sunt in zona 324-358 de lei, iar varianta XXL de 300 cm, pentru usi de balcon, ajunge spre 427 de lei. Pretul creste, asadar, mai ales cu latimea panourilor, nu cu culoarea. Cel mai bun raport il gasesti alegand exact dimensiunea de care ai nevoie: masoara fereastra, ca sa nu platesti pentru panouri prea late, si alege nuanta care se potriveste decorului tau. Pentru un set de draperii de catifea foarte bine notate, e o investitie rezonabila intr-un living mai elegant.' },
];

const images = [hero, figCald, figIntens, figNeutru, ...PICKS.map(x => x.p.image)];
---

<Layout
  title="Cele mai bune draperii elegante pentru living in 2026: nuante calde, intense si neutre"
  description="Care sunt cele mai bune draperii elegante pentru living in 2026: gama de catifea Mastel, cu 282 de pareri si nota 4.76, in nuante calde ca coniac si maro, intense ca rosu, grena si mov-lila, si neutre ca gri si wenge, plus dimensiuni pana la XXL. Ghid de culoare si marime, cum alegi si cum ai grija de catifea."
  image={hero}
  type="article"
  publishedTime={published}
  modifiedTime={published}
  author="Redactia CentroCasa"
  breadcrumb={[{ name: 'Acasa', url: '/' }, { name: 'Decoratiuni Casa', url: '/decoratiuni-casa/' }, { name: 'Cele mai bune draperii elegante pentru living' }]}
  faq={faq.map(f => ({ question: f.question, answer: f.answer }))}
>
  <article class="rd">
    <nav class="breadcrumb">
      <a href="/">Acasa</a><span class="breadcrumb-separator">/</span>
      <a href="/decoratiuni-casa/">Decoratiuni Casa</a><span class="breadcrumb-separator">/</span>
      <span>Cele mai bune draperii elegante pentru living</span>
    </nav>

    <h1>Cele mai bune draperii elegante pentru living</h1>
    <p class="rd-byline">de <a href="/despre/">Redactia CentroCasa</a> · actualizat iulie 2026</p>

    <img class="rd-hero" src={hero} alt="Cele mai bune draperii elegante de catifea pentru living: nuante calde, intense si neutre" width="1200" height="675" fetchpriority="high" />

    <div class="rd-intro">
      <p>Cele mai apreciate draperii de living din selectie sunt seturile de catifea <strong>Mastel</strong>, cu peste 280 de pareri si nota 4.76. Le gasesti in multe nuante si dimensiuni, iar acest ghid te ajuta sa alegi <strong>culoarea si marimea</strong> potrivite living-ului tau, de la coniac cald la grena profund si gri modern.</p>
      <p>Catifeaua ridica instant nivelul unei camere: <strong>cadere bogata, aspect luxos, plus izolare termica si fonica</strong>. Mai jos gasesti recomandarile grupate pe nuante, calde, intense si neutre, iar sub ele un ghid despre cum alegi culoarea, dimensiunea si cum ai grija de catifea.</p>
      <p>Sa fim clari: aici e vorba de aceeasi gama Mastel de catifea, foarte bine notata, in variantele ei de culoare si marime, nu de produse diferite care concureaza. Rolul articolului e sa te ajute sa alegi <strong>varianta potrivita</strong>, cu nuanta, dimensiune si aspect explicate la fiecare. Pentru dormitor, vezi <a href="/perdele-blackout-pentru-dormitor/">perdelele blackout</a>, iar pentru podea, <a href="/covor-modern-pentru-living/">covoarele moderne de living</a>.</p>
    </div>

    <details class="rd-toc">
      <summary>Cuprins</summary>
      <ol>
        <li><a href="#tabel">Comparatie rapida</a></li>
        <li><a href="#cald">Nuante calde: coniac, maro, cappuccino</a></li>
        <li><a href="#intens">Nuante intense: rosu, grena, mov-lila</a></li>
        <li><a href="#neutru">Neutre si dimensiuni mari</a></li>
        <li><a href="#de-ce">De ce catifea in living</a></li>
        <li><a href="#culoare">Cum alegi culoarea</a></li>
        <li><a href="#dimensiune">Cum alegi dimensiunea</a></li>
        <li><a href="#montaj">Montajul si intretinerea</a></li>
        <li><a href="#cat-costa">Cat costa</a></li>
        <li><a href="#faq">Intrebari frecvente</a></li>
      </ol>
    </details>

    <h2 id="tabel">Comparatie rapida</h2>
    <div class="table-wrap">
      <table class="rd-table">
        <thead><tr><th>Varianta</th><th>Nuanta</th><th>Dimensiune</th><th>Nota</th></tr></thead>
        <tbody>
          {PICKS.map(x => (
            <tr>
              <td><div class="cmp-prod"><img class="cmp-thumb" src={x.p.image} alt={x.short} loading="lazy" width="44" height="44" /><span>{x.short}</span></div></td>
              <td>{x.ton}</td>
              <td>{x.dim}</td>
              <td>{x.p.rating} ({x.p.reviews})</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 id="cald">Nuante calde: coniac, maro, cappuccino</h2>
    <p>Cele mai sigure alegeri, care incalzesc camera si se asorteaza usor cu lemnul si tonurile neutre. De la coniacul elegant la maroul clasic si la cappuccino, cea mai deschisa si accesibila nuanta. Perfecte pentru un living cald si primitor.</p>
