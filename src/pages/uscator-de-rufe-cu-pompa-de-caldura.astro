  { g: 'acc', id: 'D6MFD0MBM', badge: 'Cel mai ieftin', short: 'Candy Smart Pro', capacitate: '8 kg', programe: '14', zgomot: '67 dB',
    specs: ['cel mai mic pret din selectie', '8 kg, pompa de caldura, 14 programe', 'conectivitate Smart Pro', 'uscare intensiva si programe rapide'],
    pros: ['Cel mai mic pret din toata selectia', 'Pompa de caldura la buget minim', 'Conectivitate Smart Pro, control din aplicatie', '8 kg, bun pentru o familie'],
    cons: ['Nota 4.28, cea mai modesta din grup', 'Zgomot de 67 dB, printre cele mai ridicate'],
