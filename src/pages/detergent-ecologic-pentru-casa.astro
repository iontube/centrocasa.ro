---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import SimilarArticles from '../components/SimilarArticles.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import emag from '../data/emag-products.json';
import keywordsData from '../../keywords.json';
import { visibleArticles, slugify } from '../lib/articles.mjs';

const relatedArticles = visibleArticles(keywordsData.completed).map(item => ({
  title: item.keyword.charAt(0).toUpperCase() + item.keyword.slice(1),
  slug: item.slug || slugify(item.keyword),
  excerpt: item.excerpt || '',
  image: item.image || `/images/articles/${item.slug || slugify(item.keyword)}.webp`,
  category: item.category,
  categorySlug: item.categorySlug,
  date: item.date || '',
}));

const pool = emag['detergent-eco'] || [];
const byId = Object.fromEntries(pool.map(p => [p.id, p]));

const PICKS = [
  // --- Universale si multisuprafete ---
  { g: 'univ', id: 'DLJPBMBBM', badge: 'Cel mai bine notat', short: 'Frosch anticalcar', tip: 'Universal', pentru: 'Suprafete, anticalcar', form: '1 L',
    specs: ['detergent ecologic anticalcar, cu otet', 'Frosch, brand german eco cunoscut', 'dizolva calcarul si da luciu', '41 pareri, nota 4.88, cea mai mare din selectie'],
    pros: ['Cea mai mare nota din selectie, 4.88, cu multe pareri', 'Pe baza de otet, dizolva calcarul natural', 'De la Frosch, brand german eco de incredere', 'Cel mai accesibil pret din selectie'],
    cons: ['Pentru suprafete, nu pentru rufe', 'Mirosul de otet nu place tuturor'],
    verdict: 'Cu 41 de pareri si nota 4.88, cea mai mare din selectie, detergentul anticalcar Frosch cu otet e cel mai apreciat produs de aici, si o alegere de start excelenta pentru curatenie ecologica. Foloseste puterea otetului ca sa dizolve calcarul de pe robinete, gresie, faianta si obiecte sanitare, si sa lase luciu, fara clor sau substante agresive, iar Frosch e un brand german cu reputatie solida in produsele eco. E si cel mai ieftin din selectie. E gandit pentru suprafete, nu pentru rufe, iar mirosul de otet, chiar daca dispare la uscare, nu place tuturor. Il iei cand vrei cel mai bine notat detergent ecologic din selectie, ieftin si eficient pe calcar, de la un brand eco de incredere, pentru curatenia din baie si bucatarie.' },
  { g: 'univ', id: 'DCDJFPMBM', badge: 'Canistra economica 5 L', short: 'Frosch PH neutru 5 L', tip: 'Universal', pentru: 'Curatenie generala', form: '5 L',
    specs: ['detergent ecologic universal, PH neutru', 'canistra mare, de 5 L, economica', 'bland cu suprafetele si cu mainile', '23 pareri, nota 4.87'],
    pros: ['Canistra mare de 5 L, cel mai bun pret pe litru', 'PH neutru, bland cu suprafetele si mainile', 'De la Frosch, tot un produs eco de incredere', 'Nota mare, 4.87'],
    cons: ['Canistra mare ocupa loc', 'Ai nevoie si de un flacon pentru dozat'],
    verdict: 'Pentru cine face curatenie des si vrea sa nu ramana fara, canistra Frosch de 5 litri cu PH neutru e varianta economica: acelasi brand eco de incredere, dar la un pret pe litru mult mai bun decat flacoanele mici. E un detergent universal cu PH neutru, deci bland cu suprafetele si cu mainile, bun de folosit pe podele, mobila si suprafete generale, diluat in apa. Cu 23 de pareri si nota 4.87, e la fel de apreciat ca fratele sau anticalcar. Canistra mare ocupa loc si ai nevoie de un flacon separat pentru dozat comod. O iei cand faci curatenie regulat si vrei un detergent ecologic universal, bland, la cel mai bun pret pe litru, cu care aprovizionezi casa pentru mult timp.' },
  { g: 'univ', id: 'DGSCKM2BM', badge: 'Bio-enzimatic', short: 'Bio-Enzimatic multisuprafete', tip: 'Universal', pentru: 'Multisuprafete', form: '1 L',
    specs: ['detergent bio-enzimatic multisuprafete', 'enzimele descompun murdaria si petele', 'parfum Herbal Fresh, natural', '15 pareri, nota 4.73'],
    pros: ['Bio-enzimatic: enzimele descompun murdaria natural', 'Multisuprafete, il folosesti aproape peste tot', 'Parfum herbal placut, din surse naturale', 'Nota buna, 4.73'],
    cons: ['Enzimele lucreaza mai bine cu putin timp de actiune', 'Mai putine pareri decat produsele Frosch'],
    verdict: 'O abordare mai moderna a curateniei o gasesti la detergentul bio-enzimatic multisuprafete, care mizeaza pe enzime in loc de substante chimice dure. Enzimele sunt molecule naturale care descompun murdaria, grasimile si petele la nivel biologic, curatand eficient dar bland, si il folosesti aproape peste tot in casa, cu un parfum herbal placut, din surse naturale. Cu 15 pareri si nota 4.73, e bine primit de cei care l-au incercat. Enzimele dau ce e mai bun daca le lasi cateva momente sa actioneze, nu freci imediat, iar produsul are mai putine recenzii decat clasicele Frosch. Il iei cand vrei un detergent ecologic modern, bio-enzimatic, pentru toate suprafetele, care curata natural si miroase placut.' },
  // --- Pentru rufe ---
  { g: 'rufe', id: 'DMG4M0BBM', badge: 'Pentru rufe colorate', short: 'Rufe colorate menta-lamaie', tip: 'Rufe', pentru: 'Rufe colorate', form: '1.5 L',
    specs: ['detergent ecologic lichid pentru rufe colorate', 'parfum de menta si lamaie', 'bland cu fibrele si cu pielea', '9 pareri, nota 4.11'],
    pros: ['Formulat pentru rufe colorate, pastreaza culorile', 'Parfum natural de menta si lamaie', 'Ecologic, biodegradabil, bland cu pielea', 'Format lichid, se dozeaza usor'],
    cons: ['Nota mai modesta, 4.11', 'Doar pentru colorate, nu si albe puternic patate'],
    verdict: 'Cand vrei sa speli rufele colorate fara substantele dure ale detergentilor obisnuiti, varianta ecologica cu menta si lamaie e o alegere blanda. E un detergent lichid formulat special pentru colorate, care spala eficient dar menajeaza fibrele si pastreaza culorile mai mult, cu un parfum natural, proaspat, si o formula biodegradabila, blanda si cu pielea sensibila. Nota, 4.11 din 9 pareri, e ceva mai modesta decat a altor produse, semn ca pentru pete grele poate cere o mana de ajutor. E pentru colorate, nu pentru albe foarte patate. Il iei cand vrei un detergent ecologic pentru rufele colorate, bland cu fibrele si cu pielea, cu un parfum natural placut.' },
  { g: 'rufe', id: 'DYNSK5BBM', badge: 'Canistra 5 L, albe si colorate', short: 'Biolu BIO rufe', tip: 'Rufe', pentru: 'Albe si colorate', form: '5 L',
    specs: ['Biolu, detergent BIO lichid pentru rufe', 'pentru albe si colorate, parfum lamaie', 'canistra mare de 5 L, economica', 'nota 5 din 5'],
    pros: ['Pentru albe si colorate deopotriva', 'Canistra mare de 5 L, economica pentru o familie', 'Biolu, brand romanesc eco cunoscut', 'Nota maxima, 5 din 5'],
    cons: ['Doar 3 pareri deocamdata', 'Canistra mare ocupa loc'],
    verdict: 'Pentru o familie care spala des si vrea un singur detergent eco pentru tot cosul de rufe, Biolu in canistra de 5 litri rezolva economic problema. E un detergent BIO lichid bun pentru albe si colorate deopotriva, cu parfum de lamaie, de la Biolu, un brand romanesc cunoscut in zona produselor ecologice de curatenie, iar formatul mare il face avantajos pentru consum regulat. A luat nota maxima, 5 din 5, chiar daca din doar 3 pareri deocamdata, prea putine pentru o concluzie ferma. Canistra mare ocupa loc si o dozezi cu paharul. Il iei cand vrei un detergent de rufe ecologic romanesc, pentru albe si colorate, in format economic de 5 litri, potrivit unei familii care spala mult.' },
  { g: 'rufe', id: 'D3FMHK3BM', badge: 'Foi, fara plastic', short: 'Natulim Foi', tip: 'Rufe', pentru: 'Rufe, zero plastic', form: '40 spalari',
    specs: ['detergent ecologic sub forma de foi', '40 de spalari, o foaie per spalare', 'zero plastic, ambalaj mic de carton', 'parfum floral, nota 5 din 5'],
    pros: ['Foi care se dizolva, fara plastic si fara turnat', 'Ultra compact: 40 de spalari intr-un plic mic', 'Fara risc de scurgeri sau supradozare', 'Nota maxima, 5 din 5'],
    cons: ['Doar 4 pareri deocamdata', 'Pretul pe spalare, ceva mai ridicat'],
    verdict: 'Cea mai inovatoare idee din selectie vine de la Natulim: detergent nu lichid, nu praf, ci sub forma de foi care se dizolva in apa. Pui o foaie in masina pentru fiecare spalare, fara sa torni, fara sa dozezi si fara riscul de a varsa, iar cele 40 de spalari incap intr-un plic mic de carton, zero plastic, care ocupa cat o carte. E solutia cea mai curata si mai ecologica ca ambalaj, fara bidoane de aruncat, cu un parfum floral placut. A luat nota maxima, 5 din 5, din doar 4 pareri deocamdata, iar pretul pe spalare e ceva mai ridicat. Il iei cand vrei sa elimini complet plasticul din spalatul rufelor si preferi comoditatea unei foi gata dozate, curata si compacta.' },
  // --- Speciale ---
  { g: 'spec', id: 'D4HNT3MBM', badge: 'Pentru lana si matase', short: 'Lana si matase', tip: 'Delicate', pentru: 'Lana, matase', form: '1 L',
    specs: ['detergent ecologic pentru lana si matase', 'formula neutra, foarte blanda', 'protejeaza fibrele delicate', '16 pareri, nota 4.75'],
    pros: ['Formulat special pentru lana si matase delicate', 'Neutru, foarte bland, nu deterioreaza fibrele', 'Ecologic, biodegradabil', '16 pareri, nota buna 4.75'],
    cons: ['Nisa, doar pentru textile delicate', 'Nu inlocuieste un detergent obisnuit'],
    verdict: 'Lana si matasea nu suporta detergentii obisnuiti, care le infoiaza, le scamoseaza si le strica, iar aici intervine detergentul ecologic neutru special pentru ele. Are o formula foarte blanda, cu PH neutru, care curata delicat fara sa agreseze fibrele fine, pastrand puloverele de lana si bluzele de matase moi si intacte spalare dupa spalare, si e biodegradabil. Cu 16 pareri si nota 4.75, e cel mai testat produs de nisa din selectie. Fiind specializat, nu inlocuieste un detergent obisnuit, ci il completezi cu el pentru textilele delicate. Il iei cand ai haine de lana sau matase la care tii si vrei un detergent ecologic bland, facut anume sa le protejeze, nu sa le strice.' },
  { g: 'spec', id: 'D7JWDL3BM', badge: 'Pentru parchet', short: 'Bona parchet', tip: 'Pardoseli', pentru: 'Parchet lacuit', form: '4 L',
    specs: ['Bona, detergent pentru parchet lacuit', 'rezerva economica de 4 L, pe baza bio', 'curata fara sa lase urme sau pelicula', '9 pareri, nota 4.89'],
    pros: ['De la Bona, referinta in intretinerea parchetului', 'Formula pe baza bio, mai prietenoasa cu mediul', 'Curata parchetul lacuit fara urme si fara pelicula', 'Rezerva mare de 4 L, nota mare 4.89'],
    cons: ['Doar pentru parchet lacuit, nu uleiat', 'Produs de nisa'],
    verdict: 'Parchetul cere un detergent anume, iar Bona e numele de referinta in intretinerea pardoselilor de lemn, aici intr-o varianta pe baza bio, mai prietenoasa cu mediul. E gandit pentru parchetul lacuit: curata praful si murdaria fara sa lase urme, dare sau pelicula lipicioasa, si fara sa deterioreze lacul, pastrand lemnul curat si cu aspectul lui natural. Rezerva economica de 4 litri ajunge mult, iar nota, 4.89 din 9 pareri, il aseaza sus. E strict pentru parchet lacuit, nu pentru cel uleiat sau pentru alte pardoseli. Il iei cand ai parchet lacuit si vrei sa il intretii corect, cu un detergent Bona de incredere, intr-o formula pe baza bio.' },
  { g: 'spec', id: 'DW9XFKYBM', badge: 'Pentru scos pete', short: 'Biolu scos pete', tip: 'Detapator', pentru: 'Pete', form: 'spray 1 L',
    specs: ['spray BIO pentru scos pete, Biolu', 'se aplica direct pe pata inainte de spalare', 'formula ecologica, biodegradabila', 'nota 5 din 5'],
    pros: ['Ataca petele grele inainte de spalare', 'Spray comod, se aplica direct pe pata', 'Formula BIO, biodegradabila, de la Biolu', 'Nota maxima, 5 din 5'],
    cons: ['Doar o parere deocamdata', 'Detapator, il folosesti alaturi de detergent'],
    verdict: 'Petele grele, de iarba, grasime sau vin, cer un tratament punctual inainte de spalare, iar sprayul BIO Biolu pentru scos pete face exact asta, ecologic. Il pulverizezi direct pe pata, o lasi sa actioneze cateva momente, apoi speli normal, iar formula ataca petele fara clor sau substante dure, ramanand biodegradabila. E complementul care rezolva ce un detergent bland pentru colorate nu scoate din prima. A luat nota maxima, 5 din 5, dar deocamdata dintr-o singura parere, prea putin ca sa spui sigur. E un detapator, il folosesti alaturi de detergentul obisnuit, nu in locul lui. Il iei cand vrei o solutie ecologica pentru petele grele, un spray de pretratare care sa completeze detergentul de rufe.' },
].map(x => ({ ...x, p: byId[x.id] })).filter(x => x.p);

const UNIV = PICKS.filter(x => x.g === 'univ');
const RUFE = PICKS.filter(x => x.g === 'rufe');
const SPEC = PICKS.filter(x => x.g === 'spec');

const hero = '/images/articles/detergent-ecologic-pentru-casa.webp';
const figUniv = '/imagini/articole/detergent-universale.webp';
const figRufe = '/imagini/articole/detergent-rufe.webp';
const figSpec = '/imagini/articole/detergent-speciale.webp';
const published = '2026-07-19T19:26:33+03:00';

const faq = [
  { question: 'Ce inseamna un detergent cu adevarat ecologic?', answer: 'Un detergent ecologic real e formulat sa curete eficient dar cu un impact cat mai mic asupra sanatatii si a mediului. In practica, asta inseamna cateva lucruri: ingrediente biodegradabile, care se descompun in natura fara sa polueze apele, absenta fosfatilor si a clorului, care fac rau ecosistemelor acvatice, si parfumuri si coloranti din surse naturale sau lipsa lor, mai blande cu pielea sensibila si cu caile respiratorii. Multe produse eco folosesc ingrediente simple si cunoscute, ca otetul, sau enzime naturale in loc de substante chimice dure. Atentie insa la termenii de marketing: cauta certificari eco reale si o lista de ingrediente transparenta, nu doar cuvinte ca bio sau verde pe eticheta. Un detergent bun eco iti curata casa la fel de bine, dar fara reziduurile chimice agresive ale celor conventionali.' },
  { question: 'Curata la fel de bine ca detergentii obisnuiti?', answer: 'Pentru curatenia de zi cu zi, da: detergentii ecologici moderni, mai ales cei bine notati, curata suprafetele, vasele si rufele obisnuite la fel de eficient ca cei conventionali, mai ales cand sunt bine formulati, cu enzime sau cu ingrediente active naturale ca otetul. Diferenta apare uneori la petele foarte grele sau la murdaria intarita, unde un detergent chimic dur poate parea mai rapid; acolo, solutia ecologica cere putin mai mult timp de actiune, sa o lasi cateva momente sa lucreze, sau un produs punctual, ca un spray de scos pete inainte de spalare. Pentru marea majoritate a nevoilor casnice, un detergent eco de calitate isi face treaba fara compromisuri, cu avantajul ca nu lasa reziduuri chimice agresive pe suprafete, pe vase si pe haine.' },
  { question: 'Ce e un detergent bio-enzimatic?', answer: 'Un detergent bio-enzimatic foloseste enzime, molecule naturale, ca sa descompuna murdaria. Enzimele sunt aceleasi tipuri de substante pe care organismele vii le folosesc ca sa desfaca grasimile, proteinele si amidonul; intr-un detergent, ele ataca petele si murdaria la nivel biologic, taind-o in bucati mici pe care apa le indeparteaza usor. Avantajul e ca acest proces e eficient dar bland, fara substantele chimice dure ale detergentilor clasici, si prietenos cu mediul, pentru ca enzimele sunt biodegradabile. Ele lucreaza cel mai bine cand le lasi putin timp sa actioneze, deci pentru pete pulverizezi si astepti un moment inainte sa freci sau sa speli. Detergentii bio-enzimatici, ca cel multisuprafete din selectie, sunt printre cele mai moderne solutii ecologice de curatenie.' },
  { question: 'Sunt detergentii ecologici mai blanzi pentru piele si pentru copii?', answer: 'In general, da, si e unul dintre marile lor avantaje. Pentru ca evita substantele chimice agresive, parfumurile sintetice puternice si colorantii artificiali, detergentii ecologici sunt de obicei mai blanzi cu pielea si mai putin susceptibili sa provoace iritatii sau alergii, un plus important pentru pielea sensibila, pentru copii mici si pentru cei cu alergii sau probleme respiratorii. Multi sunt formulati special hipoalergenic. Asta ii face potriviti pentru rufele bebelusilor, pentru lenjerie si pentru orice intra in contact apropiat cu pielea. Totusi, sensibilitatile sunt individuale, deci daca ai piele foarte reactiva sau un copil cu alergii cunoscute, verifica lista de ingrediente si, la nevoie, alege produse cu mentiunea hipoalergenic si fara parfum. In ansamblu, trecerea la eco reduce expunerea familiei la substante chimice de care te poti lipsi.' },
  { question: 'De ce sunt bune formatele concentrate si canistrele mari?', answer: 'Din doua motive: bani si mediu. Un detergent concentrat sau o canistra mare, ca cele de 5 litri Frosch si Biolu din selectie, costa mult mai putin pe litru sau pe spalare decat flacoanele mici, deci economisesti daca faci curatenie sau speli des. In plus, formatele mari si concentratele inseamna mai putin ambalaj de plastic pe unitatea de produs si mai putine transporturi, deci un impact mai mic asupra mediului, in spiritul unei alegeri ecologice. Ideea de a reduce plasticul merge si mai departe la produsele sub forma de foi, ca Natulim, care elimina complet bidonul. Sfatul practic: cumpara concentrat sau canistra mare pentru produsele pe care le folosesti cel mai des, si pastreaza un flacon mic reutilizabil pentru dozat comod.' },
  { question: 'Am nevoie de un detergent diferit pentru fiecare lucru?', answer: 'Nu neaparat, dar cateva produse specializate merita. Baza o poti face cu un detergent universal multisuprafete, ca cel bio-enzimatic sau cel Frosch cu PH neutru, cu care cureti majoritatea suprafetelor din casa, si un detergent de rufe pentru albe si colorate. Peste aceasta baza, merita cateva produse dedicate acolo unde chiar conteaza: unul anticalcar pentru baie si robinete, unul special pentru lana si matase, ca sa nu strici textilele delicate, unul pentru parchet daca ai pardoseli de lemn, care cer o formula anume, si un spray de scos pete pentru murdaria grea. Nu ai nevoie de zeci de flacoane; un mic set bine ales, doua-trei universale plus cateva specializate pentru nevoile tale reale, acopera toata casa fara sa incarci dulapul.' },
  { question: 'Cat costa sa treci la detergenti ecologici?', answer: 'Mai putin decat te-ai astepta, mai ales daca alegi inteligent. In selectie, un detergent universal anticalcar bun porneste de la circa 16 lei flaconul, iar produsele multisuprafete si cele pentru rufe stau in general intre 30 si 70 de lei. Formatele economice, ca detergentii de rufe si universali in canistra de 5 litri, sunt in jur de 80-160 de lei dar tin foarte mult, deci pe spalare sau pe litru ies ieftin. Produsele specializate, pentru lana si matase, parchet sau scos pete, costa intre circa 50 si 125 de lei, dar le cumperi mai rar. Pe ansamblu, un set eco de baza pentru toata casa costa comparabil cu detergentii obisnuiti, mai ales cand mizezi pe formate mari si concentrate, iar diferenta o simti in aer mai curat, piele mai putin iritata si un impact mai mic asupra mediului.' },
];

const images = [hero, figUniv, figRufe, figSpec, ...PICKS.map(x => x.p.image)];
---

<Layout
  title="Cel mai bun detergent ecologic pentru casa in 2026: universale, pentru rufe si speciale"
  description="Care e cel mai bun detergent ecologic pentru casa in 2026: solutii universale si multisuprafete de la Frosch si bio-enzimatice, detergenti eco pentru rufe de la Biolu si Natulim, si produse speciale pentru lana, parchet si scos pete. Comparate pe folosire, format si nota, plus ce inseamna cu adevarat ecologic si cum alegi."
  image={hero}
  type="article"
  publishedTime={published}
  modifiedTime={published}
  author="Redactia CentroCasa"
  breadcrumb={[{ name: 'Acasa', url: '/' }, { name: 'Curatenie si Intretinere', url: '/curatenie-intretinere/' }, { name: 'Cel mai bun detergent ecologic pentru casa' }]}
  faq={faq.map(f => ({ question: f.question, answer: f.answer }))}
>
  <article class="rd">
    <nav class="breadcrumb">
      <a href="/">Acasa</a><span class="breadcrumb-separator">/</span>
      <a href="/curatenie-intretinere/">Curatenie si Intretinere</a><span class="breadcrumb-separator">/</span>
      <span>Cel mai bun detergent ecologic pentru casa</span>
    </nav>

    <h1>Cel mai bun detergent ecologic pentru casa</h1>
    <p class="rd-byline">de <a href="/despre/">Redactia CentroCasa</a> · actualizat iulie 2026</p>

    <img class="rd-hero" src={hero} alt="Cel mai bun detergent ecologic pentru casa: universale, pentru rufe si speciale" width="1200" height="675" fetchpriority="high" />

    <div class="rd-intro">
      <p>Cel mai bine notat detergent ecologic din selectie e <strong>Frosch anticalcar cu otet</strong>, cu nota 4.88 din 41 de pareri. Pentru rufe, <strong>Biolu</strong> in canistra de 5 litri e economic, iar <strong>Natulim</strong>, sub forma de foi, elimina complet plasticul.</p>
      <p>Un detergent ecologic curata casa fara substantele chimice dure ale celor obisnuiti: <strong>biodegradabil, fara fosfati si clor, mai bland cu pielea</strong>. Mai jos gasesti direct recomandarile, grupate pe universale si multisuprafete, pentru rufe, si speciale, iar sub ele un ghid despre ce inseamna cu adevarat ecologic si cum alegi.</p>
      <p>Le-am ales pe cele mai testate si mai bine notate produse cu adevarat ecologice, si le-am impartit pe tipul de folosire. Am lasat deoparte detergentii conventionali care apar la cautari, ca sa ramana doar solutii eco reale, cu folosire, format si nota clare la fiecare. Pentru cum le folosesti, vezi ghidul <a href="/cum-sa-cureti-eficient-casa/">cum sa cureti eficient casa</a> si <a href="/mop-cu-aburi-pentru-podele/">mopurile cu aburi</a>.</p>
    </div>

    <details class="rd-toc">
      <summary>Cuprins</summary>
      <ol>
        <li><a href="#tabel">Comparatie rapida</a></li>
        <li><a href="#univ">Universale si multisuprafete</a></li>
        <li><a href="#rufe">Pentru rufe</a></li>
        <li><a href="#spec">Speciale: lana, parchet, pete</a></li>
        <li><a href="#de-ce">De ce sa treci la ecologic</a></li>
        <li><a href="#conteaza">Ce conteaza cand alegi</a></li>
        <li><a href="#enzime">Bio-enzimatic, pe scurt</a></li>
        <li><a href="#folosire">Cum le folosesti eficient</a></li>
        <li><a href="#cat-costa">Cat costa</a></li>
        <li><a href="#faq">Intrebari frecvente</a></li>
      </ol>
    </details>

    <h2 id="tabel">Comparatie rapida</h2>
    <div class="table-wrap">
      <table class="rd-table">
        <thead><tr><th>Produs</th><th>Tip</th><th>Pentru</th><th>Nota</th></tr></thead>
        <tbody>
          {PICKS.map(x => (
            <tr>
              <td><div class="cmp-prod"><img class="cmp-thumb" src={x.p.image} alt={x.short} loading="lazy" width="44" height="44" /><span>{x.short}</span></div></td>
              <td>{x.tip}</td>
              <td>{x.pentru}</td>
              <td>{x.p.rating} ({x.p.reviews})</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 id="univ">Universale si multisuprafete</h2>
    <p>Baza oricarei curatenii ecologice: detergenti cu care speli podele, suprafete, baie si bucatarie. De la clasicul Frosch cu otet, anticalcar, la solutii bio-enzimatice moderne care descompun murdaria natural. Cu ei acoperi cea mai mare parte a treburilor din casa.</p>
    <div class="rd-grid">
      {UNIV.map(x => (
        <ProductCard name={x.p.name.replace(/’/g, "'")} image={x.p.image} price={x.p.price} rating={x.p.rating} reviews={x.p.reviews} badge={x.badge} specs={x.specs} pros={x.pros} cons={x.cons} verdict={x.verdict} outKey={'p-' + x.id} />
      ))}
    </div>

