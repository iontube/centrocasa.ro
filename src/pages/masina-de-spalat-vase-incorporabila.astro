---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import SimilarArticles from '../components/SimilarArticles.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import emag from '../data/emag-products.json';
import keywordsData from '../../keywords.json';
import { visibleArticles, slugify } from '../lib/articles.mjs';

const relatedArticles = visibleArticles(keywordsData.completed).map(item => ({
  title: item.keyword.charAt(0).toUpperCase() + item.keyword.slice(1),
  slug: item.slug || slugify(item.keyword),
  excerpt: item.excerpt || '',
  image: item.image || `/images/articles/${item.slug || slugify(item.keyword)}.webp`,
  category: item.category,
  categorySlug: item.categorySlug,
  date: item.date || '',
}));

const pool = emag['masina-spalat-vase'] || [];
const byId = Object.fromEntries(pool.map(p => [p.id, p]));

const PICKS = [
  // --- 60 cm ---
  { g: 'l60', id: 'DQ7CXWBBM', badge: 'Cel mai vandut', short: 'Bosch 13 seturi', lat: '60 cm', set: '13 seturi', clasa: 'E',
    specs: ['60 cm, 13 seturi de vase', 'clasa E, 6 programe', 'protectie impotriva inundatiilor', 'de departe cea mai vanduta, 188 de pareri'],
    pros: ['De departe cea mai vanduta din selectie, 188 de pareri', 'Bosch, brand de referinta la masini de spalat vase', 'Protectie impotriva inundatiilor', '13 seturi, bine pentru o familie'],
    cons: ['Clasa E, nu cea mai eficienta', 'Doar 6 programe, fara extra-uri sofisticate'],
    verdict: 'Cea mai sigura alegere pentru o bucatarie normala, de la brandul de referinta. Bosch SMV46KX are 60 cm latime si 13 seturi, adica incape vesela unei familii dupa o masa completa, plus protectie impotriva inundatiilor, care opreste apa daca apare o scurgere, un plus real de siguranta la un incorporabil ascuns in mobila. E de departe cea mai vanduta din selectie, cu 188 de pareri si nota 4.49, cea mai buna dovada ca merge si tine. E clasa E, nu cea mai eficienta pe noua scala, si are 6 programe, suficiente pentru uz zilnic, fara extra-uri sofisticate. O iei cand vrei o masina Bosch verificata de mii de oameni, cu capacitate buna si siguranta, pentru o familie, si nu insisti pe cea mai mica clasa de consum.' },
  { g: 'l60', id: 'DZ5HNXMBM', badge: 'Cel mai bun raport', short: 'Beko 13 seturi', lat: '60 cm', set: '13 seturi', clasa: 'E',
    specs: ['60 cm, 13 seturi', 'clasa E, protectie inundatii', 'indicator de sare', 'pret mic pentru 13 seturi'],
    pros: ['Cel mai mic pret pentru un 60 cm de 13 seturi', 'Beko, brand mare cu service extins', 'Protectie impotriva inundatiilor', 'Nota buna, 4.51'],
    cons: ['Doar 4 programe', 'Clasa E'],
    verdict: 'Cel mai bun raport pret-capacitate din grupul de 60 cm. Beko BDIN14320 are aceleasi 13 seturi ca modelul Bosch de top, la un pret vizibil mai mic, deci iei aceeasi capacitate pentru o familie cu mai putini bani. Vine de la Beko, un brand mare cu una dintre cele mai extinse retele de service la noi, si are protectie impotriva inundatiilor. E clasa E si are doar 4 programe, mai putine decat altele, dar cele de baza, eco, intensiv, rapid, acopera nevoile obisnuite. Are nota buna, 4.51. O iei cand vrei cea mai ieftina masina de 60 cm cu 13 seturi de la un brand serios, si nu ai nevoie de multe programe speciale.' },
  { g: 'l60', id: 'DRSSHQBBM', badge: 'Nota mare, clasa D', short: 'Electrolux 13 seturi', lat: '60 cm', set: '13 seturi', clasa: 'D',
    specs: ['60 cm, 13 seturi, clasa D', '8 programe, cele mai multe din grup', 'auto-curatare si oprire automata', 'nota 4.67 din 110 pareri'],
    pros: ['Clasa D, mai eficienta decat modelele clasa E', 'Cele mai multe programe, 8', 'Auto-curatare, isi intretine singura interiorul', 'Nota mare, 4.67, din multe pareri'],
    cons: ['Mai scumpa decat Beko de aceeasi capacitate', 'Fara capacitatea extra a modelelor de 14-15 seturi'],
    verdict: 'Alegerea daca vrei mai multa eficienta si mai multe programe, la o capacitate buna. Electrolux EES47320L are 13 seturi si e clasa D, cu o treapta mai eficienta decat modelele clasa E, deci consuma ceva mai putin pe termen lung. Are cele mai multe programe din grupul de 60 cm, 8, si o functie de auto-curatare care ii intretine singura interiorul, plus oprire automata. E foarte bine cotata, cu 4.67 din 110 pareri, semn ca lumea e multumita. Costa mai mult decat Beko de aceeasi capacitate si nu are volumul extra al modelelor de 14-15 seturi. O iei cand pui pret pe eficienta, pe programe multe si pe o nota mare, pentru o familie, si accepti un pret ceva mai ridicat.' },
  { g: 'l60', id: 'DCFT3TYBM', badge: 'Capacitate mare', short: 'Beko 15 seturi', lat: '60 cm', set: '15 seturi', clasa: 'D',
    specs: ['60 cm, 15 seturi, cea mai incapatoare', 'clasa D, 6 programe', 'protectie impotriva inundatiilor', 'nota 4.67'],
    pros: ['15 seturi, cea mai mare capacitate din selectie', 'Clasa D, eficienta buna', 'Ideala pentru familii mari sau spalat rar', 'Nota mare, 4.67'],
    cons: ['Incarci mai rar la maxim daca esti putini', 'Mai putine pareri, 30'],
    verdict: 'Alegerea pentru o familie mare sau pentru cine spala vasele mai rar, dar mult. Beko BDIN36535 are 15 seturi, cea mai mare capacitate din selectie, deci incape vesela de la mese numeroase, oale si tavi mari, fara sa faci doua cicluri. E clasa D, cu eficienta buna, si are protectie impotriva inundatiilor. Are nota mare, 4.67, chiar daca din mai putine pareri, 30. Daca sunteti putini in casa, o incarci rar la maxim, dar avantajul e ca poti aduna vasele pe doua-trei zile si sa speli o data. O iei cand vrei cea mai mare capacitate, pentru o familie numeroasa sau pentru cine gateste mult si vrea sa spele mai rar.' },
  { g: 'l60', id: 'D29MY5YBM', badge: 'Cel mai eficient', short: 'Bosch 14 seturi, clasa B', lat: '60 cm', set: '14 seturi', clasa: 'B',
    specs: ['60 cm, 14 seturi, clasa B', 'cea mai eficienta din selectie', 'Bosch, 6 programe', 'nota maxima, 5 din 5'],
    pros: ['Clasa B, de departe cea mai eficienta din selectie', '14 seturi, capacitate mare', 'Bosch, fiabilitate de referinta', 'Nota maxima, 5 din 5'],
    cons: ['Pret de gama superioara', 'Mai putine pareri, 29'],
    verdict: 'Alegerea daca vrei cel mai mic consum si esti dispus sa platesti pentru el. Bosch SMV4EVX11E e clasa B, singura din selectie care urca atat de sus pe noua scala energetica, unde A e maximul si foarte greu de atins: asta inseamna cel mai mic consum de curent si apa dintre toate, o economie care se aduna pe factura in anii de folosire. Are 14 seturi, deci si capacitate mare, si vine cu fiabilitatea Bosch. A luat nota maxima, 5 din 5, din 29 de pareri. E in zona de pret superioara, normal pentru clasa B. O iei cand privesti pe termen lung si vrei cea mai economica masina, cu volum mare si brand de top, si nu te opresti la pretul de la raft.' },
  { g: 'l60', id: 'D5VVPDMBM', badge: 'Cel mai ieftin', short: 'Heinner 12 seturi', lat: '60 cm', set: '12 seturi', clasa: 'E',
    specs: ['60 cm, 12 seturi', 'clasa E, 6 programe', 'protectie impotriva inundatiilor', 'cel mai mic pret pentru un 60 cm'],
    pros: ['Cel mai mic pret din grupul de 60 cm', '12 seturi, suficient pentru multe familii', 'Protectie impotriva inundatiilor', '6 programe'],
    cons: ['Brand mai putin cunoscut', 'Clasa E, nota 4.21'],
    verdict: 'Cea mai accesibila masina de spalat vase de 60 cm incorporabila din selectie. Heinner HDW-BI6006 are 12 seturi, cu doar unul mai putin decat modelele de 13, suficient pentru multe familii, la cel mai mic pret din grupul de 60 cm. Are 6 programe si protectie impotriva inundatiilor, deci nu lipseste ce conteaza. E de la un brand mai putin cunoscut decat Bosch sau Electrolux, clasa E, cu o nota buna, 4.21, mai modesta decat la varf. O iei cand vrei o masina de 60 cm cu capacitate buna la cel mai mic pret posibil, pentru o bucatarie normala, si nu insisti pe brand sau pe cea mai buna clasa energetica.' },
  // --- 45 cm ---
  { g: 'l45', id: 'D54VMDMBM', badge: 'Cel mai vandut slim', short: 'Electrolux 9 seturi', lat: '45 cm', set: '9 seturi', clasa: 'F',
    specs: ['45 cm, 9 seturi, pentru bucatarii mici', 'clasa F, 5 programe', 'semnal sonor la final', 'de departe cel mai vandut slim, 179 de pareri'],
    pros: ['De departe cel mai vandut model slim, 179 de pareri', 'Nota mare, 4.77, cea mai buna din grupul de 45 cm', 'Electrolux, brand consacrat', 'Doar 45 cm, incape in bucatarii mici'],
    cons: ['Clasa F, mai putin eficienta', '9 seturi, pentru 1-3 persoane'],
    verdict: 'Cea mai buna alegere slim, verificata de cei mai multi cumparatori. Electrolux EEA71210L are 45 cm latime, deci intra intr-o bucatarie mica sau intr-un spatiu ingust unde un model de 60 cm nu are loc, si spala 9 seturi, suficient pentru 1-3 persoane. E de departe cel mai vandut model de 45 cm din selectie, cu 179 de pareri si nota 4.77, cea mai buna din grupul slim, semn ca isi face treaba bine. E clasa F, mai putin eficienta, un compromis obisnuit la modelele inguste, si are 5 programe. O iei cand ai o bucatarie mica sau sunteti putini in casa si vrei cel mai testat si mai bine cotat model slim, de la un brand consacrat.' },
  { g: 'l45', id: 'D1VVPDMBM', badge: 'Cel mai ieftin', short: 'Heinner 10 seturi', lat: '45 cm', set: '10 seturi', clasa: 'E',
    specs: ['45 cm, 10 seturi', 'clasa E, 6 programe', 'protectie impotriva inundatiilor', 'cel mai mic pret din selectie'],
    pros: ['Cel mai mic pret din toata selectia', '10 seturi, mai mult decat multe modele slim', 'Clasa E, mai buna decat unele slim clasa F', 'Protectie impotriva inundatiilor'],
    cons: ['Brand mai putin cunoscut', 'Nota 4.36, buna fara sa fie in top'],
    verdict: 'Cea mai ieftina masina de spalat vase din toata selectia, si tot slim. Heinner HDW-BI4506 are 45 cm si, surprinzator, 10 seturi, cu unul mai mult decat multe modele slim de 9, la cel mai mic pret de aici. E clasa E, adica mai eficienta decat modelele slim clasa F, si are 6 programe plus protectie impotriva inundatiilor. Vine de la un brand mai putin cunoscut si are o nota buna, 4.36, fara sa fie in varf. E alegerea logica pentru o bucatarie mica, cu buget strans, unde vrei totusi capacitate decenta si functiile de baza. O iei cand cauti cel mai mic pret pentru un incorporabil de 45 cm si nu conteaza brandul.' },
  { g: 'l45', id: 'DLWK52BBM', badge: 'Accesibil, Hansa', short: 'Hansa 9 seturi', lat: '45 cm', set: '9 seturi', clasa: 'E',
    specs: ['45 cm, 9 seturi, clasa E', '4 programe, pornire programabila', 'indicator de sare', 'incarcare la jumatate'],
    pros: ['Clasa E la un pret mic', 'Pornire programabila, o lasi sa spele noaptea', 'Functie de incarcare la jumatate, pentru putine vase', 'Bine vanduta, 78 de pareri'],
    cons: ['Doar 4 programe', 'Nota 4.29, mai modesta'],
    verdict: 'O alternativa slim accesibila, cu doua functii practice. Hansa ZIM 434 B are 45 cm si 9 seturi, e clasa E si vine cu pornire programabila, deci o lasi sa porneasca noaptea cand curentul e mai ieftin sau ca sa gasesti vasele curate dimineata, plus o functie de incarcare la jumatate, utila cand ai putine vase si nu vrei sa consumi ca pentru un ciclu plin. Are 4 programe si o nota mai modesta, 4.29, din 78 de pareri, deci e bine vanduta. O iei cand vrei un incorporabil de 45 cm ieftin, clasa E, cu pornire programabila si optiune de jumatate de incarcare, si nu ai nevoie de multe programe.' },
  { g: 'l45', id: 'D4V772MBM', badge: 'Bosch, premium slim', short: 'Bosch 9 seturi', lat: '45 cm', set: '9 seturi', clasa: 'F',
    specs: ['45 cm, 9 seturi, Bosch', 'functionare silentioasa', 'senzor de incarcare, ajusteaza ciclul', '5 programe, nota 4.85'],
    pros: ['Bosch, cea mai buna nota din grupul de 45 cm, 4.85', 'Functionare silentioasa', 'Senzor de incarcare, adapteaza apa si timpul', 'Fiabilitate si constructie Bosch'],
    cons: ['Cel mai scump din grupul slim', 'Clasa F'],
    verdict: 'Alegerea slim premium, pentru cine vrea un Bosch chiar intr-o bucatarie mica. Bosch SPV2IKX10E are 45 cm si 9 seturi, cu functionare silentioasa, un plus real intr-o bucatarie deschisa spre living, si un senzor de incarcare care detecteaza cat de multe vase ai pus si ajusteaza automat consumul de apa si durata ciclului, deci nu iroseste cand speli putin. Are cea mai buna nota din grupul de 45 cm, 4.85, cu fiabilitatea si constructia Bosch in spate. E cel mai scump din grupul slim si e clasa F. O iei cand vrei brandul Bosch si spalare silentioasa, inteligenta, intr-un format ingust, si esti dispus sa platesti pentru asta.' },
  { g: 'l45', id: 'D4BX13MBM', badge: 'Clasa D, eficient', short: 'Electrolux 9 seturi, clasa D', lat: '45 cm', set: '9 seturi', clasa: 'D',
    specs: ['45 cm, 9 seturi, clasa D', 'cea mai eficienta din grupul slim', '8 programe, cele mai multe', 'oprire automata, nota 4.65'],
    pros: ['Clasa D, cea mai eficienta din grupul de 45 cm', 'Cele mai multe programe din grupul slim, 8', 'Electrolux, brand consacrat', 'Nota mare, 4.65'],
    cons: ['Mai scumpa decat modelele slim de baza', 'Mai putine pareri, 37'],
    verdict: 'Alegerea slim daca vrei cea mai buna clasa energetica si multe programe. Electrolux EEG62300L are 45 cm si 9 seturi, dar e clasa D, cea mai eficienta din grupul slim, unde majoritatea sunt clasa E sau F, deci consuma mai putin pe termen lung. Are 8 programe, cele mai multe dintre modelele de 45 cm, si oprire automata, plus nota mare, 4.65. Costa mai mult decat modelele slim de baza si are ceva mai putine pareri, 37. O iei cand ai o bucatarie mica, dar nu vrei sa faci compromis la eficienta si la programe, si preferi un Electrolux clasa D in loc de un model slim clasa F mai ieftin.' },
].map(x => ({ ...x, p: byId[x.id] })).filter(x => x.p);

const L60 = PICKS.filter(x => x.g === 'l60');
const L45 = PICKS.filter(x => x.g === 'l45');

const hero = '/images/articles/masina-de-spalat-vase-incorporabila.webp';
const fig60 = '/imagini/articole/masina-vase-60.webp';
const fig45 = '/imagini/articole/masina-vase-45.webp';
const published = '2026-07-18T19:41:47+03:00';

const faq = [
  { question: 'Masina de spalat vase de 45 sau de 60 cm, care mi se potriveste?', answer: 'Alegerea depinde de spatiul din bucatarie si de cati sunteti in casa. Un model de 60 cm, cel standard, spala 12-16 seturi si e potrivit pentru familii sau pentru cine gateste si spala mult; are nevoie de un gol de mobila de 60 cm. Unul de 45 cm, slim, spala 9-10 seturi, potrivit pentru 1-3 persoane sau pentru bucatarii mici, unde un model de 60 cm nu incape. Regula simpla: daca ai loc, ia 60 cm pentru capacitatea mai mare; daca spatiul e limitat sau sunteti putini, cei 45 cm iti dau functionalitatea completa intr-un format compact.' },
  { question: 'Cate seturi de vase imi trebuie?', answer: 'Un set inseamna vesela folosita de o persoana la o masa completa, farfurii, pahar, tacamuri. Un model de 45 cm are in general 9-10 seturi, suficient pentru 1-3 persoane, iar unul de 60 cm are 12, 13, 14 sau chiar 15 seturi, pentru familii de 3-5 persoane sau mai mari. Nu trebuie sa umpli masina la fiecare masa: multi aduna vasele pe o zi sau doua si spala o data, plin, ceea ce e si mai economic. Daca gatesti des si cu oale si tavi mari, alege mai multe seturi, ca modelul Beko de 15 din selectie, ca sa incapa tot.' },
  { question: 'Ce inseamna clasa energetica la o masina de spalat vase?', answer: 'UE a schimbat vechea scala, cu A+++ pana la D, cu una noua, mai simpla si mai stricta, de la A la G. Pe noua scala, clasa A e cea mai eficienta si foarte greu de atins, iar majoritatea masinilor bune sunt intre clasa B si F. In selectie, cea mai eficienta e modelul Bosch clasa B, urmat de cateva clasa D, ca Electrolux, in timp ce multe modele accesibile sunt clasa E sau F. O clasa mai buna inseamna consum mai mic de curent si apa, deci facturi mai mici in timp; pe eticheta gasesti si consumul exact de apa pe ciclu, util pentru comparat.' },
  { question: 'Cat de silentioasa e o masina de spalat vase incorporabila?', answer: 'Destul de silentioasa, mai ales ca sunet e atenuat de mobila in care e ascunsa. Cele mai linistite modele coboara sub 43 dB, aproape imperceptibil, iar zgomotul conteaza cel mai mult daca bucataria e deschisa spre living sau daca o pornesti seara. Modelele cu functionare silentioasa marcata, ca Bosch din selectie, sunt gandite exact pentru asta. Pentru ca e incorporabila, nivelul real perceput e si mai mic decat cifra de pe eticheta, pentru ca panoul de mobila si golul o izoleaza. Daca stai mult in bucatarie, cauta un model cu un nivel de zgomot cat mai mic.' },
  { question: 'Ce e o masina complet incorporabila si cum difera de una partial?', answer: 'O masina complet incorporabila se ascunde total in mobila de bucatarie: pe usa ei se monteaza un panou identic cu restul fronturilor, iar panoul de comenzi e pe muchia de sus a usii, invizibil cand usa e inchisa, deci arata ca un simplu dulap. Toate modelele din aceasta selectie sunt complet incorporabile. La una partial incorporabila, panoul de comenzi ramane vizibil pe fata, deci se vede ca e o masina. Complet incorporabila da un aspect mai curat si mai unitar bucatariei, ideal daca vrei ca electrocasnicele sa dispara in mobilier.' },
  { question: 'Cum usuca vasele o masina de spalat vase?', answer: 'Prin mai multe metode, in functie de model. Cea mai simpla e uscarea prin condensare, in care vasele se incalzesc la clatire, apoi apa se evapora si se condenseaza pe peretii mai reci ai masinii; e eficienta, dar cere ceva timp si e bine sa lasi usa intredeschisa la final. Modelele mai avansate folosesc un ventilator care circula aer cald, pentru uscare mai rapida si mai completa, iar unele premium au sisteme cu minerale care absorb umezeala. Pentru vase perfect uscate din prima, cauta un model cu uscare activa, cu ventilator; pentru un pret mai mic, uscarea prin condensare face treaba, cu putina rabdare.' },
  { question: 'Consuma multa apa o masina de spalat vase?', answer: 'Mai putina decat spalatul manual, contrar a ce cred multi. O masina moderna foloseste in general intre 9 si 12 litri de apa pentru un ciclu complet, in timp ce spalatul acelorasi vase la robinet poate consuma de cateva ori mai mult. Consumul exact de apa e trecut pe eticheta energetica, alaturi de clasa, si merita comparat intre modele. Programele eco folosesc cea mai putina apa si energie, spaland la temperatura mai mica, dar pe durata mai lunga. Deci, pe langa timpul economisit, o masina de spalat vase te ajuta si la factura de apa, mai ales daca folosesti programul eco.' },
  { question: 'Cat costa o masina de spalat vase incorporabila buna?', answer: 'In selectie, un model bun, de la un brand cunoscut, porneste de la circa 1470-1600 de lei, cazul modelelor Heinner, Beko sau Electrolux slim, cele mai accesibile. Modelele de 60 cm de la branduri mari, cu 13 seturi si clasa D, sunt in general 1950-2200 de lei. Cele premium, cu clasa B, capacitate mare sau brand de top ca Bosch, trec de 2600 si urca spre 3000 de lei si peste. Pe langa pret, tine cont de clasa energetica si de capacitate: o masina potrivita ca marime si eficienta se dovedeste in timp mai ieftina decat una ieftina, dar risipitoare sau prea mica.' },
];

const images = [hero, fig60, fig45, ...PICKS.map(x => x.p.image)];
---

<Layout
  title="Cele mai bune masini de spalat vase incorporabile in 2026: 45 si 60 cm, pe capacitate si buget"
  description="Care sunt cele mai bune masini de spalat vase incorporabile in 2026, pe dimensiune: modele de 60 cm pentru familie si de 45 cm slim pentru bucatarii mici, de la Bosch, Electrolux, Beko, Hansa si Heinner, comparate pe numar de seturi, clasa energetica si zgomot. Plus cum alegi si de cat spatiu ai nevoie."
  image={hero}
  type="article"
  publishedTime={published}
  modifiedTime={published}
  author="Cristian Popa"
  breadcrumb={[{ name: 'Acasa', url: '/' }, { name: 'Electrocasnice Casa', url: '/electrocasnice-casa/' }, { name: 'Cele mai bune masini de spalat vase incorporabile' }]}
  faq={faq.map(f => ({ question: f.question, answer: f.answer }))}
>
  <article class="rd">
    <nav class="breadcrumb">
      <a href="/">Acasa</a><span class="breadcrumb-separator">/</span>
      <a href="/electrocasnice-casa/">Electrocasnice Casa</a><span class="breadcrumb-separator">/</span>
      <span>Cele mai bune masini de spalat vase incorporabile</span>
    </nav>

    <h1>Cele mai bune masini de spalat vase incorporabile</h1>
    <p class="rd-byline">de <a href="/autori/cristian-popa/">Cristian Popa</a>, Specialist Electrocasnice · actualizat iulie 2026</p>

    <img class="rd-hero" src={hero} alt="Cele mai bune masini de spalat vase incorporabile: modele de 45 si 60 cm" width="1200" height="675" fetchpriority="high" />

    <div class="rd-intro">
      <p>Pentru o familie, cea mai buna masina de spalat vase incorporabila e <strong>Bosch de 60 cm</strong>, de departe cea mai vanduta, cu 13 seturi si protectie la inundatii. Daca vrei sa economisesti, <strong>Beko de 60 cm</strong> da aceeasi capacitate mai ieftin, iar pentru consum minim, <strong>Bosch clasa B</strong> e cel mai eficient. Ai o bucatarie mica? <strong>Electrolux slim de 45 cm</strong> e cel mai vandut model ingust.</p>
      <p>La un incorporabil, prima decizie e <strong>dimensiunea</strong>, 45 sau 60 cm, legata de spatiul din bucatarie si de cati sunteti, apoi <strong>numarul de seturi</strong>, <strong>clasa energetica</strong> si <strong>zgomotul</strong>. Mai jos gasesti direct recomandarile, impartite pe cele doua latimi, iar dupa ele un ghid despre cum alegi.</p>
      <p>Am pornit de la masinile de spalat vase complet incorporabile, in stoc pe eMAG, cu cele mai multe pareri, le-am verificat pe latime, numar de seturi, clasa energetica si dotari, si le-am grupat in cele de 60 cm, pentru familie, si cele de 45 cm, slim. Pentru restul bucatariei, vezi <a href="/plita-cu-inductie-pentru-bucatarie/">plitele cu inductie</a> si <a href="/frigider-side-by-side-pentru-familie/">frigiderele side by side</a>.</p>
    </div>

    <details class="rd-toc">
      <summary>Cuprins</summary>
      <ol>
        <li><a href="#tabel">Comparatie rapida</a></li>
        <li><a href="#l60">De 60 cm, pentru familie</a></li>
        <li><a href="#l45">De 45 cm, slim</a></li>
        <li><a href="#dimensiune">45 sau 60 cm si cate seturi</a></li>
        <li><a href="#clasa">Clasa energetica si consumul</a></li>
        <li><a href="#zgomot">Zgomotul si uscarea</a></li>
        <li><a href="#incorporabila">Complet incorporabila si montajul</a></li>
        <li><a href="#functii">Programe si functii utile</a></li>
        <li><a href="#greseli">Greseli de evitat</a></li>
        <li><a href="#cat-costa">Cat costa</a></li>
        <li><a href="#faq">Intrebari frecvente</a></li>
      </ol>
    </details>

    <h2 id="tabel">Comparatie rapida</h2>
    <div class="table-wrap">
      <table class="rd-table">
