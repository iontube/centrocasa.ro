---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import keywordsData from '../../keywords.json';
import { visibleArticles, slugify } from '../lib/articles.mjs';
import { categories } from '../lib/categories.mjs';
import popular from '../data/popular.json';

// Get completed articles (fara cele legacy, cand exista articole noi)
// slug = item.slug daca exista (unele articole au titlu != slug), altfel din keyword
const articles = visibleArticles(keywordsData.completed).map(item => {
  const slug = item.slug || slugify(item.keyword);
  return {
    title: item.keyword.charAt(0).toUpperCase() + item.keyword.slice(1),
    slug,
    excerpt: item.excerpt || '',
    image: item.image || `/images/articles/${slug}.webp`,
    category: item.category,
    categorySlug: item.categorySlug,
    date: item.date || new Date().toISOString()
  };
}).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// Count articles per category
const categoryCounts = categories.map(cat => ({
  ...cat,
  count: articles.filter(a => a.categorySlug === cat.slug).length
}));

// Sectiuni pe categorie: cele mai noi 9 articole per categorie (newest first) + link catre toata categoria
const sections = categories
  .map(cat => ({
    ...cat,
    count: articles.filter(a => a.categorySlug === cat.slug).length,
    items: articles.filter(a => a.categorySlug === cat.slug).slice(0, 9)
  }))
  .filter(s => s.items.length > 0);
---

<Layout
  title="CentroCasa - Sfaturi si Recomandari pentru Casa si Gradina"
  description="Descopera cele mai bune produse si sfaturi pentru casa si gradina ta. Ghiduri de cumparare, recenzii si recomandari de la experti."
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1>Recenzii si sfaturi pentru casa si gradina</h1>
        <p>
          Ghiduri de cumparare, comparatii si recomandari testate, ca sa alegi
          produsele potrivite fara batai de cap.
        </p>
      </div>
    </div>
  </section>

  <!-- Populare acum: cele mai vizitate articole (date Cloudflare) -->
  {popular && popular.length > 0 && (
    <section class="section pop-section">
      <div class="container">
        <div class="pop-head">
          <h2 class="section-title">Populare acum</h2>
          <span class="pop-sub">Cele mai citite articole de pe site</span>
        </div>
        <div class="pop-wrap">
          <a href={`/${popular[0].slug}/`} class="pop-feat">
            <img src={popular[0].image} alt={popular[0].title} loading="lazy" width="720" height="450" />
            <span class="pop-feat-grad"></span>
            <div class="pop-feat-body">
              <span class="pop-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                Cel mai citit
              </span>
              <span class="pop-feat-cat">{popular[0].category}</span>
              <h3 class="pop-feat-title">{popular[0].title}</h3>
            </div>
          </a>
          <div class="pop-list">
            {popular.slice(1).map((a, i) => (
              <a href={`/${a.slug}/`} class="pop-item">
                <span class="pop-num">{i + 2}</span>
                <img class="pop-thumb" src={a.image} alt={a.title} loading="lazy" width="88" height="66" />
                <div class="pop-meta">
                  <span class="pop-item-cat">{a.category}</span>
                  <h3 class="pop-item-title">{a.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Sectiuni pe categorie: 9 articole per categorie + link catre toata categoria -->
  {sections.map((section, i) => (
    <section class="section" style={i % 2 === 0 ? 'background: var(--color-gray-100);' : ''}>
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">{section.name}</h2>
        </div>
        <div class="articles-grid">
          {section.items.map(article => (
            <ArticleCard {...article} />
          ))}
        </div>
        <div class="section-footer">
          <a href={`/${section.slug}/`} class="section-see-all-btn">Vezi toate articolele</a>
        </div>
      </div>
    </section>
  ))}

  <!-- Despre CentroCasa -->
  <section class="section about">
    <div class="container">
      <div class="about-head">
        <h2 class="section-title">Despre CentroCasa</h2>
        <p class="about-lead">Te ajutam sa alegi cele mai bune produse pentru casa si gradina, cu recomandari sincere bazate pe specificatii reale si pe parerile a mii de cumparatori. Comparam, verificam si explicam pe intelesul tuturor, ca tu sa economisesti timp si bani.</p>
      </div>
      <div class="about-grid">
        <div class="about-card">
          <div class="about-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          </div>
          <h3>Analiza pe date reale</h3>
          <p>Comparam specificatiile reale ale fiecarui produs, nu doar cifrele de pe cutie.</p>
        </div>
        <div class="about-card">
          <div class="about-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.9 6.3 6.9.6-5.2 4.6 1.6 6.8L12 17.3 5.8 20.9l1.6-6.8L2.2 8.9l6.9-.6z"/></svg>
          </div>
          <h3>Pareri reale</h3>
          <p>Ne uitam la parerile a mii de cumparatori, nu doar la descrierea producatorului.</p>
        </div>
        <div class="about-card">
          <div class="about-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
          </div>
          <h3>Recomandari sincere</h3>
          <p>Nu suntem sponsorizati de producatori si nu favorizam anumite branduri.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Populare acum — layout editorial: featured #1 + lista numerotata #2-6 */
  .pop-section { background: var(--color-gray-100); }
  .pop-head { margin-bottom: 1.6rem; }
  .pop-head .section-title { margin-bottom: .2rem; }
  .pop-sub { color: var(--color-gray-500); font-size: .95rem; }
  .pop-wrap { display: grid; grid-template-columns: 1fr; gap: 1.2rem; }

  /* Featured (#1) */
  .pop-feat { position: relative; display: block; border-radius: 18px; overflow: hidden; text-decoration: none; aspect-ratio: 16 / 10; box-shadow: 0 12px 32px rgba(15,39,71,.14); }
  .pop-feat img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
  .pop-feat:hover img { transform: scale(1.045); }
  .pop-feat-grad { position: absolute; inset: 0; background: linear-gradient(to top, rgba(8,22,13,.86) 0%, rgba(8,22,13,.32) 48%, rgba(8,22,13,0) 78%); }
  .pop-feat-body { position: absolute; left: 0; right: 0; bottom: 0; padding: 1.4rem 1.5rem 1.5rem; }
  .pop-badge { display: inline-flex; align-items: center; gap: .35rem; background: var(--color-primary-600, #16a34a); color: #fff; font-weight: 700; font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; padding: .32rem .7rem; border-radius: 999px; margin-bottom: .7rem; box-shadow: 0 2px 10px rgba(0,0,0,.2); }
  .pop-feat-cat { display: block; color: var(--color-primary-300, #86efac); font-size: .74rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; margin-bottom: .3rem; }
  .pop-feat-title { color: #fff; font-size: 1.45rem; line-height: 1.24; font-weight: 800; margin: 0; text-shadow: 0 1px 12px rgba(0,0,0,.3); }

  /* Lista (#2-6) */
  .pop-list { display: flex; flex-direction: column; gap: .25rem; }
  .pop-item { display: flex; align-items: center; gap: 1rem; padding: .7rem .7rem; border-radius: 12px; text-decoration: none; color: inherit; transition: background .15s ease, box-shadow .15s ease; }
  .pop-item:hover { background: #fff; box-shadow: 0 6px 18px rgba(15,39,71,.08); }
  .pop-num { flex: 0 0 1.7rem; text-align: center; font-size: 1.55rem; font-weight: 800; line-height: 1; color: var(--color-primary-600, #16a34a); font-variant-numeric: tabular-nums; }
  .pop-thumb { width: 88px; height: 66px; border-radius: 10px; object-fit: cover; flex: 0 0 auto; background: var(--color-gray-200); }
  .pop-meta { min-width: 0; }
  .pop-item-cat { font-size: .68rem; text-transform: uppercase; letter-spacing: .04em; color: var(--color-primary-700, #15803d); font-weight: 700; }
  .pop-item-title { font-size: .98rem; line-height: 1.3; margin: .12rem 0 0; font-weight: 700; color: var(--color-gray-800, #1f2937); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  @media (min-width: 860px) {
    .pop-wrap { grid-template-columns: 1.08fr 1fr; gap: 2.2rem; align-items: stretch; }
    .pop-feat { aspect-ratio: auto; height: 100%; min-height: 360px; }
    .pop-feat-title { font-size: 1.6rem; }
    .pop-list { justify-content: space-between; }
  }

  .section-header--row { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; text-align: left; }
  .section-header--row .section-subtitle { max-width: 640px; }
  .section-see-all { flex: 0 0 auto; display: inline-flex; align-items: center; gap: .35rem; color: var(--color-primary-700, #15803d); font-weight: 600; text-decoration: none; white-space: nowrap; }
  .section-see-all:hover { text-decoration: underline; }
  .section-footer { text-align: center; margin-top: 2rem; }
  .section-see-all-btn { display: inline-block; padding: .7rem 1.6rem; border: 1px solid var(--color-primary-600, #16a34a); color: var(--color-primary-700, #15803d); border-radius: 10px; font-weight: 600; text-decoration: none; transition: background .15s, color .15s; }
  .section-see-all-btn:hover { background: var(--color-primary-600, #16a34a); color: #fff; }
  @media (max-width: 640px) {
    .section-header--row { flex-direction: column; align-items: flex-start; }
  }

  .about { background: linear-gradient(135deg, var(--color-primary-800, #166534) 0%, var(--color-primary-900, #14532d) 100%); }
  .about-head { text-align: center; max-width: 680px; margin: 0 auto 2.5rem; }
  .about-head .section-title { color: #fff; margin-bottom: .5rem; }
  .about-lead { color: rgba(255,255,255,.85); font-size: 1.05rem; line-height: 1.7; margin: 0; }
  .about-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; max-width: 960px; margin: 0 auto; }
  .about-card { background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); border-radius: 14px; padding: 1.9rem 1.6rem; text-align: center; }
  .about-icon { width: 54px; height: 54px; margin: 0 auto 1.1rem; border-radius: 13px; background: rgba(255,255,255,.12); color: var(--color-primary-300, #86efac); display: flex; align-items: center; justify-content: center; }
  .about-card h3 { color: #fff; font-size: 1.12rem; margin: 0 0 .45rem; }
  .about-card p { color: rgba(255,255,255,.78); font-size: .93rem; line-height: 1.6; margin: 0; }
</style>
