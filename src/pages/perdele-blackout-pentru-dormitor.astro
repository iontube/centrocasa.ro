---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import SimilarArticles from '../components/SimilarArticles.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import emag from '../data/emag-products.json';
import keywordsData from '../../keywords.json';
import { visibleArticles, slugify } from '../lib/articles.mjs';

const relatedArticles = visibleArticles(keywordsData.completed).map(item => ({
  title: item.keyword.charAt(0).toUpperCase() + item.keyword.slice(1),
  slug: item.slug || slugify(item.keyword),
  excerpt: item.excerpt || '',
  image: item.image || `/images/articles/${item.slug || slugify(item.keyword)}.webp`,
  category: item.category,
  categorySlug: item.categorySlug,
  date: item.date || '',
}));

const pool = emag['perdele-blackout'] || [];
const byId = Object.fromEntries(pool.map(p => [p.id, p]));

const PICKS = [
  // --- Seturi complete, cele mai bine notate ---
  { g: 'set', id: 'D25VBZMBM', badge: 'Cel mai bine notat', short: 'Set Mastel gri', tip: 'Set complet', dim: '2x100x245 cm', prindere: 'Rejansa',
    specs: ['set 2 draperii blackout gri + perdea brodata', '2 x 100 x 245 cm, acopera o fereastra larga', 'blackout pentru intuneric, perdea pentru zi', '24 pareri, nota 5, cea mai mare din selectie'],
    pros: ['Cea mai mare nota din selectie, 5 din 5, cu 24 de pareri', 'Set complet: draperie blackout plus perdea brodata', 'Doua panouri de 100 cm, pentru o fereastra larga', 'Combini intunericul cu lumina filtrata de zi'],
    cons: ['Mai scump, fiind set complet', 'Culoarea gri nu se potriveste oricarui dormitor'],
    verdict: 'Cu 24 de pareri si nota maxima, 5 din 5, cea mai mare din selectie, setul Mastel gri e cea mai sigura alegere pentru un dormitor. Nu e doar o draperie, ci un set complet: doua panouri blackout de 100 cm care blocheaza lumina pentru somn si o perdea brodata care filtreaza frumos lumina in timpul zilei, ca sa nu stai in intuneric total cand vrei doar intimitate. Cele doua panouri acopera o fereastra larga, iar prinderea pe rejansa se potriveste sinelor obisnuite. Fiind set complet, costa mai mult decat o simpla draperie, iar griul nu merge cu orice decor. Il iei cand vrei cea mai bine notata solutie din selectie, un set complet blackout plus perdea, pentru un dormitor in care controlezi si intunericul de noapte, si lumina de zi.' },
  { g: 'set', id: 'DQXH7ZMBM', badge: 'Acelasi set, in bej-nisip', short: 'Set Mastel bej-nisip', tip: 'Set complet', dim: '2x100x245 cm', prindere: 'Rejansa',
    specs: ['set 2 draperii blackout bej-nisip + perdea brodata', '2 x 100 x 245 cm', 'nuanta calda, neutra, se asorteaza usor', '24 pareri, nota 5'],
    pros: ['Aceeasi nota maxima, 5 din 5, din 24 de pareri', 'Nuanta bej-nisip, calda si neutra, merge cu orice', 'Set complet: blackout plus perdea brodata', 'Doua panouri, pentru o fereastra larga'],
    cons: ['Bejul se pateaza mai vizibil decat griul', 'Set complet, pret mai ridicat'],
    verdict: 'Daca setul gri e alegerea sigura, versiunea bej-nisip e cea mai usor de asortat, pentru cei care vor caldura in loc de racealea griului. E exact acelasi set Mastel foarte apreciat, cu aceeasi nota maxima din 24 de pareri, doar ca nuanta bej-nisip, calda si neutra, se potriveste aproape oricarui dormitor si oricarei mobile, de la lemn deschis la alb. Are aceleasi doua panouri blackout de 100 cm plus perdea brodata si aceeasi prindere pe rejansa. Bejul, in schimb, arata petele mai usor decat griul si cere spalat mai des. Il iei cand vrei setul Mastel foarte bine notat intr-o nuanta calda si neutra, usor de asortat, pentru un dormitor luminos in care vrei si intuneric la nevoie, si un aspect cald.' },
  { g: 'set', id: 'D9L514YBM', badge: 'Cu inele metalice', short: 'Deconovo cu inele', tip: 'Set 2 opace', dim: '140 x 175 cm', prindere: 'Inele metalice',
    specs: ['set 2 perdele opace blackout, Deconovo', 'inele metalice, se pun direct pe bara', '140 x 175 cm, pentru ferestre medii', '1 parere, nota 4'],
    pros: ['De la Deconovo, brand cunoscut de perdele blackout', 'Inele metalice, se monteaza rapid pe bara', 'Opace, blocheaza bine lumina', 'Set de 2 panouri'],
    cons: ['O singura parere deocamdata', 'Fara perdea de zi in set'],
    verdict: 'Pentru cine vrea montaj rapid, fara sistemul de rejansa, setul Deconovo cu inele metalice se pune direct pe bara si e gata. Cele doua panouri opace blackout de 140 x 175 cm blocheaza bine lumina, iar inelele metalice aluneca usor pe bara si dau acel pliu regulat, elegant, la tras si la strans, spre deosebire de rejansa care cere carlige. Deconovo e un brand cunoscut in perdelele blackout, ceva ce conteaza cand recenziile sunt inca putine, deocamdata doar una. Setul nu include si o perdea de zi. Il iei cand vrei o pereche de perdele blackout cu inele, usor de montat pe bara, de la un brand de incredere, pentru o fereastra medie de dormitor.' },
  // --- Cu inele, usor de montat ---
  { g: 'inel', id: 'D56WJT2BM', badge: 'Cea mai accesibila', short: 'Eurofirany 100% opac', tip: 'Un panou', dim: '140 x 270 cm', prindere: 'Rejansa',
    specs: ['perdea blackout Eurofirany, 100% opaca', '140 x 270 cm, lunga, pentru ferestre inalte', 'textura placuta, blocheaza complet lumina', 'cel mai mic pret din selectie'],
    pros: ['Cel mai mic pret din selectie', '100% opaca, intuneric complet', 'Lunga, 270 cm, buna si pentru ferestre inalte', 'De la Eurofirany, specialist in textile de casa'],
    cons: ['Un singur panou, iei doua pentru o fereastra larga', 'Fara pareri deocamdata'],
    verdict: 'Cand vrei intuneric complet fara sa cheltui mult, perdeaua Eurofirany 100% opaca e cea mai accesibila cale. E un panou blackout care blocheaza total lumina, cu o textura placuta, si e neasteptat de lung, 270 cm, deci acopera si ferestre inalte sau se aseaza bogat, cazand pana la podea, la cel mai mic pret din selectie. Eurofirany e un nume cunoscut in textilele de casa. Fiind un singur panou, pentru o fereastra larga iei doua, iar produsul nu are inca recenzii, deci te bazezi pe specificatii si pe reputatia marcii. O iei cand vrei cea mai ieftina perdea cu adevarat blackout, lunga si 100% opaca, si nu te deranjeaza sa comanzi doua panouri pentru o fereastra mare.' },
  { g: 'inel', id: 'DM5MT5MBM', badge: 'Negre, blackout total', short: 'Draperii negre inele', tip: 'Set 2', dim: '2 x 140 x 260 cm', prindere: 'Inele metalice',
    specs: ['set 2 draperii negre blackout, cu inele', '2 x 140 x 260 cm, panouri lungi', 'negrul da cel mai bun intuneric', 'inele metalice, montaj pe bara'],
    pros: ['Negrul ofera cel mai bun intuneric', 'Set de 2 panouri lungi, 260 cm', 'Inele metalice, se monteaza usor pe bara', 'Bune pentru cine lucreaza noaptea si doarme ziua'],
    cons: ['Fara pareri deocamdata', 'Negrul poate parea sobru intr-un dormitor luminos'],
    verdict: 'Pentru intunericul cel mai adanc, culoarea conteaza, iar negrul e campionul: setul de draperii negre blackout blocheaza lumina mai bine ca nuantele deschise. Cele doua panouri lungi, de 260 cm, cu inele metalice pentru montaj rapid pe bara, sunt alegerea celor care au nevoie de bezna adevarata: cei care lucreaza noaptea si dorm ziua, sau oricine e deranjat de cea mai mica raza de lumina. Nu au inca recenzii, deci te bazezi pe specificatii, iar negrul poate parea sobru intr-un dormitor foarte luminos si vesel. Le iei cand vrei intunericul maxim, indiferent de ora, cu doua panouri negre blackout lungi si inele usor de montat, si negrul se potriveste cu decorul tau.' },
  { g: 'inel', id: 'DL9Z0W3BM', badge: 'Gri-maro, cu inele', short: 'Blackout gri-maro', tip: 'Set 2', dim: '140 x 245 cm', prindere: 'Inele',
    specs: ['set 2 draperii blackout gri-maro', '140 x 245 cm, cu inele pentru dormitor', 'nuanta neutra, cu inele pentru montaj usor', 'accesibil, pentru dormitor'],
    pros: ['Nuanta gri-maro neutra, se asorteaza usor', 'Set de 2 panouri cu inele', 'Pret accesibil pentru un set', 'Gandite pentru dormitor'],
    cons: ['Fara pareri deocamdata', 'Nuanta mai putin populara decat gri sau bej'],
    verdict: 'Intre negru si nuantele deschise, griul-maro al acestui set ofera un compromis discret, pentru cine vrea intuneric bun fara o culoare prea puternica. Cele doua panouri blackout de 245 cm, cu inele pentru montaj usor pe bara, sunt gandite anume pentru dormitor, iar nuanta gri-maro, neutra si calda in acelasi timp, se asorteaza usor cu mobila si peretii, fara sa iasa in evidenta. E un set accesibil, o alegere practica de mijloc. Nu are inca recenzii, deci mergi pe specificatii, iar nuanta gri-maro e mai putin cautata decat clasicele gri sau bej. Il iei cand vrei un set de perdele blackout cu inele, la un pret bun, intr-o nuanta neutra discreta, pentru un dormitor in care nu vrei nici negru, nici culori deschise.' },
  // --- Speciale ---
  { g: 'spec', id: 'DJ8YM13BM', badge: 'Fara gaurire', short: 'Fara gaurire', tip: 'Fara gauri', dim: '200 x 146 cm', prindere: 'Pe feronerie',
    specs: ['perdea blackout care se prinde de feronerie', 'fara gaurire, fara bara si suruburi', '200 x 146 cm, neagra', 'ideala pentru chirie sau tamplarie PVC'],
    pros: ['Se monteaza fara nicio gaura in perete', 'Se prinde direct de feroneria geamului', 'Ideala pentru chirie sau tamplarie PVC', 'Blackout, blocheaza lumina'],
    cons: ['Fara pareri deocamdata', 'Se potriveste ferestrelor cu feronerie compatibila'],
    verdict: 'Daca stai in chirie sau nu vrei sa gauresti tamplaria PVC, perdeaua blackout fara gaurire rezolva exact aceasta problema. Se prinde direct de feroneria geamului, cu sistemul inclus, fara bara, fara suruburi si fara nicio gaura in perete sau in rama, deci o montezi si o demontezi fara urme, un mare avantaj intr-o locuinta inchiriata sau cu ferestre noi pe care nu vrei sa le strici. Panoul negru de 200 x 146 cm blocheaza lumina. Nu are inca recenzii, iar montarea depinde de o feronerie compatibila, deci verifica geamul tau. O iei cand vrei intuneric fara sa gauresti nimic, intr-o chirie sau pe tamplarie PVC noua, si ai o fereastra cu feronerie potrivita pentru sistemul de prindere.' },
  { g: 'spec', id: 'D3BNY02BM', badge: 'Portabila, cu velcro', short: 'Opaca portabila', tip: 'Portabila', dim: '300 x 145 cm', prindere: 'Benzi velcro',
    specs: ['perdea opaca portabila, neagra', 'se prinde cu benzi velcro autoadezive', '300 x 145 cm, se pliaza pentru bagaj', 'pentru calatorii, cazari si camere de copii'],
    pros: ['Portabila, o iei cu tine in calatorii', 'Se prinde cu benzi velcro, fara montaj fix', 'Se pliaza compact, incape in bagaj', 'Buna pentru cazari, hoteluri, somnul copiilor ziua'],
    cons: ['Fara pareri deocamdata', 'Velcro-ul autoadeziv poate lasa urme'],
    verdict: 'Cea mai neobisnuita idee din selectie e o perdea blackout pe care o iei cu tine: modelul portabil cu benzi velcro. Se prinde cu benzi velcro autoadezive pe rama geamului, fara bara si fara montaj fix, se desprinde si se pliaza compact intr-un bagaj, deci o duci in vacanta, la cazari sau la bunici, ca sa asiguri intuneric oriunde dormi, mai ales pentru copiii mici care au nevoie de bezna la somnul de zi. Panoul negru de 300 x 145 cm acopera bine o fereastra. Nu are inca recenzii, iar benzile velcro autoadezive pot lasa urme pe unele suprafete. O iei cand vrei intuneric portabil, pentru calatorii, cazari sau somnul copiilor ziua, si ai nevoie de o solutie fara montaj fix, pe care o strangi si o iei cu tine.' },
  { g: 'spec', id: 'DLFR31YBM', badge: 'Catifea, termoizolanta', short: 'Catifea Miulee', tip: 'Premium', dim: 'Set 2', prindere: 'Inele',
    specs: ['set 2 perdele din catifea, Miulee', 'blackout, termoizolante, opace', 'catifeaua da un aspect bogat si cald', 'de la Miulee, brand cunoscut'],
    pros: ['Din catifea, aspect bogat, premium', 'Termoizolante: tin caldura iarna, racoarea vara', 'Blackout, blocheaza lumina', 'Set de 2 panouri, de la Miulee'],
    cons: ['Fara pareri deocamdata', 'Catifeaua e grea si cere spalare cu grija'],
    verdict: 'Pentru un dormitor cu aspect bogat si confort in plus, setul de perdele din catifea Miulee joaca la alta categorie. Catifeaua da o cadere grea, eleganta, si un aer cald, mai luxos decat al unei draperii obisnuite, iar tesatura groasa e si termoizolanta: pastreaza caldura iarna si tine racoarea vara, ajutand si la factura, pe langa intuneric si izolare fonica. Sunt blackout si vin ca set de doua panouri, de la Miulee, un brand cunoscut. Nu au inca recenzii, iar catifeaua e grea si cere spalare cu grija, dupa instructiuni. Le iei cand vrei perdele blackout premium, din catifea, care sa arate bogat si sa izoleze termic, pentru un dormitor in care confortul si aspectul conteaza la fel de mult ca intunericul.' },
].map(x => ({ ...x, p: byId[x.id] })).filter(x => x.p);

const SET = PICKS.filter(x => x.g === 'set');
const INEL = PICKS.filter(x => x.g === 'inel');
const SPEC = PICKS.filter(x => x.g === 'spec');

const hero = '/images/articles/perdele-blackout-pentru-dormitor.webp';
const figSet = '/imagini/articole/perdele-seturi.webp';
const figInel = '/imagini/articole/perdele-inele.webp';
const figSpec = '/imagini/articole/perdele-speciale.webp';
const published = '2026-07-19T20:04:57+03:00';

const faq = [
  { question: 'Ce inseamna blackout si cat de mult intuneca o perdea?', answer: 'Blackout, adica intunecare, descrie o perdea facuta dintr-o tesatura groasa, deasa, uneori cu un strat special, care blocheaza lumina de afara mult mai bine decat o perdea obisnuita. O perdea blackout buna reduce drastic lumina care intra, creand un intuneric aproape total in camera, chiar si in plina zi sau cu felinar la geam. Gradul difera: unele sunt 100% opace si intuneca complet, altele filtreaza puternic dar lasa o urma de lumina. Conteaza si montajul: cu cat perdeaua acopera mai bine marginile ferestrei, sus, jos si pe laturi, cu atat blocheaza mai multa lumina care altfel s-ar strecura pe langa. Pentru un intuneric real, alege o perdea marcata 100% opaca sau full blackout, in nuante inchise, si monteaz-o sa depaseasca fereastra pe toate laturile.' },
  { question: 'De ce sa pun perdele blackout in dormitor?', answer: 'Pentru ca intunericul imbunatateste vizibil calitatea somnului. Corpul produce melatonina, hormonul somnului, mai bine la intuneric, iar cea mai mica sursa de lumina, un felinar stradal, zorii de vara devreme sau un ecran, poate perturba somnul si te poate trezi mai devreme decat vrei. O perdea blackout blocheaza aceste surse si mentine camera intunecata, ajutandu-te sa adormi mai usor, sa dormi mai adanc si sa nu te trezesti odata cu rasaritul. Sunt deosebit de utile pentru cei care lucreaza in ture si dorm ziua, pentru camerele copiilor mici care au nevoie de somn si peste zi, si pentru oricine e sensibil la lumina. Pe langa somn, multe perdele blackout sunt si termoizolante si reduc zgomotul, adaugand confort dormitorului.' },
  { question: 'Perdelele blackout ajuta si la izolarea termica si fonica?', answer: 'Da, si e un avantaj des subestimat. Tesatura groasa si deasa care blocheaza lumina blocheaza partial si caldura si sunetul. Termic, o perdea blackout tine caldura in camera iarna, reducand pierderile prin geam, si opreste o parte din caldura soarelui vara, ajutand camera sa ramana mai racoroasa, ceea ce se poate simti chiar si la factura de incalzire sau climatizare. Efectul e mai puternic la perdelele groase, ca cele din catifea, adesea marcate termoizolante. Fonic, aceeasi tesatura groasa absoarbe o parte din zgomotul de afara, nu il elimina complet, dar il atenueaza, util daca stai la strada. Asadar, o perdea blackout buna aduce trei beneficii deodata: intuneric, izolare termica si ceva liniste in plus.' },
  { question: 'Cum aleg dimensiunea corecta si prinderea?', answer: 'Pentru intuneric bun, perdeaua trebuie sa depaseasca fereastra pe toate laturile, ca lumina sa nu se strecoare pe margini: alege-o mai lata decat geamul, ideal sa acopere si zidul de langa, si suficient de lunga cat sa ajunga aproape de podea sau macar mult sub pervaz. Pentru o fereastra larga, iei doua panouri sau un set. Cat despre prindere, sunt doua sisteme comune: rejansa, o banda cusuta sus in care pui carlige ce se prind de sina, si inelele metalice, prin care treci direct bara, mai rapide de montat si cu un pliu regulat, elegant. Exista si solutii fara gaurire, care se prind de feronerie, sau portabile cu velcro, pentru chirie sau calatorii. Alege prinderea dupa ce ai deja, sina sau bara, si masoara fereastra inainte de a comanda.' },
  { question: 'Blackout sau perdea normala, sau amandoua?', answer: 'Ideal, amandoua, si de aceea seturile complete, ca cele Mastel din selectie, care includ o draperie blackout plus o perdea de zi, sunt atat de practice. Draperia blackout, groasa si opaca, o tragi seara si noaptea pentru intuneric si intimitate totala. Perdeaua de zi, subtire si semitransparenta, o lasi ziua: filtreaza frumos lumina, iti da intimitate fata de vecini fara sa te lase in intuneric si pastreaza camera luminoasa. Astfel controlezi lumina dupa moment: bezna cand dormi, lumina difuza cand esti treaz. Daca ai deja o perdea de zi, poti lua doar draperia blackout; daca pornesti de la zero intr-un dormitor, un set complet cu ambele e cea mai comoda solutie, iar aspectul stratificat arata si mai bine.' },
  { question: 'Se pot monta perdele blackout fara sa gauresc peretele?', answer: 'Da, exista solutii special pentru asta, utile mai ales in chirie sau pe tamplaria PVC noua, pe care nu vrei sa o gauresti. Un tip se prinde direct de feroneria geamului, cu un sistem inclus, fara bara, suruburi sau gauri in perete, cum e modelul fara gaurire din selectie. Alta varianta e perdeaua portabila cu benzi velcro autoadezive, care se lipesc pe rama si tin panoul, buna si pentru calatorii pentru ca o strangi si o iei cu tine. Aceste solutii nu lasa urme permanente si se demonteaza usor. Verifica insa compatibilitatea cu fereastra ta, feronerie potrivita pentru sistemul de prindere, si tine cont ca velcro-ul autoadeziv poate lasa urme pe unele suprafete. Pentru cine nu poate sau nu vrea sa gaureasca, sunt exact solutia potrivita.' },
  { question: 'Cat costa niste perdele blackout bune?', answer: 'In selectie, o perdea blackout individuala 100% opaca porneste de la circa 64 de lei, iar seturile de doua panouri cu inele sunt in zona 110-165 de lei. Solutiile speciale, ca perdeaua fara gaurire sau cea portabila cu velcro, costa in jur de 135-142 de lei. Seturile complete, care includ si draperie blackout, si perdea de zi brodata, ca cele Mastel, cele mai bine notate, sunt in jur de 328 de lei, iar setul premium din catifea, termoizolant, in jur de 241 de lei. Cel mai bun raport il gasesti alegand dupa nevoie: o perdea 100% opaca ieftina daca vrei doar intuneric, un set cu inele daca vrei montaj usor, sau un set complet cu perdea de zi daca pornesti de la zero si vrei sa controlezi si lumina de noapte, si pe cea de zi.' },
];

const images = [hero, figSet, figInel, figSpec, ...PICKS.map(x => x.p.image)];
---

<Layout
  title="Cele mai bune perdele blackout pentru dormitor in 2026: seturi, cu inele si speciale"
  description="Care sunt cele mai bune perdele blackout pentru dormitor in 2026: seturi complete cu draperie si perdea de la Mastel, modele opace cu inele usor de montat, si solutii speciale fara gaurire, portabile sau din catifea termoizolanta. Comparate pe dimensiune, prindere si opacitate, plus cum aleg dimensiunea si de ce intunericul conteaza pentru somn."
  image={hero}
  type="article"
  publishedTime={published}
  modifiedTime={published}
  author="Maria Ionescu"
  breadcrumb={[{ name: 'Acasa', url: '/' }, { name: 'Decoratiuni Casa', url: '/decoratiuni-casa/' }, { name: 'Cele mai bune perdele blackout pentru dormitor' }]}
  faq={faq.map(f => ({ question: f.question, answer: f.answer }))}
>
  <article class="rd">
    <nav class="breadcrumb">
      <a href="/">Acasa</a><span class="breadcrumb-separator">/</span>
      <a href="/decoratiuni-casa/">Decoratiuni Casa</a><span class="breadcrumb-separator">/</span>
      <span>Cele mai bune perdele blackout pentru dormitor</span>
    </nav>

    <h1>Cele mai bune perdele blackout pentru dormitor</h1>
    <p class="rd-byline">de <a href="/autori/maria-ionescu/">Maria Ionescu</a>, Designer Interior · actualizat iulie 2026</p>

    <img class="rd-hero" src={hero} alt="Cele mai bune perdele blackout pentru dormitor: seturi, cu inele si speciale" width="1200" height="675" fetchpriority="high" />

    <div class="rd-intro">
      <p>Cele mai bine notate perdele blackout din selectie sunt <strong>seturile Mastel</strong>, cu nota 5 din 24 de pareri, care includ si draperie, si perdea de zi. Pentru intuneric ieftin, perdeaua <strong>Eurofirany 100% opaca</strong> e cea mai accesibila, iar pentru chirie, modelul <strong>fara gaurire</strong> se prinde de feronerie.</p>
      <p>O perdea blackout blocheaza lumina si te ajuta sa dormi mai bine, iar multe <strong>izoleaza si termic si fonic</strong>. Mai jos gasesti direct recomandarile, grupate pe seturi complete, cu inele usor de montat, si speciale, iar sub ele un ghid despre cum alegi dimensiunea si prinderea.</p>
      <p>Trebuie spus cinstit: in afara seturilor Mastel, foarte apreciate, multe modele sunt inca noi, cu putine sau fara recenzii, asa ca la ele te bazezi pe specificatii si pe reputatia marcii. Le-am ales pe cele cu adevarat opace, blackout, si le-am impartit dupa tip si prindere, cu dimensiune si montaj clare la fiecare. Pentru living, vezi si <a href="/draperii-elegante-pentru-living/">draperiile elegante</a>, iar pentru dormitor, <a href="/cele-mai-bune-seturi-de-mobila-de-dormitor/">seturile de mobila de dormitor</a>.</p>
    </div>

    <details class="rd-toc">
      <summary>Cuprins</summary>
      <ol>
        <li><a href="#tabel">Comparatie rapida</a></li>
        <li><a href="#set">Seturi complete, cele mai bine notate</a></li>
        <li><a href="#inel">Cu inele, usor de montat</a></li>
        <li><a href="#spec">Speciale: fara gaurire, portabile, catifea</a></li>
        <li><a href="#de-ce">De ce perdele blackout in dormitor</a></li>
        <li><a href="#conteaza">Ce conteaza cand alegi</a></li>
        <li><a href="#prindere">Prinderea si montajul</a></li>
        <li><a href="#intretinere">Intretinerea</a></li>
        <li><a href="#cat-costa">Cat costa</a></li>
        <li><a href="#faq">Intrebari frecvente</a></li>
      </ol>
    </details>

    <h2 id="tabel">Comparatie rapida</h2>
    <div class="table-wrap">
      <table class="rd-table">
        <thead><tr><th>Model</th><th>Tip</th><th>Prindere</th><th>Nota</th></tr></thead>
        <tbody>
          {PICKS.map(x => (
            <tr>
              <td><div class="cmp-prod"><img class="cmp-thumb" src={x.p.image} alt={x.short} loading="lazy" width="44" height="44" /><span>{x.short}</span></div></td>
              <td>{x.tip}</td>
