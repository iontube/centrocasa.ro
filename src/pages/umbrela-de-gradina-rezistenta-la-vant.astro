---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import SimilarArticles from '../components/SimilarArticles.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import emag from '../data/emag-products.json';
import keywordsData from '../../keywords.json';
import { visibleArticles, slugify } from '../lib/articles.mjs';

const relatedArticles = visibleArticles(keywordsData.completed).map(item => ({
  title: item.keyword.charAt(0).toUpperCase() + item.keyword.slice(1),
  slug: item.slug || slugify(item.keyword),
  excerpt: item.excerpt || '',
  image: item.image || `/images/articles/${item.slug || slugify(item.keyword)}.webp`,
  category: item.category,
  categorySlug: item.categorySlug,
  date: item.date || '',
}));

const pool = emag['umbrela-gradina'] || [];
const byId = Object.fromEntries(pool.map(p => [p.id, p]));

const PICKS = [
  // --- Picior central ---
  { g: 'central', id: 'D1GQN4MBM', badge: 'Cea mai vanduta', short: 'GU cu manivela', tip: 'Picior central', diam: 'Ø 300 cm', mecanism: 'manivela + inclinare',
    specs: ['picior central, Ø 300 cm', 'manivela de ridicare si inclinare', 'structura de otel, panza poliester', 'densitate 160 g/m²'],
    pros: ['Cea mai vanduta din selectie, cu nota buna', 'Manivela pentru deschidere usoara si inclinare pentru soare piezis', 'Structura de otel, Ø 300 cm, umbreste o masa intreaga', 'Pret bun pentru o umbrela de terasa cu manivela'],
    cons: ['Ca orice umbrela mare, cere o baza grea contra vantului', 'Panza de 160 g/m², densitate medie'],
    verdict: 'Cea mai vanduta umbrela din selectie si un bun punct de plecare pentru o terasa sau o masa de gradina. Are picior central si un diametru de 300 cm, cat sa umbreasca o masa cu scaune, si vine cu manivela pentru deschidere usoara si cu inclinare, ca sa urmaresti soarele in timpul zilei. Structura e din otel, iar panza de poliester are 160 g/m², o densitate medie, buna pentru umbra de zi cu zi. Ca la orice umbrela mare, rezistenta la vant vine mai ales din baza: pune-i o baza grea si strange-o cand se anunta rafale. O iei cand vrei o umbrela clasica, cu manivela, la un pret bun, pentru o masa de terasa.' },
  { g: 'central', id: 'D3Z19XYBM', badge: 'Nota cea mai mare', short: 'SONGMICS cu inclinare', tip: 'Picior central', diam: 'Ø 160 cm', mecanism: 'inclinare',
    specs: ['picior central, Ø 160 cm', 'se inclina, pentru soare piezis', 'structura metalica', 'terasa, gradina sau plaja'],
    pros: ['Nota cea mai mare din selectie, aproape de maxim', 'Se inclina, urmaresti soarele dimineata si seara', 'SONGMICS, brand cunoscut pentru pret-calitate', 'Compacta si versatila, merge si la plaja'],
    cons: ['Diametru mai mic, 160 cm, umbreste 2-3 persoane', 'Structura mai usoara, cere baza pe masura'],
    verdict: 'Umbrela cu cea mai mare nota din selectie, pentru cine vrea ceva sigur, versatil si nu foarte mare. SONGMICS are picior central si un diametru de 160 cm, potrivit pentru doua-trei persoane la o masa mica sau pentru plaja, si se inclina, ca sa te feresti de soarele piezis de dimineata si de seara. Fiind un brand cunoscut pentru raportul pret-calitate, are in spate multe pareri bune. E mai compacta si mai usoara, deci merita o baza pe masura si strangerea la vant. O iei cand vrei o umbrela de incredere, versatila, pentru o masa mica sau pentru a o duce si la plaja.' },
  { g: 'central', id: 'D0Y2HZBBM', badge: 'Raport bun', short: 'Heinner 270 cm', tip: 'Picior central', diam: 'Ø 270 cm', mecanism: 'manivela',
    specs: ['picior central, Ø 270 cm', 'forma octogon', 'structura de otel, panza poliester', 'brand Heinner'],
    pros: ['Diametru bun, 270 cm, pentru o masa de familie', 'Heinner, brand cunoscut la noi, cu service', 'Structura de otel, rezistenta', 'Raport bun calitate-pret'],
    cons: ['Cere o baza grea, ca orice umbrela de 270 cm', 'Fara inclinare la acest model'],
    verdict: 'O umbrela de familie, cu un diametru bun si un brand de incredere, la un pret rezonabil. Heinner are picior central si 270 cm in forma de octogon, cat sa acopere o masa cu sase locuri, cu structura de otel si panza de poliester. Heinner e un brand cunoscut la noi, cu piese si service accesibile, ceea ce conteaza la o umbrela pe care o folosesti sezoane la rand. Nu se inclina la acest model, deci o orientezi din pozitia piciorului, si, ca orice umbrela mare, cere o baza grea pentru vant. O iei cand vrei o umbrela de familie solida, de la un brand cunoscut, fara sa dai multi bani.' },
  { g: 'central', id: 'D4PZRMYBM', badge: 'Portabila, cu UPF50+', short: 'Maui&Sons XL plaja', tip: 'Picior central', diam: 'Ø 220 cm', mecanism: 'rabatabila',
    specs: ['umbrela de plaja si gradina, Ø 220 cm', 'protectie solara UPF50+', 'structura de aluminiu, usoara', 'rabatabila, se inclina'],
    pros: ['Protectie solara UPF50+, blocheaza razele UV', 'Aluminiu, usoara, o cari usor la plaja', 'Se rabateaza, urmaresti soarele', 'Nota buna de la cumparatori'],
    cons: ['Gandita mai ales pentru plaja, mai putin pentru vant puternic', 'Diametru mediu, 220 cm'],
    verdict: 'Alegerea daca vrei o umbrela usoara, portabila, pe care o folosesti si in gradina, si la plaja. Maui&Sons XL are 220 cm si o structura de aluminiu, deci e usoara si o transporti fara efort, cu protectie solara UPF50+, care blocheaza eficient razele UV. Se rabateaza, ca sa te fereasca de soarele piezis. Fiind gandita mai mult pentru plaja, pe vant puternic e mai sensibila decat o umbrela grea de terasa, deci ai grija la fixare si strange-o la rafale. O iei cand vrei o umbrela versatila, cu protectie UV buna, pe care sa o muti usor intre terasa si plaja.' },
  // --- Brat lateral (cantilever) ---
  { g: 'cantilever', id: 'D73SXN3BM', badge: 'Brat lateral', short: 'CIUPIGo brat lateral', tip: 'Brat lateral', diam: 'Ø 300 cm', mecanism: 'manivela',
    specs: ['brat lateral (cantilever), Ø 300 cm', 'piciorul sta pe margine, nu in mijloc', 'structura de otel, panza 180 g/m²', 'umbreste fara stalp central'],
    pros: ['Brat lateral: piciorul sta pe margine, mesa ramane libera dedesubt', 'Diametru mare, 300 cm, umbra generoasa', 'Panza mai densa, 180 g/m²', 'Se roteste, umbresti unde vrei'],
    cons: ['Cantilever-ul prinde mai mult vant, cere baza foarte grea', 'Mai scumpa decat o umbrela cu picior central'],
    verdict: 'Alegerea daca vrei umbra fara stalp in mijlocul mesei. CIUPIGo e o umbrela cu brat lateral, tip cantilever: piciorul sta pe o margine, iar bratul aduce panza de 300 cm deasupra, deci masa si scaunele raman libere dedesubt si te asezi cum vrei. Panza are 180 g/m², mai densa decat la modelele de baza, iar unele cantilevere se si rotesc, ca sa muti umbra dupa soare. Fiind in consola, prinde mai mult vant, deci cere o baza foarte grea, cu dale, si strangerea la rafale. O iei cand vrei umbra libera, fara stalp central, si esti dispus sa investesti intr-o baza serioasa.' },
  { g: 'cantilever', id: 'DJHKTHMBM', badge: 'Mare, dreptunghiulara', short: 'Outsunny 460x270', tip: 'Brat lateral', diam: '460 x 270 cm', mecanism: 'manivela',
    specs: ['dreptunghiulara, 460 x 270 cm', 'protectie UV', 'umbra pentru un set de mobilier intreg', 'suprafata mare de umbra'],
    pros: ['Suprafata mare, 460 x 270 cm, umbreste un set intreg', 'Forma dreptunghiulara, buna peste o masa lunga', 'Protectie UV', 'Umbra generoasa pentru mai multe persoane'],
    cons: ['Suprafata mare inseamna si mai mult vant prins', 'Cere baza foarte grea si spatiu'],
    verdict: 'Alegerea cand vrei sa umbresti un set de mobilier intreg, nu doar o masa. Outsunny are o panza dreptunghiulara de 460 x 270 cm, care acopera o masa lunga cu scaune sau o canapea de gradina cu masuta, cu protectie UV. Forma dreptunghiulara se potriveste mai bine peste mobilierul alungit decat o umbrela rotunda. Fiind atat de mare si in consola, prinde mult vant, deci are nevoie de o baza foarte grea si de spatiu in jur. O iei cand ai un colt de relaxare mare de umbrit si o baza pe masura, si stai atent sa o strangi cand se anunta vant.' },
  // --- Cu LED ---
  { g: 'led', id: 'D5GRYT3BM', badge: 'Cu LED, nota mare', short: 'Lehmann Flame LED', tip: 'Picior central', diam: 'Ø 240-262 cm', mecanism: 'manivela',
    specs: ['umbrela cu lumina LED integrata', 'structura de otel, panza 180 g/m²', 'lumina pe spite pentru seara', 'brand Lehmann'],
    pros: ['LED integrat, lumina placuta seara, fara alt corp de iluminat', 'Nota mare de la cumparatori', 'Panza densa, 180 g/m²', 'Structura de otel, robusta'],
    cons: ['LED-ul cere baterii sau incarcare', 'Pret peste o umbrela simpla de aceeasi marime'],
    verdict: 'Alegerea daca stai seara pe terasa si vrei lumina fara sa montezi alt corp de iluminat. Lehmann Flame are LED-uri integrate pe spite, care lumineaza placut zona de sub umbrela dupa apus, cu structura de otel si panza densa de 180 g/m². Are nota mare de la cumparatori, semn ca lumina si constructia isi fac treaba. LED-ul se alimenteaza cu baterii sau se incarca, iar pretul e peste o umbrela simpla de aceeasi marime, pentru functia in plus. Ca orice umbrela, cere baza grea la vant. O iei cand vrei umbra ziua si lumina de ambianta seara, dintr-un singur produs.' },
  { g: 'led', id: 'D8FKQVMBM', badge: 'LED premium, cu husa', short: 'Umbrela LED cu husa', tip: 'Picior central', diam: 'Ø 300 cm', mecanism: 'manivela',
    specs: ['umbrela cu LED, Ø 300 cm', 'structura de aluminiu, mai usoara si fara rugina', 'panza 180 g/m², husa de protectie inclusa', 'aspect premium'],
    pros: ['Structura de aluminiu, usoara si fara rugina', 'LED integrat plus husa de protectie inclusa', 'Diametru mare, 300 cm, panza densa 180 g/m²', 'Aspect premium, pentru o terasa amenajata'],
    cons: ['Cea mai scumpa din selectie', 'LED cu alimentare, ca la orice model cu lumina'],
    verdict: 'Cea mai completa din selectie, pentru o terasa amenajata unde vrei si umbra mare, si lumina, si durabilitate. Are 300 cm, structura de aluminiu, care e usoara si nu rugineste ca otelul, panza densa de 180 g/m² si LED integrat pentru seara, plus o husa de protectie inclusa, ca sa o acoperi cand nu o folosesti. E cea mai scumpa din selectie, dar aluminiul, husa si LED-ul o fac o alegere de durata, cu aspect premium. Ca orice umbrela mare, are nevoie de o baza grea contra vantului. O iei cand vrei cea mai completa umbrela de terasa, cu LED, husa si structura de aluminiu.' },
].map(x => ({ ...x, p: byId[x.id] })).filter(x => x.p);

const CENTRAL = PICKS.filter(x => x.g === 'central');
const CANTILEVER = PICKS.filter(x => x.g === 'cantilever');
const LED = PICKS.filter(x => x.g === 'led');

const site = 'https://centrocasa.ro';
const hero = '/images/articles/umbrela-de-gradina-rezistenta-la-vant.webp';
const figCentral = '/imagini/articole/umbrela-central.webp';
const figCantilever = '/imagini/articole/umbrela-cantilever.webp';
const figLed = '/imagini/articole/umbrela-led.webp';
const published = '2026-07-18T11:52:07+03:00';

const faq = [
  { question: 'Ce face o umbrela de gradina rezistenta la vant?', answer: 'Trei lucruri conteaza. Primul si cel mai important e baza: o baza grea, umpluta cu apa sau nisip ori din dale de beton, tine umbrela la sol mai mult decat orice altceva. Al doilea e ventilatia din varf, un capac care lasa vantul sa scape prin panza in loc sa o umfle ca pe o vela. Al treilea e structura: spite si stalp solizi, de otel sau aluminiu, care nu se indoaie. Chiar si asa, la vant puternic sau furtuna, cea mai buna umbrela e cea pe care o strangi la timp.' },
  { question: 'Umbrela cu picior central sau cu brat lateral?', answer: 'Umbrela cu picior central are stalpul in mijloc si e cea mai simpla, mai ieftina si, la aceeasi marime, mai stabila la vant. Dezavantajul e stalpul care trece prin mijlocul mesei. Umbrela cu brat lateral, tip cantilever, are piciorul pe o margine, iar panza vine deasupra dintr-un brat, deci masa ramane libera si multe modele se si rotesc. In schimb, cantilever-ul prinde mai mult vant si cere o baza mult mai grea. Alege picior central pentru simplitate si stabilitate, brat lateral pentru umbra libera, cu o baza serioasa.' },
  { question: 'Cat de grea trebuie sa fie baza umbrelei?', answer: 'Cat mai grea, mai ales la umbrelele mari si la cele cu brat lateral. Pentru o umbrela cu picior central de 2.5-3 m, o baza de 25-40 kg e un minim rezonabil, iar la cantilever se merge spre 50-100 kg, deseori din dale de beton asezate pe suportul in cruce. Bazele umplute cu apa sau nisip sunt practice pentru ca le golesti iarna. Regula simpla: mai bine o baza prea grea decat una prea usoara, pentru ca o umbrela rasturnata de vant se strica si poate rani pe cineva.' },
  { question: 'Ce inseamna densitatea panzei, in g/m²?', answer: 'Densitatea, masurata in grame pe metru patrat, spune cat de deasa si de rezistenta e panza. O panza de 160 g/m² e o densitate medie, buna pentru umbra de zi cu zi; una de 180 g/m² sau peste e mai deasa, tine mai bine la soare si la ploaie usoara si rezista mai mult in timp. Pe langa densitate, conteaza si protectia UV a materialului. Pentru o umbrela folosita mult, cauta 180 g/m² sau mai mult si o protectie solara buna.' },
  { question: 'Ce structura e mai buna, otel sau aluminiu?', answer: 'Otelul e mai ieftin si foarte rezistent, dar mai greu si poate rugini daca vopseaua se zgarie, deci merita verificat si atins cu vopsea unde e nevoie. Aluminiul e mai usor, nu rugineste si arata mai curat, dar costa mai mult. Pentru o umbrela pe care o muti des sau o lasi mult afara, aluminiul e mai comod si mai durabil; pentru buget, otelul isi face treaba daca ai grija de el. Ambele tin bine daca umbrela are baza potrivita si o strangi la vant.' },
  { question: 'Pot lasa umbrela deschisa cand plec de acasa?', answer: 'Mai bine nu. O umbrela deschisa, nesupravegheata, e cea mai expusa la o rafala neasteptata, care o poate rasturna, indoi sau rupe, chiar cu o baza buna. Cand pleci de acasa sau seara, strange-o; e o secunda de manivela care iti salveaza umbrela si ce e sub ea. La fel, inainte de furtuna sau vant puternic anuntat, strange-o si, daca poti, culc-o. O umbrela stransa nu prinde vant si rezista ani buni.' },
];

const images = [hero, figCentral, figCantilever, figLed, ...PICKS.map(x => x.p.image)];
const b64 = (s) => Buffer.from(s).toString('base64');
---

<Layout
  title="Umbrela de gradina rezistenta la vant in 2026: cum alegi"
  description="Ce umbrela de gradina rezistenta la vant sa alegi in 2026: modele cu picior central, cu brat lateral (cantilever) si cu LED, comparate pe diametru si structura. Plus ce o face rezistenta la vant, baza si densitatea panzei."
  image={hero}
  type="article"
  publishedTime={published}
  modifiedTime={published}
  author="Maria Ionescu"
  breadcrumb={[{ name: 'Acasa', url: '/' }, { name: 'Mobilier Gradina', url: '/mobilier-gradina/' }, { name: 'Umbrela de gradina rezistenta la vant' }]}
  faq={faq.map(f => ({ question: f.question, answer: f.answer }))}
>
  <article class="rd">
    <nav class="breadcrumb">
      <a href="/">Acasa</a><span class="breadcrumb-separator">/</span>
      <a href="/mobilier-gradina/">Mobilier Gradina</a><span class="breadcrumb-separator">/</span>
      <span>Umbrela de gradina rezistenta la vant</span>
    </nav>

    <h1>Umbrela de gradina rezistenta la vant</h1>
    <p class="rd-byline">de <a href="/autori/maria-ionescu/">Maria Ionescu</a>, Designer Interior · actualizat iulie 2026</p>

    <img class="rd-hero" src={hero} alt="Umbrela de gradina rezistenta la vant, pe o terasa" width="1200" height="675" fetchpriority="high" />

    <div class="rd-intro">
      <p>Pentru o masa de terasa, cea mai buna alegere e o umbrela cu <strong>picior central si manivela</strong>, ca GU de 300 cm, cea mai vanduta. Daca vrei masa libera, fara stalp in mijloc, o umbrela cu <strong>brat lateral</strong> ca CIUPIGo umbreste dintr-o parte. Iar pentru serile pe terasa, o umbrela <strong>cu LED</strong> ca Lehmann Flame da si lumina. Dar oricare ai alege, rezistenta la vant vine mai ales din <strong>baza grea</strong>.</p>
      <p>La o umbrela de gradina, prima intrebare e tipul: <strong>picior central sau brat lateral</strong>. A doua, mai importanta decat pare, e <strong>ce o face sa reziste la vant</strong>: baza, ventilatia din varf si structura. O umbrela mare fara baza pe masura zboara la prima rafala, oricat de buna ar fi panza.</p>
      <p>Am pornit de la umbrelele de gradina vandute pe eMAG, le-am verificat tipul, diametrul, structura si densitatea panzei, si le-am grupat pe picior central, brat lateral si cu LED. Pentru umbra permanenta pe terasa, vezi si <a href="/pergola-din-lemn-pentru-terasa/">pergolele din lemn</a> si <a href="/copertina-retractabila-pentru-terasa/">copertinele retractabile</a>.</p>
    </div>

    <details class="rd-toc">
      <summary>Cuprins</summary>
      <ol>
        <li><a href="#vant">Ce o face rezistenta la vant</a></li>
        <li><a href="#tip">Picior central sau brat lateral</a></li>
        <li><a href="#tabel">Comparatie rapida</a></li>
        <li><a href="#central">Umbrele cu picior central</a></li>
        <li><a href="#cantilever">Umbrele cu brat lateral</a></li>
        <li><a href="#led">Umbrele cu LED</a></li>
        <li><a href="#baza">Baza si fixarea</a></li>
        <li><a href="#cat-costa">Cat costa o umbrela de gradina</a></li>
        <li><a href="#faq">Intrebari frecvente</a></li>
      </ol>
    </details>

    <h2 id="vant">Ce o face rezistenta la vant</h2>
    <p>E promisiunea din titlu, asa ca merita luata prima. Rezistenta la vant a unei umbrele vine din trei lucruri, in ordinea importantei:</p>
    <ul>
      <li><strong>Baza grea:</strong> de departe cel mai important. O baza umpluta cu apa sau nisip ori din dale de beton tine umbrela la sol mai mult decat orice. La umbrelele mari si la cantilever, baza usoara nu are ce cauta.</li>
      <li><strong>Ventilatia din varf:</strong> un capac in doua straturi, care lasa vantul sa scape prin panza in loc sa o umfle ca pe o vela. Reduce mult riscul de rasturnare.</li>
      <li><strong>Structura solida:</strong> spite si stalp de otel sau aluminiu, care nu se indoaie la rafale. O panza mai densa, de 180 g/m², tine si ea mai bine.</li>
    </ul>
    <p>Si cel mai simplu truc: <strong>strange umbrela cand se anunta vant puternic sau pleci de acasa</strong>. O umbrela stransa nu prinde vant deloc; cea mai rezistenta umbrela e cea inchisa la timp.</p>

    <h2 id="tip">Picior central sau brat lateral</h2>
    <p>Tipul schimba si aspectul, si stabilitatea:</p>
    <p><strong>Picior central:</strong> stalpul e in mijloc, sub panza. E cea mai simpla, mai ieftina si, la aceeasi marime, mai stabila la vant. Singurul minus e stalpul care trece prin mijlocul mesei.</p>
    <p><strong>Brat lateral (cantilever):</strong> piciorul sta pe o margine, iar panza vine deasupra dintr-un brat, deci masa ramane libera si multe modele se rotesc, ca sa muti umbra dupa soare. In schimb, prinde mai mult vant si cere o baza mult mai grea, deseori cu dale de beton.</p>
    <p>Pe scurt: picior central pentru simplitate si stabilitate, brat lateral pentru umbra libera si flexibila, cu o baza pe masura.</p>

    <h2 id="tabel">Comparatie rapida</h2>
    <div class="table-wrap">
      <table class="rd-table">
        <thead><tr><th>Umbrela</th><th>Tip</th><th>Diametru</th><th>Mecanism</th></tr></thead>
        <tbody>
          {PICKS.map(x => (<tr><td>{x.short}</td><td>{x.tip}</td><td>{x.diam}</td><td>{x.mecanism}</td></tr>))}
        </tbody>
      </table>
    </div>

    <h2 id="central">Umbrele cu picior central</h2>
    <p>Clasice, simple si stabile: stalpul in mijloc, cu manivela si, la unele, inclinare. La aceeasi marime, mai stabile la vant si mai accesibile. Aici intra si o varianta portabila, de plaja.</p>
    <div class="rd-grid">
      {CENTRAL.map(x => (
        <ProductCard name={x.p.name.replace(/’/g, "'")} image={x.p.image} price={x.p.price} rating={x.p.rating} reviews={x.p.reviews} badge={x.badge} specs={x.specs} pros={x.pros} cons={x.cons} verdict={x.verdict} outKey={'p-' + x.id} />
      ))}
    </div>

    <img class="rd-fig" src={figCentral} alt="Umbrele cu picior central: GU, SONGMICS, Heinner si Maui&Sons" width="1200" height="675" loading="lazy" />

    <h2 id="cantilever">Umbrele cu brat lateral (cantilever)</h2>
    <p>Umbra fara stalp in mijloc: piciorul sta pe margine, panza vine dintr-un brat. Masa ramane libera, dar cantilever-ul prinde mai mult vant si cere o baza foarte grea.</p>
    <div class="rd-grid">
      {CANTILEVER.map(x => (
        <ProductCard name={x.p.name.replace(/’/g, "'")} image={x.p.image} price={x.p.price} rating={x.p.rating} reviews={x.p.reviews} badge={x.badge} specs={x.specs} pros={x.pros} cons={x.cons} verdict={x.verdict} outKey={'p-' + x.id} />
      ))}
    </div>

    <img class="rd-fig" src={figCantilever} alt="Umbrele cu brat lateral CIUPIGo si Outsunny" width="1200" height="675" loading="lazy" />

    <h2 id="led">Umbrele cu LED</h2>
    <p>Umbra ziua si lumina de ambianta seara, dintr-un singur produs: LED-uri integrate pe spite, pentru cine sta mult pe terasa dupa apus.</p>
    <div class="rd-grid">
      {LED.map(x => (
        <ProductCard name={x.p.name.replace(/’/g, "'")} image={x.p.image} price={x.p.price} rating={x.p.rating} reviews={x.p.reviews} badge={x.badge} specs={x.specs} pros={x.pros} cons={x.cons} verdict={x.verdict} outKey={'p-' + x.id} />
      ))}
    </div>

    <img class="rd-fig" src={figLed} alt="Umbrele de gradina cu LED integrat" width="1200" height="675" loading="lazy" />

    <h2 id="baza">Baza si fixarea</h2>
    <p>Baza e ce tine umbrela in picioare, deci nu o lasa la urma:</p>
    <ul>
      <li><strong>Cat de grea:</strong> pentru o umbrela cu picior central de 2.5-3 m, o baza de 25-40 kg e un minim; la cantilever, mergi spre 50-100 kg, deseori cu dale de beton.</li>
      <li><strong>Umpluta sau din beton:</strong> bazele umplute cu apa sau nisip sunt practice, le golesti iarna; cele de beton sunt cele mai stabile.</li>
      <li><strong>Fixare in sol:</strong> pe iarba sau pamant, un ancoraj infipt in pamant tine si mai bine; pe terasa, o baza grea e obligatorie.</li>
      <li><strong>Regula de aur:</strong> mai bine o baza prea grea decat una prea usoara. O umbrela rasturnata de vant se strica si poate rani pe cineva.</li>
    </ul>

