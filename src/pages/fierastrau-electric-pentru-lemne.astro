const MINI = PICKS.filter(x => x.g === 'mini');
const CABLU = PICKS.filter(x => x.g === 'cablu');
const ACU = PICKS.filter(x => x.g === 'acu');

const hero = '/images/articles/fierastrau-electric-pentru-lemne.webp';
const figMini = '/imagini/articole/fierastrau-mini.webp';
const figCablu = '/imagini/articole/fierastrau-cablu.webp';
const figAcu = '/imagini/articole/fierastrau-acumulator.webp';
const published = '2026-07-19T11:04:34+03:00';

const faq = [
  { question: 'Ce fierastrau electric imi trebuie ca sa tai lemne de foc?', answer: 'Depinde de grosimea lemnului si de unde lucrezi. Pentru busteni grosi de foc, la un punct fix langa priza, o drujba cu cablu de 1800-1900 W cu lama de 35-40 cm, ca Einhell GC-EC 1935 sau Makita, e alegerea care taie mult si repede, cu autonomie nelimitata. Daca vrei sa lucrezi oriunde in curte, fara cablu, o drujba pe acumulator de 36 V cu lama de 35 cm, ca Einhell GE-LC 36/35, taie la fel de gros dar te lasa liber. Pentru crengi, pomi fructiferi si lemn subtire, un mini fierastrau de 6-12 inch, ca Folixs sau Herrgut, e usor, ieftin si suficient.' },
  { question: 'Ce lungime de lama sa aleg?', answer: 'Regula simpla: lama trebuie sa fie cu cel putin 5 cm mai lunga decat grosimea lemnului pe care il tai, ca sa treci dintr-o singura miscare. O lama de 4-8 inch (10-20 cm) e pentru crengi si lemn subtire; una de 25-30 cm e buna pentru lemn mediu de foc; iar 35-40 cm ataca busteni grosi, ca o drujba clasica. Lama mai lunga cere un motor mai puternic, pentru ca frecarea creste, asa ca nu are sens sa iei o lama mare pe un motor mic. Pentru taiat lemne de foc de grosime obisnuita in curte, o lama de 35 cm e alegerea universala.' },
  { question: 'Fierastrau electric cu cablu sau pe acumulator?', answer: 'Cel cu cablu iti da putere multa si autonomie nelimitata la cel mai bun pret, dar te tine legat de o priza, deci e ideal pentru taiat lemn de foc la un punct fix in curte. Cel pe acumulator te lasa sa lucrezi oriunde, prin gradina, la toaletat pomi sau departe de casa, si a ajuns sa taie serios pe modelele de 36 V, dar costa mai mult si are autonomie limitata de baterie. Daca tai mult lemn langa priza, alege cablul; daca vrei libertate de miscare si lucrezi in locuri diferite, alege acumulatorul, ideal pe un sistem de baterii pe care il folosesti si la alte scule.' },
  { question: 'Un mini fierastrau pe acumulator taie lemne de foc?', answer: 'Taie lemn subtire si mediu, nu busteni grosi. Un mini de 4-6 inch, ca Kardett sau Herrgut 6 inch, e pentru crengi, pomi fructiferi si lemnisor de aprins focul, nu pentru trunchiuri. Modelele mai mari, de 8-12 inch, ca Folixs sau Herrgut 12 inch, trec de crengi si taie si bucati de lemn de foc de pana la 25-30 cm, deci se descurca la lemn subtire spre mediu. Pentru busteni grosi de foc ai nevoie de o drujba adevarata, cu lama de 35-40 cm, fie cu cablu, fie pe acumulator de 36 V. Mini fierastraiele castiga la greutate mica, pret si usurinta de manevrare cu o mana.' },
  { question: 'Ce e reculul si cum ma feresc de el?', answer: 'Reculul e saltul brusc al lamei inapoi spre tine, cea mai frecventa cauza de accidente la fierastraie cu lant, si apare mai ales cand varful lamei atinge lemnul. Te feresti tinand aparatul ferm cu ambele maini, taind cu partea de jos a lamei, nu cu varful, si evitand sa infigi varful in lemn. Multe modele au si franare de lant, un mecanism care opreste lantul aproape instant daca apare reculul, plus lant si lama cu risc redus de recul. Poarta mereu ochelari si manusi, iar la drujbele mari si casti si incaltaminte solida. La cele cu cablu, tine cablul mereu in spate, departe de lama.' },
  { question: 'De ce trebuie ulei la lantul fierastraului?', answer: 'Lantul se roteste cu viteza mare pe lama si, fara ungere, se supraincalzeste, se toceste repede si poate chiar gripa pe lama. De aceea, aproape toate fierastraiele cu lant, si cele mari, si multe mini, au un rezervor de ulei si un sistem de ungere automata care unge lantul in timpul lucrului. Verifica nivelul de ulei inainte de fiecare sesiune si completeaza cu ulei special pentru lant, nu cu orice ulei. Un lant bine uns taie mai usor, mai curat, se incalzeste mai putin si tine mult mai mult. E cea mai simpla si mai importanta intretinere la un fierastrau cu lant.' },
  { question: 'Cat de puternic trebuie sa fie fierastraul?', answer: 'La cele cu cablu, puterea se masoara in wati: 1800-1900 W, ca la modelele din selectie, e putere de drujba adevarata, buna pentru lemn de foc gros. La cele pe acumulator conteaza tensiunea: 18 V e pentru crengi si lemn mediu, iar 36 V se apropie de puterea unei drujbe cu cablu si taie busteni grosi. La mini fierastraie, un motor fara perii de 1000-1200 W, ca la Folixs sau Herrgut, e mai eficient si mai durabil decat unul cu perii de 550 W. Ideea de baza: cu cat lemnul e mai gros, cu atat ai nevoie de mai multa putere, iar puterea mare cere si o lama pe masura.' },
  { question: 'Cat costa un fierastrau electric bun pentru lemne?', answer: 'Depinde de tip. Un mini fierastrau pe acumulator pentru crengi si lemn subtire porneste de la circa 160 de lei, ca Kardett de 4 inch, si urca spre 300-450 de lei la modelele mari de 8-12 inch, ca Folixs sau Herrgut. O drujba cu cablu pentru lemn de foc gros costa in general 220-540 de lei, de la Procraft sau Heinner pana la Bosch, iar variantele profesionale Makita trec de 900 de lei. Drujbele pe acumulator full-size pornesc de la circa 580 de lei, ca Einhell 18 V cu kit, si ajung la peste 1000 de lei la modelul de 36 V. Cel mai bun raport il gasesti alegand tipul potrivit grosimii lemnului, nu neaparat cel mai scump.' },
];

