---
interface Article {
  title: string;
  slug: string;
  category?: string;
  categorySlug?: string;
  date?: string;
}

interface Props {
  currentSlug: string;
  currentCategory: string;
  articles: Article[];
}

import keywordsData from '../../keywords.json';
import { slugify } from '../lib/articles.mjs';

const { currentSlug, currentCategory, articles } = Astro.props;

// Prev/Next DOAR in aceeasi categorie + ACELASI grup de vizibilitate: articolele vechi
// (legacy) nu se amesteca cu cele noi. Fara fallback cross-categorie sau cross-grup.
const legacyBySlug = new Map(keywordsData.completed.map(a => [a.slug || slugify(a.keyword), !!a.legacy]));
const currentLegacy = legacyBySlug.get(currentSlug) ?? false;
const sameCatAll = [...articles]
  .filter(a => a.categorySlug === currentCategory && (legacyBySlug.get(a.slug) ?? false) === currentLegacy)
  .sort((a, b) => new Date(a.date || 0).getTime() - new Date(b.date || 0).getTime());
const catIndex = sameCatAll.findIndex(a => a.slug === currentSlug);

const prevArticle: Article | null = catIndex > 0 ? sameCatAll[catIndex - 1] : null;
const nextArticle: Article | null = (catIndex >= 0 && catIndex < sameCatAll.length - 1) ? sameCatAll[catIndex + 1] : null;
---

{(prevArticle || nextArticle) && (
  <nav class="prev-next-nav" aria-label="Navigare articole">
    <div class="prev-next-grid">
      {prevArticle ? (
        <a href={`/${prevArticle.slug}/`} class="prev-next-card prev-card">
          <span class="prev-next-label">&#8592; Anterior</span>
          <span class="prev-next-title">{prevArticle.title}</span>
        </a>
      ) : <div />}
      {nextArticle ? (
        <a href={`/${nextArticle.slug}/`} class="prev-next-card next-card">
          <span class="prev-next-label">Urmator &#8594;</span>
          <span class="prev-next-title">{nextArticle.title}</span>
        </a>
      ) : <div />}
    </div>
  </nav>
)}

<style>
  .prev-next-nav {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid #e7e5e4;
  }

  .prev-next-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .prev-next-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .prev-next-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border: 1px solid #e7e5e4;
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .prev-next-card:hover {
    border-color: #16a34a;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .next-card {
    text-align: right;
  }

  .prev-next-label {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #16a34a;
  }

  .prev-next-title {
    font-size: 1rem;
    font-weight: 500;
    color: #1c1917;
    line-height: 1.4;
  }

  .prev-next-card:hover .prev-next-title {
    color: #16a34a;
  }
</style>
