---
import { categories as allCategories } from '../lib/categories.mjs';
import keywordsData from '../../keywords.json';
import { visibleArticles } from '../lib/articles.mjs';

// Doar categoriile cu articole — pagina unei categorii goale nici nu se genereaza.
const _populated = new Set(visibleArticles(keywordsData.completed).map(a => a.categorySlug));
const categories = allCategories.filter(c => _populated.has(c.slug));
const currentYear = new Date().getFullYear();

const legalLinks = [
  { name: 'Politica de Confidentialitate', slug: 'privacy-policy' },
  { name: 'Termeni si Conditii', slug: 'terms' },
  { name: 'Politica Cookies', slug: 'cookies' }
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">
          <img src="/logo-white.png" alt="CentroCasa" class="footer-logo-img" width="571" height="120">
        </div>
        <p class="footer-desc">
          Sfaturi practice si recomandari de produse pentru casa si gradina ta.
          Te ajutam sa alegi cele mai bune solutii pentru nevoile tale.
        </p>
      </div>

      <div>
        <h4 class="footer-title">Categorii</h4>
        <ul class="footer-links">
          {categories.map(cat => (
            <li><a href={`/${cat.slug}/`}>{cat.name}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="footer-title">Legal</h4>
        <ul class="footer-links">
          {legalLinks.map(link => (
            <li><a href={`/${link.slug}/`}>{link.name}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="footer-title">Link-uri Utile</h4>
        <ul class="footer-links">
          <li><a href="/despre/">Despre noi</a></li>
          <li><a href="/cum-testam/">Cum testam produsele</a></li>
          <li><a href="/autori/">Autori</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/sitemap/">Sitemap</a></li>
          <li><a href="https://ofertatelefoane.ro/">Top Telefoane</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} CentroCasa.ro - Toate drepturile rezervate.</p>
    </div>
  </div>
</footer>
