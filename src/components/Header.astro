---
import { categories as allCategories } from '../lib/categories.mjs';
import keywordsData from '../../keywords.json';
import { visibleArticles } from '../lib/articles.mjs';

// Aratam in nav doar categoriile care au macar un articol. O categorie noua apare
// automat aici cand primeste primul articol — pana atunci n-o linkam sitewide,
// ca sa nu trimitem crawlerul spre o pagina de listare goala.
const _populated = new Set(visibleArticles(keywordsData.completed).map(a => a.categorySlug));
const categories = allCategories.filter(c => _populated.has(c.slug));

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="container">
    <div class="header-inner">
      <a href="/" class="logo" aria-label="CentroCasa - Acasa">
        <img src="/logo.png" alt="CentroCasa - Recenzii si Sfaturi pentru Casa" class="logo-img" width="571" height="120" fetchpriority="high">
      </a>

      <nav class="nav-desktop">
        {categories.map(cat => (
          <a href={`/${cat.slug}/`} class={`nav-link ${currentPath.includes(cat.slug) ? 'active' : ''}`}>
            {cat.short || cat.name}
          </a>
        ))}
      </nav>

      <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Meniu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav">
    <a href="/" class="mobile-nav-link">Acasa</a>
    {categories.map(cat => (
      <a href={`/${cat.slug}/`} class="mobile-nav-link">{cat.short || cat.name}</a>
    ))}
    <a href="/contact/" class="mobile-nav-link">Contact</a>
  </nav>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileNav = document.getElementById('mobile-nav');

  menuBtn?.addEventListener('click', () => {
    mobileNav?.classList.toggle('open');
  });
</script>
