---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import ScrollTop from '../components/ScrollTop.astro';
import keywordsData from '../../keywords.json';
import { slugify } from '../lib/articles.mjs';

// Articolele vechi (legacy, produse fabricate de AI) primesc noindex,follow ca sa nu
// traga in jos calitatea perceputa a domeniului si sa deblocheze crawl-ul paginilor reale.
// Raman 200 + linkurile lor sunt urmarite (follow). Auto-detectat dupa slug, fara a edita cele 48 fisiere.
const legacySlugs = new Set(keywordsData.completed.filter(a => a.legacy).map(a => a.slug || slugify(a.keyword)));
const pageSlug = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const isLegacyArticle = legacySlugs.has(pageSlug);

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  faq?: Array<{ question: string; answer: string }>;
  breadcrumb?: Array<{ name: string; url?: string }>;
  /** hero-ul articolului: se preincarca, fiind de obicei elementul LCP */
  preloadImage?: string;
  preloadSrcset?: string;
  preloadSizes?: string;
}

const {
  title,
  description,
  image = '/images/default-og.jpg',
  canonical,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  faq,
  breadcrumb,
  preloadImage,
  preloadSrcset,
  preloadSizes
} = Astro.props;

const siteUrl = 'https://centrocasa.ro';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;

// WebSite (fara SearchAction fals — nu exista cautare pe site)
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "CentroCasa",
  "url": siteUrl,
  "description": "Sfaturi si recomandari pentru casa si gradina ta",
  "publisher": {
    "@type": "Organization",
    "name": "CentroCasa",
    "url": siteUrl,
    "logo": { "@type": "ImageObject", "url": `${siteUrl}/logo.png`, "width": 571, "height": 120 }
  }
};

// Article schema — doar pe pagini article, din propsurile deja transmise de pagini
const articleSchema = type === 'article' ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "image": ogImage,
  "url": canonicalUrl,
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
  ...(publishedTime ? { "datePublished": publishedTime } : {}),
  ...(modifiedTime ? { "dateModified": modifiedTime } : {}),
  ...(author ? { "author": author.startsWith("Redactia") ? { "@type": "Organization", "name": author, "url": "https://centrocasa.ro/despre/" } : { "@type": "Person", "name": author } } : {}),
  "publisher": {
    "@type": "Organization",
    "name": "CentroCasa",
    "logo": { "@type": "ImageObject", "url": `${siteUrl}/favicon.svg` }
  }
} : null;

// BreadcrumbList — cand pagina transmite breadcrumb
const breadcrumbSchema = breadcrumb && breadcrumb.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumb.map((b, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": b.name,
    ...(b.url ? { "item": b.url.startsWith('http') ? b.url : `${siteUrl}${b.url}` } : {})
  }))
} : null;

const faqSchema = faq && faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;
---

<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <!-- Google Consent Mode v2 — consimtamant implicit REFUZAT (EEA); se actualizeaza doar dupa acceptare -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'analytics_storage': 'denied',
      'functionality_storage': 'granted',
      'security_storage': 'granted',
      'wait_for_update': 500
    });
    try {
      if (localStorage.getItem('cookies-consent') === 'accepted') {
        gtag('consent', 'update', {
          'ad_storage': 'granted',
          'ad_user_data': 'granted',
          'ad_personalization': 'granted',
          'analytics_storage': 'granted'
        });
      }
    } catch (e) {}
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content={isLegacyArticle ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}>
  <meta name="theme-color" content="#16a34a">

  <title>{title}</title>
  {preloadImage && (
    <link rel="preload" as="image" href={preloadImage} imagesrcset={preloadSrcset} imagesizes={preloadSizes} fetchpriority="high" />
  )}
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl}>

  <!-- Open Graph -->
  <meta property="og:type" content={type}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:locale" content="ro_RO">
  <meta property="og:site_name" content="CentroCasa">

  {publishedTime && <meta property="article:published_time" content={publishedTime}>}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime}>}
  {author && <meta property="article:author" content={author}>}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <!-- Favicon (iconita brand) -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <!-- Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
  {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>}
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>}
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <CookieBanner />
  <ScrollTop />
  <script>
    document.addEventListener('click', (e) => {
      const el = e.target.closest('[data-o]');
      if (!el) return;
      try { window.open('/out/' + atob(el.getAttribute('data-o')), '_blank', 'noopener'); } catch {}
    });
  </script>
</body>
</html>
